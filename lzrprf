sub ws_read_frame {
    my ($buffer) = @_;
    return 0 if length($$buffer) < 2;
    my ($flags, $len) = unpack 'CC', $$buffer;
    my ($fin, $op, $at) = ($flags >> 7, $flags & 15, 2);
    return unless !($flags & 0x70) && !($len & 0x80) && ($op <= 2 || $op >= 8 && $op <= 10);
