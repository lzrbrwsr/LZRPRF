        my ($p) = @_;
        for (my $i = 1; $i < $p;) {
            my ($w, $h) = $old->[$i] =~ /^K[0-9]+,[0-9]+,[0-9]+,([0-9]+),([0-9]+)$/;
            my ($pw, $ph) = defined $w ? () : $old->[$i] =~ /^M[0-9]+,[0-9]+,[0-9]+,[0-9]+,([0-9]+),([0-9]+)$/;
