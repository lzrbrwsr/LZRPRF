    my ($way, $roots) = ("$DIR/way.$$", $PEER ne '-' ? "$ROOT/authority.pem" : $ROOTS);
    my $none = 'the request could not be made';
    my $up = $ask && $ask->{method} eq 'POST' ? $ask->{body} : $ask && defined $ask->{key} ? "Authorization: Bearer $ask->{key}\n" : undef;    # [C19] the body a page's POST carries, all that is carried besides the request; or the key that reads the answer to a support request, as a line curl adds to its request, so that no list of processes shows it (sub support_read)
    my @asked = !$ask ? () : ($ask->{method} eq 'HEAD' ? ('--head') : (), defined $ask->{key} ? ('-H', '@-') : (), $ask->{method} eq 'POST' ? ('--data-binary', '@-', '-H', 'Content-Type:' . ($ask->{type} eq '-' ? '' : " $ask->{type}"), '-H', 'Expect:') : (), defined $ask->{origin} ? ('-H', "Origin: $ask->{origin}") : ());    # [C19]
    my $cookie = $page ? sso_cookie($url) : $ask ? $ask->{cookie} : undef;    # [C7] the one exception: the cookies of a provider you connected in this profile, to that provider's own hosts only (sub sso_cookie), carried on curl's input and never on its command line
    if (defined $cookie && !defined $up) { $up = "$cookie\n"; push @asked, '-H', '@-' }
    elsif (defined $cookie && $ask && $ask->{method} eq 'POST' && $up !~ /\x00/) {    # a POST's body and its cookies, both on curl's input as its settings: a quoted text, with \\ \" \t \n \r \v written as curl reads them
        my $quoted = sub { my ($text) = @_; $text =~ s/([\\"])/\\$1/g; $text =~ s/\t/\\t/g; $text =~ s/\n/\\n/g; $text =~ s/\r/\\r/g; $text =~ s/\x0b/\\v/g; return qq("$text") };
        $up = 'header = ' . $quoted->($cookie) . "\ndata-raw = " . $quoted->($up) . "\n";
        my ($at) = grep { $asked[$_] eq '--data-binary' } 0 .. $#asked;
        @asked[$at, $at + 1] = ('-K', '-');    # in place of --data-binary @-: -K - reads both
    }
    unlink $way;
    my $listen = IO::Socket::UNIX->new(Local => $way, Listen => 1) or return (undef, $none);
    pipe(my $from_curl, my $out) or return (undef, $none);
    my ($body_in, $to_curl);
    if (defined $up) { pipe($body_in, $to_curl) or return (undef, $none) }
    my $curl = fork // return (undef, $none);
    if (!$curl) {
        %ENV = ();                        # curl takes no setting from the environment
        my @curl = ($CURL, '-q', '-g', '-s', '-i', '--raw', '--path-as-is', '--proto', '=https', '--tlsv1.2', '--http1.1', '--noproxy', '*', '--no-sessionid', '--ciphers', $TLS_CIPHERS, '--curves', $TLS_CURVES,
            '--cacert', $roots, '--max-time', $seconds, '--max-filesize', $bytes, '--write-out', "$WROTE%{certs}",
            @sent, @asked,
            '--unix-socket', $way, '--', $url);
        if ($PEER ne '-' && open my $instead, '<', "$ROOT/fetcher") { chomp(@curl = <$instead>) }    # "lzrprf try" only: the test's own program in curl's place, to probe this container too
        become($body_in, $out, undef, $FETCH_LIMITS, contain($FETCH, shift @curl, '-D', "WAY=$way", '-D', "ROOTS=$roots"), @curl);    # the memory limit first, then the container
    }
    close $out;
    if (defined $up) {                    # [C19] the body goes to curl as it reads it, never waited for in a write
        close $body_in;
        fcntl($to_curl, POSIX::F_SETFL(), O_NONBLOCK);
        if (!length $up) { close $to_curl; undef $to_curl }
    }
    my ($got, $until, $unreached, $loose, $done, $peer, @links) = ('', now() + $seconds, 0, 0, 0);    # a link: from, to, bytes held, 1 while "from" is open, bytes carried
    my $stopped = 0;
    while (now() < $until && length $got <= $bytes + $WROTE_ROOM && alive() && !grep { $_->[4] > $_->[5] } @links) {    # what curl writes after the answer is read too, and cut off below before the answer's length is judged
        if ($stop && $stop->(\$got)) { $stopped = 1; last }    # it is shown what came so far (sub videoed: a playlist by its type is read no further than a playlist)
        my ($read, $write) = ('', '');
        vec($read, fileno $from_curl, 1) = 1;
        vec($read, fileno $listen, 1) = 1 unless @links;
        vec($write, fileno $to_curl, 1) = 1 if $to_curl;
        for (@links) {
            vec($read, fileno $_->[0], 1) = 1 if $_->[3] == 1 && length $_->[2] < 262144;
            vec($write, fileno $_->[1], 1) = 1 if length $_->[2];
        }
        select($read, $write, undef, 1) > 0 or next;
        if (!@links && vec($read, fileno $listen, 1)) {
            my $in = $listen->accept or last;
            timed('curl-came');
            if (!inside($curl)) { $loose = 1; last }    # [C3] the system did not say that curl is contained: no connection is made for it
            timed('curl-inside');
            (my $site, $peer) = reach($where, $until);
            if (!$site) { $unreached = 1; last }
            timed('connected');
            $in->blocking(0);
            @links = ([$in, $site, '', 1, 0, $SENT_BYTES + length($up // '')], [$site, $in, '', 1, 0, $wire]);    # [C19] a page's POST may carry its body more
            next;
        }
        for my $link (@links) {
            my ($from, $to) = @$link;
            if ($link->[3] == 1 && vec($read, fileno $from, 1)) {
                my $n = sysread($from, $link->[2], 65536, length $link->[2]);
                $link->[3] = 0 if defined $n ? !$n : !$!{EAGAIN};
                $link->[4] += $n // 0;
            }
            if (length $link->[2] && $link->[4] <= $link->[5] && vec($write, fileno $to, 1)) {    # nothing more is passed on once more came than the allowance: so no more than the allowance ever is
                my $sent = syswrite($to, $link->[2]);
                substr($link->[2], 0, $sent, '') if $sent;
                @$link[2, 3] = ('', 0) unless defined $sent || $!{EAGAIN};
            }
            if (!$link->[3] && !length $link->[2]) {    # one side has ended and all it sent is passed on
                shutdown($to, 1);
                $link->[3] = 2;
            }
        }
        if ($to_curl && vec($write, fileno $to_curl, 1)) {
            my $sent = syswrite($to_curl, $up);
            substr($up, 0, $sent, '') if $sent;
            if (!length $up || !defined $sent && !$!{EAGAIN}) { close $to_curl; undef $to_curl }
        }
        if (vec($read, fileno $from_curl, 1)) { sysread($from_curl, $got, 65536, length $got) or ($done = 1, last) }
    }
    close $to_curl if $to_curl;
    my $late = now() >= $until;
    my $capped = !$done && length $got > $bytes + $WROTE_ROOM;    # the reading stopped on the length, not at curl's end: whatever the answer holds, a line like curl's among it too, it is not taken
    my $at = rindex $got, $WROTE;            # curl writes the certificates after the whole answer, so the last such line is curl's own, whatever the answer holds
    my $certs = $at >= 0 ? substr($got, $at + length $WROTE) : '';
    substr($got, $at) = '' if $at >= 0;
    unlink $way;
    my $how = ended($curl, $done ? 2 : 0);    # curl is gone, whatever it was doing, before anything is said about the answer
    my $exit = $how >> 8;
    return (undef, 'the system did not say that curl was in its container') if $loose;
    return (undef, 'you stopped it') if $stopped;
    return (undef, 'the answer is larger than lzrprf takes') if $capped || length $got > $bytes || $exit == 63 || @links && $links[1][4] > $wire;
    return (undef, $none) if @links && $links[0][4] > $links[0][5];
    return (undef, 'could not connect') if $unreached;
    return (undef, 'the site did not answer in time') if $late || $exit == 28;
    return ($got, undef, $peer, $certs) if $done && $how == 0 && length $got && defined $peer;    # an answer is taken only when curl's output was read to its end
    return (undef, 'the certificate does not prove the host') if grep { $exit == $_ } 51, 53, 54, 58, 59, 60, 66, 77, 80, 82, 83, 90, 91;
    return (undef, 'no secure connection could be made') if $exit == 35;
    return (undef, $none);
}

sub alive { !$RUN || getppid() == $RUN }  # the window is still there; without it nothing is carried on

sub public {
    my ($address) = @_;
    if (my $four = inet_pton(AF_INET, $address)) { return public4(unpack 'N', $four) }
    my $six = inet_pton(AF_INET6, $address) or return 0;
    my @part = unpack 'n8', $six;
    my $inside = ($part[6] << 16) | $part[7];                                    # where an address of the older kind is carried
    return public4($inside) if !grep({ $_ } @part[0 .. 4]) && $part[5] == 0xffff;
    return public4($inside) if $part[0] == 0x64 && $part[1] == 0xff9b && !grep { $_ } @part[2 .. 5];
    return 0 unless ($part[0] & 0xe000) == 0x2000;                               # only the block the public internet uses
    return 0 if $part[0] == 0x2002 || $part[0] == 0x2001 && ($part[1] < 0x200 || $part[1] == 0xdb8) || ($part[0] & 0xfff0) == 0x3ff0;    # tunnels, special uses, examples
    return 1;
}

sub public4 {
    my ($number) = @_;
    for (qw(0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24
            192.88.99.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 224.0.0.0/3)) {
        my ($net, $bits) = split m{/};
        return 0 if ($number & (0xffffffff << (32 - $bits) & 0xffffffff)) == unpack 'N', inet_aton($net);
    }
    return 1;
}

# The fixed addresses. Besides what you type, lzrprf fetches five things,
# each only after you asked for it in the window, each written in the log
# first, each sent the way a typed address is: the newest release number
# (below), a report you chose to send (above), after "Install it" the
# installer, from the one or two places the release file names (sub
# installed), a support request you send, and the answer to it when you ask
# to read it (sub support_sent, sub support_read). An address that is not on
# the public internet is not fetched for any.                            # [C4]
sub fixed {
    my ($line, $url, $host, $ask) = @_;   # $ask: a support request sent, or the answer to it read (sub support_sent, sub support_read), the two that are more than a GET of the address alone
    $UNSAID = 0;
    if (listed($url)) { refused('one of the fixed addresses of the release file'); return }    # [C23] never the case for a release made by its maker; held all the same

    open my $request, '>>', "$DIR/busy" or return;
    flock $request, LOCK_SH or return;
    my ($kept) = keeping();
    record($line, $kept) or return;       # [C5]
    my ($where, $why) = $TOR_WANTED ? tor_where($host) : find($host);
    $why = 'that host is not on the public internet' if $where && $PEER eq '-' && grep { $_->{own} } @$where;
    my ($got, $from);
    if (!$why) {
        record("$url -> lzrprf connects " . ($TOR_WANTED ? "through Tor, one circuit for $host" : 'to the first that answers of: ' . join(', ', map { $_->{text} } @$where)), $kept) or return;    # [C5]
        $UNSAID = 1;
        ($got, $why, $from) = fetch($url, $where, $ask, undef, undef, undef, undef, 1);
    }
    record("$url " . ($why ? "failed: $why" : 'answered: ' . length($got) . " bytes from $from"), $kept) or return;    # nothing of the answer is written, and "sub fault" says the report was tried
    $UNSAID = 0;
    return $why ? undef : $got;
}

# The support member licence. "Enter licence code" in the cogwheel's menu
# opens a field for the code you got when you bought the application. A code
# is 120 letters and digits: 75 bytes written in Crockford's base32, read here
# as they are written, with case, spaces and dashes left aside, O read as 0
# and I and L as 1. One byte says its kind (17: a support member), two the
# month it was bought in (months since January 2026), eight are its own
# number, and 64 are an Ed25519 signature over the words LZRBRWSR-LICENCE-1
# and the eleven bytes before it. lzrprf checks that signature itself, with
# the public key below and the system's perl alone (Math::BigInt and
# Digest::SHA), and fetches nothing for it. A code that checks is kept in one
# plain file of yours, licence, written by lzrprf alone; removing the code
# removes the file. An incognito window offers neither this nor a support
# request: both keep something.                                          # [C16]
my $LICENCE_KEY = 'ed25519 none';         # the public key of the licence codes, as their maker publishes it: "ed25519 " and its 32 bytes in base64. "none" until it is made: a code is then checked here by its form, and by its signature where a support request goes
my $CROCKFORD = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';
my @MONTHS = qw(January February March April May June July August September October November December);
my %LICENCE_WHY = (empty => 'Type or paste your licence code first.', form => 'That is not a licence code: a code has 120 letters and digits, in groups of 5.', kind => 'That code is not a support member licence.', signature => 'That code does not check: a letter may be mistyped. Paste it as it was given to you.');

sub licence_key {                         # the 32 bytes of the public key, or nothing while there is none
    my $line = $LICENCE_KEY;
    if ($TRY && open my $in, '<', "$ROOT/licence-key") { $line = <$in> // ''; chomp $line }    # "lzrprf try" only: the test's own key, with codes it signed itself
    my ($text) = $line =~ m{^ed25519 ([A-Za-z0-9+/]{43}=)$} or return;
    my $raw = decode_base64($text);
    return length $raw == 32 ? $raw : undef;
}

sub licence_read {                        # a code as it was typed: its 75 bytes, or nothing and why ("empty", "form", "kind")
    my ($typed) = @_;
    (my $code = uc($typed // '')) =~ s/[\s-]//g;
    return (undef, 'empty') unless length $code;
    $code =~ tr/OIL/011/;
    return (undef, 'form') unless length $code == 120 && $code =~ /^[0-9A-HJKMNP-TV-Z]+$/;
    my $bytes = pack 'B600', join '', map { sprintf '%05b', index $CROCKFORD, $_ } split //, $code;
    return (undef, 'kind') unless ord $bytes == 17;
    return $bytes;
}

sub licence_written { my ($bytes) = @_; return join '-', unpack '(A5)*', join '', map { substr $CROCKFORD, oct("0b$_"), 1 } unpack '(A5)*', unpack 'B600', $bytes }    # the 75 bytes as the seller writes them: 24 groups of 5
sub licence_month { my ($bytes) = @_; my $month = unpack 'n', substr $bytes, 1, 2; return $MONTHS[$month % 12] . ' ' . (2026 + int($month / 12)) }

sub licence_checked {                     # a code typed: (its bytes, "signed" or "form" for a code checked by its form alone while there is no key), or (nothing, why)
    my ($typed) = @_;
    my ($bytes, $why) = licence_read($typed);
    return (undef, $why) unless $bytes;
    my $key = licence_key() // return ($bytes, 'form');
    return signed($key, 'LZRBRWSR-LICENCE-1' . substr($bytes, 0, 11), substr($bytes, 11)) ? ($bytes, 'signed') : (undef, 'signature');
}

# Ed25519 (RFC 8032, section 5.1.7): the signature (R, S) of a message holds
# when S is below the group's order L and S times the base point equals R plus
# h times the key, h being SHA-512 of R, the key and the message, taken modulo
# L. Here S*B and (L-h)*A are added in one pass over the bits of both
# numbers, and the sum must be R itself, byte for byte. Points are kept in
# extended coordinates (X, Y, Z, T), x = X/Z, y = Y/Z, xy = T/Z.
sub signed {
    my ($key, $message, $signature) = @_;
    require Math::BigInt;
    my $two = Math::BigInt->new(2);
    my $p = $two->copy->bpow(255)->bsub(19);
    my $order = $two->copy->bpow(252)->badd('27742317777372353535851937790883648493');
    my $inverse = sub { $_[0]->copy->bmodpow($p->copy->bsub(2), $p) };
    my $d = Math::BigInt->new(-121665)->bmul($inverse->(Math::BigInt->new(121666)))->bmod($p);
    my $number = sub { Math::BigInt->from_hex(unpack 'H*', scalar reverse $_[0]) };    # 32 bytes, the least first
    my $sum = sub {
        my ($u, $v) = @_;
        my ($m, $n) = ((($u->[1] - $u->[0]) * ($v->[1] - $v->[0])) % $p, (($u->[1] + $u->[0]) * ($v->[1] + $v->[0])) % $p);
        my ($c, $e) = ((2 * $d * $u->[3] * $v->[3]) % $p, (2 * $u->[2] * $v->[2]) % $p);
        my ($f, $g, $h, $k) = ($n - $m, $e - $c, $e + $c, $n + $m);
        return [($f * $g) % $p, ($h * $k) % $p, ($g * $h) % $p, ($f * $k) % $p];
    };
    my $point = sub {                     # 32 bytes as a point of the curve, or nothing
        my $y = $number->($_[0]);
        my $odd = $y->copy->brsft(255)->is_one;
        $y->bmod($two->copy->bpow(255));
        return if $y >= $p;
        my $xx = (($y * $y - 1) * $inverse->(($d * $y * $y + 1) % $p)) % $p;
        my $x = $xx->copy->bmodpow(($p + 3) / 8, $p);
        $x = ($x * $two->copy->bmodpow(($p - 1) / 4, $p)) % $p if ($x * $x - $xx) % $p != 0;
        return if ($x * $x - $xx) % $p != 0 || $x->is_zero && $odd;
        $x = $p - $x if $x->is_odd != $odd;
        return [$x, $y, Math::BigInt->new(1), ($x * $y) % $p];
    };
    my $base = $point->(pack 'H*', '58' . '66' x 31);
    my $held = $point->($key) or return 0;
    my $s = $number->(substr $signature, 32);
    return 0 if $s >= $order;
    my $h = $number->(Digest::SHA::sha512(substr($signature, 0, 32) . $key . $message)) % $order;
    my @adds = (undef, $base, $held, $sum->($base, $held));
    my ($one, $other) = map { substr $_->as_bin, 2 } $s, ($order - $h) % $order;
    $_ = ('0' x (256 - length)) . $_ for $one, $other;
    my $at = [Math::BigInt->new(0), Math::BigInt->new(1), Math::BigInt->new(1), Math::BigInt->new(0)];
    for my $i (0 .. 255) {
        $at = $sum->($at, $at);
        my $which = substr($one, $i, 1) + 2 * substr($other, $i, 1);
        $at = $sum->($at, $adds[$which]) if $which;
    }
    my $z = $inverse->($at->[2]);
    my ($x, $y) = (($at->[0] * $z) % $p, ($at->[1] * $z) % $p);
    $y->badd($two->copy->bpow(255)) if $x->is_odd;
    my $hex = substr $y->as_hex, 2;
    return scalar(reverse pack 'H*', ('0' x (64 - length $hex)) . $hex) eq substr($signature, 0, 32);
}

sub licence_kept {                        # the code kept, as written, and its bytes; nothing when none is kept
    return if $INCOGNITO;
    open my $in, '<', "${\ shared()}/licence" or return;
    my $line = <$in> // '';
    chomp $line;
    my ($bytes) = licence_read($line);
    return unless $bytes;
    return ($line, $bytes);
}

sub licence_told { my (undef, $bytes) = licence_kept(); window($INCOGNITO ? 'licence off' : $bytes ? 'licence kept ' . licence_month($bytes) : 'licence none') }
sub licence_refused { my ($says) = @_; window("licence refused $says"); return idle($says) }

sub licence_set {
    my ($typed) = @_;
    return licence_refused("$UNKEPT, so it keeps no licence code.") if $INCOGNITO;    # [C16]
    busy('Checking the licence code on this Mac.');
    my ($bytes, $how) = licence_checked($typed);
    return licence_refused($LICENCE_WHY{$how}) unless $bytes;
    my $month = licence_month($bytes);
    record('you entered a support member licence code: it is kept in the file licence, and is not written here') or return licence_refused('The licence code was not kept: its line could not be written to the log.');
    unlink "${\ shared()}/licence.new";
    return licence_refused('The licence code was not kept: its file could not be written.') unless put("${\ shared()}/licence.new", O_EXCL, licence_written($bytes)) && rename("${\ shared()}/licence.new", "${\ shared()}/licence");
    synced(shared());
    window("licence kept $month");
    return idle("The licence code is kept: this browser is a support member's, since $month. " . ($how eq 'signed' ? 'It was checked on this Mac. A support request you send carries it, so it is answered first.' : 'Its form was checked on this Mac; its signature is checked where a support request goes, and a request you send carries it, so it is answered first.'));
}

sub licence_removed {
    return licence_refused("$UNKEPT, so it keeps no licence code.") if $INCOGNITO;    # [C16]
    my $had = -e "${\ shared()}/licence";
    unlink "${\ shared()}/licence.new";
    return licence_refused('The licence code could not be removed: its file is still there.') if $had && !unlink "${\ shared()}/licence";
    synced(shared());
    record('you removed the support member licence code, and its file') if $had;
    window('licence none');
    return idle($had ? 'The licence code was removed, and its file with it. Support requests now go without it.' : 'No licence code was kept.');
}

# A support request. "Support request" in the cogwheel's menu opens a box for
# your words, a support question or a feature you would like. It goes to the
# one address the application's release file names for it, the line
# "support", and to no other: never a host the window or a page gives. It is
# a POST of JSON, sent as every fixed request is (sub fixed): its line in the
# log first, through the one place that connects, by curl in its container,
# with the fixed lines of [C7] and the body. The body holds exactly: "text",
# your words and then one line with the number of this release; "licence",
# the code you entered, only when one is kept; and "screenshot", a PNG of the
# window drawn by the window itself into a picture of its own, only when you
# ticked it, which shows the page in it and the address in its bar. Nothing
# else: no address of a page besides what that picture shows, no history, no
# name of this computer or of you. The window lists all
# of it before Send. The log says that a request was sent, never its words.
# The answer names the request's reference and a key, given once; both are
# kept in one plain file of yours, support, so that "Read the answer" can
# read the answer later: a GET of the reference's address under the support
# address, with the key in the line Authorization, which curl takes on its
# input, so no list of processes shows it. A request sent later replaces the
# one kept, and "Forget it" removes the file.                    # [C4] [C7]
my $SUPPORT_TEXT = 4000;                  # DECLARED(the most characters the support address takes in one request, the release line counted)
my $SUPPORT_PICTURE = 2 * 1024 * 1024;    # DECLARED(the largest PNG the support address takes)
my $SUPPORT_MESSAGES = 100;               # DECLARED(the most messages of one request the window is shown)

sub support_address {                     # the support address the release file names: (address, host), or nothing
    return if $INCOGNITO;                 # [C16]
    my ($line) = map { /^support (https:\/\/\S+)$/ ? $1 : () } release_lines();
    my ($url, $host) = address($line // '');
    return unless $url && $url eq $line && $url =~ m{^https://[^/?#]+(?:/[A-Za-z0-9_-]+)+$};    # the line as lzrprf would fetch it, and a plain path with no query: the reference is added to it
    return ($url, $host);
}

sub support_kept { return if $INCOGNITO; open my $in, '<', "${\ shared()}/support" or return; my $line = <$in> // ''; return $line =~ /^([A-Za-z0-9_-]{22}) ([A-Za-z0-9_-]{43})\n?\z/ ? ($1, $2) : () }    # the reference and the key of the request sent last
sub support_told { my (undef, $host) = support_address(); my ($ticket) = support_kept(); my ($release) = beside(); window($INCOGNITO ? 'support off incognito' : $host && defined $release ? "support on $host $release" : 'support off none', 'support kept ' . ($host && $ticket ? $ticket : '-')) }
sub support_failed { my ($says) = @_; window("support failed $says"); return idle($says) }

sub support_words {                       # the words the window sent, in base64 of UTF-8: as text with no control or format character but line ends and tabs, or nothing
    my ($text) = @_;
    return if length $text > 4 * int((4 * $SUPPORT_TEXT + 2) / 3);    # more bytes than the most characters can take, each of four bytes
    require Encode;
    $text = eval { Encode::decode('UTF-8', decode_base64($text), Encode::FB_CROAK()) } // return;
    $text =~ s/\r\n?/\n/g;
    $text =~ s/[\x00-\x08\x0b-\x1f\x7f-\x9f\x{ad}\x{200b}-\x{200f}\x{2028}-\x{202e}\x{2060}-\x{206f}\x{feff}\x{fff9}-\x{fffb}]//g;
    $text =~ s/^\s+|\s+$//g;
    return $text;
}

sub support_picture {                     # a PNG as the window draws one: its signature, IHDR first and IEND last, at most $SUPPORT_PICTURE bytes; or nothing
    my ($text) = @_;
    return unless length $text <= 4 * int(($SUPPORT_PICTURE + 2) / 3) && length($text) % 4 == 0 && $text =~ /^[A-Za-z0-9+\/]+={0,2}$/;
    my $png = decode_base64($text);
    return unless length $png >= 57 && length $png <= $SUPPORT_PICTURE && substr($png, 0, 8) eq "\x89PNG\r\n\x1a\n" && substr($png, 12, 4) eq 'IHDR' && substr($png, -8, 4) eq 'IEND';
    return $png;
}

sub support_answer {                      # what the support address answered: (status, its JSON as Perl data); nothing for an answer in no such form
    my ($got, $method) = @_;
    my ($status, undef, $body) = @{ live_parts($got, $method) // [] } or return;
    require JSON::PP;
    my $data = eval { JSON::PP->new->utf8->max_depth(8)->decode($body) };
    return ($status, ref $data eq 'HASH' ? $data : undef);
}

sub support_problem {                     # why the support address took nothing, in plain words
    my ($status, $data) = @_;
    my ($first) = ref $data && ref $data->{problems} eq 'ARRAY' ? grep { defined && !ref } @{ $data->{problems} } : ();
    return 'it does not take support requests yet' if ($status // '') eq '503';
    return 'too many requests reached it just now; try again in an hour' if ($status // '') eq '429';
    return 'the request is too large' if ($status // '') eq '413';
    return 'it answered ' . ($status // 'in no form lzrprf reads') . (defined $first ? ': ' . tool_plain($first, 200) : '');
}

sub support_sent {
    my ($words, $picture) = @_;
    return support_failed("$UNKEPT, so it sends no support request.") if $INCOGNITO;    # [C16]
    my ($url, $host) = support_address() or return support_failed('This application names no address for support requests, so nothing was sent.');
    my ($release) = beside();
    return support_failed('This application has no release number, so nothing was sent.') unless defined $release;
    my $last = "Release $release";
    my $text = support_words($words) // return support_failed('Your words could not be read, so nothing was sent.');
    return support_failed('Write what the request is about first. Nothing was sent.') unless length $text;
    return support_failed('The words are longer than ' . ($SUPPORT_TEXT - length($last) - 2) . ' characters. Nothing was sent.') if length($text) + 2 + length($last) > $SUPPORT_TEXT;
    my $png;
    if ($picture ne '-') { $png = support_picture($picture) // return support_failed('The picture of the window is not one lzrprf sends, so nothing was sent.') }
    my ($code) = licence_kept();
    require JSON::PP;
    my $json = JSON::PP->new->ascii->allow_nonref;
    my $body = '{"text":' . $json->encode("$text\n\n$last") . (defined $code ? ',"licence":' . $json->encode($code) : '') . (defined $png ? ',"screenshot":"' . encode_base64($png, '') . '"' : '') . '}';
    busy("Sending your support request to $host.");
    my $got = fixed('you sent a support request' . (defined $code ? ', with your licence code' : '') . (defined $png ? ', with a picture of the window' : '') . ": $url", $url, $host, { method => 'POST', body => $body, type => 'application/json' });
    return support_failed($UNSAID ? 'lzrprf tried to send the request. Whether it arrived is not shown: the line that says how it ended could not be written to the log.' : 'The request could not be sent. The log says why.') unless defined $got;
    my ($status, $data) = support_answer($got, 'POST');
    my ($ticket, $key) = $data ? ($data->{ticket} // '', $data->{key} // '') : ('', '');
    return support_failed('The support address did not take the request: ' . support_problem($status, $data) . '.') unless ($status // '') eq '200' && $ticket =~ /^[A-Za-z0-9_-]{22}\z/ && $key =~ /^[A-Za-z0-9_-]{43}\z/;
    unlink "${\ shared()}/support.new";
    my $kept = put("${\ shared()}/support.new", O_EXCL, "$ticket $key") && rename("${\ shared()}/support.new", "${\ shared()}/support");
    synced(shared());
    my $licence = ($data->{licence} // '') =~ /^(none|accepted|refused)\z/ ? $1 : 'none';
    window("support sent $ticket " . ($data->{priority} ? 'priority' : 'plain') . " $licence", 'support kept ' . ($kept ? $ticket : '-'));
    return idle("Your support request was sent. Its reference is $ticket." . ($licence eq 'accepted' ? ' It goes with your licence code, so it is answered first.' : $licence eq 'refused' ? ' Your licence code was not taken, so it goes without priority.' : '') . ($kept ? ' Read the answer later from Support request in the cogwheel\'s menu.' : ' Its key could not be kept, so its answer cannot be read here.'));
}

sub support_read {
    return support_failed("$UNKEPT, so it reads no support request.") if $INCOGNITO;    # [C16]
    my ($url, $host) = support_address() or return support_failed('This application names no address for support requests.');
    my ($ticket, $key) = support_kept() or return support_failed('No support request is kept here.');
    require Encode;
    busy("Reading the answer to your support request from $host.");
    my $got = fixed("you read the answer to your support request: $url/$ticket", "$url/$ticket", $host, { method => 'GET', key => $key });
    return support_failed('The answer could not be read. The log says why.') unless defined $got;
    my ($status, $data) = support_answer($got, 'GET');
    return support_failed('The support address knows no request by this reference and key now.') if ($status // '') eq '404';
    return support_failed('The answer could not be read: ' . support_problem($status, $data) . '.') unless ($status // '') eq '200' && $data && ref $data->{messages} eq 'ARRAY';
    my $state = ($data->{status} // '') =~ /^(open|answered|resolved|rejected)\z/ ? $1 : 'open';
    my $shown = sub { my ($text, $most) = @_; $text = defined $text && !ref $text ? "$text" : ''; $text =~ s/[\x00-\x08\x0b-\x1f\x7f-\x9f\x{ad}\x{200b}-\x{200f}\x{2028}-\x{202e}\x{2060}-\x{206f}\x{feff}]//g; return encode_base64(Encode::encode('UTF-8', substr($text, 0, $most)), '') };    # words of the answer, shown as text and nowhere acted on
    my @messages = grep { ref eq 'HASH' } @{ $data->{messages} };
    splice @messages, 0, @messages - $SUPPORT_MESSAGES if @messages > $SUPPORT_MESSAGES;    # the newest are shown
    my @lines = ("support thread $state " . $shown->($data->{reason}, 300));
    for my $one (@messages) {
        my $author = ($one->{author} // '') =~ /^(user|support|agent)\z/ ? $1 : next;
        my $at = ($one->{at} // '') =~ /^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2})/ ? $1 : '-';
        push @lines, "support message $author $at " . $shown->($one->{body}, $SUPPORT_TEXT);
    }
    window(@lines, 'support thread end');
    return idle("The answer to your support request $ticket is shown: it is $state.");
}

sub support_forgot {
    return support_failed("$UNKEPT, so it keeps no support request.") if $INCOGNITO;    # [C16]
    my $had = -e "${\ shared()}/support";
    unlink "${\ shared()}/support.new";
    return support_failed('The support request could not be forgotten: its file is still there.') if $had && !unlink "${\ shared()}/support";
    synced(shared());
    window('support kept -');
    return idle($had ? 'The support request is forgotten here: its reference and key were removed. Its answer can no longer be read on this Mac.' : 'No support request was kept.');
}

# What the application's maker put beside the program, in a file "release":
# the number of this release, and up to four addresses. Where the newest
# release number is published, where the installer is, where reports go, and
# a second place that holds the same installer ("same"), so that the copy
# from one place can be compared with the copy from the other. A newer
# application also names the SHA-256 of the lzrprf it was installed with
# ("lzrprf"). A program without that file is never checked for a newer one,
# and is never asked about in a report.
sub release_file { $PROGRAM =~ m{^(.*\.app)/Contents/MacOS/} ? "$1/Contents/Resources/release" : dirname($PROGRAM) . '/release' }
sub release_lines { open my $in, '<', release_file() or return; return <$in> }

sub beside {
    my %is = map { /^(release|newest|installer|report|same|lzrprf) (\S+)$/ ? ($1 => $2) : () } release_lines();
    return unless ($is{release} // '') =~ /^\d{1,6}$/;
    my ($same) = address($is{same} // '');
    return ($is{release}, (map { my ($url) = address($is{$_} // ''); $url } 'newest', 'report', 'installer'), exists $is{same} ? $same // '' : undef, $is{lzrprf});    # the last: the SHA-256 of the lzrprf the application was installed with, when the file names it. A second place that is named and is no address counts as one that does not agree: nothing is written
}

# A newer release. The first time, you are asked whether lzrprf may look at
# each start, and your answer is kept in a file. A yes is kept with the
# address it was given for: when a later release names another address, the
# yes does not count for it and you are asked again. With a yes, lzrprf fetches
# one fixed address at each start, where the newest release number is
# published and nothing else. The request holds what "request" above holds:
# the same request from every computer, so it says nothing about you or about
# which release you run, and it is written in the log like any other. When
# the number there is larger than the one beside the program, the window says
# so and offers the installer. "Install it" is the yes: the installer then
# runs at once, in a modal of lzrprf's own in this window, in auto: it shows
# no question, since nobody is there choosing, and every line it prints is
# shown there and kept in install.txt (sub installed).
# THE RELEASE KEY AND THE APPROVAL KEYS. An update is offered, and its installer is run, only when
# its release is signed and approved [C25]. A release is signed as a manifest: its number, when it
# was signed, until when the signature holds, and the SHA-256 of each file a person downloads or
# runs. Two SSH signatures (ssh-keygen -Y) are made over the same manifest, and both must hold:
#   the approval, namespace lzrbrwsr-approval, by an approval key. The first is made in the Secure
#   Enclave of the owner's phone, opens only to his Face ID at each use and never leaves the phone.
#   He reads the release on his phone and approves it there. By his decision of 2026-11-22 a
#   second key may approve too: the agent approval key, held by the project's signing service,
#   so releases go out as work lands. Its line ends "valid-until YYYY-MM-DD": it holds through
#   that day (UTC) and never after (sub approval_key_current), and a release that drops the line
#   revokes it.
#   the signature, namespace lzrbrwsr-release, by the release key. Its private half is on the
#   project's server, readable by the signing service alone, which signs only a manifest that
#   carries a valid approval, and each release number once.
# So without the agent approval key no program, server or person at a computer can authorize a release
# without the owner's approval on his phone, and the phone alone cannot publish one either; while that
# key is listed and in date, the project's server can, and nothing else. The public halves are written here
# and beside this file (release-key.pub, approval-keys.pub). The manifest and both signatures stand
# beside the installer, in each place the release file names it, and both places must hold the same
# three files. lzrprf reads the manifest in one form only (sub manifest_read) and has macOS's own
# ssh-keygen check each signature in the verifier container: no network, nothing to write, and of
# the disk the system's files and the folder with the manifest, the signature and the keys (sub
# signature_holds). A release is refused when the manifest cannot be fetched or read, either
# signature does not hold for its keys, its number is not the published one or not newer than yours, it says it was signed
# later than now, it expired or says it holds longer than a year and a month, or it names no
# installer; and the installer runs only when its SHA-256 is the one the manifest names. A refusal
# has no way around it: nothing is installed, and the window says why.
my $RELEASE_KEY = 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINHg3YnFC/5ryVmSXSX4jSb/+x8HsD8B52O07Ug75X+C lzrbrwsr-release';    # [C25] the public half of the release key
my $RELEASE_NAMESPACE = 'lzrbrwsr-release';    # [C25] what an SSH signature says it was made for: a signature made for anything else does not hold
my @APPROVAL_KEYS = (                     # [C25] the public halves of the approval keys, one OpenSSH line each: one of them approves each release; a line ending "valid-until YYYY-MM-DD" holds through that day only (sub approval_key_current)
    'ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBIWKMATpVOLaAKtBC4cBWQYxOMaESOFLQrgngQ8BuBU7xm5z4JEA+a9JMkTi0dSj7FVpQZ2HhViKWh+FOcp0DVU= henry-phone',
    'ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBC8gYmKCyxfiGXwWmeZZDRY2wyW1MbVBRkaDEKff8qS13flShTkVHiRkKkCCPIwmayFMNVQ9JeMqnOx5nIb1yJM= lzrbrwsr-agent valid-until 2027-02-28',
);
my $APPROVAL_NAMESPACE = 'lzrbrwsr-approval';    # [C25] what the approval says it was made for
my $MANIFEST_MOST = 4096;                 # [C25] bytes a manifest may hold
my $SIGNATURE_MOST = 2048;                # [C25] bytes its signature may hold
my %SIGNATURE_HELD;                       # [C25] what the verifier said of each manifest, signature and keys asked in this window (sub signature_holds)
my $SIGNED_DAYS = 400;                    # [C25] the longest a signature may say it holds, counted from when it was signed
my $VERIFIER = <<'END';
(allow file-read* (subpath (param "WORK")))
(allow file-write-data (literal "/dev/null"))
(allow sysctl-read (sysctl-name "kern.hostname"))
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo"))
END

sub release_key {                         # the key a signature must hold for; "lzrprf try" alone may be given a test's key, in its own folder, and installs nothing
    return $RELEASE_KEY unless $TRY;
    open my $in, '<', "$ROOT/release-key.pub" or return $RELEASE_KEY;
    my $key = <$in> // '';
    chomp $key;
    return $key =~ m{\Assh-ed25519 [A-Za-z0-9+/]{60,80}={0,2}(?: [!-~]{1,64})?\z} ? $key : $RELEASE_KEY;
}

sub approval_keys {                       # the keys an approval must hold for, those past their valid-until day left out; "lzrprf try" alone may be given a test's keys, in its own folder, and installs nothing
    my @keys = @APPROVAL_KEYS;
    if ($TRY && open my $in, '<', "$ROOT/approval-keys.pub") {
        my @read = grep { m{\Aecdsa-sha2-nistp256 [A-Za-z0-9+/]{100,200}={0,2}(?: [!-~]{1,64})?(?: valid-until [0-9]{4}-[0-9]{2}-[0-9]{2})?\z} } map { s/\n\z//r } <$in>;
        @keys = @read if @read;
    }
    return grep { approval_key_current($_) } @keys;
}

sub approval_key_current {                # [C25] an approval key whose line ends "valid-until YYYY-MM-DD" holds through the end of that day (UTC) and never after; a line without one holds until a release takes it out
    my ($key) = @_;
    return 1 unless $key =~ / valid-until /;
    my ($y, $m, $d) = $key =~ / valid-until ([0-9]{4})-([0-9]{2})-([0-9]{2})\z/ or return 0;
    my $until = eval { Time::Local::timegm(0, 0, 0, $d, $m - 1, $y) } // return 0;
    return time < $until + 86400 ? 1 : 0;
}

sub manifest_read {                       # [C25] a manifest in its one form, as numbers and sums; or nothing and why
    my ($text) = @_;
    my $bad = 'the manifest is not in its form';
    return (undef, $bad) unless length $text <= $MANIFEST_MOST && $text =~ /\A[\x20-\x7e\n]*\n\z/;
    my @lines = split /\n/, $text;
    return (undef, $bad) unless @lines >= 5 && @lines <= 36 && $lines[0] eq 'lzrbrwsr release manifest 1';
    my ($release) = $lines[1] =~ /\Arelease ([1-9][0-9]{0,5})\z/;
    my @when;
    for my $at (2, 3) {
        my ($word) = $at == 2 ? 'signed' : 'expires';
        my @t = $lines[$at] =~ /\A$word ([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})Z\z/ or return (undef, $bad);
        return (undef, $bad) unless $t[1] >= 1 && $t[1] <= 12 && $t[2] >= 1 && $t[2] <= 31 && $t[3] < 24 && $t[4] < 60 && $t[5] < 60;
        push @when, eval { Time::Local::timegm($t[5], $t[4], $t[3], $t[2], $t[1] - 1, $t[0]) } // return (undef, $bad);
    }
    my %files;
    for my $line (@lines[4 .. $#lines]) {
        my ($name, $sum) = $line =~ /\Afile ([A-Za-z0-9][A-Za-z0-9._-]{0,63}) ([0-9a-f]{64})\z/ or return (undef, $bad);
        return (undef, $bad) if exists $files{$name};
        $files{$name} = $sum;
    }
    return (undef, $bad) unless defined $release;
    return ({ release => $release, signed => $when[0], expires => $when[1], files => \%files });
}

sub signature_holds {                     # [C25] macOS's own ssh-keygen, in the verifier container, says the signature holds for one of these keys, made for this namespace
    my ($manifest, $signature, $namespace, $type, @keys) = @_;
    my $asked = Digest::SHA::sha256_hex(join "\0", $manifest, $signature, $namespace, $type, @keys);    # the same bytes asked again in this window, as the curated rules and the filter lists each ask: the answer the verifier gave
    return $SIGNATURE_HELD{$asked} if exists $SIGNATURE_HELD{$asked};
    return $SIGNATURE_HELD{$asked} = signature_checked($manifest, $signature, $namespace, $type, @keys);
}

sub signature_checked {                   # [C25] signature_holds asked of the verifier: macOS's own ssh-keygen, in the verifier container
    my ($manifest, $signature, $namespace, $type, @keys) = @_;
    return 0 unless @keys && $signature =~ m{\A-----BEGIN SSH SIGNATURE-----\n(?:[A-Za-z0-9+/=]{1,76}\n){1,30}-----END SSH SIGNATURE-----\n\z} && length $signature <= $SIGNATURE_MOST;
    my $allowed = join "\n", map { my @key = split / /; qq{$namespace namespaces="$namespace" $key[0] $key[1]} } @keys;
    my $work = "${\ shared()}/verify.$$";
    remove_tree($work);
    mkdir($work, 0700) or return 0;
    my @is = lstat $work;
    my $real = abs_path($work) // '';
    my $held = 0;
    if (@is && -d _ && $is[4] == $< && $real !~ /["\\\n]/ && length $real
        && put("$real/manifest", O_EXCL, $manifest =~ s/\n\z//r) && put("$real/manifest.sig", O_EXCL, $signature =~ s/\n\z//r)
        && put("$real/allowed", O_EXCL, $allowed)) {
        my ($said, $well) = said(10, '/bin/sh', '-c', 'exec "$@" <"$0"', "$real/manifest",
            contain($VERIFIER, '/usr/bin/ssh-keygen', '-D', "WORK=$real"),
            '-Y', 'verify', '-f', "$real/allowed", '-I', $namespace, '-n', $namespace, '-s', "$real/manifest.sig");
        $held = $well && $said =~ /\AGood "\Q$namespace\E" signature for \Q$namespace\E with \Q$type\E key /;
    }
    remove_tree($work);
    return $held;
}

sub release_signed {                      # [C25] the signed manifest of release $there, fetched from beside each installer; or nothing and why it is refused
    my ($there, $release, $installer, $same) = @_;
    my @places = map { m{\A(https://[^?#\s]*/)[^/?#\s]+\z} ? $1 : () } $installer, defined $same ? $same : ();
    return (undef, 'the release file names no place beside the installer for a signed manifest') unless @places == (defined $same ? 2 : 1);
    my (@manifests, @signatures, @approvals);
    for my $place (@places) {
        my ($host) = $place =~ m{^https://([^/:]+)};
        for my $kind (['release.manifest', \@manifests, $MANIFEST_MOST], ['release.manifest.sig', \@signatures, $SIGNATURE_MOST], ['release.manifest.approval', \@approvals, $SIGNATURE_MOST]) {
            my ($name, $into, $most) = @$kind;
            my $got = fixed("lzrprf fetches the signed manifest of release $there: $place$name", "$place$name", $host);
            my $body = defined $got ? body_of($got) : undef;
            return (undef, "$place$name could not be fetched") unless defined $body && length $body && length $body <= $most;
            push @$into, $body;
        }
    }
    return (undef, 'the two places hold different manifests, signatures or approvals') if @places == 2 && ($manifests[0] ne $manifests[1] || $signatures[0] ne $signatures[1] || $approvals[0] ne $approvals[1]);
    my ($manifest, $why) = manifest_read($manifests[0]);
    return (undef, $why) unless $manifest;
    return (undef, 'it is not approved with an approval key lzrprf carries: a key past its valid-until day is not carried') unless signature_holds($manifests[0], $approvals[0], $APPROVAL_NAMESPACE, 'ECDSA', approval_keys());
    return (undef, 'its signature does not hold for the release key lzrprf carries') unless signature_holds($manifests[0], $signatures[0], $RELEASE_NAMESPACE, 'ED25519', release_key());
    return (undef, "the signed manifest is of release $manifest->{release}, not of the published $there") unless $manifest->{release} == $there;
    return (undef, "release $there is not newer than release $release") unless $there > $release;
    my $now = time;
    return (undef, 'it says it was signed later than this Mac says it is now') if $manifest->{signed} > $now + 86400;
    return (undef, 'its signature expired') if $now >= $manifest->{expires};
    return (undef, "its signature says it holds longer than $SIGNED_DAYS days") unless $manifest->{expires} > $manifest->{signed} && $manifest->{expires} - $manifest->{signed} <= $SIGNED_DAYS * 86400;
    return (undef, 'the signed manifest names no installer') unless $manifest->{files}{'install.sh'};
    return ($manifest);
}

sub newer {
    my ($asked) = @_;                     # "update-check": Check for updates in the cogwheel's menu was chosen, and that choice is the yes for this one look
    my ($release, $newest, undef, $installer, $same) = beside();
    return $asked && checked_said('none') unless $newest && $installer;
    return newer_looked($release, $newest, $installer, $same, 1) if $asked;
    my ($may, $back) = ('', strip_back());
    if (open my $in, '<', "${\ shared()}/look") { $may = <$in> // '' }
    $may = $may eq "yes $newest" ? 'yes' : $may =~ /^no\b/ ? 'no' : '';    # a yes for another address is no yes for this one; a no stays a no
    if (!$may) {
        $may = ask("May lzrprf look for a newer release of $APP at each start? It fetches one fixed address, $newest, with the same request from every computer, and writes it in the log like every other. The request does not say who you are or what you read; the host of that address sees your internet address, as every site does.", 'No', 'Yes, look') == 2 ? 'yes' : 'no';
        unlink "${\ shared()}/look";
        my $kept = record($may eq 'yes' ? "you allowed lzrprf to look for a newer release at each start: $newest" : 'no newer release is looked for: the question was answered no, or not at all');    # an answer that lasts is a line first, like a change of what is kept: without its line it is not kept
        my $out;
        $kept &&= sysopen($out, "${\ shared()}/look", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) && print({$out} ($may eq 'yes' ? "yes $newest" : 'no')) && close($out);
        if (!$kept) {                         # no line, or no place to keep it: the answer counts for nothing, now or later, and the question comes again at the next start
            unlink "${\ shared()}/look";
            record('that answer could not be kept: no newer release is looked for now, and you are asked again at the next start');
            $may = 'no';
        }
        $back->();                        # the question was in the strip: answered, it leaves the window closed to every press until this
    }
    return unless $may eq 'yes';
    return newer_looked($release, $newest, $installer, $same, 0);
}

# One look at the published release number, at a start allowed to look or for Check for updates;
# when it was done and what it found is kept in a plain file of yours, checked ("EPOCH RESULT":
# "same N", "newer N" or "failed"), and told to the window as "checked EPOCH RESULT", which shows
# it under Check for updates. An incognito window looks for nothing and keeps nothing.    # [C16]
sub newer_looked {
    my ($release, $newest, $installer, $same, $asked) = @_;
    my $back = strip_back();
    busy('Looking for a newer release.');
    my ($host) = $newest =~ m{^https://([^/]+)};
    my $got = fixed(($asked ? 'you chose Check for updates: ' : '') . "lzrprf looks for a newer release: $newest", $newest, $host);
    my ($there) = defined $got ? $got =~ m{\AHTTP/1\.1 200 .*?\r\n\r\n(?:[0-9a-f]{1,4}\r\n)?(\d{1,6})\s*(?:0\r\n\r\n)?\z}s : ();    # one number and nothing else, or the answer counts for nothing
    checked_said(!defined $there ? 'failed' : $there > $release ? "newer $there" : "same $release", $asked);
    if ($asked) {                         # that it is the newest stands in the menu, beside Check for updates, and in this window's log: the strip stays as it was
        my $says = !defined $there ? 'lzrprf could not read the newest release number just now. The log says what was fetched.' : $there > $release ? "A newer release of $APP is published: $there." : "You run the newest release of $APP, $release.";
        noted($says);
        defined $there && $there <= $release ? aside($says) : idle($says);
        $back = strip_back();             # what the strip says now is what a "Later" below puts back
    }
    else { $back->() }                    # the start's own look: it said busy, so it says idle, with the strip's words as they were
    return unless defined $there && $there > $release;
    my ($signed, $refused) = release_signed($there, $release, $installer, $same);    # [C25]
    if (!$signed) {
        my $says = "A newer release of $APP is published ($there), and it is not offered: $refused. Only a release signed with the release key lzrprf carries is installed, and nothing else is.";
        record("release $there is not offered: $refused");
        noted($says);
        aside($says);
        return;
    }
    return $back->() unless ask("A newer release of $APP is published: $there. You run $release. Install it fetches the installer and runs it here, in this window, with no further question: every line it prints is shown and kept in ${\ shared()}/install.txt.", 'Later', 'Install it') == 2;
    installed($there, $installer, $same, $signed);
    return $back->();                     # the installer did not run to its end (an install that is done never comes back here): its modal says why, and the window takes a press again
}

# A welcome, once after each install or update. At the first start of a
# release this folder was not welcomed to yet, the window shows a modal: what
# is new in it (the release file's lines "new", at most six) and, every time,
# two short groups, what $APP keeps you from and what it cannot, which stays
# yours to watch, so that every release is begun with the right picture of
# what it does. A site can still do things to you with what you give it: the
# second group says so before anything is opened. "Got it" closes it, and only
# then is the release number written to $DIR/welcomed, a number and nothing
# else; when it cannot be written the welcome comes again at the next start.
# Nothing is fetched for it. An application without a release file shows none,
# and "lzrprf try" only when its folder holds a file "welcome".
my @PROTECTS = (
    'Page scripts: the scripts of a page run sealed in its container, with no network, no file of yours and no other program, so no tracking code, fingerprinting or hidden miner runs either.',
    'Being followed: every site gets the same request from every computer, with no cookie and nothing kept from an earlier visit, except the sign-in of a provider you connected, which goes to the sites of that provider alone.',
    'Pages reaching your Mac: each page is drawn in a sealed container with no network, no file of yours and no other program.',
    'Hidden requests: nothing is fetched that you did not ask for, and every address is in your log before it is fetched.',
);
my @CANNOT = (
    'What you send: whatever you type into a site, a password, a card number, your name, goes to that site, to keep or to misuse.',
    'What a site does on its side: a site you sign in to knows it is you, and keeps and shares what you do there on its own servers.',
    'Fake sites and scams: a page can look exactly like your bank. Read the address in the bar before you trust it or type anything.',
    'What you take elsewhere: a file you save and open, or a link you follow in another program, is outside $APP.',
    'Your internet address: every site you open sees it, as with every browser.',
);
sub welcome {
    my ($release) = beside();
    return unless defined $release;
    return if $TRY && !-e "${\ shared()}/welcome";
    my $was = '';
    if (open my $in, '<', "${\ shared()}/welcomed") { $was = <$in> // '' }
    return if $was eq $release;
    my @new = grep { length } map { /^new (.+)$/ ? substr($1 =~ s/[\x00-\x1f\x7f]//gr, 0, 200) : () } release_lines();
    splice @new, 6;
    window("welcome begin $release");
    window(@new ? ("welcome line n What is new in release $release", map { "welcome line b $_" } @new) : ());
    window("welcome line g What $APP keeps you from", (map { "welcome line b $_" } @PROTECTS), "welcome line y What $APP cannot keep you from: yours to watch", map { "welcome line b " . s/\$APP/$APP/gr } @CANNOT);
    window('welcome end');
    my @held;
    while (defined(my $line = hear())) {
        if ($line ne 'welcomed') { push @held, $line; next }
        unlink "${\ shared()}/welcomed";
        my $out;
        sysopen($out, "${\ shared()}/welcomed", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) && print({$out} $release) && close($out);
        unshift @HELD, @held;
        return;
    }
    leave();                              # the window is gone
}

# What "Install it" does, with no key to press after it: the press is the yes.
# What it can reach is only this: the installer at the address the
# application's release file names. lzrprf fetches it the way it fetches a
# typed address, with its line in the log first [C5], through the one place
# that connects [C6], by a curl held to https that follows no redirect and is
# contained [C3], and from the public internet only. When the release file
# names a second place for the same installer, it is fetched from there too,
# and it runs only when the two copies are the same byte for byte: somebody
# who changed the installer in one place would have had to change it in the
# other too. A second place that is named and is no address counts as one
# that does not agree. The installer is written into a folder of its own
# under $DIR, as a plain file, its SHA-256 is shown in the window and written
# in the log, and it is started there, with nothing of lzrprf's own
# environment: env -i, the system's PATH, your home folder, and TERM=dumb,
# in auto, so it asks nothing and needs no terminal. Every line it prints is
# given to the window, which shows it in a modal of its own over everything
# (no page draws there), and appended to $DIR/install.txt. A colour the
# installer asks for in a line becomes one letter the window draws in, and
# every escape and control character is taken out, so nothing it prints acts
# on the window. The window cannot close the modal while it runs; at the end
# it says done or failed. After done, lzrprf takes nothing more in this
# window: the application was replaced, and is started again. lzrprf itself
# replaces nothing: whatever is replaced is replaced by that installer.
# The installer runs in a session of its own, so a signal meant for lzrprf's
# group does not reach it, nor one of its own reach lzrprf. From "install
# begin" to the end, a signal that would end lzrprf without a word
# (@INSTALL_STOPS) is said in install.txt, the modal and the log, and lzrprf
# stops there. An installer that runs then goes on, and a process of its own
# reads its lines on into install.txt (sub install_drained); each line
# reaches install.txt as it comes. The window is told when the installer
# starts and when lzrprf stops while it runs, and when lzrprf is gone before
# the install ended it keeps the modal open and says what is true of the
# installer. A file grown past the size the system allows fails its write
# and ends nothing (signal XFSZ).
my %INK = (31 => 'r', 32 => 'g', 33 => 'y', 34 => 'b', 35 => 'm', 36 => 'c', 37 => 'w', 91 => 'r', 92 => 'g', 93 => 'y', 94 => 'b', 95 => 'm', 96 => 'c', 97 => 'w');    # the colours of a terminal, as one letter each
my $INSTALL_LOG;                          # install.txt in the state folder (sub shared) while an installer runs
sub installed {
    my ($there, $installer, $same, $signed) = @_;    # $signed: the manifest release_signed read for $there [C25]
    my %run = (phase => 'fetch', held => '');    # phase: fetch until the installer is started, run while it runs, after once it ended
    local $SIG{XFSZ} = 'IGNORE';          # install.txt grown past the size the system allows: that write fails, and nothing ends lzrprf
    local @SIG{@INSTALL_STOPS} = (sub { POSIX::_exit(1) unless $$ == $FRESH; die "lzrprf told $_[0]\n" }) x @INSTALL_STOPS;    # from "install begin" to the end, the restart included; a copy made by fork that has not yet become its program ends at once, never going on as lzrprf
    my $fault;                            # an error of lzrprf's own while it installs: said as a stop signal is, in install.txt, the modal and the log, and never an end without a word (an empty line of the installer ended lzrprf so, silently, up to release 68)
    my $told = eval { install_run(\%run, $there, $installer, $same, $signed); '' } // ($@ =~ /\Alzrprf told ([A-Z0-9]+)\n\z/ ? $1 : do { POSIX::_exit(1) unless $$ == $FRESH; ($fault = "$@") =~ s/\s+\z//; $fault =~ s/[^\x20-\x7e]/?/g; 'FAULT' });
    return unless length $told;
    my $why = defined $fault ? "met an error of its own ($fault)" : "was told to stop by the signal $told";
    if ($run{phase} eq 'fetch') {         # no installer was started: nothing was changed
        record("lzrprf behind this window $why before the installer of release $there ran: nothing was changed");
        install_end(0, "lzrprf behind this window $why before the installer ran, and stops here. Nothing was changed.") if $INSTALL_LOG;
    } elsif ($run{phase} eq 'run') {      # the installer runs, in its own session: its lines go on into install.txt by a process of its own, and it goes on by itself
        my $held = $run{held};            # what was read and not yet shown, whole lines and a part, which a signal or an error can leave: never glued into one line
        $run{held} = '';
        my $drained = install_drained($run{from}, $run{until}, $held);    # the reader that takes over starts with it
        if (!$drained) { install_guarded($1) while $held =~ s/\A([^\n]*)\n//; install_guarded($held) if length $held }
        close $run{from};
        record("lzrprf behind this window $why while the installer of release $there ran: it stops, and the installer goes on by itself" . ($drained ? ', its lines into install.txt' : ', and no process could be started to read its lines'));
        install_end(0, "lzrprf behind this window $why, and stops here. The installer goes on by itself" . ($drained ? ', and each line it prints goes on into install.txt.' : '. No process could be started to read what it prints, so it may stop at its next line.'));
        print STDOUT "install told $told" . ($drained ? '' : ' undrained') . "\n";    # the window keeps its modal open when lzrprf is gone: undrained, with the words of an installer nothing reads
    } else {                              # the installer had ended, and how was said: only that lzrprf stops
        record("lzrprf behind this window $why after the installer of release $there had ended");
    }
    leave();
}

sub install_run {
    my ($run, $there, $installer, $same, $signed) = @_;
    window('install begin');
    sysopen($INSTALL_LOG, "${\ shared()}/install.txt", O_WRONLY | O_CREAT | O_APPEND | O_NOFOLLOW, 0600) or undef $INSTALL_LOG;
    $INSTALL_LOG->autoflush(1) if $INSTALL_LOG;    # each line reaches install.txt as it comes: a run that ends without its own end still leaves every line it was given
    my @is = $INSTALL_LOG ? stat $INSTALL_LOG : ();
    undef $INSTALL_LOG unless @is && -f _ && $is[3] == 1 && $is[4] == $<;
    return install_end(0, "${\ shared()}/install.txt could not be written, so nothing was fetched.") unless $INSTALL_LOG;
    print {$INSTALL_LOG} line("you chose to install release $there"), "\n";    # the time, the run, what happened: as a line of the log
    return install_end(0, 'The second place the release file names is not an address lzrprf fetches. Nothing was fetched.') if defined $same && !length $same;
    my @from = ($installer, defined $same ? $same : ());
    my @copies;
    for my $try (1 .. $INSTALL_TRIES) {       # the copies are compared each time anew: one that differs is never run, it is only fetched again later
        @copies = ();
        for my $url (@from) {
            install_line("Fetching the installer from $url");
            my ($host) = $url =~ m{^https://([^/:]+)};
            my $got = fixed("you chose to install release $there: lzrprf fetches the installer: $url", $url, $host);
            my $body = defined $got ? body_of($got) : undef;
            return install_end(0, "The installer could not be fetched from $url. Nothing was changed.") unless defined $body && length $body;
            push @copies, $body;
        }
        last if @copies < 2 || $copies[0] eq $copies[1] || $try == $INSTALL_TRIES;
        install_line("The two places hold different installers for now. Nothing runs while they differ: a new release is usually being published, and one place can keep its old copy for up to five minutes. Both are fetched again in $INSTALL_WAIT seconds (try $try of $INSTALL_TRIES).");
        Time::HiRes::sleep($TRY ? 0.05 : $INSTALL_WAIT);    # "lzrprf try" waits a moment only: the tries are what is tested, not the clock
    }
    return install_end(0, "The two places hold different installers. Nothing was changed: $from[0] and $from[1].") if @copies == 2 && $copies[0] ne $copies[1];
    my $wanted = ref $signed eq 'HASH' && $signed->{release} == $there ? $signed->{files}{'install.sh'} // '' : '';    # [C25]
    my $fetched = Digest::SHA->new(256)->add($copies[0])->hexdigest;
    return install_end(0, "The installer is not the one the signed manifest of release $there names: it has SHA-256 $fetched" . (length $wanted ? ", the manifest names $wanted" : ', and no signed manifest was read') . '. Nothing was changed.') unless length $wanted && $fetched eq $wanted;
    my ($folder, $out) = ("${\ shared()}/install.$$");
    mkdir $folder, 0700;
    my @folder = lstat $folder;
    my $file = "$folder/install.sh";
    unlink $file;
    return install_end(0, "The installer could not be written to $file. Nothing was changed.") unless @folder && -d _ && $folder[4] == $< && sysopen($out, $file, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) && print({$out} $copies[0]) && close($out);
    my $sum = Digest::SHA->new(256)->add($copies[0])->hexdigest;
    install_line(@copies == 2 ? 'The installer was fetched from two places, and both hold the same file.' : 'The installer comes from one place.');
    install_line("It is in this file, to read: $file");
    install_line("Its SHA-256: $sum");
    window("install sum $sum");
    record("the installer of release $there has SHA-256 $sum, and runs now in auto: $file") or return install_end(0, $UNWRITTEN);    # [C5]
    return install_end(0, 'lzrprf try: the installer was written and is not run.') if $TRY;
    install_line('It runs now by itself: no question is shown, and each line it prints is shown here.');
    pipe(my $from, my $to) or return install_end(0, 'The installer could not be started. Nothing was changed.');
    my $stops = POSIX::SigSet->new(map { POSIX->can("SIG$_")->() } @INSTALL_STOPS);
    POSIX::sigprocmask(POSIX::SIG_BLOCK(), $stops);    # held from the fork until the phase says it: a signal in between is taken once it does
    my $child = fork;
    if (defined $child && !$child) {
        POSIX::sigprocmask(POSIX::SIG_UNBLOCK(), $stops);    # the installer starts with no signal held
        $SIG{XFSZ} = 'DEFAULT';           # ignored above for install.txt; an ignored signal outlives the start of a program, and the installer's self-test expects this one as the system gives it (SIGPIPE stays ignored: the installer goes on writing when this window stops reading)
        close $from;
        POSIX::setsid();                  # a session of its own: a signal to the group of lzrprf behind this window does not reach the installer, and the installer's own group signals do not reach lzrprf
        chdir $folder or POSIX::_exit(127);
        become(undef, $to, $to, '/usr/bin/env', '-i', 'PATH=/usr/bin:/bin:/usr/sbin:/sbin', "HOME=$HOME", 'TERM=dumb', '/bin/sh', 'install.sh', 'auto');
    }
    @$run{qw(phase from until)} = ('run', $from, now() + $INSTALL_SECONDS) if defined $child;
    print STDOUT "install runs\n" if defined $child;    # the installer was started: from here on the window knows it may go on without lzrprf
    POSIX::sigprocmask(POSIX::SIG_UNBLOCK(), $stops);
    defined $child or return install_end(0, 'The installer could not be started. Nothing was changed.');
    close $to;
    my ($how, $piped, $late);
    {
        local $SIG{PIPE} = sub {          # the window stopped reading: the installer's lines still go on into install.txt, said once
            return if $piped++;
            print {$INSTALL_LOG} "lzrprf behind this window could no longer write to the window (signal PIPE): the installer's lines go on into this file.\n" if $INSTALL_LOG;
            record('the window stopped reading while the installer ran (signal PIPE): its lines go on into install.txt');
        };
        while ((my $left = $run->{until} - now()) > 0) {
            my $ready = '';
            vec($ready, fileno $from, 1) = 1;
            select($ready, undef, undef, $left > 1 ? 1 : $left) > 0 or next;
            my $got = sysread($from, $run->{held}, 65536, length $run->{held});
            next if !defined $got && $!{EINTR};
            last unless $got;
            install_line($1) while $run->{held} =~ s/\A([^\n]*)\n//;
            install_line(substr($run->{held}, 0, $INSTALL_LINE, '')) while length $run->{held} > 4 * $INSTALL_LINE;    # a line with no end yet is given in parts once it is this long
        }
        POSIX::sigprocmask(POSIX::SIG_BLOCK(), $stops);    # the end of the installer is taken whole: a signal now is taken as one after it
        install_line($run->{held}) if length $run->{held};
        $run->{held} = '';
        $late = now() >= $run->{until};
        $how = ended($child, 5);
        close $from;
        $run->{phase} = 'after';
    }
    if ($late) { install_end(0, "The installer was ended after $INSTALL_SECONDS seconds. What it printed is above.") }
    elsif ($how != 0) { install_end(0, 'The installer ended with an error (' . ($how >> 8) . '). What it printed is above.') }
    else { install_end(1, "The installer says it is done. Close $APP, or close it and start the new release at once.") }
    POSIX::sigprocmask(POSIX::SIG_UNBLOCK(), $stops);    # held until the end is in the window and in install.txt: a signal in the end's wait is taken here, after it
    restarted() if !$late && $how == 0;
}

# The installer's lines once lzrprf behind the window stops while it runs: a
# process of its own, in a session of its own and deaf to the signals that
# stop lzrprf, reads them on into install.txt until the installer ends or its
# time is over. So the installer, which takes no signal PIPE, is never left
# writing into a pipe nobody reads, where its next line would fail and end it.
# It holds nothing of the window's and nothing else of lzrprf's: the window
# sees lzrprf gone, and the lock lzrprf holds while it lives is let go.
sub install_drained {
    my ($from, $until, $held) = @_;
    my $stops = POSIX::SigSet->new(map { POSIX->can("SIG$_")->() } @INSTALL_STOPS);
    POSIX::sigprocmask(POSIX::SIG_BLOCK(), $stops);    # held from here: lzrprf behind the window only ends after this, and the reader takes none until it is deaf to them
    my $drainer = fork // return 0;
    return 1 if $drainer;
    $SIG{$_} = 'IGNORE' for @INSTALL_STOPS, 'PIPE', 'XFSZ';
    POSIX::setsid();
    POSIX::sigprocmask(POSIX::SIG_UNBLOCK(), $stops);
    my $nowhere = POSIX::open('/dev/null', O_RDWR) // POSIX::_exit(1);
    POSIX::dup2($nowhere, $_) // POSIX::_exit(1) for 0 .. 2;
    my %kept = map { $_ => 1 } fileno($from), $INSTALL_LOG ? fileno($INSTALL_LOG) : ();
    opendir(my $open, '/dev/fd') or POSIX::_exit(1);
    my @numbers = grep { /^\d+$/ && $_ > 2 && !$kept{$_} } readdir $open;
    closedir $open;
    POSIX::close($_) for @numbers;
    $held //= '';                         # what lzrprf behind the window had read and not yet shown: its whole lines first, each as one
    while (1) {
        install_guarded($1) while $held =~ s/\A([^\n]*)\n//;
        install_guarded(substr($held, 0, $INSTALL_LINE, '')) while length $held > 4 * $INSTALL_LINE;
        my $left = $until - now();
        last if $left <= 0;
        my $ready = '';
        vec($ready, fileno $from, 1) = 1;
        select($ready, undef, undef, $left > 1 ? 1 : $left) > 0 or next;
        my $got = sysread($from, $held, 65536, length $held);
        next if !defined $got && $!{EINTR};
        last unless $got;
    }
    install_guarded($held) if length $held;
    POSIX::_exit(0);
}

sub install_guarded {                     # one line into install.txt once lzrprf behind the window stops while the installer runs: a line that cannot be shown is said as such there, and the reading goes on, so the installer is never left writing into a pipe nobody reads
    my ($line) = @_;
    return if eval { install_line($line); 1 };
    (my $fault = "$@") =~ s/\s+\z//;
    print {$INSTALL_LOG} 'lzrprf could not show one line of the installer (' . ($fault =~ s/[^\x20-\x7e]/?/gr) . "): it is left out, and the lines after it go on.\n" if $INSTALL_LOG;
    return;
}

# After an install that is done lzrprf takes nothing more in this window, which
# offers two buttons: Close, and Close and restart. "restart" starts the
# application again once this run has ended: a process of its own, outside
# this run's session, waits until lzrprf and the launcher that started it are
# gone (at most 20 seconds), then asks macOS to open the application at the
# place it ran from, which the installer has replaced by then. Nothing else
# is started, and "lzrprf try" starts nothing.
sub restarted {
    busy('The install is done.');
    while (defined(my $line = hear())) {
        next unless $line eq 'restart';
        my ($app) = $PROGRAM =~ m{^(.*\.app)/Contents/MacOS/};
        last unless $app && !$TRY;
        record("you chose to start $APP again after the install: $app") or last;    # [C5]
        my @waits = ($$, getppid());
        my $first = fork;
        if (defined $first && !$first) {
            POSIX::setsid();
            my $second = fork;
            POSIX::_exit(0) if !defined $second || $second;
            # The waiter lets go of the window's pipes, and of every other descriptor, before it waits: while it held
            # lzrprf's output the window never saw it end, so the window stayed open until these 20 seconds were over.
            my $nowhere = POSIX::open('/dev/null', O_RDWR) // POSIX::_exit(127);
            POSIX::dup2($nowhere, $_) // POSIX::_exit(127) for 0 .. 2;
            seal();
            for (1 .. 80) { last unless grep { kill 0, $_ } @waits; Time::HiRes::sleep(0.25) }
            # The first profile comes back as the icon starts it: macOS opens the application, whose launcher starts the new lzrprf.
            # Another profile cannot go that road, since the launcher passes nothing on, so this process starts it as the Profiles
            # icon does (sub profile_command): perl, the file $SELF and the program $PROGRAM, with the profile's id alone. The
            # installer has replaced both in place by now, and a fresh perl reads $SELF from the disk, so the new release runs,
            # and it goes through every start check itself, the self-test's mark of the new release among them.
            become(undef, undef, undef, defined $PROFILE ? profile_command($PROFILE) : ('/usr/bin/open', '-n', $app));
        }
        waitpid($first, 0) if $first;
        last;
    }
    leave();
}

sub install_line {                        # one line the installer printed: in the window's modal, with its colour as one letter, and in install.txt
    my ($text) = @_;
    my ($ink) = map { $INK{$_} // () } map { split /;/ } $text =~ /\e\[([0-9;]*)m/g;
    $text =~ s/\e\][^\a\e]*(?:\a|\e\\)?//g;    # a title or a link a terminal would take: nothing of it is shown
    $text =~ s/\e\[[0-9;?]*[ -\/]*[\@-~]//g;
    $text =~ s/\e.?//gs;
    $text =~ s/\A.*\r(?=.)//s;            # a line written over itself: what stands last
    no warnings 'utf8';
    utf8::decode($text) or $text =~ s/[^\x00-\x7f]/?/g;
    $text =~ s/[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\p{NChar}]|[^\x{0}-\x{10ffff}]//g;
    for my $piece ($text =~ /(.{1,$INSTALL_LINE})/gs, length $text ? () : '') {
        my $part = $piece;                # a copy: an empty line is the constant '' here, which encoding it in place would change, and perl ends lzrprf for that ("Modification of a read-only value attempted": every install of releases 36 to 68 from the window ended so at the installer's first line, which is empty)
        utf8::encode($part);
        print STDOUT 'install line ' . ($ink // '-') . " $part\n";    # not "window": when the window is gone the installer is not left without its reader
        print {$INSTALL_LOG} "$part\n" if $INSTALL_LOG;
    }
}

sub install_end {                         # how the install ended, said in the modal, in install.txt and in the log; returns nothing
    my ($done, $words) = @_;
    eval { install_line($words); 1 } or do {    # the end is said even when a line cannot be cleaned: in plain characters
        my $plain = $words =~ s/[^\x20-\x7e]/?/gr;
        print STDOUT "install line - $plain\n";
        print {$INSTALL_LOG} "$plain\n" if $INSTALL_LOG;
    };
    print STDOUT 'install end ' . ($done ? 'done' : 'failed') . " $words\n";
    if ($INSTALL_LOG) { $INSTALL_LOG->flush; $^O eq 'darwin' ? fcntl($INSTALL_LOG, 51, 0) : $INSTALL_LOG->sync; close $INSTALL_LOG; undef $INSTALL_LOG }
    record('the install ' . ($done ? 'is done' : "failed: $words"));
    return;
}

sub body_of {                             # the body of an answer 200, as curl gave it raw: whole, or in chunks that are all there; nothing for anything else
    my ($got) = @_;
    my ($head, $body) = $got =~ m{\AHTTP/1\.1 200 [^\r\n]*\r\n(.*?)\r\n\r\n(.*)\z}s or return;
    return $body unless $head =~ /^transfer-encoding:[ \t]*chunked[ \t]*\r?$/mi;
    my $whole = '';
    pos($body) = 0;                       # read where the last chunk ended, never a copy of the rest: a site's thousands of one-byte chunks cost no more than one chunk of their size
    while ($body =~ /\G([0-9a-fA-F]{1,8})[^\r\n]*\r\n/gc) {
        my ($n, $at) = (hex $1, pos $body);
        return $whole unless $n;
        return unless length($body) >= $at + $n + 2 && substr($body, $at + $n, 2) eq "\r\n";
        $whole .= substr($body, $at, $n);
        pos($body) = $at + $n + 2;
    }
    return;
}

# The window's side. The window is lzrprf's: the text at the end of this file,
# run by the system's own osascript in the window container. It is told what
# to show in lines, and says what you did in lines. Ten kinds of line can come
# from it, each in a shape lzrprf checks, and nothing the application wrote is
# among them: that it is ready, what you typed into the bar when you pressed
# Return, which of two buttons you pressed, that you asked for the log, that
# it could not draw a list, the size of its page, a tab opened, chosen or
# closed or moved ("tab new", "tab select N", "tab close N", "tab move FROM TO"), and an item of the
# cogwheel's menu ("menu clear-history", "menu clear-sessions", "menu home", "menu bookmarks-bar"), a bookmark opened, saved or removed ("mark open N", "mark save ...", "mark remove N", sub mark_saved), its size and place once you have moved or resized it ("frame X Y W H" or "frame full", sub frame_said), and buttons up to three for a question in a modal ("redirect"). Four more come only while the page shown is kept running ("live on"): a click in it ("page click X Y", in the laid page's points after scrolling), a key ("page key NAME" or "page key NAME shift", a printable character or one of the named keys), text typed while a field of it has the focus ("page text ...", at most $LIVE_TEXT bytes) and where it shows the page from ("page scroll T X Y", T the tab shown, whole CSS pixels of the laid page, at most once a frame); lzrprf hands each to that page and to nothing else (sub live_input), and tells the window "live on|off 0|1" and "live end WHY" (sub live_told), and "scroll T X Y" where the page's script scrolled it, just before its drawing (sub live_scroll_told). In a terminal's tab five more: "page drag X Y", "page wheel N", "page copy", and your paste as "page paste TEXT" or "page pastelong" (sub trmnl_viewed) [C29]. The words lzrprf says are in a
# strip of their own between the bar and the page, where no page can write:
# the one thing of the application's that lzrprf says there is up to four of
# the other hosts its page names, each in the shape of a host name, and how
# many there are (the last line of "sub visit").
sub window {                              # all the lines in one write: a list of thousands of lines printed one by one (autoflush) woke the window once a line, and a page took 100 ms to arrive (measured 2026-11-23)
    print join('', map { "$_\n" } @_) or leave() if @_;    # without a window ("lzrprf try" only) this is printed for the test to read
    sound_hushed() if $SOUND && @_ && $_[0] =~ /^(?:tabs |page(?: [0-9]+)?\z|live (?!on ))/;    # [C12] another tab, a new page shown, or no page kept running: every sound stops and goes
    timed('sent ' . ($_[0] =~ /^(\S+)/ ? $1 : '')) if $TIMED && @_;    # "lzrprf try" with "times": the moment the window was handed each write, by its first word
}

# The strip as it is now, to put back. The window takes a press only after lzrprf said "idle": a line
# "busy", and a question once it is answered, leave it closed to every press. So whatever speaks in the
# strip beside a page (the look for a newer release) ends by putting the strip back, on every way out.
sub strip_back {                          # what the strip said, said again: with a sentence of the page's own given, that sentence in the strip and after the words in full (a video that is locked, sub videoed)
    my ($was, $short) = @{ $TABS[$TAB] }{qw(says brief)};
    return sub { defined $_[0] ? idle(index($was // '', $_[0]) >= 0 ? $was : join(' ', grep { length } $was // '', $_[0]), $_[0]) : idle($was // '', $short); return };    # a sentence the words already end with, a locked video clicked again, is not said twice
}
sub busy { window('busy ' . $_[0] =~ s/\s+/ /gr) }
sub idle {                                # what lzrprf says, in full; with $short the strip shows that instead ("brief"), and the full words stand where they belong: with what the page is made of, or on the log page
    my ($says, $short) = map { defined ? s/\s+/ /gr : undef } @_[0, 1];
    @{ $TABS[$TAB] }{qw(says brief)} = ($says, $short);
    window("brief $short") if length($short // '');
    window("idle $says");
    return;
}
sub aside {                               # said in full, with the strip left as it was: an answer that belongs elsewhere than the strip
    my ($says, $shut) = @_;
    my ($was, $short) = @{ $TABS[$TAB] }{qw(says brief)};
    window('log shut') if $shut;
    idle($says, length($short // '') ? $short : $was // '');
    @{ $TABS[$TAB] }{qw(says brief)} = ($was, $short);
    return;
}
sub noted { push @SESSION, line(unlisted($_[0])); return }    # [C23] a line of this window's log alone, in its memory, that names no listed address
sub said_noted { my $says = $TABS[$TAB]{says}; noted($says) if length($says // ''); return }    # what the strip just said of something you did that fetched nothing: a bookmark, a setting, a window    # a line of this window's log alone, in its memory: what happened here and fetched nothing

# The =statement line of a page, which comes right after its =pictures and
# =sheets lines (or its first line): the application's own words, in one sentence, for why it
# shows the page in compatibility-statement mode. At most one such line, of
# 1 to $STATEMENT bytes that are each a plain printable character (0x20 to
# 0x7e), so nothing in it acts on the window; a second one is a line of no kind
# and makes the page unfit, as does one too long or with any other byte. The
# words are shown as they are, as plain text, at the end of the bottom bar
# (sub visit); they are never read for anything. Takes the checked page's
# lines and takes the line off them. Returns its words, '' when there is none,
# or nothing for a line that is not one.
sub stated {
    my ($lines) = @_;
    my $STATEMENT = 200;                  # the most bytes of the words: one sentence the bottom bar holds beside its own
    return '' unless @$lines && $lines->[0] =~ /^=statement/;
    my ($words) = shift(@$lines) =~ /^=statement ([\x20-\x7e]{1,$STATEMENT})\z/ or return;
    return $words;
}

sub hear {                                # the next thing the window says; nothing (undef) when the window is gone, an empty line when it said nothing in time
    my ($seconds, $main) = @_;            # $main: the loop of sub behind, the one place that takes "live", the word that a page kept running answered or is to end (sub live_turn); elsewhere what such a page writes is read and held, and taken there later
    push @HELD, splice @LATER if $main && @LATER;
    return shift @HELD if @HELD;
    my $until = defined $seconds ? now() + $seconds : undef;
    while (1) {
        return 'live' if $main && grep { live_due($_) || (live_scroll_left($_) // 1) <= 0 } @LIVE;    # or a place of its own scroll waited for the frame to be over (sub live_scroll_told)
        if ($main && !$FROM && @EVENTS && $EVENTS[0] eq 'idle') { shift @EVENTS; my $work = $IDLE_WORK; undef $IDLE_WORK; $work->(), timed('idle-work') if $work; next }    # "lzrprf try": the test's line "=idle" stands for a window that waits for you, as a real one does before you type (scripts/snappy.pl)
        return substr(shift @EVENTS, 1) if !$FROM && @EVENTS && substr($EVENTS[0], 0, 1) eq '~';    # "lzrprf try": a test's line marked "~" is said at once, while a page kept running has not answered yet, as a window says it whenever it likes
        return shift @EVENTS unless $FROM || $main && (grep { $_->{waiting} } @LIVE) || $main && !@EVENTS && grep { now() < $_->{heard} + $TRY_QUIET } @LIVE;    # "lzrprf try": the test's next line, once every page kept running answered the one before; after the last, the end once every such page was quiet for $TRY_QUIET
        if ($FROM && (my $end = index($FROM_HELD, "\n")) >= 0) {
            my $line = substr($FROM_HELD, 0, $end + 1, '');
            chomp $line;
            print STDERR "$line\n" if $TRY && $line =~ /^(?:test|fault) /;    # "lzrprf try" only: what a test's own text in the window reports
            if ($line =~ /^undrawn ([a-z]{1,20}) ([\x20-\x7e]{0,200})$/) { record("the window could not finish drawing its $1 view this once, and goes on: $2"); next }    # said by function viewDrawn in the window, the first fault of each view once: kept in the log wherever lzrprf listens, in the loop of sub behind, in a question or after an install
            return $line;
        }
        my ($ready, $writable, $wait) = ('', '', defined $until ? $until - now() : undef);
        for my $live (@LIVE) { vec($writable, fileno $live->{relay}, 1) = 1 if length($live->{input_held} // '') }
        return '' if defined $wait && $wait <= 0;    # the time is over, and the window is still there
        vec($ready, fileno $FROM, 1) = 1 if $FROM;
        if ($SOUND) { vec($ready, fileno $SOUND->{from}, 1) = 1; vec($writable, fileno $SOUND->{to}, 1) = 1 if length $SOUND->{out} }    # [C12] the sound process: what it says, and what waits for it
        for my $live (grep { !live_due($_) } @LIVE) {    # a page kept running is heard while the window is waited for, up to its own end of time
            vec($ready, fileno $live->{from}, 1) = 1;
            my ($left, $quiet) = ($live->{until} - now(), $live->{heard} + $TRY_QUIET - now());
            $left = $quiet if !$FROM && $quiet > 0 && $quiet < $left;    # "lzrprf try": up to the end of its quiet, when the test is looked at again
            $wait = $left < 0 ? 0 : $left if !defined $wait || $left < $wait;
            my $frame = $main ? live_scroll_left($live) : undef;    # up to the end of the frame a place of its own scroll waits for
            $wait = $frame if defined $frame && $frame < $wait;
        }
        trmnl_select(\$ready, \$writable);    # [C29] each terminal's shell and container, heard as the window is
        if ($main && $FROM && $IDLE_WORK && !length($FROM_HELD) && $writable !~ /[^\0]/ && !grep({ $_->{starting} } @LIVE) && select(my $now = $ready, undef, undef, 0) == 0) { my $work = $IDLE_WORK; undef $IDLE_WORK; $work->(); timed('idle-work'); next }    # once: nothing said, nothing to write and no page being made, so nothing waits for it
        select($ready, $writable, undef, $wait) > 0 or next;
        trmnl_heard($ready, $writable);
        live_flushed($_) for grep { length($_->{input_held} // '') && vec($writable, fileno $_->{relay}, 1) } @LIVE;
        live_read($_) for grep { !live_due($_) && vec($ready, fileno $_->{from}, 1) } @LIVE;
        sound_flushed() if $SOUND && length $SOUND->{out} && vec($writable, fileno $SOUND->{to}, 1);
        sound_heard() if $SOUND && vec($ready, fileno $SOUND->{from}, 1);
        next unless $FROM && vec($ready, fileno $FROM, 1);
        my $got = sysread($FROM, $FROM_HELD, 65536, length $FROM_HELD);
        return if defined $got ? !$got : !$!{EINTR};    # the window is gone
    }
}

# Pages kept running with their tabs (sub contained). Each is bound to the tab
# it was shown in; at most $LIVE_MOST run at once, and the oldest is ended
# when one more is kept. A page is ended, with "=end" and then for certain,
# when its tab goes elsewhere or is closed, when the sessions are cleared,
# when it was laid out anew, when it wrote anything out of its form, more than
# $LIVE_BYTES in all or more than $PAGE_BYTES in one answer, after
# $LIVE_SECONDS, and when the window closes. Its last good drawing stays.
sub live_of { my ($tab) = @_; my ($live) = grep { $_->{tab} && $_->{tab} == $tab } @LIVE; return $live }

sub live_kept {
    my ($live, $tab, $lines, $paths, $host, $decoded, $shown, $videos) = @_;
    $live->{raw} = [grep { !/^U/ } @$lines];    # the checked page before picture substitution, for later splices
    $live->{plain} = $shown == $lines;    # no picture in it: what is shown is what was checked (sub live_patched)
    my @made;                             # what the page is made of, the U lines of its first list: an answer is checked with them, as the first list was
    for (@$lines) { last unless /^U/; push @made, $_ }
    @$live{qw(tab made paths host pictures shown videos)} = ($tab, \@made, [@$paths], $host, $decoded // {}, $shown, [@{ $videos // [] }]);
    $live->{laid} = ($lines->[scalar @made] // '') =~ /^(L[0-9]+x[0-9]+)$/ ? $1 : '';    # [C18] the size it was laid at, when it was laid: a drawing of another height has its end somewhere else (sub live_answered)
    push @LIVE, $live;
    live_end($LIVE[0], 'more pages were kept running than lzrprf keeps') while @LIVE > $LIVE_MOST;
}

sub live_dropped {                        # a run that kept its page and is not shown: ended at once; the words, when there are any, are said
    my ($live, $words) = @_;
    live_end($live, 'it is not shown', 1) if $live;
    return defined $words ? idle($words) : undef;
}

sub live_told {                           # the window is told whether the page shown is kept running, and whether a text field of it has the focus: "live on|off 1|0"
    my $live = live_of($TABS[$TAB]);
    my @now = $TABS[$TAB]{trmnl} ? ('on', 1, 'trmnl') : $live ? ('on', $live->{focus} ? 1 : 0) : ('off', 0);    # [C29] a terminal's tab takes every key, and keys held with Control
    return if "@now" eq "@LIVE_TOLD";
    @LIVE_TOLD = @now;
    window("live @now");
}

sub live_end {                            # "=end" for the page, then its keeper and the page are ended, the keeper first (sub contained); $now: at once, and nothing said to the window
    my ($live, $why, $now) = @_;
    @LIVE = grep { $_ != $live } @LIVE;
    delete @$live{qw(unknown unknown_more)};    # what it counted of lines lzrprf does not know goes with it
    return if $live->{ended}++;
    my $gone = 0;
    syswrite($live->{relay}, "=end\n");    # never waited for: a page that reads nothing is ended below all the same
    close $live->{relay};
    my $until = now() + ($now ? 0 : $LIVE_END_SECONDS);
    while (!$gone && (my $left = $until - now()) > 0) {    # the page is given a moment to end by itself: its end is the end of what it writes. The window is never kept waiting for it: once the window says anything, the page is ended at once
        last if $FROM && index($FROM_HELD, "\n") >= 0;
        my $ready = '';
        vec($ready, fileno $live->{from}, 1) = 1;
        vec($ready, fileno $FROM, 1) = 1 if $FROM;
        select($ready, undef, undef, $left) > 0 or next;
        last if $FROM && vec($ready, fileno $FROM, 1) && !vec($ready, fileno $live->{from}, 1);
        next unless vec($ready, fileno $live->{from}, 1);
        my $more = sysread($live->{from}, my $rest, 65536);
        $gone = 1 if defined $more ? !$more : !$!{EINTR};
    }
    kill 'KILL', $live->{keeper};         # the keeper first: it acts on the page's number, and is gone before the system may give that number to another process
    waitpid $live->{keeper}, 0;
    kill 'KILL', $live->{page};
    waitpid $live->{page}, 0;
    close $_ for @$live{qw(from hold)};
    return if $now;
    window("live end $why; " . ($gone ? 'it ended by itself' : 'lzrprf ended it'));
    live_told();
}

sub live_read {                           # what a page kept running wrote, held until it is a whole answer; its end is noted
    my ($live) = @_;
    my $got = sysread($live->{from}, $live->{held}, 65536, length $live->{held});
    return if !defined $got && $!{EINTR};
    $live->{gone} = 1 unless $got;
    my $at = now();
    $live->{bytes} -= ($at - ($live->{bytes_at} // $at)) * $PAGE_BYTES;    # bounded drawing rate, not a character-count deadline
    $live->{bytes} = 0 if $live->{bytes} < 0;
    $live->{bytes_at} = $at;
    $live->{bytes} += $got // 0;
    $live->{heard} = now();
}

sub live_due {                            # a page kept running has a whole answer held (up to a line "=ready"), ended, wrote too much, or its time is over
    my ($live) = @_;
    return 1 if defined $live->{whole} || $live->{gone} || $live->{bytes} > $LIVE_BYTES || length $live->{held} > $PAGE_BYTES || now() >= $live->{until};
    if (defined(my $asked = live_asked($live))) { return $asked ? 1 : 0 }    # [C19] a request, due once it is all there
    if (substr($live->{held}, 0, 7) eq "=ready\n") { $live->{whole} = -1; return 1 }
    my $at = index($live->{held}, "\n=ready\n", $live->{looked} > 7 ? $live->{looked} - 7 : 0);
    $live->{looked} = length $live->{held};
    return 0 if $at < 0;
    $live->{whole} = $at;
    return 1;
}

sub live_turn {
    my @due = grep { live_due($_) } @LIVE;
    $_->{starting} ? home_arrived($_) : live_answered($_) for @due;
    live_scroll_told($_) for grep { (live_scroll_left($_) // 1) <= 0 } @LIVE;    # [C18] a place of the page's own scroll that waited for the frame to be over
}

# A request of a page kept running ([C19]). While it is kept, and while it is
# read before its first list (sub contained), the page may write, in place of
# an answer, one request at a time, and waits for its reply before it writes
# anything else (src/page/scripted.rs):
#
#   =fetch METHOD BODYLEN TYPE [DEST] URL   then exactly BODYLEN bytes of its body
#       METHOD   GET, HEAD or POST
#       BODYLEN  0 to $LIVE_FETCH_UP, and 0 for GET and HEAD
#       TYPE     "-", or for a POST one of text/plain,
#                application/x-www-form-urlencoded and application/json
#       DEST     what the answer is for: data, script, module, worker or
#                frame; a line without it is data, as before [C26]
#       URL      printable, at most 8192 bytes
#
# A script, module or worker of a site whose scripts are not allowed is not
# fetched at all, and one whose bytes a rule of yours denies is fetched,
# hashed and not handed over: both are told "=fetched 403 0 0" [C26]. A
# frame of such a site comes with its scripts taken out. A POST to another
# host than the page's asks you first, in lzrprf's strip, and while the page
# is read, before it is shown, it is refused: no script permission covers it
# [C5]. While the page runs in lzrprf's sandbox (E1: its site has no rule of
# yours, sub permit_site), a POST to any origin and every request to another
# origin that is not a script or module are refused with no question, told
# "=fetched 403 0 0", and never fetched or sent (@PERMIT_SANDBOX) [C26].
#
# The page may ask, the same way, whether a script may run [C26]:
#
#   =permit KIND ORIGIN SHA256 CAPS   answered "=permitted always", "once" or
#                                     "deny" at once (sub live_permitted)
#
# The address is checked as one typed into the bar is (sub address: https, a
# host by its name, port 443), the count of the page's requests against
# $LIVE_FETCH_MOST, then it is written down first [C5] and looked up or asked
# of Tor as a typed one [C17]; a host that is not on the public internet is
# refused, as for the fixed addresses, since no question is asked for a page.
# It is fetched by sub fetch, the one place that connects [C6], with the fixed
# request [C7] and only what $ask adds there. Whatever comes of it, the page
# is written exactly one reply, on its input, through the keeper:
#
#   =fetched STATUS HEADLEN BODYLEN  then HEADLEN bytes of "name: value" lines,
#                                    each ending in a line end, then BODYLEN
#                                    bytes of the body
#
# STATUS is the answer's, 200 to 599; the lines are only those of
# content-type and of the five access-control-allow-origin,
# -allow-credentials, -allow-methods, -allow-headers and -expose-headers,
# names in small letters, printable values, at most $LIVE_HEAD_BYTES in all;
# the body is the answer's, its chunks joined, at most $PAGE_BYTES; a HEAD has
# none. A request refused, failed, or answered in another form is told
# "=fetched 0 0 0". A request line of no form ends the page.
sub live_asked {                          # [C19] the request at the front of what the page wrote: nothing when there is none, 0 while it is not all there, else [its line, its body, the bytes it takes], or [its line] when it is of no form
    my ($live) = @_;
    my $permit = substr($live->{held}, 0, 8) eq '=permit ';    # [C26] a question whether a script may run: one line, no body
    return unless $permit || substr($live->{held}, 0, 7) eq '=fetch ';
    my $end = index $live->{held}, "\n";
    if ($end < 0 || $end > $LIVE_FETCH_LINE) { return $end < 0 && length $live->{held} <= $LIVE_FETCH_LINE ? 0 : [''] }
    my $line = substr($live->{held}, 0, $end);
    return [$line, '', $end + 1] if $permit;
    my ($size) = $line =~ /^=fetch [A-Z]{1,8} (0|[1-9][0-9]{0,5}) / or return [$line];
    return [$line] if $size > $LIVE_FETCH_UP;
    return 0 if length($live->{held}) < $end + 1 + $size;
    return [$line, substr($live->{held}, $end + 1, $size), $end + 1 + $size];
}

my %LIVE_PASSED = map { $_ => 1 } qw(content-type access-control-allow-origin access-control-allow-credentials access-control-allow-methods access-control-allow-headers access-control-expose-headers);    # [C19] the headers a page is handed of an answer: its type, and what the CORS check of its engine reads

sub live_fetched {                        # [C19]
    my ($live, $asked) = @_;
    my ($line, $body, $took) = @$asked;
    return live_end($live, 'it wrote a line of no form') unless defined $took;
    substr($live->{held}, 0, $took, '');
    $live->{looked} = 0;
    return live_permitted($live, $line) if substr($line, 0, 8) eq '=permit ';
    return live_replied($live, 0, '', '') if $live->{home};    # the local home has no network door, including absolute script requests    # [C26]
    my ($method, $size, $type, $dest, $as, $to) = $line =~ m{^=fetch (GET|HEAD|POST) (0|[1-9][0-9]{0,5}) (-|text/plain|application/x-www-form-urlencoded|application/json) (?:(data|script|module|worker|frame) )?(?:as ([a-z]{1,16}) )?([\x21-\x7e]{1,8192})$} or return live_end($live, 'it wrote a line of no form');
    return live_end($live, 'it wrote a line of no form') if $method ne 'POST' && ($size || $type ne '-');
    $dest //= 'data';                     # [C26] a line of an application from before the destination word
    return live_end($live, 'it wrote a line of no form') if defined $as && !identity_word($as);    # [C7] D19: an identity lzrprf holds no header set for is no request at all
    my ($url, $host) = address($to);
    my $filter = $url && !listed($to) ? filter_said($url, $FILTER_DEST{$dest}, $live->{host}) : undef;    # [C27] after [C23] and before the sandbox and every script permission: what a list blocks is never fetched, and decides nothing of [C26]
    my $site = "https://$live->{host}";
    my $code = $dest =~ /^(?:script|module|worker)$/;    # [C26] bytes that would run: hashed, and refused when the policy denies them
    my ($rules) = permit_rules();
    my $allowed = permit_site($site, $rules, $live->{url});    # [C26] "person", "sandbox" or nothing
    my $boxed = !$url || defined $filter || $allowed ne 'sandbox' ? '' : $method eq 'POST' ? 'post' : $host ne $live->{host} && $dest !~ /^(?:script|module)$/ ? 'fetch-other' : '';    # [C26] E1: what of the sandbox's table this request is, when the table refuses it
    $boxed = '' if $boxed && sandbox_says($boxed) ne 'refused';
    my $away = $url && !$boxed && !defined $filter && $method eq 'POST' && $host ne $live->{host};    # [C5] a POST to another host than the page's: never covered by a script permission
    my $sent = $away && $live->{until} ? ask("The page $live->{host} wants to send something to $host, another host. No script permission covers that. Send it this once?", "Don't send", 'Send') : 0;    # asked before the log is held, so a question left open keeps nothing waiting; a page that is still read, before it is shown, is not asked for
    my ($status, $head, $answer, $why) = (0, '', '');
    my ($kept) = keeping();               # read once, as in visit
    open my $request, '>>', "$DIR/busy" or return live_replied($live, 0, '', '');
    flock $request, LOCK_SH or return live_replied($live, 0, '', '');    # as in visit: no line of this request falls into a clearing of the log
    if (listed($to)) { refused("the page $live->{host} asked for an address", $kept); return live_replied($live, 0, '', '') }    # [C23] refused as an address lzrprf does not fetch is, with no address written
    if (!$url) {
        record("the page $live->{url} asked for an address lzrprf does not fetch; refused", $kept);
        return live_replied($live, 0, '', '');
    }
    if (defined $filter) { record("the page $live->{url} asked for $url; not fetched: $filter", $kept); return live_replied($live, 0, '', '') }    # [C27] nothing is looked up or fetched
    my $asked_for = "the page $live->{url} asked for $url ($method" . ($host eq $live->{host} ? '' : ", from $live->{host}") . ($dest eq 'data' ? '' : ", $dest") . ')';
    if ($boxed) {                         # [C26] E1: refused with no question, and never fetched or sent
        record("$asked_for; refused: the page runs in lzrprf's sandbox, which " . ($boxed eq 'post' ? 'sends no POST' : 'fetches nothing else of another origin'), $kept);
        permit_seen('e1', $site, ($boxed eq 'post' ? 'a POST to ' : 'a request to ') . "https://$host", 'refused');
        $PERMIT_ASK->{boxed}++ if $PERMIT_ASK && $PERMIT_ASK->{site} eq $site;
        return live_replied($live, 403, '', '');
    }
    if ($away && $sent != 2) {            # [C5]
        record("$asked_for; refused: " . ($live->{until} ? 'you did not let it send to another host' : 'a page that is still read is not let send to another host'), $kept);
        return live_replied($live, 0, '', '');
    }
    record("you let the page $live->{url} send to $host, this once", $kept) or return live_replied($live, 0, '', '') if $away;
    if ($code && !$allowed) {             # [C26] not fetched at all: the site's scripts do not run
        record("$asked_for; refused: the scripts of $live->{host} are not allowed", $kept);
        $PERMIT_ASK->{refused}++ if $PERMIT_ASK && $PERMIT_ASK->{site} eq $site && !($PERMIT_DENIED{$site} && $PERMIT_DENIED{$site}{''});
        return live_replied($live, 403, '', '');
    }
    record($asked_for, $kept) or return live_replied($live, 0, '', '');    # [C5] before the name is even looked up
    $why = "the page asked for more than $LIVE_FETCH_MOST addresses" if ++$live->{fetches} > $LIVE_FETCH_MOST;
    if (!$why) { my $shield = shield_said($url); $why = shield_why($shield) if $shield ne 'allow' }    # [C28] before any DNS lookup, including requests while a page is still being read
    my $where;
    ($where, $why) = $TOR_WANTED ? tor_where($host) : find($host) unless $why;    # [C17] with Tor on, nothing is looked up on this computer
    $why = 'that host is not on the public internet' if !$why && $where && $PEER eq '-' && grep { $_->{own} } @$where;    # [C8] no question is asked for a page's request: it is refused
    my ($got, $from);
    if (!$why) {
        record("$url -> lzrprf connects " . ($TOR_WANTED ? "through Tor, one circuit for $host" : 'to the first that answers of: ' . join(', ', map { $_->{text} } @$where)), $kept) or return live_replied($live, 0, '', '');    # [C5] written down first, connected second
        ($got, $why, $from) = fetch($url, $where, { method => $method, type => $type, body => $body, origin => $host eq $live->{host} ? undef : "https://$live->{host}", cookie => scalar(sso_cookie($url, $live->{host})), as => $as, dest => $dest, from => $live->{host} });    # [C6] [C7] cookies only of a provider you connected, and only from a page of that provider's own family (sub sso_cookie)
    }
    sso_heard($url, $got, $live->{host}) unless $why;    # [C7] as in visit, for a page of the provider's own family alone
    if (!$why) {
        my $parts = live_parts($got, $method);
        if ($parts) { ($status, $head, $answer) = @$parts } else { $why = 'the answer is in no form lzrprf hands a page' }
    }
    my $sha = !$why && $code ? Digest::SHA::sha256_hex($answer) : '';
    if (length $sha && permit_refused($site, $dest eq 'script' ? 'external' : $dest, "https://$host", $sha, $rules)) {    # [C26] the bytes themselves, whoever serves them
        record("$url answered $status: " . length($answer) . " bytes, not handed to the page: a rule of yours denies these bytes", $kept);
        return live_replied($live, 403, '', '');
    }
    if (length $sha) {                    # [C26] where these bytes came from, for a curated rule by path pattern (E2)
        %PERMIT_PATHS = () if keys %PERMIT_PATHS >= $PERMIT_RULES;
        $PERMIT_PATHS{"$site https://$host $sha"} = $url =~ m{\Ahttps://[^/?#]+(/[^?#]*)} ? $1 : '/';
        permit_info($site, "https://$host", $sha, $host . $PERMIT_PATHS{"$site https://$host $sha"}, 'external', $answer);    # [C26] its name and source, for the question about it
    }
    ($answer) = permit_body($answer) if !$why && $dest eq 'frame' && !$allowed;    # [C26] a frame of a site whose scripts are not allowed, with them taken out
    record("$url " . ($why ? "failed: $why" : "answered $status: " . length($answer) . " bytes to the page from $from"), $kept) or return live_replied($live, 0, '', '');    # an answer whose line could not be recorded is not handed over
    close $request;
    return live_replied($live, $why ? (0, '', '') : ($status, $head, $answer));
}

sub live_parts {                          # [C19] an answer as curl gave it raw: [status, the header lines the page is handed, the body]; nothing when it is in no such form
    my ($got, $method) = @_;
    1 while $got =~ s{\AHTTP/1\.[01] 1[0-9][0-9][^\r\n]*\r\n(?:[^\r\n]+\r\n)*\r\n}{};    # an interim answer goes before the answer
    my ($status, $head, $body) = $got =~ m{\AHTTP/1\.[01] ([2-5][0-9][0-9])[^\r\n]*\r\n((?:[^\r\n]+\r\n)*)\r\n(.*)\z}s or return;
    $body = '' if $method eq 'HEAD';
    $body = unchunked($body) // return if $head =~ /^transfer-encoding:[ \t]*chunked[ \t]*\r?$/mi && length $body;
    return if length $body > $PAGE_BYTES;
    my $lines = '';
    for (split /\r\n/, $head) {
        my ($name, $value) = /^([!#\$%&'*+.^_\x60|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/ or next;    # a token (RFC 9110 5.6.2), its grave accent written as \x60
        $name = lc $name;
        next unless $LIVE_PASSED{$name} && $value =~ /^[\x20-\x7e]*$/;
        my $one = "$name: $value\n";
        last if length($lines) + length($one) > $LIVE_HEAD_BYTES;
        $lines .= $one;
    }
    return [$status, $lines, $body];
}

sub unchunked {                           # a body sent in chunks, its chunks joined; nothing when it is in no such form
    my ($body) = @_;
    my ($whole, $at) = ('', 0);
    while (1) {
        substr($body, $at) =~ /\A([0-9a-fA-F]{1,8})[^\r\n]*\r\n/ or return;
        my $n = hex $1;
        $at += length $&;
        last unless $n;
        return unless length($body) >= $at + $n + 2 && substr($body, $at + $n, 2) eq "\r\n";
        $whole .= substr($body, $at, $n);
        $at += $n + 2;
    }
    return $whole;
}

sub live_replied {                        # [C19] the one reply to a request, through the keeper as it takes it, within $FETCH_SECONDS; a page that does not take it is ended
    my ($live, $status, $head, $body) = @_;
    return live_sent($live, "=fetched $status " . length($head) . ' ' . length($body) . "\n$head$body");
}

sub live_sent {                           # [C19] a reply written to a page kept running, through the keeper as it takes it, within $FETCH_SECONDS; a page that does not take it is ended
    my ($live, $reply) = @_;
    $reply = (delete($live->{input_held}) // '') . $reply;    # an input tail always precedes a reply; never splice a reply into a partial input line
    my $until = now() + $FETCH_SECONDS;
    while (length $reply) {
        my $took = syswrite($live->{relay}, $reply);
        if ($took) { substr($reply, 0, $took, ''); next }
        return live_end($live, 'it does not read what it is given') unless !defined $took && ($!{EAGAIN} || $!{EINTR});
        my ($ready, $left) = ('', $until - now());
        return live_end($live, 'it does not read what it is given') if $left <= 0 || !alive();
        vec($ready, fileno $live->{relay}, 1) = 1;
        select(undef, $ready, undef, $left > 1 ? 1 : $left);
    }
    $live->{heard} = now();
    return;
}

# LZRDFNDR scripts (until release 77 named Script permissions) [C26]. LZRBRWSR runs no script you have not allowed
# (managed-projects/lzrbrwsr/architecture/script-permissions.md, docs/script-permissions.md, RULES.md). Two layers
# decide and either one alone refuses: lzrprf, which holds the only policy and
# the only store, and the engine, which asks before any text becomes code and
# runs nothing without an answer. A script is named by its kind, the origin
# its bytes came from ("inline" for bytes in the page), the SHA-256 of its
# bytes and the capabilities it asks. The site is the page's origin.
#
# The policy, in order (sub permit_decided): a Deny of yours (a rule, or
# your Deny in this window) refuses, whatever E1 and E2 would say; a site
# whose scripts may not run at all ("page deny", sub permit_site) runs none.
# A site may run scripts when you allowed it (an Always rule of yours for
# it, or Allow Once for this visit), or, while you have no rule for it, in
# lzrprf's sandbox (E1, switched on unless you switched it off, or a curated
# rule for it), never on a page for signing in. Then, in this order:
#   E1  an inline or same-origin script, not data: or blob:, asking only for
#       capabilities of low risk (%PERMIT_E1), runs ("once"); in the sandbox
#       its requests are held to @PERMIT_SANDBOX (sub live_fetched);
#   E2  a curated rule names it (sub curated): reviewed, signed with the
#       release, switched on, by SHA-256 or by a reviewed path pattern;
#   E3  an Always rule of yours whose capabilities cover those asked, then
#       your Allow Once;
# and anything else is denied at once and kept to put to you once the page is
# drawn. No question ever holds a page: on an Allow lzrprf loads the page
# again with what you allowed. A changed SHA-256, or capabilities no rule
# names, is a new script.
#
# The store, "$DIR/scripts", one rule a line:
#   always|deny TAB site TAB class TAB script origin TAB sha256 TAB caps TAB date
# The class is the kind asked when you answered: "code" (inline, external,
# module, handler, worker, import) or "strings" (eval, function, timer), so
# that a script allowed to run is still asked before it turns text into code.
# lzrprf alone writes it, beside the old file and through to the disk, and
# only once there is a rule; a file that is a link, of another owner, with a
# second name, larger than $PERMIT_FILE_BYTES, with more than $PERMIT_RULES
# rules or with one line of another form is not read: none of its rules then
# counts, which means you are asked, never that anything runs, and it is
# never written over. An incognito window reads the file of the folder its
# settings come from and keeps every rule of its own in its memory only.
# A rule holds for the kinds of its class (sub permit_kinds); a line of
# another form, the six fields of before the class among them, is no form.
sub permit_rules {                        # [C26] the rules: [always|deny, site, class, script origin, sha256, caps, date, "file" or "memory"] each, the file's first; and whether a file is there that was not read
    my @held = map { [@$_] } @PERMIT_HELD;
    my $file = kept_in() . '/scripts';
    sysopen(my $in, $file, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return (\@held, -l $file || -e _ ? 1 : 0);
    my @is = stat $in;
    return (\@held, 1) unless @is && -f _ && $is[3] == 1 && $is[4] == $< && $is[7] <= $PERMIT_FILE_BYTES;
    my $text = '';
    while (1) {
        my $got = sysread($in, $text, 65536, length $text);
        return (\@held, 1) if !defined $got || length $text > $PERMIT_FILE_BYTES;
        last unless $got;
    }
    return (\@held, 1) unless $text eq '' || $text =~ /\n\z/;
    my @file;
    for (split /\n/, $text) {
        my @rule = /\A(always|deny)\t(https:\/\/$NAME)\t(code|strings)\t($PERMIT_ORIGIN)\t([0-9a-f]{64})\t($PERMIT_CAPS)\t([0-9]{4}-[0-9]{2}-[0-9]{2})\z/ or return (\@held, 1);
        return (\@held, 1) if lc($rule[1]) ne $rule[1] || lc($rule[3]) ne $rule[3] || @file >= $PERMIT_RULES;
        push @file, [@rule, 'file'];
    }
    return ([@file, @held], 0);
}

sub permit_written {                      # [C26] the rules of the file, written beside it and through to the disk, then given its name in one step; with none, the file is removed
    my (@rules) = @_;
    my $file = "$DIR/scripts";
    if (!@rules) { return 1 unless -e $file || -l $file; unlink $file or return 0; synced(); return 1 }
    unlink "$file.new";
    unless (put("$file.new", O_EXCL, map { join "\t", @$_[0 .. 6] } @rules)) { unlink "$file.new"; return 0 }
    unless (rename "$file.new", $file) { unlink "$file.new"; return 0 }
    synced();
    return 1;
}

sub permit_stored {                       # [C26] a change of the rules, made by $how on them as read again under the lock of the settings: written when the file can be, in this window's memory when not (an incognito window, a file that is not read). A rule of a file that is not written never changes. Returns "file" or "memory", or nothing when nothing was changed
    my ($how) = @_;
    my $lock = $INCOGNITO ? 1 : keep_lock();
    return unless $lock;
    my ($rules, $unread) = permit_rules();
    my $memory = $INCOGNITO || $unread;
    my $was = join "\n", map { join "\t", @$_ } grep { $_->[7] eq 'file' } @$rules;
    $how->($rules, $memory) or return;
    $_->[7] //= $memory ? 'memory' : 'file' for @$rules;
    my @file = grep { $_->[7] eq 'file' } @$rules;
    if ($was ne join "\n", map { join "\t", @$_ } @file) { return if $memory || @file > $PERMIT_RULES || !permit_written(@file) }
    @PERMIT_HELD = grep { $_->[7] eq 'memory' } @$rules;
    return $memory ? 'memory' : 'file';
}

sub permit_covers {                       # [C26] whether the capabilities a rule names cover those asked ("-": none)
    my ($has, $asks) = @_;
    my %has = map { $_ => 1 } split /,/, $has eq '-' ? '' : $has;
    return !grep { !$has{$_} } split /,/, $asks eq '-' ? '' : $asks;
}

sub permit_site {                         # [C26] whether a site may run scripts at all ("page allow") on the page at $url: "person", an Always rule of yours for it or your Allow Once of the visit shown; "sandbox", no rule of yours, and E1 is on or a curated rule names the site, on a page that is not for signing in and of a site you did not deny in this window; nothing, "page deny"
    my ($site, $rules, $url) = @_;
    return 'person' if $PERMIT_ONCE{$site} || grep { $_->[0] eq 'always' && $_->[1] eq $site } @$rules;
    return '' if permit_signin($url) || ($PERMIT_DENIED{$site} && $PERMIT_DENIED{$site}{''});
    my $layers = permit_layers();
    return 'sandbox' if $layers->{e1} || grep { $_->{site} eq $site } curated_on($layers);
    return '';
}

sub permit_signin {                       # [C26] whether the page at $url is for signing in: its page held a password field, its host begins with a label of signing in, or a segment of its path is one
    my ($url) = @_;
    return 1 unless defined $url;
    return 1 if $PERMIT_PASSWORD{$url};
    my ($host, $path) = $url =~ m{\Ahttps://([^/?#:]+)(?::[0-9]+)?([^?#]*)} or return 1;
    return 1 if $SIGNIN_HOSTS{ lc((split /\./, $host)[0] // '') };
    return scalar grep { $SIGNIN_PATHS{ lc((split /\./, $_)[0] // '') } } split m{/}, $path;
}

sub permit_password {                     # [C26] a page answer, as curl gave it, that holds a password field: its address is kept for this window as one for signing in
    my ($url, $got) = @_;
    return unless defined $got && $got =~ /<input\b[^>]*\btype\s*=\s*["']?password\b/i;
    %PERMIT_PASSWORD = () if keys %PERMIT_PASSWORD >= $PERMIT_SEEN_MOST;
    $PERMIT_PASSWORD{$url} = 1;
}

sub permit_seen {                         # [C26] one decision of the sandbox (E1) or of a curated rule (E2), kept in this window's memory for Script permissions: the newest first, counted, at most $PERMIT_SEEN_MOST
    my ($layer, $site, $what, $said) = @_;
    my ($had) = grep { $_->[0] eq $layer && $_->[1] eq $site && $_->[2] eq $what && $_->[3] eq $said } @PERMIT_SEEN;
    @PERMIT_SEEN = grep { $_ != ($had // 0) } @PERMIT_SEEN;
    unshift @PERMIT_SEEN, [$layer, $site, $what, $said, ($had ? $had->[4] : 0) + 1];
    splice @PERMIT_SEEN, $PERMIT_SEEN_MOST if @PERMIT_SEEN > $PERMIT_SEEN_MOST;
}

sub permit_info {                         # [C26] what lzrprf saw of one script, kept the first time: its name, inline or external, its size and the first $PERMIT_SOURCE_MOST bytes of its source
    my ($site, $origin, $sha, $name, $where, $text) = @_;
    my $key = "$site $origin $sha";
    return if $PERMIT_INFO{$key};
    %PERMIT_INFO = () if keys %PERMIT_INFO >= $PERMIT_RULES;
    $text //= '';
    $PERMIT_INFO{$key} = { name => $name, where => $where, bytes => length $text, source => substr($text, 0, $PERMIT_SOURCE_MOST), unfetched => $where eq 'unfetched' ? 1 : 0 };
}

sub permit_tracker {                      # [C26] who runs the scripts of the host a name begins with, when @PERMIT_TRACKERS knows it, or ''
    my ($name) = @_;
    my ($host) = lc($name) =~ m{\A([a-z0-9.-]+)};
    return '' unless defined $host;
    my ($known) = grep { $host eq $_->[0] || substr($host, -length($_->[0]) - 1) eq ".$_->[0]" } @PERMIT_TRACKERS;
    return $known ? $known->[1] : '';
}

sub permit_named {                        # [C26] a script by its name (host and path, its query left out, or an inline script of the page by the start of its SHA-256), inline or external, its size in bytes (0 when not seen) and who runs it when known
    my ($site, $kind, $origin, $sha) = @_;
    my $info = $PERMIT_INFO{"$site $origin $sha"};
    my ($host) = $site =~ m{\Ahttps://(.*)\z};
    my $name = $info ? $info->{name} : $origin eq 'inline' ? ($kind eq 'handler' ? 'handler ' : 'inline script ') . substr($sha, 0, 12) . " in $host" : $origin =~ m{\Ahttps://(.*)\z} ? "a script from $1, " . substr($sha, 0, 12) : "a $origin script, " . substr($sha, 0, 12);
    return ($name, $origin eq 'inline' ? 'inline' : $info && $info->{unfetched} ? 'external, size unknown, not fetched' : 'external', $info ? $info->{bytes} : 0, permit_tracker($origin eq 'inline' ? '' : $name =~ s/\Aa script from //r));
}

sub permit_part {                         # [C26] one part the strip took out of the page at $url ($at: its host and path), by its name: [kind, origin, identity, name, where, text]. A script file is named by its address resolved against the page, its query left out, and is never fetched for it: its identity is the SHA-256 of "src " and that address, so a Deny Always of it holds on the next visit. An address of no origin a rule can hold is named as the text it is
    my ($url, $at, $kind, $sha, $text, $label) = @_;
    if ($kind eq 'src') {
        (my $value = $text) =~ s/&amp;/&/gi;
        $value =~ s/\A[\x00-\x20]+|[\x00-\x20]+\z//g;
        my $to = resolved($url, $value) =~ s/[?#].*\z//sr;
        my ($origin, $host, $path) = $to =~ m{\A(https://([^/?#]+))([^?#]*)\z};
        return ['external', $origin, Digest::SHA::sha256_hex("src $to"), $host . (length $path ? $path : '/'), 'unfetched', ''] if defined $origin && $origin =~ /\A$PERMIT_ORIGIN\z/;
        my ($scheme) = $to =~ /\A(data|blob):/;
        return ['external', "$scheme:", Digest::SHA::sha256_hex("src $to"), "a $scheme: script address", 'unfetched', ''] if $scheme;
        ($kind, $sha, $label) = ('handler', Digest::SHA::sha256_hex($value), 'script address');
        $text = $value;
    }
    return [$kind, 'inline', $sha, "$label " . substr($sha, 0, 12) . " in $at", 'inline', $text];
}

sub permit_decision {                     # [C26] your decision on one script of a site, as LZRDFNDR's On Websites says it: "allowed always", "denied always", "allowed once", "denied once" or "no decision"; and the number of the rule of yours, or -1
    my ($site, $class, $origin, $sha, $rules) = @_;
    for my $n (0 .. $#$rules) {
        my $r = $rules->[$n];
        return ($r->[0] eq 'always' ? 'allowed always' : 'denied always', $n) if $r->[1] eq $site && $r->[2] eq $class && $r->[3] eq $origin && $r->[4] eq $sha;
    }
    return ('denied once', -1) if $PERMIT_DENIED{$site} && $PERMIT_DENIED{$site}{"$class $origin $sha"};
    for my $once (grep { $_ } $PERMIT_ONCE{$site}, $PERMIT_NEXT{$site}) {
        return ('allowed once', -1) if grep { my ($k, $o, $s) = split / /; permit_class($k) eq $class && $o eq $origin && $s eq $sha } keys %{ $once->{keys} };
    }
    return ('no decision', -1);
}

sub sites_told {                          # [C26] LZRDFNDR's On Websites: "sites begin", then for each site in order "sites site SITE", and under it "sites script N<tab>SITE<tab>NAME<tab>inline|external<tab>BYTES<tab>WHO<tab>CLASS<tab>DECISION" for each script put to you in this window and each rule of yours; then "sites end"
    my ($keys, $all, $lines) = sites_listed();
    window('sites begin', @$lines, 'sites end');
}

sub sites_listed {                        # [C26] the scripts of On Websites, each site's together in the order of their keys: the keys, the scripts by key, and the lines that tell them
    my ($rules) = permit_rules();
    my %all = %PERMIT_WEB;
    $all{ join "\t", @$_[1 .. 4] } //= [$_->[1], $_->[2] eq 'strings' ? 'eval' : $_->[3] eq 'inline' ? 'inline' : 'external', @$_[3, 4, 5]] for @$rules;
    my @keys = sort keys %all;
    my ($n, $was, @lines) = (0, '');
    for my $key (@keys) {
        my ($site, $kind, $origin, $sha) = @{ $all{$key} };
        my $class = permit_class($kind);
        push @lines, "sites site $site" if $site ne $was;
        $was = $site;
        my ($name, $where, $bytes, $who) = permit_named($site, $kind, $origin, $sha);
        push @lines, 'sites script ' . join("\t", $n++, $site, $name, $where, $bytes, $who, $class, (permit_decision($site, $class, $origin, $sha, $rules))[0]);
    }
    return \@keys, \%all, \@lines;
}

sub sites_decide {                        # [C26] [C4] a decision changed in LZRDFNDR's On Websites, for the script numbered $n as sites_told last numbered it: "always" or "deny" keeps a rule of yours for it, "forget" takes away every decision of yours for it; then the list is told again
    my ($n, $to) = @_;
    my ($keys, $all) = sites_listed();    # numbered as sites_told numbered them
    my $key = $keys->[$n];
    my $words = 'Nothing was changed: that script is no longer in the list.';
    if (defined $key) {
        my ($site, $kind, $origin, $sha, $caps) = @{ $all->{$key} };
        my $class = permit_class($kind);
        my $date = strftime('%Y-%m-%d', gmtime);
        delete $PERMIT_DENIED{$site}{"$class $origin $sha"} if $PERMIT_DENIED{$site};
        for my $once (grep { $_ } $PERMIT_ONCE{$site}, $PERMIT_NEXT{$site}) { delete $once->{keys}{$_} for grep { my ($k, $o, $s) = split / /; permit_class($k) eq $class && $o eq $origin && $s eq $sha } keys %{ $once->{keys} } }
        my $done = permit_stored(sub {
            my ($rules, $memory) = @_;
            my $had = @$rules;
            @$rules = grep { !($_->[1] eq $site && $_->[2] eq $class && $_->[3] eq $origin && $_->[4] eq $sha && !($memory && $_->[7] eq 'file')) } @$rules;
            push @$rules, [$to, $site, $class, $origin, $sha, $caps // '-', $date] if $to ne 'forget';
            return $to ne 'forget' || $had != @$rules;
        });
        my ($name) = permit_named($site, $kind, $origin, $sha);
        $words = $to eq 'forget' ? "No decision of yours is kept for $name: it is asked about again." : $done ? "$name is now " . ($to eq 'always' ? 'allowed' : 'denied') . ' always.' : 'Nothing was changed: the scripts file could not be written.';
        noted("LZRDFNDR On Websites: $words");
    }
    sites_told();
    return idle($words);
}

# The two switches of the layers, in the plain file scriptlayers of yours, one
# a line: "e1 off" switches the sandbox off, and "curated off TAB site TAB
# script origin TAB identity TAB class" switches one curated rule off. No file
# means the sandbox is on and every curated rule is; the file is written only
# while something is switched off. It is read strictly, as the scripts file
# is: a file that does not read switches the sandbox and every curated rule
# off, so you are asked, never that anything runs. An incognito window reads
# it and keeps what is chosen in it in its memory only.
sub permit_layers {                       # [C26] {e1 => 1 or 0, off => {"SITE TAB ORIGIN TAB IDENTITY TAB CLASS" => 1}, unread => 1 when a file is there that does not read}
    return { e1 => $HELD_LAYERS->{e1}, off => { %{ $HELD_LAYERS->{off} } }, unread => 0 } if $INCOGNITO && $HELD_LAYERS;
    my $file = kept_in() . '/scriptlayers';
    my %layers = (e1 => 1, off => {}, unread => 0);
    sysopen(my $in, $file, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return -l $file || -e _ ? { e1 => 0, off => {}, unread => 1, all => 1 } : \%layers;
    my @is = stat $in;
    my $text = '';
    my $bad = { e1 => 0, off => {}, unread => 1, all => 1 };
    return $bad unless @is && -f _ && $is[3] == 1 && $is[4] == $< && $is[7] <= $PERMIT_FILE_BYTES && defined sysread($in, $text, $PERMIT_FILE_BYTES + 1) && length $text <= $PERMIT_FILE_BYTES && ($text eq '' || $text =~ /\n\z/);
    for (split /\n/, $text) {
        if ($_ eq 'e1 off') { $layers{e1} = 0; next }
        my ($key) = /\Acurated off\t(https:\/\/$NAME\t(?:inline|https:\/\/$NAME(?::[0-9]{1,5})?)\t(?:sha256 [0-9a-f]{64}|path \/[!-~]{1,300})\t(?:code|strings))\z/ or return $bad;
        return $bad if keys %{ $layers{off} } >= $CURATED_MOST;
        $layers{off}{$key} = 1;
    }
    return \%layers;
}

sub permit_layers_kept {                  # [C26] the switches written as $layers says, under the lock of the settings: the file removed when nothing is switched off; in an incognito window held in its memory. Returns "file" or "memory", or nothing when it could not be written
    my ($layers) = @_;
    if ($INCOGNITO) { $HELD_LAYERS = { e1 => $layers->{e1} ? 1 : 0, off => { %{ $layers->{off} } } }; return 'memory' }
    my $file = "$DIR/scriptlayers";
    my @lines = (($layers->{e1} ? () : 'e1 off'), map { "curated off\t$_" } sort keys %{ $layers->{off} });
    if (!@lines) { return 'file' unless -e $file || -l $file; unlink $file or return; synced(); return 'file' }
    unlink "$file.new";
    unless (put("$file.new", O_EXCL, @lines) && rename("$file.new", $file)) { unlink "$file.new"; return }
    synced();
    return 'file';
}

# E2, the curated rules: reviewed rules of site scripts, kept in lzrprf's
# repository in rules/, one file per site, and joined in the order of their
# names into one file, permit-rules, that the release's signed manifest names
# by its SHA-256 (RULES.md has the form). The installer keeps that file beside
# lzrprf with the manifest and both its signatures (release.manifest,
# release.manifest.sig, release.manifest.approval). lzrprf uses a curated rule
# only when all four are plain files of yours; the manifest is in its one form
# (sub manifest_read); the approval holds for an approval key and the
# signature for the release key lzrprf carries (sub signature_holds, macOS's
# own ssh-keygen in the verifier container); the manifest is of the release
# the application's release file names; and it names permit-rules by the
# SHA-256 of the file beside it. Anything else, and every curated rule is
# unused: you are asked, never that anything runs. The expiry of the manifest
# is not held against rules already installed with it. In the file, a site's
# part whose rule is unreviewed, grants a capability that is not of low risk,
# names a path pattern too wide, a site for signing in, or any line of another
# form, is not used at all; the other parts are.
sub curated {                             # [C26] E2: the curated rules, read and checked once a window (see above)
    return $CURATED if $CURATED;
    $CURATED = { rules => [], parts => [], why => '' };
    my $no = sub { $CURATED->{why} = $_[0]; return $CURATED };
    my %text;
    for my $name ('permit-rules', 'release.manifest', 'release.manifest.sig', 'release.manifest.approval') {
        my $file = "$ROOT/$name";
        sysopen(my $in, $file, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return $no->(-l $file || -e $file ? "$file is not a plain file of yours" : "there is no $name beside lzrprf, so no curated rule is used");
        my @is = stat $in;
        return $no->("$file is not a plain file of yours") unless @is && -f _ && $is[3] == 1 && $is[4] == $<;
        my $most = $name eq 'permit-rules' ? $CURATED_BYTES : $name eq 'release.manifest' ? $MANIFEST_MOST : $SIGNATURE_MOST;
        return $no->("$file is larger than lzrprf reads") if $is[7] > $most;
        my $got = '';
        while (1) { my $n = sysread($in, $got, 65536, length $got); return $no->("$file could not be read") unless defined $n; last unless $n; return $no->("$file is larger than lzrprf reads") if length $got > $most }
        $text{$name} = $got;
    }
    my ($manifest, $why) = manifest_read($text{'release.manifest'});
    return $no->("release.manifest: $why") unless $manifest;
    return $no->('the manifest is not approved with an approval key lzrprf carries') unless signature_holds($text{'release.manifest'}, $text{'release.manifest.approval'}, $APPROVAL_NAMESPACE, 'ECDSA', approval_keys());
    return $no->('the signature of the manifest does not hold for the release key lzrprf carries') unless signature_holds($text{'release.manifest'}, $text{'release.manifest.sig'}, $RELEASE_NAMESPACE, 'ED25519', release_key());
    my ($release) = beside();
    return $no->('the application\'s release file names no release, so lzrprf cannot tell the manifest is of this one') if !defined $release && (release_lines() || $PROGRAM =~ m{\.app/Contents/MacOS/});
    return $no->("the manifest is of release $manifest->{release}, and the application is release $release") if defined $release && $release != $manifest->{release};
    my $named = $manifest->{files}{'permit-rules'} // return $no->('the signed manifest names no permit-rules');
    return $no->('permit-rules is another file than the signed manifest names') unless $named eq Digest::SHA::sha256_hex($text{'permit-rules'});
    my ($rules, $parts, $bad) = curated_read($text{'permit-rules'});
    return $no->("permit-rules is not in its form: $bad") if defined $bad;
    @$CURATED{qw(rules parts)} = ($rules, $parts);
    return $CURATED;
}

sub curated_read {                        # [C26] E2: the parts of a file of curated rules, each "lzrprf permit rules 1" and its rules (RULES.md); returns [rules used], [[site, "used" or "ignored", why]] and why the file as a whole is in no form, or nothing
    my ($text) = @_;
    return ([], [], 'it holds a byte that is not printable or does not end in a line end') unless $text eq '' || $text =~ /\A[\x20-\x7e\n]*\n\z/;
    my (@rules, @parts, $part);
    my $now = time;
    my $done = sub {
        return unless $part;
        my @mine = @{ $part->{rules} };
        my $why = $part->{why} // (!@mine ? 'it holds no rule' : '');
        my $site = @mine ? $mine[0]{site} : $part->{site} // '-';    # a part none of whose rules is used is named by the site its first rule says
        $why ||= 'its rules are of more than one site' if grep { $_->{site} ne $site } @mine;
        push @parts, [$site, length $why ? 'ignored' : 'used', length $why ? $why : 'reviewed and signed'];
        push @rules, @mine unless length $why;
    };
    my @lines = split /\n/, $text;
    while (@lines) {
        my $line = shift @lines;
        next if $line eq '' || $line =~ /\A# [\x20-\x7e]{0,300}\z/;
        if ($line eq 'lzrprf permit rules 1') { $done->(); $part = { rules => [] }; next }
        return ([], [], "a line of no form where a part or a rule begins: $line") unless $part && $line eq 'rule';
        my %rule;
        for my $field (qw(site script-origin script class caps justification source reviewer reviewed)) {
            my $got = shift(@lines) // '';
            my ($value) = $got =~ /\A\Q$field\E ([\x20-\x7e]{1,400})\z/ or return ([], [], "a rule without its field $field in its place");
            $rule{$field} = $value;
        }
        $part->{site} //= $rule{site};
        return ([], [], 'a rule that does not end with "end"') unless (shift(@lines) // '') eq 'end';
        my $one = curated_rule(\%rule, $now);
        if (!ref $one) { $part->{why} //= $one; next }
        return ([], [], "more than $CURATED_MOST rules") if @rules + @{ $part->{rules} } >= $CURATED_MOST;
        push @{ $part->{rules} }, $one;
    }
    $done->();
    return (\@rules, \@parts, undef);
}

sub curated_rule {                        # [C26] E2: one rule's fields checked, as a rule lzrprf can use; or why it may never be used
    my ($r, $now) = @_;
    my ($site) = $r->{site} =~ m{\A(https://$NAME)\z} or return 'its site is not an https origin of small letters';
    return 'its site is not an https origin of small letters' if lc $site ne $site;
    return 'its site is one for signing in' if $SIGNIN_HOSTS{ (split /\./, substr($site, 8))[0] };
    my ($origin) = $r->{'script-origin'} =~ m{\A(inline|https://$NAME(?::[0-9]{1,5})?)\z} or return 'its script origin is neither inline nor an https origin';
    return 'its script origin is neither inline nor an https origin' if lc $origin ne $origin;
    my ($kind, $id, $reason);
    if ($r->{script} =~ /\Asha256 ([0-9a-f]{64})\z/) { ($kind, $id) = ('sha256', $1) }
    elsif ($r->{script} =~ m{\Apath ((?:/[A-Za-z0-9._~*-]{1,128}){2,16}) reason ([\x20-\x7e]{8,300})\z}) { ($kind, $id, $reason) = ('path', $1, $2) }
    else { return 'it names no script identity: a SHA-256, or a path pattern with its reason' }
    if ($kind eq 'path') {
        my @segments = split m{/}, substr($id, 1);
        return 'a path pattern is not for a script of an inline origin' if $origin eq 'inline';
        return 'its path pattern does not end in .js or .mjs' unless $id =~ /\.m?js\z/;
        return 'its path pattern has more than two "*"' if ($id =~ tr/*//) > 2;
        return 'its path pattern names no fixed folder, so it would hold for a whole domain' unless grep { !/\*/ } @segments[0 .. $#segments - 1];
        return 'its path pattern has a segment that is only "*"' if grep { $_ eq '*' } @segments;
    }
    my ($class) = $r->{class} =~ /\A(code|strings)\z/ or return 'its class is neither code nor strings';
    my ($caps) = $r->{caps} =~ /\A($PERMIT_CAPS)\z/ or return 'its capabilities are not names';
    for my $cap (split /,/, $caps eq '-' ? '' : $caps) {
        return "it grants $cap, which no script permission covers (C5)" if ($PERMIT_CAPS{$cap} // '') eq 'c5';
        return "it grants $cap, which only you grant" if ($PERMIT_CAPS{$cap} // '') eq 'person';
        return "it grants $cap, a capability lzrprf does not know" unless $PERMIT_CAPS{$cap};
    }
    return 'its justification is too short to say why' if length $r->{justification} < 12;
    return 'it names no source inspected' if length $r->{source} < 8;
    return 'it is unreviewed' if $r->{reviewer} =~ /\A\s*(?:unreviewed|-|none)?\s*\z/i;
    my @date = $r->{reviewed} =~ /\A([0-9]{4})-([0-9]{2})-([0-9]{2})\z/ or return 'its review date is not a date';
    my $when = eval { Time::Local::timegm(0, 0, 0, $date[2], $date[1] - 1, $date[0]) } // return 'its review date is not a date';
    return 'its review date is later than today' if $when > $now + 86400;
    my $pattern = $kind eq 'path' ? join('', map { $_ eq '*' ? '[A-Za-z0-9._~-]{1,128}' : quotemeta } split /(\*)/, $id) : undef;
    return { site => $site, origin => $origin, kind => $kind, id => $id, reason => $reason, class => $class, caps => $caps, justification => $r->{justification},
        source => $r->{source}, reviewer => $r->{reviewer}, reviewed => $r->{reviewed}, pattern => $pattern, key => "$site\t$origin\t$kind $id\t$class" };
}

sub curated_on {                          # [C26] E2: the curated rules in use and not switched off by you
    my ($layers) = @_;
    $layers //= permit_layers();
    return if $layers->{all};
    return grep { !$layers->{off}{ $_->{key} } } @{ curated()->{rules} };
}

sub permit_curated {                      # [C26] E2: the curated rule that holds for this script on the page at $url, or nothing: of its site and class, of a kind its class holds for, of its origin, its bytes by their SHA-256 or the path they were fetched from by its pattern, the capabilities asked covered; never on a page for signing in
    my ($site, $kind, $origin, $sha, $caps, $url) = @_;
    return if permit_signin($url);
    my $class = permit_class($kind);
    for my $rule (curated_on()) {
        next unless $rule->{site} eq $site && $rule->{class} eq $class && $rule->{origin} eq $origin && grep({ $_ eq $kind } permit_kinds($class, $origin)) && permit_covers($rule->{caps}, $caps);
        return $rule if $rule->{kind} eq 'sha256' ? $rule->{id} eq $sha : ($PERMIT_PATHS{"$site $origin $sha"} // '') =~ /\A$rule->{pattern}\z/;
    }
    return;
}

sub permit_refused {                      # [C26] bytes you denied for the class of this kind: a Deny rule of the site for them, whatever capabilities it names, or your Deny in this window
    my ($site, $kind, $origin, $sha, $rules) = @_;
    my $class = permit_class($kind);
    return 1 if $PERMIT_DENIED{$site} && $PERMIT_DENIED{$site}{"$class $origin $sha"};
    return scalar grep { $_->[0] eq 'deny' && $_->[1] eq $site && $_->[2] eq $class && $_->[3] eq $origin && $_->[4] eq $sha } @$rules;
}

sub permit_decided {                      # [C26] the policy, in its order, for a script on the page at $url: "always", "once" or "deny"; in a list, also the layer that decided: "e1", "e2", "e3", or "none" for a deny no rule of yours names
    my ($site, $kind, $origin, $sha, $caps, $rules, $url) = @_;
    my $said = sub { return wantarray ? @_ : $_[0] };
    return $said->('deny', 'e3') if permit_refused($site, $kind, $origin, $sha, $rules);    # your Deny wins over E1 and E2
    my $layer = permit_site($site, $rules, $url);
    return $said->('deny', 'none') unless $layer;
    my $class = permit_class($kind);
    return $said->('once', 'e1') if ($layer eq 'person' || permit_layers()->{e1}) && $kind =~ /\A(?:inline|external|module|handler)\z/ && ($origin eq 'inline' || $origin eq $site) && permit_covers(join(',', keys %PERMIT_E1), $caps);    # E1: never data: or blob:, which are neither
    return $said->('once', 'e2') if permit_curated($site, $kind, $origin, $sha, $caps, $url);    # E2, a curated rule
    return $said->('always', 'e3') if grep { $_->[0] eq 'always' && $_->[1] eq $site && $_->[2] eq $class && $_->[3] eq $origin && $_->[4] eq $sha && permit_covers($_->[5], $caps) } @$rules;    # E3, your rules, of the class asked
    my $once = $PERMIT_ONCE{$site};
    return $said->('once', 'e3') if $once && grep { my ($k, $o, $s, $c) = split / /; $k eq $kind && $o eq $origin && $s eq $sha && permit_covers($c, $caps) } keys %{ $once->{keys} };    # your Allow Once, of the kind asked
    return $said->('deny', 'none');
}

sub permit_queued {                       # [C26] a script no rule allows, kept to put to you once the visit shown is drawn: of that visit's site only, once each, at most $PERMIT_QUEUE, and nothing you denied in this window
    my ($site, $kind, $origin, $sha, $caps) = @_;
    my $ask = $PERMIT_ASK;
    return unless $ask && $ask->{site} eq $site && !($PERMIT_DENIED{$site} && ($PERMIT_DENIED{$site}{''} || $PERMIT_DENIED{$site}{permit_class($kind) . " $origin $sha"}));
    my $key = "$kind $origin $sha $caps";
    return if $ask->{items}{$key} || keys %{ $ask->{items} } >= $PERMIT_QUEUE;
    $ask->{items}{$key} = [$kind, $origin, $sha, $caps];
}

# The frame of a page run, after its style sheets: "=permits N", then N
# lines, at most $PERMITS_MOST with this one: "page allow" or "page deny",
# then "always KIND ORIGIN SHA256" or "deny KIND ORIGIN SHA256" for each
# decision lzrprf holds for the site (your rules, and a curated rule by
# SHA-256 while the site may run scripts), a Deny first. A rule is told for each
# kind of its class (sub permit_kinds); Allow Once is told as "always", for
# the kind it was given to and this visit only. What does not fit is asked by the page (sub
# live_permitted) and answered by the same rules.
sub permit_page {                         # [C26] the frame for a page run of $url; with "page deny" the answer, $$got, loses its scripts first (sub permit_stripped)
    my ($url, $got) = @_;
    my ($host) = $url =~ m{^https://([^/?#:]+)};
    $host = lc($host // '');
    my $site = "https://$host";
    permit_password($url, $$got);         # a page with a password field is one for signing in: no sandbox and no curated rule
    my ($rules) = permit_rules();
    my $allowed = permit_site($site, $rules, $url);
    my %line;
    my $one = sub { my ($word, $id) = @_; $line{$id} = $word if $word eq 'deny' || !$line{$id} };
    my $put = sub { my ($word, $class, $origin, $sha) = @_; $one->($word, "$_ $origin $sha") for permit_kinds($class, $origin) };
    $put->(@$_[0, 2, 3, 4]) for grep { $_->[1] eq $site } @$rules;
    $put->('always', @$_{qw(class origin id)}) for $allowed && !permit_signin($url) ? grep { $_->{site} eq $site && $_->{kind} eq 'sha256' } curated_on() : ();    # E2: a curated rule by SHA-256; one by path pattern is answered when the page asks (sub live_permitted)
    $one->('always', join ' ', (split / /)[0 .. 2]) for keys %{ ($PERMIT_ONCE{$site} // {})->{keys} // {} };
    $put->('deny', split / /) for grep { length } keys %{ $PERMIT_DENIED{$site} // {} };
    my ($stripped, $count, $inline) = permit_stripped($$got);
    my ($path) = $url =~ m{\Ahttps://[^/?#]+(/[^?#]*)};
    my @parts = map { permit_part($url, $host . ($path // '/'), @$_) } @$inline;    # [C26] every part taken out by its name: [kind, origin, identity, name, where, text]
    permit_info($site, @$_[1 .. 5]) for @parts;    # each one's name and source, for the question about it
    if (!$allowed) {
        if ($count) {
            $$got = $stripped;
            if ($PERMIT_ASK && $PERMIT_ASK->{site} eq $site) {
                $PERMIT_ASK->{stripped} = $count - grep { permit_refused($site, @$_[0 .. 2], $rules) } @parts;    # a part a Deny Always of yours names is not asked about again
                permit_queued($site, @$_[0 .. 2], '-') for @parts;
            }
            noted("lzrprf took $count script " . ($count == 1 ? 'part' : 'parts') . " out of $url before it was laid out: the scripts of $host are not allowed");
        }
    }
    my @lines = sort { ($line{$b} eq 'deny') <=> ($line{$a} eq 'deny') || $a cmp $b } keys %line;
    splice @lines, $PERMITS_MOST - 1 if @lines > $PERMITS_MOST - 1;
    @lines = ('page ' . ($allowed ? 'allow' : 'deny'), map { "$line{$_} $_" } @lines);
    return '=permits ' . @lines . "\n" . join('', map { "$_\n" } @lines);
}

sub permit_stripped {                     # [C26] an answer as curl gave it, with the scripts taken out of its body (sub permit_body) and its length said anew; the same answer when nothing was taken out. Returns it, how many parts were taken out, and [kind, sha256, text] of each inline script and handler
    my ($got) = @_;
    my $before = '';
    while ($got =~ s{\A(HTTP/1\.[01] 1[0-9][0-9][^\r\n]*\r\n(?:[^\r\n]+\r\n)*\r\n)}{}) { $before .= $1 }    # an interim answer goes before the answer
    my ($head, $body) = $got =~ m{\A(HTTP/1\.[01] [0-9]{3}[^\r\n]*\r\n(?:[^\r\n]+\r\n)*)\r\n(.*)\z}s or return ($before . $got, 0, []);
    return ($before . $got, 0, []) if $head =~ m{^content-type:[ \t]*(?:image|audio|video|font)/}mi;    # bytes that are no document
    my $text = $body;
    $text = unchunked($body) if $head =~ /^transfer-encoding:[ \t]*chunked[ \t]*\r?$/mi;
    $text = undef if $head =~ /^content-encoding:[ \t]*(?!identity\b)[^\s]/mi;    # lzrprf asks for none (Accept-Encoding: identity) and reads none
    my ($html, $count, $inline) = defined $text ? permit_body($text) : ('', length($body) ? 1 : 0, []);    # a body lzrprf cannot read is not handed over
    return ($before . $got, 0, []) unless $count;
    $head =~ s/^(?:content-length|transfer-encoding|content-encoding):[^\r\n]*\r\n//mgi;
    return ("$before${head}Content-Length: " . length($html) . "\r\n\r\n$html", $count, $inline);
}

sub permit_body {                         # [C26] a document with every script element, every attribute named on..., every srcdoc and every attribute whose value is a javascript: or vbscript: address taken out, read once from its start to its end; it will never read exactly as the engine's parser does, which refuses on its own. Returns it, how many parts were taken out, and [kind, sha256, text] of each script element's text that names no src and of each handler's text as written
    my ($html) = @_;
    my ($out, $count, @inline) = ('', 0);
    my $rest = sub {                      # what follows a tag's name up to its ">", which is passed: a quoted value holds a ">", and one never closed runs to the end, as a browser reads it. A step at a time, so a tag of a million quoted values costs what its bytes do
        my $from = pos($html);
        1 while $html =~ /\G[^>"']+/gc || $html =~ /\G"[^"]*(?:"|\z)/gc || $html =~ /\G'[^']*(?:'|\z)/gc;
        my $attrs = substr($html, $from, pos($html) - $from);
        return ($attrs, $html =~ /\G>/gc ? '>' : '');
    };
    pos($html) = 0;
    while (pos($html) < length $html) {
        if ($html =~ /\G([^<]+)/gc) { $out .= $1; next }
        if ($html =~ /\G(<!--.*?(?:-->|\z))/gcs) { $out .= $1; next }
        if ($html =~ /\G<script(?=[\s\/>]|\z)/gci) {
            my ($attrs) = $rest->();
            my $from = pos($html);
            my $to = $html =~ /\G.*?(?=<\/script[\s\/>])/gcsi ? pos($html) : length $html;
            my ($src) = map { defined ? $_ : () } $attrs =~ /(?:\A|[\s"'\/])src\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s>]*))/i;
            push @inline, defined $src ? ['src', '', $src, ''] : ['inline', Digest::SHA::sha256_hex(substr($html, $from, $to - $from)), substr($html, $from, $to - $from), 'inline script'];    # a script file by its address, which is not fetched
            pos($html) = $to;
            $html =~ /\G<\/script[^>]*>?/gci;
            $count++;
            next;
        }
        if ($html =~ /\G<([A-Za-z][^\s\/>]*)/gc) {
            my $name = $1;
            my ($attrs, $end) = $rest->();
            my ($kept, $n, @parts) = permit_tag($attrs);
            push @inline, map { [$_->[0], Digest::SHA::sha256_hex($_->[1]), $_->[1], $_->[2]] } @parts;
            $count += $n;
            $out .= '<' . $name . ($n ? $kept : $attrs) . $end;
            next;
        }
        $html =~ /\G</gc;
        $out .= '<';
    }
    return ($out, $count, \@inline);
}

sub permit_tag {                          # [C26] a tag's attributes without those that would run: named on..., srcdoc, or holding a javascript: or vbscript: address; how many were taken out; and the text of each handler as written
    my ($attrs) = @_;
    my ($kept, $n, @handlers) = ('', 0);
    pos($attrs) = 0;
    while ($attrs =~ /\G([\s\/]*)([^\s\/>=]+|=[^\s\/>=]*)((?:\s*=\s*(?:"([^"]*)(?:"|\z)|'([^']*)(?:'|\z)|([^\s>]*)))?)/gc) {
        my ($gap, $name, $value, $said) = ($1, $2, $3, $4 // $5 // $6 // '');
        if ($name =~ /\Aon/i) { push @handlers, ['handler', $said, 'handler']; $n++; next }
        if (lc $name eq 'srcdoc') { push @handlers, ['inline', $said, 'srcdoc']; $n++; next }    # a frame's document: its scripts are named by the document's identity
        if (length $value && permit_scripted($said)) { push @handlers, ['handler', $said, 'script address']; $n++; next }
        $kept .= (length $gap ? $gap : ' ') . $name . $value;
    }
    return ($kept . substr($attrs, pos($attrs) // 0), $n, @handlers);
}

sub permit_scripted {                     # [C26] whether an attribute's value is an address that runs a script, read as a browser reads it: character references decoded, every space and control character dropped, any case; also as the address of a refresh ("0;url=javascript:...")
    my ($value) = @_;
    $value =~ s/&#[xX]0*([0-9a-fA-F]{1,6});?/hex($1) > 0x10ffff ? '' : chr hex $1/ge;
    $value =~ s/&#0*([0-9]{1,7});?/$1 > 0x10ffff ? '' : chr $1/ge;
    $value =~ s/&colon;/:/gi;
    $value =~ s/&(?:tab|newline);//gi;
    $value =~ s/[\x00-\x20\x7f]+//g;
    return lc($value) =~ /(?:\A|url=)['"]?(?:javascript|vbscript):/;
}

sub live_permitted {                      # [C26] "=permit KIND ORIGIN SHA256 CAPS" of a page: answered at once, "=permitted always", "once" or "deny" (sub permit_decided), one answer for each in its order; what no rule allows is denied and kept to put to you once the page is drawn, so no question ever holds a page
    my ($live, $line) = @_;
    my ($kind, $origin, $sha, $caps) = $line =~ /\A=permit ($PERMIT_KIND) ($PERMIT_ORIGIN) ([0-9a-f]{64}) ($PERMIT_CAPS)\z/ or return live_end($live, 'it wrote a line of no form');
    return live_end($live, "it asked more than $LIVE_PERMIT_MOST times whether a script may run") if ++$live->{permits} > $LIVE_PERMIT_MOST;
    $origin = lc $origin;
    my $site = "https://$live->{host}";
    my ($rules) = permit_rules();
    my ($said, $layer) = permit_decided($site, $kind, $origin, $sha, $caps, $rules, $live->{url});
    permit_queued($site, $kind, $origin, $sha, $caps) if $said eq 'deny' && !permit_refused($site, $kind, $origin, $sha, $rules);
    my $what = "$kind script " . ($origin eq 'inline' ? 'in the page' : "from $origin") . ' ' . substr($sha, 0, 12);
    permit_seen($layer, $site, $what, 'ran') if $layer =~ /\Ae[12]\z/;    # [C26] what E1 and E2 decided, for Script permissions
    permit_seen('e1', $site, $what, 'asked') if $said eq 'deny' && $layer eq 'none' && permit_site($site, $rules, $live->{url}) eq 'sandbox';
    noted("the page $live->{url} asked to run a script ($kind, " . ($origin eq 'inline' ? 'in the page' : "from $origin") . ", capabilities $caps): " . ($said eq 'deny' ? 'not run' : "run ($said, " . { e1 => 'E1, the sandbox', e2 => 'E2, a curated rule', e3 => 'E3, your rule' }->{$layer} . ')'));
    return live_sent($live, "=permitted $said\n");
}

sub permit_visited {                      # [C26] a visit begins: what you allowed once for its site is for this visit, and what its page asks is put to you once it is drawn
    my ($url, $host) = @_;
    my $site = "https://$host";
    delete $PERMIT_DENIED{$site};         # Deny Once held for the visit it was given in, and no longer
    if (my $next = delete $PERMIT_NEXT{$site}) { $PERMIT_ONCE{$site} = $next } else { delete $PERMIT_ONCE{$site} }
    $PERMIT_ROUND = defined $PERMIT_RELOAD && $PERMIT_RELOAD eq $url ? $PERMIT_ROUND + 1 : 0;
    undef $PERMIT_RELOAD;
    $PERMIT_ASK = { site => $site, url => $url, items => {}, stripped => 0, refused => 0, boxed => 0 };
}

sub permits_asked {                       # [C26] once the page is drawn: its scripts no rule allows, and what was taken out of it or refused, put to you, each by its name and with its source: Deny Once, Deny Always, Allow Once, Always Allow. Deny Once is the first button and the answer when nobody answers; Deny Always keeps a deny rule, and a script a deny rule names is never put to you again. Returns true when the page is to be loaded again with what you allowed
    my $ask = $PERMIT_ASK or return 0;
    return 0 unless ($TABS[$TAB]{url} // '') eq $ask->{url};
    my $site = $ask->{site};
    my ($rules) = permit_rules();
    my $allowed = permit_site($site, $rules, $ask->{url});
    my @items = grep { permit_decided($site, @$_, $rules, $ask->{url}) eq 'deny' && !permit_refused($site, @$_[0 .. 2], $rules) } map { $ask->{items}{$_} } sort keys %{ $ask->{items} };
    my $blocked = $allowed || ($PERMIT_DENIED{$site} && $PERMIT_DENIED{$site}{''}) ? 0 : $ask->{stripped} + $ask->{refused};
    my $boxed = $allowed eq 'sandbox' ? $ask->{boxed} // 0 : 0;    # what the sandbox refused: said when you are asked, never a question of its own
    ($ask->{items}, $ask->{stripped}, $ask->{refused}, $ask->{boxed}) = ({}, 0, 0, 0);
    return 0 unless @items || $blocked;
    my ($host) = $site =~ m{^https://(.*)\z};
    my (@from, @text);                    # each script by its name, where it is, its size and who runs it when known; a script that wants to turn text into code (class "strings") is named on its own
    for my $item (@items) {
        my ($name, $where, $bytes, $who) = permit_named($site, @$item[0 .. 2]);
        push @{ permit_class($item->[0]) eq 'strings' ? \@text : \@from }, "$name (" . join(', ', $where, ($bytes ? "$bytes bytes" : ()), (length $who ? $who : ())) . ')';
        $PERMIT_WEB{ join "\t", $site, permit_class($item->[0]), @$item[1, 2] } //= [$site, @$item];    # for LZRDFNDR's On Websites
    }
    %PERMIT_WEB = () if keys %PERMIT_WEB > $PERMIT_RULES;
    my $words = "$host has scripts that did not run. " . (@from ? 'Not allowed: ' . join('; ', @from) . '. ' : '') . (@text ? 'Scripts that want to turn text into code (eval): ' . join('; ', @text) . '. ' : '') . ($blocked ? "lzrprf took $blocked script " . ($blocked == 1 ? 'part' : 'parts') . ' out of the page or refused ' . ($blocked == 1 ? 'it' : 'them') . '. ' : '')
        . ($allowed eq 'sandbox' ? (permit_layers()->{e1} ? "Its own scripts ran in lzrprf's sandbox" : "The scripts its curated rules name ran in lzrprf's sandbox") . ($boxed ? ", which refused $boxed " . ($boxed == 1 ? 'request' : 'requests') . ' to send or to fetch from another site' : '') . '. ' : '')
        . 'Deny Once keeps them from running on this visit; Deny Always keeps a deny rule in LZRDFNDR scripts. Allow Once runs them on this visit' . ($allowed eq 'sandbox' ? ', outside the sandbox' : '') . '; Always Allow keeps a rule in LZRDFNDR scripts' . ($allowed eq 'sandbox' ? ', and the site leaves the sandbox.' : '.');
    my $i = 0;
    window(map { my ($name, $where, $bytes, $who) = permit_named($site, @$_[0 .. 2]); my $info = $PERMIT_INFO{"$site $_->[1] $_->[2]"}; my $source = $info ? $info->{source} : '';
        'permitscript ' . join("\t", $i++, $name, $where, $bytes, $who, length $source, MIME::Base64::encode_base64($source, '')) } @items);    # [C26] each script with its source, shown in the question as text that never runs
    my $press = asked("permit $site\t$words", 'Deny Once', 'Deny Always', 'Allow Once', 'Always Allow');
    if ($press == 1 || $press == 2) {
        $PERMIT_DENIED{$site}{''} = 1 unless $allowed;    # not asked again on this visit
        $PERMIT_DENIED{$site}{permit_class($_->[0]) . " $_->[1] $_->[2]"} = 1 for @items;
        if ($press == 1) { noted("you did not allow the scripts of $host on this visit (Deny Once): nothing is kept, and the next visit asks again"); return 0 }
        my $date = strftime('%Y-%m-%d', gmtime);
        my $kept = !@items ? '' : permit_stored(sub {
            my ($rules, $memory) = @_;
            for my $item (@items) {
                my ($kind, $origin, $sha, $caps) = @$item;
                my $class = permit_class($kind);
                @$rules = grep { !($_->[1] eq $site && $_->[2] eq $class && $_->[3] eq $origin && $_->[4] eq $sha && !($memory && $_->[7] eq 'file')) } @$rules;
                push @$rules, ['deny', $site, $class, $origin, $sha, $caps, $date];
            }
            return 1;
        }) // '';
        my $said = !@items ? 'The page named no script to keep a deny rule for, so nothing is kept and the next visit asks again.' : $kept eq 'file' ? 'Kept as deny rules in LZRDFNDR scripts: they are not asked about again.' : $kept eq 'memory' ? ($INCOGNITO ? 'Kept in the memory of this incognito window only.' : kept_in() . "/scripts is not a file lzrprf reads, so the deny rule is kept in this window's memory only.") : 'The deny rule could not be written, so they are refused on this visit only.';
        noted("you denied the scripts of $host always: $said");
        idle($said);
        return 0;
    }
    $press -= 1;                          # Allow Once and Always Allow, as they were numbered before Deny Always stood beside Deny
    $PERMIT_NEXT{$site} = { keys => { %{ ($PERMIT_ONCE{$site} // {})->{keys} // {} }, map { (join(' ', @$_) => 1) } @items } };    # also after Always Allow: what could not be kept still runs on the reload
    my $kept = '';
    if ($press == 3 && @items) {
        my $date = strftime('%Y-%m-%d', gmtime);
        $kept = permit_stored(sub {
            my ($rules, $memory) = @_;
            for my $item (@items) {
                my ($kind, $origin, $sha, $caps) = @$item;
                my $class = permit_class($kind);    # the class of the kind asked: an Always for a script's code never lets it turn text into code
                my @caps = split /,/, $caps eq '-' ? '' : $caps;
                @$rules = grep {
                    my $same = $_->[1] eq $site && $_->[2] eq $class && $_->[3] eq $origin && $_->[4] eq $sha && !($memory && $_->[7] eq 'file');
                    push @caps, split /,/, $_->[5] eq '-' ? '' : $_->[5] if $same && $_->[0] eq 'always';
                    !$same;
                } @$rules;
                my %seen;
                my @all = grep { !$seen{$_}++ } sort @caps;
                push @$rules, ['always', $site, $class, $origin, $sha, @all > 32 ? $caps : join(',', @all) || '-', $date];
            }
            return 1;
        }) // '';
    }
    my $said = $press == 2 ? 'Allowed on this visit.' : !@items ? 'The page named no script to keep a rule for yet, so its scripts run on this visit, and what they ask is put to you again.' : $kept eq 'file' ? 'Kept in LZRDFNDR scripts.' : $kept eq 'memory' ? ($INCOGNITO ? 'Kept in the memory of this incognito window only.' : kept_in() . "/scripts is not a file lzrprf reads, so the rule is kept in this window's memory only.") : 'The rule could not be written, so they run on this visit only.';
    noted("you allowed the scripts of $host " . ($press == 2 ? 'once' : 'always') . ": $said");
    if ($PERMIT_ROUND >= $PERMIT_ROUNDS) { idle("$said Reload the page to run them."); return 0 }    # your Allow loaded this address again often enough in a row: the next is yours
    $PERMIT_RELOAD = $ask->{url};
    idle("$said lzrprf loads the page again.");
    return 1;
}

sub permits_later {                       # [C26] what a page kept running asked meanwhile, put to you after it answered; on an Allow it is loaded again
    return unless $PERMIT_ASK && (%{ $PERMIT_ASK->{items} } || $PERMIT_ASK->{refused});
    go($PERMIT_ASK->{url}, 'you reloaded') if permits_asked();
}

sub scripts_set {                         # [C26] [C4] Script permissions, from the cogwheel's menu: "list"; "revoke" and "set" (to always or deny) of the rule numbered $n in the list; "reset", every rule of yours removed; "e1" on or off; "curated" $n on or off. The list is told again after each
    my ($what, $n, $to) = @_;
    my $words = '';
    if ($what eq 'e1' || $what eq 'curated') { $words = scripts_layer($what, $n, $to) }    # E1's switch, or a curated rule's (E2)
    elsif ($what ne 'list') {
        my $date = strftime('%Y-%m-%d', gmtime);
        my $done = permit_stored(sub {
            my ($rules, $memory) = @_;
            if ($what eq 'reset') { my $had = @$rules; @$rules = $memory ? grep { $_->[7] eq 'file' } @$rules : (); return $had != @$rules || !$memory }
            return 0 unless $rules->[$n];
            if ($what eq 'revoke') { splice @$rules, $n, 1 } else { @{ $rules->[$n] }[0, 6] = ($to, $date) }
            return 1;
        });
        my $unread = (permit_rules())[1];
        $words = !$done ? ($INCOGNITO ? "$UNKEPT: a rule of the scripts file is not changed in it. Nothing was changed." : $unread ? kept_in() . '/scripts is not a file lzrprf reads, so it is not changed. Nothing was changed.' : 'Nothing was changed: that rule is no longer there, or the scripts file could not be written.')
            : $what eq 'reset' ? ($done eq 'memory' ? "Every script permission of this window's memory is removed." : 'Every script permission is removed.')
            : $what eq 'revoke' ? 'The rule is removed: its script is asked about again.'
            : "The rule now says $to.";
    }
    scripts_told();
    my ($rules) = permit_rules();
    return idle(length $words ? $words : 'LZRDFNDR scripts: ' . @$rules . (@$rules == 1 ? ' rule.' : ' rules.'));
}

sub scripts_layer {                       # [C26] [C4] a switch of Script permissions: "e1" on or off, the sandbox; "curated" N on or off, the curated rule numbered N in the list. Kept under the lock of the settings (sub permit_layers_kept). Returns what to say
    my ($what, $n, $to) = @_;
    my $lock = $INCOGNITO ? 1 : keep_lock();
    return 'Nothing was changed: the lock of the settings could not be taken.' unless $lock;
    my $layers = permit_layers();
    return kept_in() . '/scriptlayers is not a file lzrprf reads, so the sandbox and every curated rule stay off. Nothing was changed.' if $layers->{unread};
    my $rule;
    if ($what eq 'e1') { $layers->{e1} = $to eq 'on' ? 1 : 0 }
    else {
        $rule = curated()->{rules}[$n] or return 'Nothing was changed: that curated rule is no longer there.';
        if ($to eq 'off') { $layers->{off}{ $rule->{key} } = 1 } else { delete $layers->{off}{ $rule->{key} } }
    }
    my $kept = permit_layers_kept($layers) or return 'Nothing was changed: the file scriptlayers could not be written.';
    my $where = $kept eq 'memory' ? ' in this incognito window only' : '';
    return $what eq 'e1' ? ($to eq 'on' ? "The sandbox is on$where: a site's own scripts run in it until you keep a rule for the site." : "The sandbox is off$where: a site with no rule of yours runs no script until you allow it.")
        : "The curated rule for $rule->{origin} on $rule->{site} is $to$where.";
}

sub scripts_told {                        # [C26] the list page: "scripts begin", "scripts rule N<tab>always|deny<tab>SITE<tab>CLASS<tab>ORIGIN<tab>SHA256<tab>CAPS<tab>DATE<tab>file|memory" for each rule of yours (E3); "scripts e1 on|off" and "scripts sandbox NAME<tab>runs|asks|refused|off<tab>WORDS" for each line of the sandbox's table (E1); "scripts curated N<tab>on|off<tab>SITE<tab>CLASS<tab>ORIGIN<tab>IDENTITY<tab>CAPS<tab>REVIEWER<tab>DATE" for each curated rule in use, "scripts part SITE<tab>used|ignored<tab>WHY" for each part of the file and "scripts curatedwhy WHY" when none is used (E2); "scripts seen LAYER<tab>SITE<tab>WHAT<tab>SAID<tab>COUNT" for the newest decisions of E1 and E2; then "scripts end", or "scripts end unread" when a scripts file is there and not read
    my ($rules, $unread) = permit_rules();
    my $layers = permit_layers();
    my $curated = curated();
    my $n = 0;
    window('scripts begin', (map { 'scripts rule ' . join("\t", $_, @{ $rules->[$_] }) } 0 .. $#$rules),
        'scripts e1 ' . ($layers->{e1} ? 'on' : 'off'), (map { 'scripts sandbox ' . join("\t", @$_) } @PERMIT_SANDBOX),
        (map { 'scripts curated ' . join("\t", $n++, $layers->{all} || $layers->{off}{ $_->{key} } ? 'off' : 'on', @$_{qw(site class origin)}, "$_->{kind} $_->{id}", @$_{qw(caps reviewer reviewed)}) } @{ $curated->{rules} }),
        (map { 'scripts part ' . join("\t", @$_) } @{ $curated->{parts} }), (length $curated->{why} ? "scripts curatedwhy $curated->{why}" : ()),
        (map { 'scripts seen ' . join("\t", @$_) } @PERMIT_SEEN), 'scripts end' . ($unread ? ' unread' : ''));
}

# The filter lists [C27] (docs/filters.md). uBlock Origin's
# uAssets lists, kept byte for byte in lzrprf's repository in filters/ubo/
# under their own licence (GPL-3.0), and lzrprf's own reviewed exceptions,
# filters/local-exceptions.txt, reach a computer as files beside lzrprf that
# the release's signed manifest names, each on its own line: "ubo-NAME.txt"
# for a list, "ubo-SOURCE" for the record of where they came from, and
# "filters-local.txt". lzrprf reads them only when the manifest is in its one
# form, its approval and its signature hold, it is of the application's
# release, and every list beside lzrprf is the file it names by SHA-256: as
# for the curated rules, and checked by the same subs. Anything else, and
# nothing is filtered; Filters in the cogwheel's menu says why. lzrprf is a
# generic interpreter of the published filter syntax: it reads the lists as
# data, holds no code of uBlock Origin, and does what this part says with
# each line, nothing else:
#   - a network rule (an address pattern with ||, |, ^ and *, and the options
#     of a type, of party, $domain= and $important) blocks a request it
#     matches, and an exception (@@) matches the same way and means only that
#     the request is not blocked. A blocking rule with $important wins over
#     an exception without it;
#   - every other line is counted by its kind and never used: cosmetic rules
#     (lzrprf has no place of its own to give a page styles: the =sheets
#     frame carries only the page's own sheets), scriptlets (+js) and other
#     code, procedural and HTML rules, regular expressions, $redirect,
#     $removeparam, $csp and every option lzrprf does not read, conditional
#     parts (!#if) and the lines in them, and a line that looks like a
#     permission (a line of the scripts file, of scriptlayers or of a curated
#     rule, or an option that names one), which no filter line can be.
# A request is held to the lists after [C23] and before [C26], before any
# name is looked up; a request a filter blocks is never fetched, and nothing
# a filter decides changes what [C26] decides about a script. The rules are
# indexed when the lists are read, once a window: a rule anchored at a whole
# host by that host, any other by its longest token that a request's address
# must hold, and the few with no such token are read for every request.
sub filters {                             # [C27] the filter lists, read and checked once a window: {lists => [{name, rules, counts}], host => {HOST => [entry]}, token => {TOKEN => [entry]}, loose => [entry], counts => {KIND => N}, commit, ms, why => why nothing is filtered}
    return $FILTERS if $FILTERS;
    my $began = now();
    $FILTERS = filter_empty();
    my $no = sub { my $why = $_[0]; $FILTERS = filter_empty(); $FILTERS->{why} = $why; return $FILTERS };
    my %text;
    for my $name ('release.manifest', 'release.manifest.sig', 'release.manifest.approval') {
        my ($got, $why) = beside_read($name, $name eq 'release.manifest' ? $MANIFEST_MOST : $SIGNATURE_MOST);
        return $no->("$why, so nothing is filtered") unless defined $got;
        $text{$name} = $got;
    }
    my ($manifest, $why) = manifest_read($text{'release.manifest'});
    return $no->("release.manifest: $why, so nothing is filtered") unless $manifest;
    my @named = sort grep { /\Aubo-[a-z0-9][a-z0-9.-]{0,47}\.txt\z/ || $_ eq 'filters-local.txt' } keys %{ $manifest->{files} };
    return $no->('the signed manifest names no filter list, so nothing is filtered') unless @named;
    return $no->("the signed manifest names more than $FILTER_LISTS filter lists, so nothing is filtered") if @named > $FILTER_LISTS;
    return $no->('the manifest is not approved with an approval key lzrprf carries, so nothing is filtered') unless signature_holds($text{'release.manifest'}, $text{'release.manifest.approval'}, $APPROVAL_NAMESPACE, 'ECDSA', approval_keys());
    return $no->('the signature of the manifest does not hold for the release key lzrprf carries, so nothing is filtered') unless signature_holds($text{'release.manifest'}, $text{'release.manifest.sig'}, $RELEASE_NAMESPACE, 'ED25519', release_key());
    my ($release) = beside();
    return $no->('the application\'s release file names no release, so lzrprf cannot tell the manifest is of this one, and nothing is filtered') if !defined $release && (release_lines() || $PROGRAM =~ m{\.app/Contents/MacOS/});
    return $no->("the manifest is of release $manifest->{release}, and the application is release $release, so nothing is filtered") if defined $release && $release != $manifest->{release};
    for my $name (@named, exists $manifest->{files}{'ubo-SOURCE'} ? 'ubo-SOURCE' : ()) {
        my ($got, $unread) = beside_read($name, $FILTER_BYTES);
        return $no->("$unread, so nothing is filtered") unless defined $got;
        return $no->("$name is another file than the signed manifest names, so nothing is filtered") unless Digest::SHA::sha256_hex($got) eq $manifest->{files}{$name};
        $text{$name} = $got;
    }
    ($FILTERS->{commit}) = ($text{'ubo-SOURCE'} // '') =~ /^commit ([0-9a-f]{40})$/m;
    filter_list_read($_, $text{$_}) for @named;
    $FILTERS->{ms} = int((now() - $began) * 1000);
    return $FILTERS;
}

sub filter_empty { return { lists => [], host => {}, token => {}, loose => [], parsed => {}, counts => {}, commit => undef, ms => 0, why => '' } }    # [C27] lists that filter nothing

sub beside_read {                         # [C25] one file beside lzrprf, of at most $most bytes, a plain file of yours: its bytes, or nothing and why
    my ($name, $most) = @_;
    my $file = "$ROOT/$name";
    sysopen(my $in, $file, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return (undef, -l $file || -e $file ? "$file is not a plain file of yours" : "there is no $name beside lzrprf");
    my @is = stat $in;
    return (undef, "$file is not a plain file of yours") unless @is && -f _ && $is[3] == 1 && $is[4] == $<;
    return (undef, "$file is larger than lzrprf reads") if $is[7] > $most;
    my $got = '';
    while (1) { my $n = sysread($in, $got, 65536, length $got); return (undef, "$file could not be read") unless defined $n; last unless $n; return (undef, "$file is larger than lzrprf reads") if length $got > $most }
    return ($got);
}

sub filter_list_read {                    # [C27] one list, each line read once: a network rule or exception indexed, every other line counted by its kind (see above)
    my ($name, $text) = @_;
    my $k = @{ $FILTERS->{lists} };
    my %counts;
    push @{ $FILTERS->{lists} }, { name => $name, counts => \%counts };
    my $depth = 0;                        # inside a conditional part (!#if), whose condition lzrprf does not weigh: its lines are not used, on either side of its !#else
    for my $line (split /\n/, $text) {
        $line =~ s/[ \t\r]+\z//;
        next if $line eq '' || $line =~ /\A\[/;    # a header such as [Adblock Plus 2.0]
        if (substr($line, 0, 1) eq '!') {
            if ($line =~ /\A!#if\b/) { $depth++ } elsif ($line =~ /\A!#endif\b/) { $depth-- if $depth } elsif ($line =~ /\A!#include\b/) { $counts{include}++ }
            next;                         # a comment
        }
        next if $line =~ /\A#(?: |\z)/;   # a comment in the form of a hosts file
        if ($depth) { $counts{conditional}++; next }
        my ($kind, $entry, $key) = filter_line($line);
        $counts{$kind}++;
        next unless defined $entry;
        $entry = "$k $entry";
        if ($key =~ s/\Ah://) { push @{ $FILTERS->{host}{$key} }, $entry }
        elsif ($key =~ s/\At://) { push @{ $FILTERS->{token}{$key} }, $entry }
        else { push @{ $FILTERS->{loose} }, $entry }
    }
    $FILTERS->{counts}{$_} += $counts{$_} for keys %counts;
    return;
}

my %FILTER_TYPE = (script => 'script', image => 'image', stylesheet => 'stylesheet', css => 'stylesheet', font => 'font', media => 'media', subdocument => 'subdocument', frame => 'subdocument', xmlhttprequest => 'xmlhttprequest', xhr => 'xmlhttprequest', websocket => 'websocket', other => 'other');    # [C27] the types of request an option may name, by each name the syntax gives them
my %FILTER_PERMITS = map { $_ => 1 } qw(permit permits permitted permissions allow allowed allow-script run exec execute grant trusted caps capabilities always);    # [C27] option names that would read as a permission: a line that carries one is refused, never used
my %FILTER_SKIPPED = (redirect => 'redirect', 'redirect-rule' => 'redirect', rewrite => 'redirect', removeparam => 'removeparam', queryprune => 'removeparam', csp => 'csp');    # [C27] options lzrprf does not do, each counted by its own kind

sub filter_line {                         # [C27] one line of a list: its kind, and for a network rule or exception the entry kept and its index key ("h:HOST", "t:TOKEN" or "" for none)
    my ($line) = @_;
    return 'permission' if $line =~ /\A(?:always|deny)\t|\Alzrprf permit|\A(?:e1 off|curated off\t)|\A(?:rule|end)\z|\A(?:site|script-origin|script|class|caps|justification|source|reviewer|reviewed) [^#\$]/i;    # [C27] a line of the scripts file, of scriptlayers or of a curated rule: no permission is read from a filter list
    if ($line =~ /\A([^\/\$|^@#\s]*)(#@?[?\$%]?#)(.*)\z/) {    # a cosmetic rule, or code, after its hosts
        my ($sep, $rest) = ($2, $3);
        return index($sep, '%') >= 0 || $rest =~ /\A\+js\(/ ? 'scriptlet' : $rest =~ /\A\^/ ? 'html' : index($sep, '?') >= 0 ? 'procedural' : index($sep, '$') >= 0 ? 'style'
            : $rest =~ /:(?:has-text|has|xpath|matches-css(?:-before|-after)?|matches-attr|matches-path|matches-media|matches-prop|min-text-length|others|remove|remove-attr|remove-class|style|upward|watch-attr|-abp-[a-z-]+)\(/ ? 'procedural' : 'cosmetic';
    }
    $line = "||$2^" if $line =~ /\A(?:0\.0\.0\.0|127\.0\.0\.1)([ \t]+)([A-Za-z0-9.-]+)\z/;    # a line of a hosts file: its host
    my $except = $line =~ s/\A@@//;
    my ($pattern, $options) = filter_split($line);
    my $kind = $except ? 'exception' : 'network';
    return 'unsupported' if $pattern =~ /\s/;
    for my $option (length $options ? split(/,/, $options) : ()) {
        my ($word, $value) = $option =~ /\A~?([a-z0-9_-]+)(?:=(.*))?\z/i or return 'unsupported';
        $word = lc $word;
        return 'permission' if $FILTER_PERMITS{$word};
        return $FILTER_SKIPPED{$word} if $FILTER_SKIPPED{$word};
        next if $FILTER_TYPE{$word} || $word =~ /\A(?:all|third-party|3p|first-party|1p|important|match-case)\z/;
        return 'document' if $word =~ /\A(?:doc|document|popup|popunder)\z/;    # a page you open, not a request of one: lzrprf does not filter what you open
        next if ($word eq 'domain' || $word eq 'from') && defined $value && $value =~ /\A~?[a-z0-9.-]+(?:\|~?[a-z0-9.-]+)*\z/i;
        $FILTERS->{options}{$word}++;
        return 'unsupported';             # a type lzrprf never asks for ($ping, $object), a part of a page ($ghide, $elemhide), $badfilter, a domain by a pattern, and every other option
    }
    return 'regex' if $pattern =~ m{\A/.+/\z};    # a regular expression: not matched, rather than matched in a way lzrprf cannot hold fast and safe
    return 'unsupported' if $pattern eq '' || $pattern eq '*' || $pattern !~ /\A[\x21-\x7e]+\z/;
    my $p = lc $pattern;
    $p = "||$p^" if $p =~ /\A[a-z0-9-]+(?:\.[a-z0-9-]+)+\z/ && $p =~ /[a-z]/ && $p !~ /\A[0-9.]+\z/;    # a host alone, as a hosts file names one
    my $entry = ($except ? '@@' : '') . ($p eq lc $pattern ? $pattern : $p) . (length $options ? "\$$options" : '');
    return ($kind, $entry, "h:$1") if $p =~ /\A\|\|([a-z0-9](?:[a-z0-9.-]*[a-z0-9])?)(?=[\^\/:]|\z)/;    # anchored at a whole host
    return ($kind, $entry, filter_token($p));
}

sub filter_split { return $_[0] =~ /\A(.*)\$(~?[A-Za-z0-9_-]+(?:[=,].*)?)\z/s ? ($1, $2) : ($_[0], '') }    # [C27] a rule's pattern and its options, after its last "$" that begins an option: a "$" inside a value or a pattern is no start of options

sub filter_token {                        # [C27] the index key of a pattern that names no whole host: its longest token that a matching address must hold whole, or "" when it has none
    my ($p) = @_;
    my ($best, $at) = ('', 0);
    while ($p =~ /([a-z0-9]+)/g) {
        my ($token, $from, $to) = ($1, $-[1], $+[1]);
        my $before = $from ? substr($p, $from - 1, 1) : '';
        my $after = $to < length $p ? substr($p, $to, 1) : '';
        my $left = $from == 0 ? 0 : $before eq '*' ? 0 : $before eq '|' ? ($from == 1 || substr($p, 0, 2) eq '||' && $from == 2) : 1;
        my $right = $after eq '' ? 0 : $after eq '*' ? 0 : $after eq '|' ? $to == length($p) - 1 : 1;
        next unless $left && $right && length $token >= 2;
        my $score = $token =~ /\A(?:https?|www|com|net|org|js|html?|php|png|gif|jpe?g)\z/ ? 1 : length $token;    # a token nearly every address holds narrows nothing
        ($best, $at) = ($token, $score) if $score > $at;
    }
    return length $best ? "t:$best" : '';
}

sub filter_rule {                         # [C27] an entry made into what a request is held to, once: {x => an exception, imp, types, not, party, on, off, host => a whole host and nothing else, re}; or nothing for an entry no request matches
    my ($entry) = @_;
    my $parsed = $FILTERS->{parsed};
    return $parsed->{$entry} if exists $parsed->{$entry};
    my ($line) = $entry =~ /\A[0-9]+ (.*)\z/s;
    my %r = (x => $line =~ s/\A@@// ? 1 : 0, party => '');
    my ($pattern, $options) = filter_split($line);
    my $case = 0;
    for my $option (length $options ? split(/,/, $options) : ()) {
        my ($not, $word, $value) = $option =~ /\A(~?)([a-z0-9_-]+)(?:=(.*))?\z/i;
        $word = lc $word;
        if ($FILTER_TYPE{$word}) { $not ? ($r{not}{ $FILTER_TYPE{$word} } = 1) : ($r{types}{ $FILTER_TYPE{$word} } = 1) }
        elsif ($word eq 'third-party' || $word eq '3p') { $r{party} = $not ? '1p' : '3p' }
        elsif ($word eq 'first-party' || $word eq '1p') { $r{party} = $not ? '3p' : '1p' }
        elsif ($word eq 'all') { }       # every type: as no type named
        elsif ($word eq 'important') { $r{imp} = 1 }
        elsif ($word eq 'match-case') { $case = 1 }
        elsif ($word eq 'domain' || $word eq 'from') { for (split /\|/, lc $value) { s/\A~// ? ($r{off}{$_} = 1) : ($r{on}{$_} = 1) } }
        else { return $parsed->{$entry} = undef }
    }
    if (!$case && $pattern =~ /\A\|\|([a-z0-9](?:[a-z0-9.-]*[a-z0-9])?)\^?\z/i) { $r{host} = 1 }    # ||HOST or ||HOST^: the host index found it, nothing more to match
    else {
        my $re = join '', map { $_ eq '*' ? '.*' : $_ eq '^' ? '(?:[^A-Za-z0-9_.%-]|\z)' : quotemeta } $pattern =~ /(\*|\^|[^*^]+)/g;
        $re =~ s/\A\\\|\\\|/\\A[a-z][a-z0-9+.-]*:\/\/(?:[^\/?#]*\\.)?/ or $re =~ s/\A\\\|/\\A/;
        $re =~ s/\\\|\z/\\z/;
        $r{re} = eval { $case ? qr/$re/ : qr/$re/i } // return $parsed->{$entry} = undef;
    }
    return $parsed->{$entry} = \%r;
}

sub filter_party { my @labels = split /\./, $_[0]; return $_[0] if @labels <= 2; my $n = length $labels[-1] == 2 && $labels[-2] =~ /\A(?:co|com|net|org|gov|edu|ac|or|ne|go|nic|ltd|plc|sch)\z/ ? 3 : 2; return join '.', @labels[-$n .. -1] }    # [C27] the site a host belongs to, for first and third party: its last two labels, or three under a country's own second level (co.uk); no list of public suffixes is held

sub filter_up { my ($host) = @_; my @up = ($host); push @up, $host while $host =~ s/\A[^.]*\.(?=.)//; return @up }    # [C27] a host and every name it stands under: a.b.example.com, b.example.com, example.com, com

sub filtered {                            # [C27] what the lists say of one request of a page: (the entry that blocks it, or nothing; the exception that matched, or nothing). TYPE is one of %FILTER_TYPE's; the page is its host
    my ($url, $type, $page) = @_;
    my $f = filters();
    return if length $f->{why};
    my ($host) = $url =~ m{\Ahttps?://([^/?#:]+)}i or return;
    $host = lc $host;
    $page = lc($page // '');
    my $layers = filter_layers();
    return if $layers->{allow}{"https://$page\t$host"};
    my $lower = lc $url;
    my $third = filter_party($host) ne filter_party($page);
    my @pages = filter_up($page);
    my (%seen, $block, $vital, $except, $vital_except);
    my %token = map { $_ => 1 } $lower =~ /[a-z0-9]+/g;
    for my $entry (map({ @{ $f->{host}{$_} // [] } } filter_up($host)), map({ @{ $f->{token}{$_} // [] } } keys %token), @{ $f->{loose} }) {
        next if $seen{$entry}++;
        my ($k) = $entry =~ /\A([0-9]+) /;
        next if $layers->{off}{ $f->{lists}[$k]{name} };
        my $r = filter_rule($entry) or next;
        next if $r->{types} && !$r->{types}{$type} || $r->{not} && $r->{not}{$type};
        next if $r->{party} eq '3p' && !$third || $r->{party} eq '1p' && $third;
        next if $r->{on} && !grep({ $r->{on}{$_} } @pages) || $r->{off} && grep({ $r->{off}{$_} } @pages);
        next unless $r->{host} || $url =~ $r->{re};
        if ($r->{x}) { $except //= $entry; $vital_except //= $entry if $r->{imp} } elsif ($r->{imp}) { $vital //= $entry } else { $block //= $entry }
    }
    return ($vital && !$vital_except ? $vital : $block && !$except ? $block : undef, $except);
}

sub filter_named { my ($entry) = @_; my ($k, $line) = $entry =~ /\A([0-9]+) (.*)\z/s; return ($line =~ s/[^\x20-\x7e]/?/gr =~ s/\A(.{200}).+\z/$1.../sr, $FILTERS->{lists}[$k]{name}) }    # [C27] an entry as it is said: its line, printable and at most 200 characters, and its list

sub filter_said {                         # [C27] why a request of a page is not fetched, when a filter list blocks it: words for the log and the window, and the request kept for Filters; or nothing
    my ($url, $type, $page) = @_;
    my ($by) = filtered($url, $type, $page);
    return unless $by;
    my ($rule, $list) = filter_named($by);
    unshift @FILTER_SEEN, [lc $page, $url =~ s/[^\x20-\x7e]//gr =~ s/\A(.{300}).+\z/$1/sr, $type, $rule, $list];
    splice @FILTER_SEEN, $FILTER_SEEN_MOST if @FILTER_SEEN > $FILTER_SEEN_MOST;
    return "the filter rule $rule of $list blocks it";
}

# Your filter switches, in the plain file filterlayers of yours, one a line:
# "list off TAB NAME" switches one list off, and "allow TAB SITE TAB HOST"
# lets the requests of pages of SITE to HOST through every list. No file
# means every list is on and nothing is let through; the file is written only
# while something is switched off or let through. A file that does not read
# switches nothing off and lets nothing through, and Filters says so. An
# incognito window reads it and keeps what is chosen in it in its memory only.
sub filter_layers {                       # [C27] {off => {NAME => 1}, allow => {"SITE TAB HOST" => 1}, unread => 1 when a file is there that does not read}
    return { off => { %{ $HELD_FILTER_LAYERS->{off} } }, allow => { %{ $HELD_FILTER_LAYERS->{allow} } }, unread => 0 } if $HELD_FILTER_LAYERS;
    my $file = kept_in() . '/filterlayers';
    my %layers = (off => {}, allow => {}, unread => 0);
    my $bad = { off => {}, allow => {}, unread => 1 };
    sysopen(my $in, $file, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return -l $file || -e _ ? $bad : \%layers;
    my @is = stat $in;
    my $text = '';
    return $bad unless @is && -f _ && $is[3] == 1 && $is[4] == $< && $is[7] <= $PERMIT_FILE_BYTES && defined sysread($in, $text, $PERMIT_FILE_BYTES + 1) && length $text <= $PERMIT_FILE_BYTES && ($text eq '' || $text =~ /\n\z/);
    for (split /\n/, $text) {
        if (/\Alist off\t((?:ubo-[a-z0-9][a-z0-9.-]{0,47}|filters-local)\.txt)\z/) { $layers{off}{$1} = 1; next }
        my ($key) = /\Aallow\t(https:\/\/$NAME\t$NAME)\z/ or return $bad;
        return $bad if keys %{ $layers{allow} } >= $FILTER_ALLOWS;
        $layers{allow}{ lc $key } = 1;
    }
    return \%layers;
}

sub filter_layers_kept {                  # [C27] the switches written as $layers says, under the lock of the settings: the file removed when nothing is switched; in an incognito window held in its memory. Returns "file" or "memory", or nothing when it could not be written
    my ($layers) = @_;
    if ($INCOGNITO) { $HELD_FILTER_LAYERS = { off => { %{ $layers->{off} } }, allow => { %{ $layers->{allow} } } }; return 'memory' }
    my $file = "$DIR/filterlayers";
    my @lines = ((map { "list off\t$_" } sort keys %{ $layers->{off} }), map { "allow\t$_" } sort keys %{ $layers->{allow} });
    if (!@lines) { return 'file' unless -e $file || -l $file; unlink $file or return; synced(); return 'file' }
    unlink "$file.new";
    unless (put("$file.new", O_EXCL, @lines) && rename("$file.new", $file)) { unlink "$file.new"; return }
    synced();
    return 'file';
}

sub filters_set {                         # [C27] [C4] Filters, from the cogwheel's menu: "list"; "switch" N on or off, the list numbered N; "allow" N, the host of the blocked request numbered N on its page's site; "revoke" N, what you let through numbered N. The page is told again after each
    my ($what, $n, $to) = @_;
    my $words = '';
    if ($what ne 'list') {
        my $lock = $INCOGNITO ? 1 : keep_lock();
        $words = !$lock ? 'Nothing was changed: the lock of the settings could not be taken.' : filter_changed($what, $n, $to);
    }
    filters_told();
    my $f = filters();
    return idle(length $words ? $words : length $f->{why} ? "Filters: nothing is filtered: $f->{why}." : 'Filters: ' . @{ $f->{lists} } . (@{ $f->{lists} } == 1 ? ' list.' : ' lists.'));
}

sub filter_changed {                      # [C27] one switch of Filters made and kept (sub filter_layers_kept); what to say
    my ($what, $n, $to) = @_;
    my $layers = filter_layers();
    return kept_in() . '/filterlayers is not a file lzrprf reads, so no list is off and nothing is let through. Nothing was changed.' if $layers->{unread};
    my $said;
    if ($what eq 'switch') {
        my $list = filters()->{lists}[$n] or return 'Nothing was changed: that list is no longer there.';
        if ($to eq 'off') { $layers->{off}{ $list->{name} } = 1 } else { delete $layers->{off}{ $list->{name} } }
        $said = "The list $list->{name} is $to";
    }
    elsif ($what eq 'allow') {
        my $seen = $FILTER_SEEN[$n] or return 'Nothing was changed: that request is no longer in the list.';
        my ($host) = $seen->[1] =~ m{\Ahttps?://([^/?#:]+)}i;
        return 'Nothing was changed: that request names no host lzrprf lets through.' unless defined $host && $host =~ /\A$NAME\z/ && $seen->[0] =~ /\A$NAME\z/;
        return "Nothing was changed: you let through more than $FILTER_ALLOWS hosts already." if keys %{ $layers->{allow} } >= $FILTER_ALLOWS;
        $layers->{allow}{ lc "https://$seen->[0]\t$host" } = 1;
        $said = "The requests of pages of https://$seen->[0] to " . lc($host) . ' are let through every list';
    }
    else {
        my $key = (sort keys %{ $layers->{allow} })[$n] // return 'Nothing was changed: that is no longer let through.';
        delete $layers->{allow}{$key};
        $said = 'The requests of pages of ' . ($key =~ s/\t/ to /r) . ' are held to the lists again';
    }
    my $kept = filter_layers_kept($layers) or return 'Nothing was changed: the file filterlayers could not be written.';
    return $said . ($kept eq 'memory' ? ' in this incognito window only.' : '.');
}

sub filters_told {                        # [C27] the list page: "filters begin"; "filters state on<tab>MS" or "filters state off<tab>WHY"; "filters list N<tab>on|off<tab>NAME<tab>RULES<tab>SKIPPED" for each list; "filters commit HEX" of the upstream lists; "filters count KIND<tab>N" for each kind of line; "filters allow N<tab>SITE<tab>HOST<tab>file|memory"; "filters seen N<tab>PAGE<tab>ADDRESS<tab>TYPE<tab>RULE<tab>LIST", the newest first; then "filters end" or "filters end unread"
    my $f = filters();
    my $layers = filter_layers();
    my @allow = sort keys %{ $layers->{allow} };
    my $where = $INCOGNITO ? 'memory' : 'file';
    my $current = $SHOWN ? lc($SHOWN->{host} // '') : '';
    window('filters begin', 'filters state ' . (length $f->{why} ? "off\t$f->{why}" : "on\t$f->{ms}"),
        (map { my $c = $f->{lists}[$_]{counts}; 'filters list ' . join("\t", $_, $layers->{off}{ $f->{lists}[$_]{name} } ? 'off' : 'on', $f->{lists}[$_]{name}, ($c->{network} // 0) + ($c->{exception} // 0), filter_skipped($c)) } 0 .. $#{ $f->{lists} }),
        (defined $f->{commit} ? "filters commit $f->{commit}" : ()), (map { "filters count $_\t$f->{counts}{$_}" } sort keys %{ $f->{counts} }),
        (map { 'filters allow ' . join("\t", $_, split(/\t/, $allow[$_]), $where) } 0 .. $#allow),
        (map { 'filters seen ' . join("\t", $_, ($FILTER_SEEN[$_][0] eq $current ? 'current' : 'recent'), @{ $FILTER_SEEN[$_] }) } 0 .. $#FILTER_SEEN), 'filters end' . ($layers->{unread} ? ' unread' : ''));
}

sub filter_skipped { my ($c) = @_; my $n = 0; $n += $c->{$_} for grep { $_ ne 'network' && $_ ne 'exception' } keys %$c; return $n }    # [C27] the lines of one list counted and not used

sub filters_dir {                         # [C27] "lzrprf filters DIR PAGE TYPE ADDRESS...": what the lists in DIR (every NAME.txt there, read unsigned) would do with each address as a request of TYPE from a page of the host PAGE. It decides nothing for a window: for a survey of sites and for selftest
    my ($dir, $page, $type, @urls) = @_;
    die "lzrprf: filters takes a folder, the host of a page, a type (" . join(' ', sort keys %FILTER_TYPE) . ") and addresses\n" unless -d $dir && $page =~ /\A$NAME\z/ && $FILTER_TYPE{$type} && @urls;
    $type = $FILTER_TYPE{$type};
    $HELD_FILTER_LAYERS = { off => {}, allow => {} };    # nothing of yours: no switch of any profile is read
    my $began = now();
    $FILTERS = filter_empty();
    opendir(my $in, $dir) or die "lzrprf: $dir cannot be read\n";
    my @names = sort grep { /\A[A-Za-z0-9][A-Za-z0-9._-]{0,63}\.txt\z/ && -f "$dir/$_" } readdir $in;
    for my $name (@names) { open(my $list, '<:raw', "$dir/$name") or die "lzrprf: $dir/$name cannot be read\n"; local $/; filter_list_read($name, <$list> // '') }
    my $loaded = now() - $began;
    my ($looked, $at) = (0, now());
    for my $url (@urls) {
        my ($by, $except) = filtered($url, $type, $page);
        print $by ? join("\t", 'blocked', filter_named($by)) : $except ? join("\t", 'excepted', filter_named($except)) : 'passed', "\t$url\n";
        $looked++;
    }
    my $took = now() - $at;
    print 'counts ', join(' ', map { "$_=$FILTERS->{counts}{$_}" } sort keys %{ $FILTERS->{counts} }), "\n";
    printf "took load_ms=%d lookups=%d lookup_us=%.1f loose=%d hosts=%d tokens=%d\n", $loaded * 1000, $looked, $looked ? $took * 1e6 / $looked : 0, scalar @{ $FILTERS->{loose} }, scalar keys %{ $FILTERS->{host} }, scalar keys %{ $FILTERS->{token} };
    return;
}

# A line of the window for the page kept running with the selected tab, in a
# form sub behind checked: "click X Y" in CSS pixels of the laid page, where
# the window found the pointer after its own scrolling, at most 200000 each
# way; "key NAME" or "key NAME shift"; "text TEXT", only while a text field of
# the page has the focus, of 1 to $LIVE_TEXT bytes of UTF-8 with no control
# or format character; "scroll T X Y", where the window shows the page of tab
# T from, in whole CSS pixels of the laid page, at most 200000 each way. The
# window says it after every drawing of the page shown, when the page is kept
# running ("live on") and as you scroll, at most once a frame; one for a tab
# that is not the selected one is passed over. Each page kept running is
# handed the first one it hears and then each one that differs from the last
# it was handed or told of itself (sub live_answered), so a page is told where
# it is shown once at its start and never told back its own scroll. Once
# lzrprf has sent the window a scroll of the page's own (sub
# live_scroll_told), every place the window says is passed over until it says
# that very place back: what it said before it read lzrprf's line is where it
# was, not where the page is. The window's next place after that echo, said
# within $LIVE_STOP_SECONDS of it, says where its view stopped (sub
# live_stopped): within a pixel of the page's place each way, it is where the
# page is and is not handed back; short of it by more on an axis, it is the
# window's end there: the page is handed it, and a place of the page's script
# past it on that axis is told only up to it, and not at all when the window
# shows that already, until you scroll elsewhere or click or press a key, the
# page is drawn at another height or the window's page changes size; so a
# page that scrolls past its end on every scroll is not answered once a frame,
# and a page that keeps to its bottom as it grows is still told its new bottom.
# The window is told a place of the page's own scroll at most once a frame
# ($LIVE_FRAME_SECONDS); one sooner waits, and only the newest.
# While the page has not answered a line yet, a
# scroll waits, and only the newest waits: a page that is slow to answer is
# not sent a line for every frame, and a click or key after it sends it
# first, in its order.
# Each is written to the page as "=click", "=key", "=text" or "=scroll", at
# most $LIVE_INPUT bytes, and nothing else ever is; a tab with no page kept
# running takes none.
sub live_input {                          # [C18]
    my ($what) = @_;
    return trmnl_input($what) if $TABS[$TAB]{trmnl};    # [C29] a terminal's tab: its keys go to its shell, in their fixed forms
    my $live = live_of($TABS[$TAB]) or return;
    return if $what =~ /^(?:click|scroll [0-9]+) ([0-9]+) ([0-9]+)$/ && ($1 > 200_000 || $2 > 200_000);
    if ($what =~ /^text (.*)\z/s) {
        my $text = $1;
        return unless $live->{focus} && utf8::decode($text) && $text !~ /[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\p{NChar}]|[^\x{0}-\x{10ffff}]/;
    }
    if ($what =~ /^scroll ([0-9]+) (.*)$/) {
        my ($tab, $at) = ($1, $2);
        return if $tab != $TAB;    # said of a tab the window showed before it heard lzrprf choose another
        if (defined $live->{scroll_sent}) { @$live{qw(scroll_echo scroll_echoed)} = (delete $live->{scroll_sent}, now()) if $at eq $live->{scroll_sent}; return }    # said before the window read the page's own scroll, or that scroll said back
        my ($echo, $echoed) = (delete $live->{scroll_echo}, delete $live->{scroll_echoed});
        my $stop = defined $echo && now() - $echoed <= $LIVE_STOP_SECONDS ? live_stopped($at, $echo) : undef;    # only the window's next place after its echo, and soon after it, says where its view stopped
        if ($stop && !grep { defined } @$stop) { $live->{scrolled} = $at; return }    # within a pixel of the page's own place each way: where the page is, not handed back to it
        if ($stop) { $live->{scroll_clamp} = $stop }    # the window could not show the page's place: it stopped short of it, at its own end, on these axes
        elsif ($live->{scroll_clamp} && $at ne ($live->{scrolled} // '')) { delete $live->{scroll_clamp} }    # you scrolled elsewhere: the page's places past the window's end may be told again
        return if ($live->{scrolled} // '') eq $at;    # what it was handed or told last: nothing new
        $live->{scrolled} = $at;
        if ($live->{waiting}) { $live->{scroll_held} = "scroll $at"; return }    # the newest scroll waits for the page's answer (sub live_answered)
        return live_wrote($live, "scroll $at");
    }
    delete @$live{qw(scroll_echo scroll_echoed scroll_clamp)};    # only the window's next place after its echo can say where it stopped short, and after a click or a key the page's places are told again
    live_wrote($live, delete $live->{scroll_held}) if defined $live->{scroll_held};    # a scroll that waits goes first: the lines keep their order
    return if $live->{ended};
    $live->{pressed} = now() if $what =~ /^(?:click |key (?!Escape(?: |\z)))/;    # [C12] a press of yours: the page may sound for $SOUND_PRESS_SECONDS after it (sub live_sound); Escape is none, as in the engine
    live_wrote($live, $what);
}

sub live_wrote {                          # [C18] preserve the order and any unwritten tail on a nonblocking relay
    my ($live, $what) = @_;
    my $line = "=$what\n";
    return unless length $line <= $LIVE_INPUT + 1;
    $live->{input_held} //= '';
    return live_end($live, 'it does not read what it is given') if length($live->{input_held}) + length($line) > 1_048_576;    # DECLARED(1 MiB of bounded pending input; an unresponsive page cannot grow the parent)
    $live->{input_held} .= $line;
    $live->{waiting}++;
    live_flushed($live);
    return;
}

sub live_flushed {                        # [C18] a short write is progress, EAGAIN waits for readiness, a closed reader ends the page
    my ($live) = @_;
    return unless length($live->{input_held} // '');
    my $took = syswrite($live->{relay}, $live->{input_held});
    if (defined $took && $took > 0) { substr($live->{input_held}, 0, $took, '') }
    elsif (defined $took || (!$!{EAGAIN} && !$!{EINTR})) { live_end($live, 'it does not read what it is given') }
}

sub live_stopped {                        # [C18] where the window's place $at stands to the page's place $wanted it said back, axis by axis: undef when it is past it either way by more than a pixel (you scrolled), else for x and y the window's place where it stopped short of the page's by more than a pixel, as a view at its end does, and undef where it is at it within a pixel
    my ($at, $wanted) = @_;
    my @at = split / /, $at;
    my @wanted = split / /, $wanted;
    my @short;
    for my $i (0, 1) {
        return undef if $at[$i] > $wanted[$i] + 1;
        push @short, $at[$i] < $wanted[$i] - 1 ? $at[$i] : undef;
    }
    return \@short;
}

sub live_scroll_told {                    # [C18] where the page's script scrolled it, to the window: just before its drawing, so the window shows the drawing from there and says nothing older; once a frame at most
    my ($live) = @_;
    return unless $live && defined $live->{scroll_unsent};
    return if now() < ($live->{scroll_told} // 0) + $LIVE_FRAME_SECONDS;    # told one a moment ago: this waits, newer ones take its place, and the loop of sub behind tells the newest once the frame is over (sub live_scroll_left)
    $live->{scroll_told} = now();
    $live->{scroll_sent} = delete $live->{scroll_unsent};
    window("scroll $TAB $live->{scroll_sent}");
}

sub live_scroll_back {                    # [C18] the line the window says when it says back the page's own scroll it was told last, of the tab shown, or '' when none is owed: kept while a question is open (sub asked)
    my $live = live_of($TABS[$TAB]);
    return $live && defined $live->{scroll_sent} ? "page scroll $TAB $live->{scroll_sent}" : '';
}

sub live_scroll_left {                    # [C18] the seconds until a place of the page's own scroll that waits may be told to the window, 0 when it may be now; nothing when none waits for the window
    my ($live) = @_;
    return undef unless defined $live->{scroll_unsent} && !$live->{ended} && $DRAWN && $live->{tab} == $TABS[$TAB];
    my $left = ($live->{scroll_told} // 0) + $LIVE_FRAME_SECONDS - now();
    return $left > 0 ? $left : 0;
}

# An answer of a page kept running, up to its line "=ready", each part only
# when there is one and in this order:
#
#   =focus 1|0          a text field of the page took the focus, or none has it now: whether text typed goes to it
#   =go ADDRESS         an address the page asks to go to: a link followed, or a form sent with GET; it is
#                       checked and fetched exactly as an address typed into the bar (sub go), in the tab shown
#   =statement WORDS    1 to 200 plain printable characters, shown in lzrprf's strip as plain text
#   =scroll X Y         its script scrolled the page: the window is told "scroll T X Y" and shows the page of tab T
#                       from X, Y CSS pixels (whole, 0 to 200000), and says nothing of it back as a scroll of yours;
#                       the page writes it only once the window has said where it shows it ("=scroll" above). It goes
#                       just before the drawing of the same answer; of answers with no drawing, only the newest of
#                       one turn goes, once the page is drawn in the window. A place of the window's that waited
#                       for this answer is then dropped, as older than it; with no =scroll it is handed now
#   =layers ITEMS       what of the page the window draws as layers of its own, moved by the page frame by frame
#                       without a drawing (src/page/layers.rs): one or more lines of at most $LAYERS_LINE bytes,
#                       each item checked in its form and against the layers the page made before (sub live_layer);
#                       their bytes are not counted in $LIVE_BYTES but against a budget of their own, $LAYERS_RATE
#                       a second with $LAYERS_BURST at once (sub live_layers_paid). The window is told
#                       "layers T ITEMS" for the tab shown; a tab not shown is told nothing, and once it is shown
#                       again its page is written "=layers" and tells every layer gone and makes it again
#   =sound ID RATE FRAMES FROM TO, =samples ID BASE64, =play ID AT, =hush ID
#                       the page's sound (src/page/sound.rs), after =layers and before =again, each line checked
#                       against the sounds the page made before (sub live_sound): a sound of FRAMES samples of 16
#                       bits at RATE a second, looping from FROM to TO or played once when both are 0, its samples
#                       in base64 on the =samples lines that follow; =play sounds it from frame AT, =hush silences
#                       it. Their bytes are not counted in $LIVE_BYTES but against $SOUND_BYTES of samples in the
#                       page's life. A =play goes to the sound process (sub sound_told) only within
#                       $SOUND_PRESS_SECONDS of a click or a key lzrprf handed the page, and only for the tab shown
#                       (sub live_sounded)
#   =again              then the page's lines, as a first list has them after its head: checked by sub checked
#                       with the first list's =pictures paths, =videos and U lines in front, at the width it was laid at,
#                       and drawn in place of the drawing before, its decoded pictures placed again
#
# A line before =again of the form "=NAME" or "=NAME WORDS" (NAME small letters,
# digits and "-", 1 to 32; WORDS printable, at most 8192 bytes) whose NAME is
# none that lzrprf knows is passed over: so an application may add a line a
# later lzrprf reads without its pages ending under this one. Only such a part
# of one line is passed over; a part of more lines ends the page, as any line
# of no form does. The first $LIVE_UNKNOWN_NAMES such NAMEs of one page kept
# running are written in the log once each, and then one line says there were
# more; what a page counted goes with it when it ends. Anything else, a line of no
# form, a known part out of its form or its order, a line that begins with "="
# among the lines after =again, or lines that sub checked does not let
# through, ends the page; its last good drawing stays. Nothing of an answer
# reaches the window before the whole of it was checked.
sub live_unknown {                        # a line of an answer lzrprf does not know, by its name: written in the log once for each page, for the first $LIVE_UNKNOWN_NAMES names
    my ($live, $name) = @_;
    my $seen = $live->{unknown} //= {};
    return if $seen->{$name};
    if (keys %$seen < $LIVE_UNKNOWN_NAMES) {
        $seen->{$name} = 1;
        return record("the page $live->{url} wrote a line lzrprf does not know, =$name; it is passed over, here and in every later answer of this page");
    }
    return if $live->{unknown_more}++;
    record("the page $live->{url} wrote lines of more names lzrprf does not know than the $LIVE_UNKNOWN_NAMES named; they are passed over and not named");
}

sub live_answered {                       # [C18]
    my ($live) = @_;
    while (!$live->{ended} && live_due($live)) {
        if (!defined $live->{whole} && !$live->{gone} && now() < $live->{until} && $live->{bytes} <= $LIVE_BYTES && ref(my $asked = live_asked($live))) {    # [C19] a request of the page, answered before anything it writes after it
            live_fetched($live, $asked);
            next;
        }
        return live_end($live, $live->{gone} ? 'it ended' : now() >= $live->{until} ? 'its time was over' : 'it wrote more than lzrprf takes') unless defined $live->{whole};
        my $at = delete $live->{whole};
        my $answer = $at < 0 ? '' : substr($live->{held}, 0, $at + 1);
        substr($live->{held}, 0, $at < 0 ? 7 : $at + 8, '');
        $live->{looked} = 0;
        $live->{waiting}-- if $live->{waiting};
        my @lines = split /\n/, $answer;
        my ($stage, $focus, $go, $words, $scroll, $shown, @layers, @sounds) = (0);
        my $before_shown = $live->{shown};
        while (@lines && $lines[0] ne '=again' && $lines[0] !~ /^=patch /) {
            my $line = shift @lines;
            if ($stage < 1 && $line =~ /^=focus ([01])$/) { ($stage, $focus) = (1, $1) }
            elsif ($stage < 2 && $line =~ /^=go ([\x21-\x7e]{1,8192})$/) { ($stage, $go) = (2, $1) }    # the longest the application writes (LONGEST_GO); sub address takes 2000 at most, and says so
            elsif ($stage < 3 && $line =~ /^=statement ([\x20-\x7e]{1,200})$/) { ($stage, $words) = (3, $1) }
            elsif ($stage < 4 && $line =~ /^=scroll (0|[1-9][0-9]{0,5}) (0|[1-9][0-9]{0,5})$/ && $1 <= 200_000 && $2 <= 200_000) { ($stage, $scroll) = (4, "$1 $2") }
            elsif ($stage <= 5 && $line =~ /^=layers ([\x20-\x7e]+)\z/ && length $line <= $LAYERS_LINE) {    # [C18] after =scroll and before =again, one line or more
                my $items = $1;
                $stage = 5;
                my $wrong = live_layers_paid($live, length($line) + 1);
                for my $item (split /;/, $items, -1) { last if $wrong; $wrong = live_layer($live, $item) }
                return live_end($live, "it wrote layers lzrprf does not take: $wrong") if $wrong;
                push @layers, $items;
            }
            elsif ($stage <= 6 && $line =~ /^=(?:sound|samples|play|hush) /) {    # [C12] after =layers and before =again
                $stage = 6;
                $live->{bytes} -= length($line) + 1;    # counted when read (sub live_read): a page's sound has its own budget
                my $wrong = live_sound($live, $line, \@sounds);
                return live_end($live, "it wrote a sound lzrprf does not take: $wrong") if $wrong;
            }
            elsif ($line =~ /^=([a-z0-9-]{1,32})(?: [\x20-\x7e]{0,8192})?$/ && !$LIVE_KNOWN{$1}) { live_unknown($live, $1) }    # a line of a later application: passed over
            else { return live_end($live, 'it wrote a line of no form') }
        }
        my $quick;                        # a splice checked by itself, and sent to the window as it came (sub live_patched)
        if (my $drawing = shift @lines) {    # a full snapshot or a splice into the previous checked snapshot
            my ($start, $drop) = $drawing =~ /^=patch (0|[1-9][0-9]{0,5}) (0|[1-9][0-9]{0,5})$/;
            if (defined $start && ($quick = live_patched($live, $start, $drop, \@lines))) { $shown = $live->{shown} }
            else {
                if ($drawing ne '=again') {
                    my $old = $live->{raw};
                    return live_end($live, 'it wrote an invalid drawing splice') unless defined($start) && $old && $start <= @$old && $drop <= @$old - $start;
                    @lines = (@$old[0 .. $start-1], @lines, @$old[$start+$drop .. $#$old]);
                    my $bytes = 0; $bytes += length($_) + 1 for @lines;
                    return live_end($live, 'its expanded drawing is too large') if @lines > $PIECES || $bytes > $PAGE_BYTES;
                }
                return live_end($live, 'it wrote a line of no form') if grep { /^=/ } @lines;
                my $list = join '', map { "$_\n" } '=page', @{ $live->{paths} } ? '=pictures ' . join(' ', @{ $live->{paths} }) : (), @{ $live->{videos} } ? '=videos ' . join(' ', @{ $live->{videos} }) : (), @{ $live->{made} }, @lines;
                my ($wide, $title) = ($LAID_WIDE, $TITLED);
                $LAID_WIDE = $live->{wide};
                my ($checked) = checked($list);    # [C9] the same checks as a first list
                ($LAID_WIDE, $TITLED) = ($wide, $title);
                return live_end($live, 'it drew a list that is not fit') unless $checked;
                $live->{tally} = $LAID_TALLY;    # what it holds, for the next splice checked by itself (sub live_patched)
                my $laid = ($lines[0] // '') =~ /^(L[0-9]+x[0-9]+)$/ ? $1 : '';
                delete $live->{scroll_clamp} if $laid ne ($live->{laid} // '');    # laid at another height: the page's end moved, so where the window stopped short says nothing now, and a page that keeps to its bottom is told its new bottom
                $live->{laid} = $laid;
                $live->{raw} = [@lines];
                delete $live->{raw_bytes};     # counted again for the next splice checked by itself
                ($shown) = pictured($checked, $live->{paths}, $live->{host}, undef, undef, $live->{pictures});    # its decoded pictures only: nothing is fetched
                $live->{plain} = $shown == $checked;    # no picture in it: what is shown is what was checked, line for line
                $live->{shown} = $shown;
                $live->{unsent} = 1;       # not yet in the window: a tab not shown keeps its old drawing there until it is chosen again (sub tab_shown)
            }
        }
        if (defined $scroll) { delete $live->{scroll_held} }    # the page's own scroll is newer than any place of the window's that waited for this answer: the window is told it and shows it, and the page is not handed the older place
        elsif (!$live->{waiting} && defined $live->{scroll_held}) { live_wrote($live, delete $live->{scroll_held}); return if $live->{ended} }    # the newest place that waited for this answer, once it was read
        $live->{focus} = $focus if defined $focus;
        if (defined $scroll && (my $end = $live->{scroll_clamp})) {    # past where the window stopped short, on an axis it stopped on: told, the window would stop short again and the page be handed that, once a frame
            my @to = split / /, $scroll;
            my @past = grep { defined $end->[$_] && $to[$_] > $end->[$_] } 0, 1;
            if (@past) {
                $to[$_] = $end->[$_] for @past;    # the window is told only what it can show
                $scroll = "$to[0] $to[1]";
                $scroll = undef if $scroll eq ($live->{scrolled} // '');    # nothing it does not show already
                record("the page $live->{url} scrolled past where the window can show it; the window is told no place past that until you scroll elsewhere") unless $live->{scroll_past_said}++;
            }
        }
        if (defined $scroll) { ($live->{scrolled}, $live->{scroll_unsent}) = ($scroll, $scroll) }    # what the window will show: not handed back to the page when the window says it
        if (@layers && $live->{tab} == $TABS[$TAB]) { window(map { "layers $TAB $_" } @layers) }    # [C18] onto the drawing shown, before a drawing of the same answer
        elsif (@layers) { $live->{layers_lost} = 1 }    # the window is shown another tab: this page's layers are made again once it is shown (sub live_layers_again)
        live_sounded($live, @sounds) if @sounds;    # [C12] a tab not shown sounds nothing
        next unless $live->{tab} == $TABS[$TAB];    # a tab not selected draws when it is chosen again (sub relaid), and follows no address
        if ($shown) { live_scroll_told($live); $quick ? window("patch $TAB @$quick[0, 1]", @{ $quick->[2] }, '.') : live_window_patch($before_shown, $shown); $live->{unsent} = 0; $DRAWN = 1 }    # where it was read in the page is kept, and where its script scrolled it goes just before
        live_told();
        window('home ready') if @layers && $live->{home} && !$live->{home_ready}++;
        idle($words) if defined $words;
        if (defined $go && (($go eq $LZRDFNDR_OPEN && $live->{url} =~ $LZRDFNDR_PAGE) || ($live->{home} && $go =~ m{\Ahttps://lzrbrwsr\.invalid/_home/lzrdfndr(?:-other)?\z}))) { noted("the game page asked for LZRDFNDR's panel; it was opened, and nothing was fetched"); game_helper_set(1, 1) if $live->{home}; window('tool show' . ($go =~ /-other\z/ ? ' other' : '')); undef $go }    # [C26] its Activate LZRDFNDR button, or Setup LZRDFNDR (".../lzrdfndr-other": on the panel's Other tab): the page stays, and the window opens the panel as a press on its icon does
        if ($live->{home} && defined $go) {
            if ($go =~ m{^https://lzrbrwsr\.invalid/_home/(search|marks|tabs|new|trmnl)$} && now() - ($live->{pressed} // 0) <= 1) { $1 eq 'trmnl' ? ($TRMNL_OPEN = 1) : window("homeaction $1") }    # [C29] the terminal icon: lzrprf opens it itself, within a second of your press
            undef $go;    # a local home never follows an address, even if its program asks
        }
        return go($go, 'you followed the page to') if defined $go;    # [C4] a visit like a typed address; it ends this page first (sub visit)
    }
    live_scroll_told($live) if !$live->{ended} && $DRAWN && $live->{tab} == $TABS[$TAB];    # of the answers of this turn with no drawing, the newest scroll only, and only onto a drawing the window shows
}


# The layers of a page kept running (src/page/layers.rs; how-it-works.md,
# "Layers of a page kept running"). Each item of a "=layers" line is one of
#
#   n ID P g | n ID P k X Y W H | n ID P s FILL STROKE WIDTH CAP RULE GLOWC GLOWR PATH
#   n ID P t SIZE WEIGHT STRETCH ANCHOR COLOR SPACING GLOWC GLOWR TEXT
#   n ID P e COLOR RATE LIFE SPEED SPREAD ANGLE AX AY SIZE
#   m ID A B C D E F | o ID ALPHA | d ID PATH | f ID FILL STROKE WIDTH GLOWC GLOWR
#   c ID TEXT | r ID RATE | x ID
#
# An id is 1 to 9999. "n" makes a layer of an id not in use, under a group
# (g or k) that is, or under the page (0); every other item names a layer
# that is, and only of the kind it changes (d of a shape; f of a shape or a
# text, whose STROKE is then -; c of a text; r of a particle source). "x"
# takes the layer and all it holds. At most $LAYERS_MOST layers at once and
# $LAYERS_EMITTERS particle sources; a source's RATE is 0 to 1000 a second,
# LIFE 0 to 10 seconds, SPEED 0 to 2000, SPREAD 0 to 6.2832, SIZE 0 to 64;
# an opacity is 0 to 1; a PATH at most $LAYERS_PATH bytes. Anything else ends
# the page.
sub live_layer {                          # [C18] one item of a "=layers" line, against the layers the page made: '' when it is fit, else what is wrong with it
    my ($live, $item) = @_;
    my ($n, $c, $kind) = ($LAYER_NUM, $LAYER_COLOUR, $live->{layer_kind} //= {});
    if ($item =~ /^n ([1-9][0-9]{0,3}) (0|[1-9][0-9]{0,3}) (.*)\z/s) {
        my ($id, $parent, $rest, $is) = ($1, $2, $3);
        return "layer $id is made twice" if $kind->{$id};
        return "layer $id is made under no group" unless $parent == 0 || ($kind->{$parent} // '') =~ /^[gk]\z/;
        return 'more layers than lzrprf takes' if keys %$kind >= $LAYERS_MOST;
        if ($rest eq 'g') { $is = 'g' }
        elsif ($rest =~ /^k $n $n $n $n\z/) { $is = 'k' }
        elsif ($rest =~ /^s $c $c $n [brs] [ne] $c $n ($LAYER_PATH)\z/ && length $1 <= $LAYERS_PATH) { $is = 's' }
        elsif ($rest =~ /^t $n [1-9] [nw] [sme] [0-9a-f]{8} $n $c $n $LAYER_TEXT\z/) { $is = 't' }
        elsif ($rest =~ /^e [0-9a-f]{8} ($n) ($n) ($n) ($n) $n $n $n ($n)(?: ($n) ($n) ($n))?\z/ && (!defined $6 || abs($6) <= 10 && abs($7) <= 10 && abs($8) <= 10) && $1 >= 0 && $1 <= 1000 && $2 >= 0 && $2 <= 10 && $3 >= 0 && $3 <= 2000 && $4 >= 0 && $4 <= 6.2832 && $5 >= 0 && $5 <= 64) {
            return 'more particle sources than lzrprf takes' if ($live->{layer_emitters} // 0) >= $LAYERS_EMITTERS;
            $live->{layer_emitters}++;
            $is = 'e';
        }
        else { return "layer $id is made in no form" }
        $kind->{$id} = $is;
        $live->{layer_parent}{$id} = $parent;
        $live->{layer_kids}{$parent}{$id} = 1;
        return '';
    }
    return 'an item of no form' unless $item =~ /^([modfcrx]) ([1-9][0-9]{0,3})(?: (.*))?\z/s;
    my ($op, $id, $rest) = ($1, $2, $3);
    my $is = $kind->{$id} or return "layer $id is not there";
    return '' if $op eq 'x' && !defined $rest && live_layer_gone($live, $id);
    return "layer $id is changed in no form" unless defined $rest;
    return '' if $op eq 'm' && $rest =~ /^$n $n $n $n $n $n\z/;
    return '' if $op eq 'o' && $rest =~ /^$n\z/ && $rest >= 0 && $rest <= 1;
    return '' if $op eq 'd' && $is eq 's' && length $rest <= $LAYERS_PATH && $rest =~ /^$LAYER_PATH\z/;
    return '' if $op eq 'f' && ($is eq 's' ? $rest =~ /^$c $c $n $c $n\z/ : $is eq 't' && $rest =~ /^[0-9a-f]{8} - $n $c $n\z/);
    return '' if $op eq 'c' && $is eq 't' && $rest =~ /^$LAYER_TEXT\z/;
    return '' if $op eq 'r' && $is eq 'e' && $rest =~ /^$n\z/ && $rest >= 0 && $rest <= 1000;
    return "layer $id is changed in no form";
}

sub live_layer_gone {                     # [C18] a layer and all it holds taken out of what lzrprf knows of the page's layers; true
    my ($live, $id) = @_;
    my @gone = ($id);
    while (defined(my $one = shift @gone)) {
        push @gone, keys %{ delete $live->{layer_kids}{$one} // {} };
        $live->{layer_emitters}-- if (delete $live->{layer_kind}{$one} // '') eq 'e';
        my $parent = delete $live->{layer_parent}{$one};
        delete $live->{layer_kids}{$parent}{$one} if defined $parent && $live->{layer_kids}{$parent};
    }
    return 1;
}

sub live_layers_paid {                    # [C18] the bytes of one "=layers" line taken out of its page's budget, which fills at $LAYERS_RATE a second up to $LAYERS_BURST; they are not counted in $LIVE_BYTES. '' while the budget holds, else why not
    my ($live, $bytes) = @_;
    $live->{bytes} -= $bytes;              # counted when read (sub live_read): a page's layers have their own budget
    my $now = now();
    my $had = $live->{layers_budget} // $LAYERS_BURST;
    $had += ($now - ($live->{layers_paid} // $now)) * $LAYERS_RATE;
    $had = $LAYERS_BURST if $had > $LAYERS_BURST;
    $live->{layers_paid} = $now;
    $live->{layers_budget} = $had - $bytes;
    return $live->{layers_budget} < 0 ? "more than $LAYERS_RATE bytes of layers a second" : '';
}

# The sound of a page kept running (src/page/sound.rs; how-it-works.md,
# "Sound of a page kept running"). "=sound ID RATE FRAMES FROM TO" makes
# sound ID, an id of 1 to 4294967295 not made before: RATE of 8000 to 96000
# frames a second, FRAMES of 1 to $SOUND_FRAMES, looping from FROM to TO with
# FROM below TO and TO at most FRAMES, or played once with both 0; at most
# $SOUNDS_MOST sounds and $SOUND_BYTES of samples in the page's life.
# "=samples ID BASE64" adds to its samples: RFC 4648 base64 in groups of
# four, padded only on the line that ends them, never more than FRAMES
# samples of two bytes. "=play ID AT" sounds a sound whose samples are all
# there from frame AT, below FRAMES; "=hush ID" silences a sound made.
# Anything else ends the page. A =play more than $SOUND_PRESS_SECONDS after
# the last click or key lzrprf handed the page is not passed on, and the log
# says so once for the page: a page never starts sound by itself.
sub live_sound {                          # [C12] one sound line of an answer, against the sounds the page made: '' when it is fit, else what is wrong with it; what the sound process is to be told is put on @$out
    my ($live, $line, $out) = @_;
    my $made = $live->{sounds} //= {};
    my $id = qr/([1-9][0-9]{0,9})/;
    if ($line =~ /^=sound $id (0|[1-9][0-9]{0,8}) (0|[1-9][0-9]{0,8}) (0|[1-9][0-9]{0,8}) (0|[1-9][0-9]{0,8})\z/) {
        my ($n, $rate, $frames, $from, $to) = ($1, $2, $3, $4, $5);
        return 'an id past 4294967295' if $n > 4294967295;
        return 'a sound made twice' if $made->{$n};
        return 'a rate lzrprf does not take' if $rate < 8000 || $rate > 96000;
        return 'a sound of no frames or too many' if $frames < 1 || $frames > $SOUND_FRAMES;
        return 'a loop outside the sound' unless ($from == 0 && $to == 0) || ($from < $to && $to <= $frames);
        return "more than $SOUNDS_MOST sounds" if ++$live->{sounds_made} > $SOUNDS_MOST;
        return "more than $SOUND_BYTES bytes of samples" if ($live->{sound_bytes} += 2 * $frames) > $SOUND_BYTES;
        $made->{$n} = { rate => $rate, frames => $frames, from => $from, to => $to, parts => [], got => 0 };
        return '';
    }
    if ($line =~ /^=samples $id ([A-Za-z0-9+\/]*={0,2})\z/) {
        my ($n, $code) = ($1, $2);
        my $sound = $made->{$n} or return 'samples of a sound not made';
        return 'samples of a line too long' if length($code) > $SOUND_LINE;
        return 'samples not in groups of four' if !length($code) || length($code) % 4;
        my $pad = $code =~ /(=+)\z/ ? length $1 : 0;
        $sound->{got} += length($code) / 4 * 3 - $pad;
        return 'more samples than the sound has' if $sound->{got} > 2 * $sound->{frames};
        return 'padding before the samples end' if $pad && $sound->{got} < 2 * $sound->{frames};
        push @{ $sound->{parts} }, $code;
        return '';
    }
    if ($line =~ /^=play $id (0|[1-9][0-9]{0,8})\z/) {
        my ($n, $at) = ($1, $2);
        my $sound = $made->{$n} or return 'a sound not made';
        return 'a sound whose samples are not all there' if $sound->{got} != 2 * $sound->{frames};
        return 'a frame past its end' if $at >= $sound->{frames};
        if (now() - ($live->{pressed} // -1e9) > $SOUND_PRESS_SECONDS) {
            record("the page $live->{url} started a sound with no click or key of yours just before it; no sound of it is played") unless $live->{sound_unpressed}++;
            return '';
        }
        push @$out, "play $n $at";
        return '';
    }
    if ($line =~ /^=hush $id\z/) {
        return 'a sound not made' unless $made->{$1};
        push @$out, "stop $1";
        return '';
    }
    return 'a line of no form';
}

sub live_sounded {                        # [C12] what a page's answer sounds, for the tab shown, to the sound process: a sound's samples once ("sound begin", "sound part"), then "sound play" and "sound stop"; every sound goes with another tab, a new page and no page kept running (sub sound_hushed), and lzrprf forgets what it sent then
    my ($live, @told) = @_;
    return unless $live->{tab} == $TABS[$TAB];
    my $held = $live->{sound_held} //= {};
    my @lines;
    for (@told) {
        my ($what, $n, $at) = split / /;
        if ($what eq 'stop') { push @lines, "sound stop $TAB $n" if $held->{$n}; next }
        my $sound = $live->{sounds}{$n};
        push @lines, "sound begin $TAB $n $sound->{rate} $sound->{frames} $sound->{from} $sound->{to}", map { "sound part $TAB $n $_" } @{ $sound->{parts} } unless $held->{$n}++;
        push @lines, "sound play $TAB $n $at";
    }
    sound_told($live, @lines) if @lines;
}

sub live_layers_again {                   # [C18] the page of the tab shown now, whose layers the window does not hold, is written "=layers": it tells every layer gone and makes it again
    my $live = live_of($TABS[$TAB]) or return;
    return unless delete $live->{layers_lost} or %{ $live->{layer_kind} // {} };
    delete $live->{home_ready} if $live->{home};
    live_wrote($live, 'layers') unless $live->{ended};
}

# Only checked complete drawings arrive here. The window receives a compact replacement range
# when it saves at least 512 bytes; it retains the same drawing objects for unchanged lines.
# [C9] A splice of a laid list checked by itself: its own lines, from where the list stands where it
# begins (found item by item, the rows of a tile or a picture passed over by their count), against what
# the rest of the list holds (sub laid_run), and ending where the list it replaces ended. Only a splice
# with no tile, placed tile, picture or picture to fetch (K, J, M, I) on either side, of a page with no
# picture to fetch whose last list was checked whole; else nothing, and the whole list is checked as a
# first list is. Typing in a field of a long page checked its 8 MB list again on every key, 15 to 20 ms
# with putting it together (measured 2026-11-23). Gives where the shown list changed, and its new lines.
sub live_patched {
