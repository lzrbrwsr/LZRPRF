sub link_folder { return "${\ shared()}/link" }
sub link_state {                          # [C31] the link as its file holds it, read at most once in two seconds: (id, key, until) or nothing while it is off
    return if $INCOGNITO || $TOR_WINDOW || $LINK{child};
