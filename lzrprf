        : $len <= 65535 ? pack('CCn', 0x80 | $opcode, 0xfe, $len)
        : pack('CCNN', 0x80 | $opcode, 0xff, 0, $len);
    my $key = substr($mask x int(($len + 3) / 4), 0, $len);
    return $header . $mask . ($body ^ $key);
