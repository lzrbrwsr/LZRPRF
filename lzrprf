        videos => [], sites => [], wide => $VIEW[0], scale => $VIEW_SCALE };
    live_kept($live, $tab, $lines, $paths, $host, {}, $lines, []);
    tab_shown();
    live_told();
    return;
}
# The live debug link [C31]. Off until you switch it on in the cogwheel's menu
