    return ($lines, $hosts, $paths, $said, $named, $live, $videos);
}

# A relayout outrun (sub relaid): what the window said while the page was laid out again is read as sub relaid
# reads it before a run, every size taken and the rest held in its order for later. Returns whether the width to
# lay at moved on from the one this run lays at, or the window is gone: either way the run is ended at once, so
# a drag that pauses at one width and then at another never waits for the first width's run.
sub outrun {
    my $got = sysread($FROM, $FROM_HELD, 65536, length $FROM_HELD);
    return 1 if defined $got ? !$got : !$!{EINTR};
    my @later;
    while (defined(my $more = hear(0))) { last if $more eq ''; push @later, $more unless viewing($more) }
    push @HELD, @later;
    return $VIEW[0] != $LAID_WIDE;
}

# The fonts a page is drawn with, as one frame in front of its answer:
# "=fonts", the length of each of the eight, a line end, then their bytes.
# The application opens no file of its own, so lzrprf reads them here, once
# in a window. A face that is a link, a pipe or anything but a plain file,
# is larger than $FACE_BYTES or does not begin as a font goes as length 0.
my $FRAME;
sub faces {                               # [C13]
    return $FRAME //= do {
        my @got = map {
            my ($in, $font) = (undef, '');
            sysopen($in, $_, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) && -f $in && binmode($in)
                && read($in, $font, $FACE_BYTES + 1) && length($font) <= $FACE_BYTES
                && $font =~ /\A\x00\x01\x00\x00/ ? $font : '';
        } @FACES;
        join(' ', '=fonts', map { length } @got) . "\n" . join('', @got);
    };
}

# One run of the application in a page container, for a page or for one
# picture: it is given what was fetched on descriptor 0, under the same
# limits, the same keeper and the same clock. Returns what it wrote, not yet
# checked; or nothing, and one word for what went wrong. A picture run is
# told one thing more, LZRPRF_PICTURE=1; a page run gets the size of the
# window's page first, "=view", its width and its height in points and a line
# end, then the fonts, then the frame of its style sheets, $sheets, none of
# which a picture run has.
#
# A page kept running with its tab. With $keep (a page run, never a picture
# run) the answer goes in the frame "=live", its length in bytes and a line
# end, then the answer; the application's half is src/page/scripted.rs.
# An application that keeps the page (an HTML page its engines read) writes
# its first list and then a line "=ready", and stays: its keeper keeps its
# input open and hands it the lines lzrprf writes into a third pipe, the
# relay, which only lzrprf and that keeper hold. lzrprf reads the first list
# up to "=ready", within the same $PAGE_SECONDS and $PAGE_BYTES, checks it as
# every first list, and returns the run with it: the page, its keeper, the
# relay, the pipe the page writes to and lzrprf's end of the keeper's pipe,
# which still ends the page when lzrprf ends by whatever way. An application
# that does not keep the page writes its list and ends, and is read to its end
# as before. Every line that reaches a page kept running is written by lzrprf
# from a line of the window it checked (sub live_input); every answer of the
# page is checked before anything of it is drawn (sub live_answered).
sub contained {
    my ($url, $got, $sheets, $keep, $tool, $local_home, $soon, $app) = @_;    # $soon: a page kept running is handed back once it is contained, and its first list read in the loop of sub behind (sub home_arrived)    # $tool 'judge': LZRDFNDR's verdicts on addresses before they are fetched ([C28], sub shield_asked); else the run is the application's tool ([C20], sub tool_shown): handed lzrprf's look at this computer as a picture run is handed a picture, and read to its end
    if ($app && (!kept_app_valid($app, $url) || !$keep || !defined $sheets || $tool || $local_home || $soon)) { return (undef, 'unstarted') }
    $READ_ASKED = 0;                      # this run has asked for nothing yet, whatever way it ends
    return (undef, 'changed') unless program_same();    # read again before every run: the program on the disk is the file this window began with, or nothing is laid out
    $keep = 0 unless defined $sheets;     # a picture run is never kept
    my $frame = defined $sheets ? "=view $VIEW[0] $VIEW[1]" . ($VIEW_SCALE == 2 ? " 2" : "") . "\n" . faces() . $sheets : '';    # the size first, numbers lzrprf holds to its bounds (sub viewing); [C13] [C14] the fonts read here, before the keeper is a copy of this process, so once in a window; handed over by the keeper alone, after the same word as the answer
    $frame .= permit_page($url, \$got, $app) if defined $sheets && !$tool;    # [C26] the decisions lzrprf holds for the site, after the style sheets; a site whose scripts are not allowed is handed its page with them taken out
    $frame .= ($app ? kept_app_jar($app, sub { jar_frame($url) }) : jar_frame($url)) if defined $sheets && !$tool && !$local_home;    # [C7] the cookies of the page's own site its script may see, after the permissions (sub jar_frame)
    my ($stored, $epoch) = $app ? kept_storage_frame($app, $url) : ('', undef);
    $frame .= $stored;
    $frame .= '=live ' . length($got) . "\n" if $keep;
    if (!$app && (my $ran = beside_taken($frame . $got, defined $sheets && !$tool, $url, !$local_home && !$soon))) { return run_read($ran, $keep, $sheets, $tool) }    # the very run, started beside the first (sub beside_begun)
    my ($input, $relay);                  # the keeper's end of the relay and lzrprf's, for a page kept running
    if ($keep) { pipe($input, $relay) or return (undef, 'unstarted') }
    my $run = (!$app ? spare_taken($url, $sheets, $tool, $local_home) : undef) // page_started($url, $sheets, $tool, $local_home, $app) // return (undef, 'unstarted');    # its process, started for this one run, here or a moment before (sub spare_for)
    my ($page, $answer_in, $from_page, $seal) = @$run{qw(page in from seal)};
    pipe(my $held, my $hold) or do { kill 'KILL', $page; waitpid $page, 0; return (undef, 'unstarted') };
    my $feeder = fork;
    if (!defined $feeder) {               # no second process to be had: the application is running by now, so it is ended here and not left to end by itself
        kill 'KILL', $page;
        waitpid $page, 0;
        return (undef, 'unstarted');
    }
    if (!$feeder) {                       # the keeper of this page
        close $_ for $from_page, $hold, grep { defined } $relay, map({ @$_{qw(relay from hold)} } @LIVE), trmnl_fds(), cht_fds(), beside_fds(), $SPARE ? @$SPARE{qw(in from)} : (), $CURL_SPARE ? @$CURL_SPARE{qw(to from)} : ();    # and lzrprf's ends of every page kept running: the end of lzrprf is the end of each of their pipes, held by nobody else
        keeper($held, $answer_in, "=seal $seal\n" . $frame . $got, $page, $input);
        POSIX::_exit(0);                  # the keeper never returns; were it ever to, it ends here and does not go on as a second lzrprf
    }
    close $_ for $answer_in, $held, grep { defined } $input;
    timed('page-forked');
    timed("run-forked $$") if $TIMED;    # "lzrprf try" with "times": each run of the application by the process that started it, a page's or a picture's (scripts/load-timeline.pl)
    fcntl($relay, POSIX::F_SETFL(), O_NONBLOCK) if $relay;    # lzrprf never waits in a write to a page: a line it cannot write at once ends the page (sub live_input)
    if (!inside($page)) {                 # [C3] the system did not say so: the answer stays here; the application was told the address and nothing else
        kill 'STOP', $page;               # held still before anything else: the keeper's end closes the application's input, and an application the system does not call contained is not to go on at that while it waits to be ended
        kill 'KILL', $feeder;             # the keeper first, here and below: it acts on the application's number, and is gone before the system may give that number to another process
        waitpid $feeder, 0;
        my $gone = waitpid($page, POSIX::WNOHANG()) == $page;    # it ended by itself: of a process that is gone the system has nothing to say
        kill 'KILL', $page unless $gone;
        waitpid $page, 0 unless $gone;
        return (undef, $gone ? 'ended' : 'uncontained');    # only a process still running, of which the system does not say that it is contained, is the container's fault
    }
    timed('page-inside');
    if ((syswrite($hold, 'g') // 0) != 1) {    # the keeper cannot be told that the system said so: nothing is handed over
        kill 'KILL', $feeder, $page;
        waitpid $_, 0 for $feeder, $page;
        return (undef, 'unstarted');
    }
    my $started = { page => $page, keeper => $feeder, relay => $relay, from => $from_page, hold => $hold, held => '', looked => 0, wide => $VIEW[0], scale => $VIEW_SCALE, until => now() + $PAGE_SECONDS, bytes => 0, waiting => 0, focus => 0, home => $local_home, url => $url, fetches => 0, heard => now() };
    @$started{qw(kept_app storage_epoch)} = ($app, $epoch) if $app;
    if ($soon && $keep) { $started->{fed} = $frame . $got if $soon eq 'beside'; return (undef, undef, $started) }
    beside_begun($started, $sheets, $keep, $tool) unless $app;    # what the page names is begun, and its second run when its style sheets are here first (07-visit-beside.pl)
    return run_read($started, $keep, $sheets, $tool);
}

# The application's process for one run, started and left waiting on its input for its seal, which
# its keeper hands over only after the system said it is contained (sub contained). Its variables
# are those of the run, the address among them: nothing of the answer is in it yet.
sub page_started {
    my ($url, $sheets, $tool, $local_home, $app) = @_;
    pipe(my $answer_out, my $answer_in) && pipe(my $from_page, my $to_lzrprf) or return;
    my $seal = run_seal() // return;      # [C1] the run's seal: in its variables, and again as the first line its keeper hands over, only after the system said it is contained
    my $page = fork // return;
    if (!$page) {
        %ENV = (LZRPRF_CONTAINED => $url, LZRPRF_SEAL => $seal, $TOR_WANTED ? (LZRPRF_TOR => '1') : (), $local_home ? (LZRPRF_HOME => ($INCOGNITO ? 'private' : 'home') . (game_helper() ? ' satellite' : '') . (part_on('lzrgm') ? '' : ' nogame') . (part_on('lzrtrmnl') ? '' : ' notrmnl')) : (), $tool ? ($tool eq 'judge' ? (LZRPRF_JUDGE => '1') : (LZRPRF_TOOL => '1')) : defined $sheets ? () : (LZRPRF_PICTURE => '1'), !$tool && !$local_home && defined $sheets && !$OUTRUN ? (LZRPRF_EARLY => '1') : (), !$app && !$tool && !$local_home && !$TOR_WANTED ? (LZRPRF_SOON => '1') : (), $TIMED && !$tool ? (LZRPRF_TIMES => '1') : ());    # the application is told the address it lays out, and for a picture that it is one, and sees no other variable: these it is given before the system is asked [C3]
        chdir '/';
        the_program($answer_out, $to_lzrprf);    # [C1]
    }
    close $_ for $answer_out, $to_lzrprf;
    return { page => $page, in => $answer_in, from => $from_page, seal => $seal, key => "$url\t" . ($TOR_WANTED ? 1 : 0), of => $$ };
}

# A page run's process started before its run: the 10 to 25 ms the system takes to put a process in
# its container (and the program's own start) are then spent while the address is judged and
# fetched, or while the window is quiet, and not on the way to the drawing (measured 2026-11-24). At
# most one, for one address, a plain page run's (no picture, tool, verdict or local home); made by
# this process alone and taken by it alone, so a copy of lzrprf never hands it anything. Each is
# one run's process as sub contained starts it, with the same variables, limits, container and seal
# of its own, and it is used once: sub contained hands it its answer as it would a process started
# there (its keeper, the system asked first, then the seal). One that is not used is ended, never
# kept for another address; one for an older Tor setting is not taken.
sub spare_for {
    my ($url) = @_;
    return if $SPARE && $SPARE->{of} == $$ && $SPARE->{key} eq "$url\t" . ($TOR_WANTED ? 1 : 0) or $BESIDE && $BESIDE->{run};    # or the run it would be for is started already (07-visit-beside.pl)
    spare_dropped();
    return unless $$ == $FRESH && program_same();    # a program changed on the disk is not started, as sub contained starts none
    $SPARE = page_started($url, "=sheets\n");
}

sub spare_taken {                         # the process started for this run, when it is the one for its address and is still waiting; else nothing, and one for another run is ended
    my ($url, $sheets, $tool, $local_home) = @_;
    return unless $SPARE && defined $sheets && !$tool && !$local_home;
    my $one = $SPARE;
    return spare_dropped() if $one->{of} != $$ || $one->{key} ne "$url\t" . ($TOR_WANTED ? 1 : 0);
    undef $SPARE;
    return $one if waitpid($one->{page}, POSIX::WNOHANG()) == 0;
    close $_ for @$one{qw(in from)};      # it ended while it waited, having been handed nothing: a new one is started in its place
    return;
}

sub spare_dropped {                       # the process started before its run, ended unused; a copy of lzrprf only forgets it
    my $one = $SPARE or return;
    undef $SPARE;
    if ($one->{of} == $$) { kill 'KILL', $one->{page}; waitpid $one->{page}, 0 }
    close $_ for @$one{qw(in from)};
    return;
}

sub spare_work {                          # what the next quiet moment does (sub hear): the process for the next run of the page shown, for a new width, and curl for the next request
    my ($url, $curl) = ($SPARE_WANTED, $CURL_WANTED);
    return unless defined $url || $curl;
    ($SPARE_WANTED, $CURL_WANTED) = ();
    return sub { spare_for($url) if defined $url; curl_for() if $curl };
}

sub idle_taken {                          # the work of a quiet moment, once: sub behind's first ($IDLE_WORK), then a spare's
    my $work = $IDLE_WORK // return spare_work();
    undef $IDLE_WORK;
    return $work;
}

# The seal of one run of the application [C1]: 16 random bytes as 32 hex digits, named to the
# application in LZRPRF_SEAL and written again by its keeper as the first line it hands over,
# "=seal" and the digits. The keeper writes nothing before lzrprf's word that the system called
# the application contained, so the line is lzrprf's handshake: the application refuses to start
# without it (src/page/sealed.rs), and then tries a write and a read its container refuses, and
# refuses to start when either is not refused. A variable alone is not enough: anyone can set one.
sub run_seal {
    open my $random, '<:raw', '/dev/urandom' or return;
    read($random, my $bytes, 16) == 16 or return;
    return unpack('H*', $bytes);
}

# The keeper: the second process of a page, a copy of lzrprf itself. It
# waits for one byte, lzrprf's word that the system called the application
# contained, and only then hands the answer over. After that, and while it
# hands over, it waits for one thing more: the end of lzrprf. The pipe it
# reads has its other end in lzrprf alone, so it runs dry when lzrprf ends,
# by whatever way, also when lzrprf is killed and can end nothing itself.
# Then the keeper ends the application and itself. Without it an application
# that sleeps would stay, in its container, after lzrprf was killed. While
# lzrprf lives, lzrprf ends the keeper before it lets go of the application's
# number, so the keeper never acts on a number the system gave to another
# process; after lzrprf's end it acts at once, on a number the system gives
# away only once the application has ended and been cleared away, which is
# the one moment this cannot rule out. An application that does not read
# changes nothing: the keeper never waits in a write.
# The keeper of a page kept running has one pipe more, the relay ($input),
# whose other end only lzrprf holds: what lzrprf writes there it hands on
# after the answer, in the same way, and it keeps the application's input
# open until the relay ends. It holds at most $LIVE_HELD bytes that are not
# handed on yet and reads no more until they are, so lzrprf, which writes
# without waiting, finds the relay full and ends the page.
sub keeper {
    my ($held, $to, $data, $page, $input) = @_;
    $SIG{PIPE} = 'IGNORE';                # an application that closes what it reads does not end its keeper
    my $over = sub { kill 'KILL', $page; POSIX::_exit(0) };
    my ($word, $go, $sent) = ('', undef, 0);
    do { $go = sysread($held, $word, 1) } until defined $go || !$!{EINTR};
    $over->() unless $go;                 # lzrprf ended, or ended this page, before the system said that the application is contained
    fcntl($to, POSIX::F_SETFL(), O_NONBLOCK) or $over->();
    while (1) {
        if ($to && $sent >= length $data && !$input) { close $to; undef $to }    # all of the answer is handed over, and of a page kept running the relay has ended: what the application reads ends here
        my ($read, $write) = ('', '');
        vec($read, fileno $held, 1) = 1;
        vec($read, fileno $input, 1) = 1 if $input && length($data) - $sent < $LIVE_HELD;
        vec($write, fileno $to, 1) = 1 if $to && $sent < length $data;
        select($read, $write, undef, undef) > 0 or next;
        if (vec($read, fileno $held, 1)) {
            my $more = sysread($held, $word, 1);
            $over->() if defined $more ? !$more : !$!{EINTR};    # nothing more to read: lzrprf is gone
        }
        if ($input && vec($read, fileno $input, 1)) {
            my $more = sysread($input, my $lines, 4096);
            if ($more) { substr($data, 0, $sent, ''); $sent = 0; $data .= $lines }    # what was handed on already is let go
            elsif (defined $more || !$!{EINTR}) { undef $input }    # lzrprf closed the relay ("=end" is in it): what is held is handed on, then the input ends
        }
        next unless $to && vec($write, fileno $to, 1);
        my $left = length($data) - $sent;
        my $took = syswrite($to, $data, $left > 65536 ? 65536 : $left, $sent);
        if (defined $took) { $sent += $took } elsif (!$!{EINTR} && !$!{EAGAIN}) { $sent = length $data }    # the application reads no more: the rest is not handed over
    }
}

# What the application may write, and nothing else: a first line that names
# the other hosts the page asks for, its =pictures, =sheets and =statement lines (sub stated), and then lines of five kinds, or a laid page.
#
#   U<kind><s><name>   a thing the application says the page is made of; <s> is + when it says its own code supports the thing and - when not; a tab and a version may follow
#   P<style><depth>    a paragraph begins: plain, heading 1 2 3, list item, quote, code, rule; how far it is set in, 0 to 9
#   T<looks><text>     text in that paragraph; one letter says bold, italic, fixed width, and coloured as a link
#   B                  a line ends
#   I<wide>x<high>     a grey box where a picture would stand, 8 to 640 wide and 8 to 480 high
#
# None of the five can carry an address to fetch, a program, a picture or a
# command: a link is a colour, a picture is a size. A list with any other
# line in it is not drawn at all. The lines of the first kind stand before
# every other, at most 120 of them: one of eight letters for the kind
# (document, CSS, JavaScript, libraries, media and formats, web APIs,
# security and transport, metadata), a + or a - for whether the application
# says its own code supports the thing, a name of 1 to 60 plain characters,
# and after a tab a version of 1 to 30, neither with a space at either end.
# They come in the order of the kinds and by name within a kind, and no name
# twice in a kind, so a list has one form only. They are what the
# application says, of the page and of itself: lzrprf checks their form, not
# whether they are true, and the window shows them as text in a pane of
# their own under the page.
# Or, after the first kind, a laid page: one line L and then rectangles, runs
# of text, grey boxes and pictures where the application laid them out (see
# "sub laid"). A picture or a tile there is pixels, checked to be exactly as
# many bytes as it says; it carries no address and no command either.
# In the text, every character that would
# act on the display instead of being displayed (a control code, an invisible
# mark, a mark that turns the reading direction) is replaced by the
# replacement mark before the window is given it.                        # [C9]
# What the window is spared. The window lays text out with the system's own
# code, and that code is not linear: measured on the real window, unseen, one
# block of 100,000 characters outside the first font (an emoji, Devanagari,
# Arabic) kept it busy for more than a minute, and so did one letter under
# 20,000 marks, one chain of 10,000 letters joined by a joining sign, and
# words of 20,000 Devanagari letters. A list of 200,000 lines took 17
# seconds. So a page may hold $PIECES lines and $PAGE_BYTES bytes and a block
# $BLOCK characters as the application wrote them: more is not a page. And
# two things are changed in a text, as a control character in it is changed.
# No more than $HUNG characters in a row hang on the one before them: the next
# one becomes U+FFFD, which nothing joins, and the row begins again. What
# hangs is what Unicode joins to the character before it (a mark, a character
# that extends a cluster or is spaced like a mark, a Hangul vowel or final, a
# Hangul initial after another), what follows a character that comes before
# its letter, and what follows a sign that joins two letters into one (and a
# mark after that sign), which Unicode 13, the version this Perl knows, does
# not join and the system does. And no more than $WORD characters stand in a
# row with no place where a line may end: there lzrprf puts in a space of no
# width (U+200B), which shows nothing and lets a line end. A no-break space
# is no such place. The application cannot write U+200B itself, it is one of
# those replaced above. It is put after all the characters that hang on the
# last one; a word that ends in them keeps them, so no mark is parted from
# its letter and no joined letter from its sign. Both are counted over the end
# of a line of text, because the window sets one line after the other. A text
# you copy out of the window holds those spaces. selftest draws the heaviest
# pages of each kind that was measured slow in the real window and takes the
# time; that is a measurement, and a text of a kind nobody tried may be slow.
sub unhung {                              # (the row the text before ended with, and the character before it; a line of text): the line with no row longer than $HUNG, and the row it ends with
    my ($row, $line) = @_;
    my $both = $row . substr($line, 2);
    $both =~ s/((?:$HANGS){$HUNG})$HANGS/$1\x{fffd}/g;
    my ($ends) = (length($both) > $HUNG + 3 ? substr($both, -$HUNG - 3) : $both) =~ /(.(?:$HANGS)*|(?:$HANGS)*)\z/s;    # with the character before the row: whether the next one hangs can depend on it
    return (substr($line, 0, 2) . substr($both, length $row), $ends);
}

sub parted {                              # (how many characters the word before the line has, and its last two; a line of text): the line with no word longer than $WORD, and the same of its last word
    my ($had, $tail, $line) = @_;
    my $both = 'x' x ($had - length $tail) . $tail . substr($line, 2);    # the last two as they are: whether a character hangs can depend on them
    $both =~ s/(?:\G|(?<!$SOLID))((?:$SOLID){$WORD}(?:$HANGS){0,$HUNG})(?!$HANGS)(?=$SOLID)/$1\x{200b}/g if length($both) > $WORD;    # only from the beginning of a word or the last space put in, so every word is read once
    my ($ends) = reverse(length($both) > $WORD + $HUNG ? substr($both, -$WORD - $HUNG) : $both) =~ /^($SOLID*)/;    # read from the end: a search for the last word from the front would try every place
    my $word = length($ends) < $WORD ? length $ends : $WORD;    # a word that ended in what hangs may be longer: counted as $WORD, so a space put in later is never put into the stand-in above
    return (substr($line, 0, 2) . substr($both, $had), $word, $word < 2 ? substr($both, -$word, $word) : substr($both, -2));
}

sub checked {
    my ($wrote) = @_;
    no warnings 'utf8';
    undef $LAID_TALLY;                    # said again by sub laid, for a laid list alone
    @FONTS_NAMED = ();                    # [C30] said again below, by a run that names web fonts
    return unless utf8::decode($wrote) && $wrote =~ s/\n\z//;
    my ($first, @lines) = split /\n/, $wrote, -1;
    return unless defined $first && $first =~ /^=page((?: $NAME){0,200})$/ && @lines <= $PIECES;
    my @hosts = split ' ', $1;
    $TITLED = '';
    if (@lines && $lines[0] =~ /^=title/) {    # the page's title, shown in its tab and nowhere else: one line of 1 to $TITLE characters; what would act on the display instead of being shown is taken out
        my ($title) = shift(@lines) =~ /^=title (.{1,$TITLE})\z/s or return;
        $title =~ s/[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\p{NChar}]|[^\x{0}-\x{10ffff}]//g;
        $title =~ s/^[ \p{M}]+| +$//g;    # and a mark with no letter before it, which would hang on the tab's own drawing
        utf8::encode($title);
        $TITLED = $title;
    }
    my @paths;
    if (@lines && $lines[0] =~ /^=pictures/) {    # the pictures the page names: on its own host by path alone, on another host as https://, a host by name and a path [C9]; how many other sites are asked, and what each address may be, is held where it is fetched (sub pictured)
        return unless shift(@lines) =~ m{^=pictures((?: (?:https://$NAME)?/[A-Za-z0-9._~/%?=&,-]{0,511}){1,$PICTURES})$};
        @paths = split ' ', $1;
    }
    my @videos;
    if (@lines && $lines[0] =~ /^=videos/) {    # [C22] the MP4 files the page names, written as its pictures are and held to the same checks where one is fetched, only when you click it (sub videoed)
        return unless shift(@lines) =~ m{^=videos((?: (?:https://$NAME)?/[A-Za-z0-9._~/%?=&,-]{0,511}){1,$VIDEOS})$};
        @videos = split ' ', $1;
    }
    my @sheets;
    if (@lines && $lines[0] =~ /^=sheets/) {    # [C14] the style sheets the page names on its own host, by path alone, as its pictures are
        return unless shift(@lines) =~ m{^=sheets((?: /[A-Za-z0-9._~/%?=&-]{0,511}){1,$SHEETS})$};
        @sheets = split ' ', $1;
    }
    if (@lines && $lines[0] =~ /^=webfonts/) {    # [C30] the web font files the page's style names on its own host, by path alone, as its sheets are: a run handed its sheets writes it, or a first run of a page that names no sheet, from its own <style>
        my $path = qr{/[A-Za-z0-9._~/%?=&-]{0,511}};
        return unless shift(@lines) =~ m{^=webfonts((?: $path(?:\|$path){0,@{[$FONT_TRIES - 1]}}){1,$FONTS})$};    # each font its paths in order, joined by |
        @FONTS_NAMED = split ' ', $1;
    }
    my ($said, $boxes, $made, $block, $row, $word, $tail, $before, $begun) = ((stated(\@lines) // return), 0, 0, 0, '', 0, '');    # the words of the one =statement line, '' for none; a malformed one makes the page unfit
    for (@lines) {
        if (!$begun && /^U([dcjlmasx])[+-]([\x21-\x7e](?:[\x20-\x7e]{0,58}[\x21-\x7e])?)(?:\t[\x21-\x7e](?:[\x20-\x7e]{0,28}[\x21-\x7e])?)?$/) {    # only plain characters, so nothing in such a line acts on the display
            my $key = index('dcjlmasx', $1) . $2;
            return unless ++$made <= $MADE && (!defined $before || $before lt $key);    # in the one order there is, and none twice
            $before = $key;
            next;
        }
        return laid(\@lines, \@hosts, $made, \@paths, $said, \@sheets, \@videos) if !$begun++ && /^L/;    # from the first line of another kind on, a line that begins with U is no line at all; and that first line says whether the page is laid
        if (/^T[\@-O]./s) {
            s/[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\p{NChar}]|[^\x{0}-\x{10ffff}]/\x{fffd}/g;    # the last: a number above every character there is, which Perl would pass on and the window could not read
            return unless ($block += length($_) - 2) <= $BLOCK;    # counted as the application wrote it, before anything is put in below
            ($_, $row) = unhung($row, $_) if $row ne '' || /$HANGS/;
            ($_, $word, $tail) = parted($word, $tail, $_);
            next;
        }
        ($row, $word, $tail) = ('', 0, '');   # a row of hanging characters and a word end with the text they are in: at a break, a box, a new block
        if (/^I([0-9]{1,3})x([0-9]{1,3})$/) { return unless $1 >= 8 && $1 <= 640 && $2 >= 8 && $2 <= 480 && ++$boxes <= $BOXES && ($block += $BOX) <= $BLOCK }
        elsif ($_ eq 'B') { return unless ++$block <= $BLOCK }
        else { return unless /^P[p123lqcr][0-9]$/; $block = 0 }
    }
    utf8::encode($_) for @lines;
    return (\@lines, \@hosts, \@paths, $said, \@sheets, \@videos);
}

# A laid page. The application has laid the page out itself and says where
# everything stands, in CSS pixels, on a page of a width and a height it
# names in one line L<width>x<height> right after what the page is made of.
# Then, in the order they are painted:
#
#   R<x>,<y>,<w>,<h>,<rrggbbaa>             a filled rectangle in that colour
#   X<x>,<y>,<size>,<looks>,<rrggbb>,<text> a run of text whose baseline begins at x,y; <looks> as in T
#   G<x>,<y>,<w>,<h>                        a grey box where a picture would stand
#   M<x>,<y>,<w>,<h>,<pw>,<ph>              a picture of pw by ph pixels shown in that box, given by
#   m<base64>                               exactly ph lines after it, one row each: pw times four
#                                           bytes, red, green, blue and how opaque, as pixels already
#   I<x>,<y>,<w>,<h>,<n>                    the picture of the nth path in =pictures (from 0), scaled
#                                           into that box; lzrprf fetches it and gives the window an M
#                                           in its place, or a G when there is no picture (sub pictured)
#   K<n>,<x>,<y>,<w>,<h>                    tile n, 0 to 31, each once, at a corner of the grid of 256: w and h are
#                                           256, or what is left of the page there; exactly h lines follow, one row
#   n<base64>                               each: w times three bytes, red, green and blue, with no "=" at the end;
#                                           a tile is opaque, the application paints white under everything
#   n                                       a bare n: the row above it in the same tile again, never a tile's first
#                                           row; on a page measured 58% of the rows were one (release 83)
#   J<n>,<x>,<y>                            tile n of a K above, placed again at a corner where it is cut the same
#   V<x>,<y>,<w>,<h>,<k>                    the place of the kth video in =videos (from 0), at most 8: the window
#                                           draws a play mark of its own over what was drawn there before (its
#                                           poster, an I, or grey); nothing of the video is fetched until you
#                                           click it there, and then lzrprf fetches it (sub videoed)
#
# Numbers are written in one way only, without a sign or a 0 in front, and
# everything stands inside the page. A page is laid or flowing, never both.
# A run of text gets the changes a text gets: a control or format character
# becomes U+FFFD, and so does the 31st character in a row that hangs on the
# one before it, counted in that run alone, since each run is set by itself.
# No space of no width is put in: a run is drawn on one line, where no line
# ends, and it is 2000 characters at most, a tenth of the word that was
# measured slow. A picture is bytes and no file: the window has no decoder
# to give it a picture to, it puts the bytes into the pixels as they are. A row of a
# tile is not decoded here: w times three bytes are exactly 4w characters of
# base64 with no "=", and every text of that alphabet and that length is the
# one form of its bytes, so its length and its alphabet are its whole check.
# A bare n is checked by where it stands: below a row of its own tile that was
# checked, which it repeats, so the window never reads a row nobody checked.
my $N = qr/(0|[1-9][0-9]{0,5})/;          # a number in its one form
sub laid {
    my ($lines, $hosts, $from, $paths, $said, $sheets, $videos) = @_;
    no warnings 'utf8';
    my ($wide, $high) = $lines->[$from] =~ /^L${N}x$N$/ or return;
    return unless defined $LAID_WIDE && $wide == $LAID_WIDE && $high >= 1 && $high <= 200_000;    # laid at the width its =view frame asked for, and at no other
    my $state = { wide => $wide, high => $high, text => 0, pixels => 0, rows => 0, row_bytes => 0, row_chars => 0, above => 0, rounded => 0, count => {}, tile => {} };
    laid_run($lines, $from + 1, $#$lines, $state, $paths, $videos) or return;
    return if $state->{rows} || $state->{rounded};    # a picture with rows missing, or a rounded edge with no picture after it
    $LAID_TALLY = $state;                 # what the list holds, for a splice of it checked by itself (sub live_patched)
    utf8::encode($_) for @$lines;
    return ($lines, $hosts, $paths, $said, $sheets, $videos);
}

sub laid_run {                            # the lines $first to $last of a laid list, checked in order from where $state says the list stands, and $state brought to after them; X lines are put in their shown form in place
    my ($lines, $first, $last, $state, $paths, $videos) = @_;
    no warnings 'utf8';
    my ($wide, $high, $text, $pixels, $rows, $row_bytes, $row_chars, $above, $count, $tile, $rounded) = @$state{qw(wide high text pixels rows row_bytes row_chars above count tile rounded)};    # $row_chars: how long a row of the tile above is, 0 under a picture; $above: whether a row of that tile was checked above the next
    my %count = %$count;
    my %tile = %$tile;
    my $inside = sub { my ($x, $y, $w, $h) = @_; return $w >= 1 && $h >= 1 && $x + $w <= $wide && $y + $h <= $high };
    my $cut = sub { my ($x, $y) = @_; return $x % 256 || $y % 256 || $x >= $wide || $y >= $high ? '' : ($wide - $x < 256 ? $wide - $x : 256) . ',' . ($high - $y < 256 ? $high - $y : 256) };    # the one size a tile has at a corner of the grid, or '' for no corner
    for (@$lines[$first .. $last]) {
        if ($rows) {                      # a row of the picture or the tile above: in base64, exactly as long as it is wide
            if ($row_chars) { return unless $_ eq 'n' ? $above : length($_) == $row_chars && /\An[A-Za-z0-9+\/]+\z/; $above = 1 }    # a tile's row n, never m; a bare n only below a row it repeats
            else {                        # a picture's row m, never n
                my ($code) = /^m([A-Za-z0-9+\/]+={0,2})$/ or return;
                my $bytes = decode_base64($code);
                return unless length($bytes) == $row_bytes && encode_base64($bytes, '') eq $code;    # written back the same: one form only, no byte more or less
            }
            $rows--;
            next;
        }
        my ($kind) = /^([RXGMIKJVQ])/ or return;
        return if $rounded && $kind ne 'I'; $rounded = 0;    # a rounded edge Q is said of the fetched picture on the next line, and of nothing else
        return unless ++$count{$kind} <= $LAID{$kind};
        if ($kind eq 'R') { return unless /^R$N,$N,$N,$N,[0-9a-f]{8}$/ && $inside->($1, $2, $3, $4) }
        elsif ($kind eq 'Q') { return unless /^Q$N,$N,$N,$N((?:,[0-9]{1,5}){8})$/ && $3 >= 1 && $4 >= 1 && $1 + $3 <= 200000 && $2 + $4 <= 200000 && !grep { $_ > 20000 } split /,/, substr($5, 1); $rounded = 1 }    # its rounded edge: a box and the eight radii of its corners, px
        elsif ($kind eq 'G') { return unless /^G$N,$N,$N,$N$/ && $inside->($1, $2, $3, $4) }
        elsif ($kind eq 'V') { return unless /^V$N,$N,$N,$N,$N$/ && $inside->($1, $2, $3, $4) && $5 < @$videos }
        elsif ($kind eq 'I') { return unless /^I$N,$N,$N,$N,$N(?:,([1-4]),$N,$N,$N,$N)?$/ && $inside->($1, $2, $3, $4) && $5 < @$paths && (!defined $6 || 4 == grep { $_ >= 1 && $_ <= 199999 } $7, $8, $9, $10) }    # a fit and a position (sub fit_crop)
        elsif ($kind eq 'M') {
            return unless /^M$N,$N,$N,$N,$N,$N(?:,$N,$N,$N,$N)?$/ && $inside->($1, $2, $3, $4) && $5 >= 1 && $5 <= 1024 && $6 >= 1 && $6 <= 1024 && ($pixels += $5 * $6) <= $PIXELS;
            return if defined $7 && ($9 < 1 || $10 < 1 || $7 + $9 > 100 * $5 || $8 + $10 > 100 * $6);    # the part of the picture a fit draws lies in it
            ($rows, $row_bytes, $row_chars) = ($6, $5 * 4, 0);
        } elsif ($kind eq 'K') { return unless /^K$N,$N,$N,$N,$N(,2)?$/ && $1 < $LAID{K} && !exists $tile{$1} && ($tile{$1} = $cut->($2, $3)) eq "$4,$5"; my $s = $6 ? 2 : 1; ($rows, $row_chars, $above) = ($5 * $s, 1 + 4 * $4 * $s, 0) }    # a tile is not counted in $PIXELS: 32 at most is its bound
        elsif ($kind eq 'J') { return unless /^J$N,$N,$N$/ && defined $tile{$1} && $tile{$1} eq $cut->($2, $3) }
        else {
            my ($head, $x, $y, $size, $chars) = /^(X$N,$N,$N,[\@-O],[0-9a-f]{6},)(.{1,$RUN_TEXT})\z/s or return;
            return unless $x < $wide && $y <= $high && $size >= 6 && $size <= 96 && ($text += length $chars) <= $ALL_TEXT;
            $chars =~ s/[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\p{NChar}]|[^\x{0}-\x{10ffff}]/\x{fffd}/g if $chars =~ /[^\x20-\x7e]/;    # as in T; printable ASCII is never replaced, so it is not searched
            $chars = substr((unhung('', "  $chars"))[0], 2) if $chars =~ /[^\x20-\x7e]/ && $chars =~ /$HANGS/;    # no printable ASCII character hangs
            $_ = $head . $chars;
        }
    }
    @$state{qw(text pixels rows row_bytes row_chars above count tile rounded)} = ($text, $pixels, $rows, $row_bytes, $row_chars, $above, \%count, \%tile, $rounded);
    return 1;
}


# LZRDFNDR's Redirects [C4]: every redirect lzrprf put to you in this window, with what you answered,
# grouped under the site that redirected. A decision changed there, "proceed always" or "cancel always",
# answers that same redirect (the same address to the same address) for you from then on, in this window;
# Forget takes it away, and the redirect is asked about again. Nothing of it is written.
sub redirect_noted {                      # [C4] a redirect about to be put to you, kept as "pending"; returns 2 when your kept decision proceeds (and it can be followed), 1 when it cancels, 0 when you are asked
    my ($url, $to, $status, $fit) = @_;
    my $key = "$url\t" . ($to // '');
    my $one = $REDIRECTS{$key};
    return $one->{decision} eq 'proceed always' && $fit ? 2 : 1 if $one && $one->{decision} =~ /always\z/;
    if ($one && delete $one->{once}) { return $one->{decision} eq 'proceeded' && $fit ? 2 : 1 }
    if (!$one && keys %REDIRECTS >= $REDIRECTS_MOST) { my ($oldest) = sort { $REDIRECTS{$a}{n} <=> $REDIRECTS{$b}{n} } keys %REDIRECTS; delete $REDIRECTS{$oldest} }
    my ($host) = $url =~ m{\Ahttps://([^/?#:]+)};
    $REDIRECTS{$key} = { site => 'https://' . lc($host // ''), status => $status, from => $url, to => $to // '', fit => $fit ? 1 : 0, decision => 'pending', n => ++$REDIRECTS_SEEN };
    return 0;
}

sub redirect_answered {
    my ($url, $to, $press, $went) = @_;
    my $one = $REDIRECTS{"$url\t" . ($to // '')} or return;
    if ($press == 5) { $one->{decision} = 'pending'; return }
    $one->{decision} = $press == 3 && $went ? 'proceed always' : $press == 4 ? 'cancel always' : $went ? 'proceeded' : 'cancelled';
}

sub redirects_listed {                    # [C4] the redirects of LZRDFNDR's Redirects, each site's together, in the order of their site and address: their keys, and the lines that tell them
    my @keys = sort { $REDIRECTS{$a}{site} cmp $REDIRECTS{$b}{site} || $a cmp $b } keys %REDIRECTS;
    my ($n, $was, @lines) = (0, '');
    for my $key (@keys) {
        my $one = $REDIRECTS{$key};
        push @lines, "redirects site $one->{site}" if $one->{site} ne $was;
        $was = $one->{site};
        push @lines, 'redirects one ' . join("\t", $n++, $one->{site}, $one->{status}, $one->{from}, $one->{to}, $one->{decision}, $one->{fit});
    }
    return \@keys, \@lines;
}

my @REDIRECT_WEB_KEYS;
sub redirects_told { my ($keys, $lines) = redirects_listed(); @REDIRECT_WEB_KEYS = @$keys; window('redirects begin', map({ unlisted($_) } @$lines), 'redirects end') }    # [C4] [C23] "redirects begin", "redirects site SITE", "redirects one N<tab>SITE<tab>STATUS<tab>FROM<tab>TO<tab>DECISION<tab>FIT" for each, "redirects end"

sub redirects_decide {                    # [C4] a decision changed in LZRDFNDR's Redirects, for the redirect numbered $n as redirects_told last numbered it: "proceed" or "cancel" keeps it as always, "forget" takes it away
    my ($n, $to) = @_;
    my $key = $REDIRECT_WEB_KEYS[$n];
    my $words = 'Nothing was changed: that redirect is no longer in the list.';
    if (defined $key && exists $REDIRECTS{$key}) {
        my $one = $REDIRECTS{$key};
        if ($to eq 'forget') { delete $REDIRECTS{$key}; $words = "No decision is kept for the redirect of $one->{from}: it is asked about again." }
        elsif (($to eq 'proceed' || $to eq 'allow-once') && !$one->{fit}) { $words = "The redirect of $one->{from} cannot be followed, so its decision stays unchanged." }
        else {
            delete $one->{once};
            $one->{once} = 1 if $to =~ /-once\z/;
            $one->{decision} = $to eq 'allow-once' ? 'proceeded' : $to eq 'deny-once' ? 'cancelled' : "$to always";
            $words = "The redirect of $one->{from} is now answered $to in this window.";
        }
        noted('LZRDFNDR Redirects: ' . unlisted($words));
    }
    redirects_told();
    return idle(unlisted($words));
}
# The pictures of a laid page. A page may name up to $PICTURES of them, each
# a path on its own host or a full address https://HOST/PATH on another host
# by its name. A name under the page's host (sub under) is the site you visit;
# any other host is another site, as a news site's image server is (sub
# elsewhere), and at most $PICTURE_SITES other sites are asked for one page's
# pictures, the first the page names: a picture on one more is not fetched,
# and the log says so. An address on another site is fetched only when it
# stands, as //HOST/PATH, in the text of the page as it was fetched (&amp; read
# as &, the host in any case): the application, which may be hostile, cannot
# make lzrprf ask another site for an address the page never named. That a
# picture of two dots or less is not named, and that the page's img-src policy
# is kept, are the application's checks: lzrprf keeps the eight sites, the
# address in the page, and everything below, and "Block pictures from other
# sites" in the cogwheel's menu (sub pictures_elsewhere) stops every one.
# What another site learns from a picture is your address and the picture's
# address, which names the page's picture and so tells it which page you read,
# at the moment you read it. It is sent nothing else: no cookie (lzrprf keeps
# none), no Referer, no Origin, only the fixed request of its address [C7].
# Each one a place I of the page draws is fetched once, the way the page was: its
# line in the log first, then "fetch", so a site is sent "request" of the
# picture's address and nothing else. At most $PICTURES_AT_ONCE are fetched
# and decoded side by side, each in a process of its own that writes nothing
# to the log: lzrprf writes every line itself. A path goes to the same checked
# addresses the page came from. Any other host is checked as a typed address is
# (sub address), its line is written before it is looked up [C5], with Tor on
# it is fetched through Tor as everything is [C17], and a host that
# leads inside your own network is not fetched at all, with no question: a
# page cannot make lzrprf ask you about your router [C8]. The application decodes it, in a
# page container of its own started as a page's is, and writes pixels:
#
#   P<w>,<h>      then exactly h lines p<hex>, 8 times w lowercase hex characters each:
#                 red, green, blue and how opaque, a byte each, not multiplied by it;
#                 1 to 2048 wide and high, 800,000 pixels at most; or P0,0 for none
#
# Anything else is no picture, and so is a picture not begun within one clock
# of $PICTURE_SECONDS for them all. Each place I becomes, for the window, an M
# with its rows in base64, the form of a picture a laid page already has, or
# the G it would be without one. This does not widen what the window reads:
# the window decodes no picture of a site (a video it hands to the system is
# the one file of a site it holds [C22]), and every byte of an M and
# its rows was written by lzrprf from numbers and hex it checked here, so the
# window is given nothing it was not given before. Returns the lines for the
# window, how many pictures were fetched and how many were asked for, and the
# pictures decoded, by number, which a new width places again; or nothing
# when a line of the log could not be written.
sub pictures_state {                      # what one page's pictures are fetched with: sub pictured's own, or begun ahead of it for an early list (sub pictures_ahead)
    my ($paths, $wanted, $host, $where, $kept, $page) = @_;
    open my $request, '>>', "$DIR/busy" or return;
    flock $request, LOCK_SH or return;    # as in visit: no line of these requests falls into a clearing of the log
    my %once;
    my @waiting = grep { $wanted->{$_} && !$once{$_}++ } @$paths;    # in the page's order
    shield_asked(map { m{^/} ? "https://$host$_" : (address($_))[0] } @waiting);    # [C28] all judged in one run, before any is looked up or fetched
    return { owner => $$, request => $request, host => $host, where => $where, kept => $kept, answer => $page // '', until => now() + $PICTURE_SECONDS, n => 0, lost => 0, running => {}, sites => {}, found => {}, hosts => [], picture => {}, begun => {%once}, waiting => \@waiting,
        named => (body_of($page // '') // '') =~ s/&amp;/&/gr };    # running: each picture fetched now, by the number fork gave for it: its entry, its address, what it said so far, its pipe; sites: the other sites asked for this page's pictures so far; found: what each other host was found at, looked up once; named: the page's own text, its body alone and not the site's headers, where an address on another site must stand (sub named_in)
}

sub pictures_begun {                      # the pictures waiting begun, up to $PICTURES_AT_ONCE side by side: every check and every line of the log of each, then its run
    my ($P, $few) = @_;                   # $few: at most that many begun in this call (sub pictures_ahead, sub pictures_pumped): beginning eight at once held the page's waiting script requests 31 ms on yle.fi (measured 2026-11-25)
    my ($host, $where, $kept) = @$P{qw(host where kept)};
    while (!$P->{lost} && @{ $P->{waiting} } && keys(%{ $P->{running} }) < $PICTURES_AT_ONCE && now() < $P->{until} && (!defined $few || $few-- > 0)) {    # a picture not begun within the clock is not begun
        my $entry = shift @{ $P->{waiting} };
        my $n = ++$P->{n};
        if (listed($entry =~ m{^/} ? "https://$host$entry" : $entry)) { refused("a picture the page $host names", $kept) or $P->{lost} = 1; next }    # [C23] its place stays a grey box, and nothing is looked up or asked
        my ($url, $there) = $entry =~ m{^/} ? ("https://$host$entry") : address($entry);    # another host: checked as a typed address is
        next unless defined $url;
        if (my $filter = filter_said($url, 'image', $host)) { record("$url not fetched: $filter", $kept) or $P->{lost} = 1; next }
        if ((my $shield = shield_said($url)) ne 'allow') { record("$url not fetched: " . shield_why($shield), $kept) or $P->{lost} = 1; next }    # [C28] its place stays a grey box, and its host is not even looked up    # [C27] after [C23]: its place stays a grey box, and nothing is looked up or asked
        my $other = defined $there && elsewhere($there, $host);
        if ($other && !pictures_elsewhere()) { record("$url not fetched: pictures from other sites are blocked (Block pictures from other sites, in the cogwheel's menu)", $kept) or $P->{lost} = 1; next }    # [C4] the setting of the cogwheel's menu (sub pictures_elsewhere): nothing is looked up, nothing is asked
        if ($other && !named_in($P->{named}, $there, $url)) { record("$url not fetched: the page $host does not name that address in its text", $kept) or $P->{lost} = 1; next }    # [C4] the application named it, and may be hostile: nothing is looked up, nothing is asked
        if ($other && !$P->{sites}{$there}) {    # another site, not asked yet for this page
            if (keys(%{ $P->{sites} }) >= $PICTURE_SITES) { record("$url not fetched: the page $host names pictures on more than $PICTURE_SITES other sites, and lzrprf asks at most $PICTURE_SITES of them for one page's pictures", $kept) or $P->{lost} = 1; next }    # [C4] nothing is looked up, nothing is asked
            $P->{sites}{$there} = 1;
        }
        my $to = $where;
        if (defined $there && $there ne $host) {
            record("the page $host names a picture on $there: $url", $kept) or ($P->{lost} = 1, last);    # [C5] before the name is even looked up
            my $why;
            ($to, $why) = @{ $P->{found}{$there} //= [$TOR_WANTED ? tor_where($there) : find($there)] };    # one lookup for each host of the page's pictures, however many it names there
            if ($to && grep { $_->{own} } @$to) { ($to, $why) = (undef, "$there leads inside your own network (" . join(', ', map { $_->{text} } @$to) . '), where no picture is fetched') }    # [C8] never for a picture, and nothing is asked
            if (!$to) { record("$url not fetched: $why", $kept) or $P->{lost} = 1; next }
            push @{ $P->{hosts} }, $there unless grep { $_ eq $there } @{ $P->{hosts} };
        }
        record("$url -> lzrprf connects " . ($TOR_WANTED ? 'through Tor, one circuit for ' . ($there // $host) : 'to the first that answers of: ' . join(', ', map { $_->{text} } @$to)), $kept) or ($P->{lost} = 1, last);    # [C5] written down first, connected second
        busy("Fetching picture $n of the page: $url");
        pipe(my $from_run, my $to_lzrprf) or next;
        my $run = fork // next;
        if (!$run) {                    # fetched and decoded beside up to seven others; what it says goes to lzrprf alone, which writes the log
            setpgrp(0, 0);              # a group of its own, named by its number, so what it started (curl, the application, sips) ends with it
            spare_dropped(); curl_ended($CURL_SPARE); undef $CURL_SPARE;    # its copies of the ends of what lzrprf started before a run: closed here, so they hold nothing open
            close $from_run;
            $RUN = getppid();           # it goes on while lzrprf does, and lzrprf ends it when the window is gone
            $SHIELD_CHILD = 1;          # [C28] it asks the application nothing: what was judged before it, and only that, may be fetched
            my ($got, $why, $from) = fetch($url, $to, undef, undef, undef, undef, ['image', $host]);    # [C6] [C7]
            my ($wrote) = $why ? () : contained($url, $got);    # [C1] [C3] no frame of style sheets: a picture run
            my $system = '';            # what the system's decoder made of it, for the log
            if (defined $wrote && $wrote =~ /\AS([1-9][0-9]{0,8})\n/ && length($wrote) == length($&) + $1) {    # [C21] a file the application does not decode, handed back whole
                my $body = body_of($got);    # what sips is given is the site's answer itself, which lzrprf takes from what curl fetched: the application only says that it is for the system, and chooses no byte of it
                my ($png, $fault) = defined $body && $body eq substr($wrote, length $&) ? system_decoded($body) : (undef, 'the application handed back another file than the site answered');
                ($wrote) = defined $png ? contained($url, "HTTP/1.1 200 OK\r\nContent-Length: " . length($png) . "\r\n\r\n$png") : ();    # the PNG is decoded by the application as any picture is
                $system = defined $png ? 'decoded by the operating system (sips) and then by the application' : "the operating system's decoder gave no picture: $fault";
            }
            print $to_lzrprf join("\t", defined $wrote ? 1 : 0, length($got // ''), $from // '', $why // '', $system), "\n", $wrote // '';
            close $to_lzrprf;
            POSIX::_exit(0);
        }
        close $to_lzrprf;
        setpgrp($run, $run);            # the same from this side, so the group is there whichever of the two runs first
        $P->{running}{$run} = [$entry, $url, '', $from_run];
    }
    return;
}

sub pictures_heard {                      # ($P, $wait): what the runs wrote within $wait seconds read, and each that ended written to the log and kept
    my ($P, $wait) = @_;
    my $kept = $P->{kept};
    return unless %{ $P->{running} };
    my $read = '';
    vec($read, fileno $_->[3], 1) = 1 for values %{ $P->{running} };
    select($read, undef, undef, $wait) > 0 or return;
    for my $run (grep { vec($read, fileno $P->{running}{$_}[3], 1) } keys %{ $P->{running} }) {
        my $one = $P->{running}{$run};
        my $came = sysread($one->[3], $one->[2], 262144, length $one->[2]);
        next if defined $came ? $came && length $one->[2] <= $PAGE_BYTES + 1000 : $!{EINTR} || $!{EAGAIN};    # a read a signal broke off is tried again
        delete $P->{running}{$run};    # it has said all it says
        close $one->[3];
        waitpid $run, 0;
        my ($head, $wrote) = split /\n/, $one->[2], 2;
        my ($decoded, $length, $from, $why, $system) = split /\t/, $head // '', 5;
        $why = 'the request could not be made' unless defined $from && ($length // '') =~ /^\d+$/;
        record("$one->[1] " . (length $why ? "failed: $why" : "answered: $length bytes from $from" . (length($system // '') ? "; $system" : '')), $kept) or ($P->{lost} = 1, last);
        $P->{picture}{ $one->[0] } = pixels($wrote) if !length $why && $decoded && defined $wrote;    # [C9]
    }
    return;
}

sub pictures_ended {                      # what still runs of a page's pictures ended, each run and every process of its group, sips among them, by the number fork gave
    my ($P) = @_;
    kill 'KILL', map { (-$_, $_) } keys %{ $P->{running} };
    waitpid $_, 0 for keys %{ $P->{running} };
    decoders_removed(keys %{ $P->{running} });    # [C21] the folder a run ended this way had for the system's decoder, which it could not remove itself
    close $P->{request};
    return;
}

# The pictures an early list places (sub live_early), begun while the page's
# scripts still run: the same checks, the same lines of the log before each
# request and the same runs as sub pictured makes, which takes them over when
# the page's own list is here and begins only what that list places besides.
# What the page's own list does not place after all was fetched as the early
# one placed it. Never through Tor, where a request waits for the page [C17].
sub pictures_judged {                     # ($lines, $paths, $host): the pictures of the page's first list judged beside its second run (sub shield_ahead), so its early list finds their verdicts
    my ($lines, $paths, $host) = @_;
    return if $TOR_WANTED;
    my %wanted = map { /^I\d+,\d+,\d+,\d+,(\d+)$/ ? ($paths->[$1] => 1) : () } @$lines;
    shield_ahead(map { m{^/} ? "https://$host$_" : (address($_))[0] } grep { $wanted{$_} } @$paths);
    return;
}

sub pictures_ahead {
    my ($lines, $paths, $host, $sent) = @_;
    my $page = $AHEAD_PAGE or return;
    return if $PICTURES_AHEAD || $TOR_WANTED || $page->{host} ne $host;
    my %wanted = map { /^I\d+,\d+,\d+,\d+,(\d+)$/ ? ($paths->[$1] => 1) : () } @$lines;
    return unless %wanted;
    $PICTURES_AHEAD = pictures_state($paths, \%wanted, $host, @$page{qw(where kept answer)}) or return;
    $PICTURES_AHEAD->{early} = [$lines, $paths, $host];    # the list they are drawn into when they are here (sub pictures_pumped)
    $PICTURES_AHEAD->{sent} = [$sent, $TAB, $WINDOW_LISTS] if $sent;    # the list the window was just handed, and how to tell that it still holds it
    timed('pictures-ahead ' . scalar @{ $PICTURES_AHEAD->{waiting} }) if $TIMED;
    pictures_begun($PICTURES_AHEAD, 2);
    return;
}

sub pictures_pumped {                     # the pictures begun ahead: what they wrote so far read without waiting, and the next of them begun
    my $P = $PICTURES_AHEAD or return;
    return if $P->{owner} != $$;        # a run started since holds a copy of them (a picture's own run reads its decoder as a page is read): only the process that began them hears them or begins more
    pictures_heard($P, 0);
    pictures_begun($P, 2);
    if ($P->{early} && !%{ $P->{running} } && !@{ $P->{waiting} } && !$P->{lost} && !$P->{shown}++ && %{ $P->{picture} }) {    # all of them here before the page's own list: the early list drawn once more, with them in their places
        my ($shown) = pictured(@{ $P->{early} }, undef, undef, pictures_so_far($P->{host}));
        my $held = $P->{sent} && $P->{sent}[1] == $TAB && $P->{sent}[2] == $WINDOW_LISTS ? $P->{sent}[0] : undef;    # the window still holds the early list: only the pictures' lines are sent
        window_changed($held, $shown);
        timed('pictures-early') if $TIMED;
    }
    return;
}

sub pictures_waited {                     # ($ready, $seconds): select on $ready for reading, changed in place as select changes it; the runs of the pictures begun ahead wake it too and are heard then. Returns how many of the caller's own are ready
    my $P = $PICTURES_AHEAD;
    undef $P if $P && $P->{owner} != $$;
    my @own = grep { vec($_[0], $_, 1) } 0 .. 8 * length($_[0]) - 1;
    if ($P) { vec($_[0], fileno $_->[3], 1) = 1 for values %{ $P->{running} } }
    prefetch_select(\$_[0]);              # and the scripts begun ahead (17-prefetch.pl)
    my $any = select($_[0], undef, undef, $_[1]) > 0;
    $_[0] = q{} unless $any;
    pictures_pumped() if $P && $any;
    prefetch_heard($_[0]) if $any;
    return scalar grep { vec($_[0], $_, 1) } @own;
}

sub pictures_so_far {                     # ($host): the pictures a first list may place with nothing fetched: those kept of the page this tab showed before on this host, and over them those begun ahead for this page that are decoded by now
    my ($host) = @_;
    my ($P, $B) = ($PICTURES_AHEAD, $PICTURES_BEFORE);
    if ($B && ($B->{host} ne $host || $B->{tab} != $TABS[$TAB])) { undef $PICTURES_BEFORE; undef $B }    # the tab went to another host, or another tab is read: dropped
    return { ($B ? %{ $B->{picture} } : ()), ($P && $P->{owner} == $$ && $P->{host} eq $host ? %{ $P->{picture} } : ()) };
}

sub pictures_before {                     # ($shown, $tab): the decoded pictures of the page shown in this tab kept for the visit that begins, by their entry, up to $PICTURES_BEFORE_BYTES; what was kept before is dropped first
    my ($shown, $tab) = @_;
    undef $PICTURES_BEFORE;
    my $all = $shown && $shown->{pictures} or return;
    my ($bytes, %kept) = (0);
    for my $entry (sort keys %$all) {
        my $size = 0;
        $size += length for @{ $all->{$entry} }[2 .. $#{ $all->{$entry} }];
        next if $bytes + $size > $PICTURES_BEFORE_BYTES;
        $bytes += $size;
        $kept{$entry} = $all->{$entry};
    }
    $PICTURES_BEFORE = { tab => $tab, host => $shown->{host}, picture => \%kept } if %kept;
    return;
}

sub pictures_dropped {                    # the pictures begun ahead and never taken over, ended
    pictures_ended($PICTURES_AHEAD) if $PICTURES_AHEAD && $PICTURES_AHEAD->{owner} == $$;
    undef $PICTURES_AHEAD;
    undef $AHEAD_PAGE;
    return;
}

sub pictured {
    my ($lines, $paths, $host, $where, $kept, $decoded, $page) = @_;    # $decoded: the pictures of this page decoded before, by their entry in =pictures; given when it is laid out again, and then nothing is fetched (sub relaid); $page: the page's answer as it was fetched, which an address on another site must stand in
    my %wanted = map { /^I\d+,\d+,\d+,\d+,(\d+)$/ ? ($paths->[$1] => 1) : () } @$lines;    # by entry: at another width the page may choose other sources, and an entry decoded then is placed again
    @PICTURED = ();
    if (!%wanted) { pictures_dropped() unless $decoded; return ($lines, 0, 0, {}) }
    my %picture = $decoded ? %$decoded : ();
    if (!$decoded) {
        my $P = $PICTURES_AHEAD;
        undef $PICTURES_AHEAD;
        undef $P if $P && $P->{owner} != $$;
        if ($P && ($P->{host} ne $host || $P->{answer} ne ($page // ''))) { pictures_ended($P); undef $P }    # begun for another page than this one
        if ($P) {                           # begun ahead for this very page: what this list places besides waits behind them, in the page's order
            my @more = grep { $wanted{$_} && !$P->{begun}{$_}++ } @$paths;
            shield_asked(map { m{^/} ? "https://$host$_" : (address($_))[0] } @more);    # [C28]
            push @{ $P->{waiting} }, @more;
            @$P{qw(where kept)} = ($where, $kept);
        }
        $P //= pictures_state($paths, \%wanted, $host, $where, $kept, $page) or return;
        while (!$P->{lost} && alive() && (%{ $P->{running} } || @{ $P->{waiting} } && now() < $P->{until})) {
            pictures_begun($P);
            last if $P->{lost} || !%{ $P->{running} };
            pictures_heard($P, 1);
        }
        pictures_ended($P);                 # the window is gone or a line could not be written: what still runs is ended
        return if $P->{lost};
        %picture = %{ $P->{picture} };
        @PICTURED = @{ $P->{hosts} };
    }
    my ($drawn, @shown) = (0);
    for (@$lines) {
        my ($x, $y, $w, $h, $n, @fit) = /^I(\d+),(\d+),(\d+),(\d+),(\d+)(?:,([1-4]),(\d+),(\d+),(\d+),(\d+))?$/ or (push(@shown, $_), next);
        my $one = $picture{ $paths->[$n] };
        if ($one && ($drawn += $one->[0] * $one->[1]) <= $DRAWN_PIXELS) {
            $one = $picture{ $paths->[$n] } = picture_one($one);
            my @crop = defined $fit[0] ? fit_crop($x, $y, $w, $h, $one->[0], $one->[1], @fit) : ($x, $y, $w, $h);
            next unless @crop;    # the fit leaves nothing of the picture in its box
            push @shown, 'N' . join(',', picture_named($one), @crop[0 .. 3], $one->[0], $one->[1], @crop[4 .. $#crop]);    # by its name: its rows go to the window once (sub named_owed), however many lists place it
        }
        else { push @shown, "G$x,$y,$w,$h" }
    }
    return (\@shown, scalar(grep { $picture{$_} } keys %wanted), scalar(keys %wanted), \%picture);
}

# A decoded picture goes to the window once. A list places it by a name, a line
# "N<name>,x,y,w,h,<wide>,<high>" with the fit's four numbers after it when it
# has a fit, and holds none of its rows; before a list is written, the rows of
# every picture it names that this process has not sent yet are written as
# "picture <name> <wide> <high>", a line "m<row>" for each row and a line "."
# (sub named_owed, called by sub window alone). A page's three lists and a
# page loaded again so carry each picture's rows once: on a front page 22 MB
# went with every list (measured in the real browser, 2026-11-25). Only sub
# pictured writes a line N: a list the application makes may not hold one (sub
# laid_run), so a page cannot place a bitmap of another page. The window keeps
# a bounded number of bitmaps; one it no longer has is asked for with "page
# refresh", and then every picture of the list is owed again (sub named_again).
my %NAMED_LIKE;                           # the names of this process by what a picture looks like at a glance (sub picture_like), so a picture decoded again finds the name of the same pixels

sub picture_named {                       # ($one): the name of a decoded picture, made the first time it is placed
    my ($one) = @_;
    if ($NAMED_OWNER != $$) {             # the first name of this process: a start of its own
        my $bytes = '';
        if (open my $random, '<:raw', '/dev/urandom') { read($random, $bytes, 4); close $random }
        $bytes = pack('N', (time() ^ ($$ << 15)) & 0xffffffff) unless length($bytes) == 4;
        ($NAMED_RUN, $NAMED_OWNER, $NAMED_COUNT) = (unpack('H*', $bytes), $$, 0);
        %NAMED = %NAMED_AT = %NAMED_LIKE = ();
    }
    my $known = $NAMED_AT{ 0 + $one };
    return $known->[0] if $known && defined $known->[1] && $known->[1] == $one;
    if (!(++$NAMED_COUNT % 64)) {         # the names of pictures no page keeps any more are let go
        for my $name (grep { !defined $NAMED{$_}[1] } keys %NAMED) { delete $NAMED{$name} }
        for my $at (grep { !defined $NAMED_AT{$_}[1] } keys %NAMED_AT) { delete $NAMED_AT{$at} }
        for my $like (grep { !$NAMED{ $NAMED_LIKE{$_} } } keys %NAMED_LIKE) { delete $NAMED_LIKE{$like} }
    }
    my $like = picture_like($one);
    my $entry = [$NAMED_RUN . sprintf('%x', $NAMED_COUNT), $one, 0];
    weaken($entry->[1]);
    $NAMED{ $entry->[0] } = $NAMED_AT{ 0 + $one } = $entry;
    $NAMED_LIKE{$like} = $entry->[0];
    return $entry->[0];
}

sub picture_one {                         # ($one): the picture already named that holds the same pixels, when one is still kept; else $one. A page asked again, or the next page of a site, decodes its pictures again: placed as the one the window holds, no row is sent and the second copy is let go
    my ($one) = @_;
    return $one if $NAMED_OWNER != $$ || $NAMED_AT{ 0 + $one };
    my $same = $NAMED{ $NAMED_LIKE{ picture_like($one) } // '' };
    return $same && defined $same->[1] && picture_same($same->[1], $one) ? $same->[1] : $one;
}

sub picture_like {                        # ($one): what a decoded picture looks like at a glance: its size, its rows' number and its middle row
    my ($one) = @_;
    return join ',', @$one[0, 1], $#$one, $one->[ 2 + int(($#$one - 2) / 2) ] // '';
}

sub picture_same {                        # ($one, $other): both hold the same size and the same rows, each compared whole
    my ($one, $other) = @_;
    return 0 if @$one != @$other;
    $one->[$_] eq $other->[$_] or return 0 for 0 .. $#$one;
    return 1;
}

sub named_owed {                          # (@lines of one list): the rows of each picture it names that the window was not sent yet, as lines to write before it
    my @owed;
    for (@_) {
        next unless /^N([0-9a-f]{9,24}),/;
        my $entry = $NAMED{$1} or next;
        next if $entry->[2] || !defined $entry->[1];
        $entry->[2] = 1;
        my $one = $entry->[1];
        push @owed, "picture $entry->[0] $one->[0] $one->[1]", (map { "m$_" } @$one[2 .. $#$one]), '.';
    }
    return @owed;
}

sub named_again { $_->[2] = 0 for values %NAMED; return }    # the window said it lacks a bitmap a list names: every picture is owed again with the list that names it next

# object-fit and object-position (CSS Images 3, sections 5.5 and 5.6): the
# engine lays the page out before any picture is decoded, so an I line whose
# img is not fill carries five more numbers: the fit (1 contain, 2 cover, 3
# none, 4 scale-down), then across and down each a permyriad of the room the
# box leaves and px, each plus 100000 so no number has a sign. Given the box
# x, y, w, h and the decoded picture pw by ph, gives the part of the box the
# picture shows in (rounded to whole px) and the part of the picture drawn
# there, in hundredths of a picture pixel: left, top, width and height of each.
# Nothing when none of it shows. The same arithmetic, in the same order, as the
# engine's layout/object_fit.rs crop, whose tests hold the numbers of this one's
# selftest. A picture the decoder made smaller has lost its own size: none and
# scale-down use the smaller one.
sub fit_crop {
    my ($x, $y, $bw, $bh, $nw, $nh, $fit, $xp, $xl, $yp, $yl) = @_;
    return if $nw < 1 || $nh < 1 || $bw <= 0 || $bh <= 0;
    my $round = sub { $_[0] < 0 ? -int(0.5 - $_[0]) : int($_[0] + 0.5) };
    my ($across, $down) = ($bw / $nw, $bh / $nh);
    my $contain = $across < $down ? $across : $down;
    my $scale = $fit == 1 ? $contain : $fit == 2 ? ($across > $down ? $across : $down) : $fit == 3 || $contain > 1 ? 1 : $contain;
    my ($w, $h) = ($nw * $scale, $nh * $scale);
    my $ox = $x + ($xp - 100000) / 10000 * ($bw - $w) + ($xl - 100000);
    my $oy = $y + ($yp - 100000) / 10000 * ($bh - $h) + ($yl - 100000);
    my ($l, $t) = ($round->($ox > $x ? $ox : $x), $round->($oy > $y ? $oy : $y));
    my ($r, $b) = ($round->($ox + $w < $x + $bw ? $ox + $w : $x + $bw), $round->($oy + $h < $y + $bh ? $oy + $h : $y + $bh));
    return if $r <= $l || $b <= $t || $w <= 0 || $h <= 0;
    my $along = sub {
        my ($from, $o, $size, $n) = @_;
        my ($v, $most) = ($round->(($from - $o) * $n / $size * 100), $round->($n * 100));
        $v < 0 ? 0 : $v > $most ? $most : $v;
    };
    my ($sx, $sy, $sr, $sb) = ($along->($l, $ox, $w, $nw), $along->($t, $oy, $h, $nh), $along->($r, $ox, $w, $nw), $along->($b, $oy, $h, $nh));
    return if $sr <= $sx || $sb <= $sy;
    return ($l, $t, $r - $l, $b - $t, $sx, $sy, $sr - $sx, $sb - $sy);
}

# A picture for the system to decode [C21]: the site's answer itself, which
# the application said is for the system and handed back whole, so lzrprf
# knows it is the same file; an ISO base media file whose first box names
# AVIF or HEIF, as the application judged it, judged again here. In a folder
# of its own, readable by you alone and removed after, the file is written,
# and the system's own sips runs in the decoder container to write it as a
# PNG: told to make it at most $DECODED_SIDE pixels a side when the file says it is
# larger (sub stated_size; sips -Z makes a small picture larger too, so it is
# told only then), and once more on the PNG when a side of it is still over
# $DECODED_SIDE (a file that said too little). In its container sips ends at once when
# asked the size of an AVIF, so the size is read here. A PNG is taken only
# when the system said, before sips started ($GATE), that it ran contained,
# and only when out.png is a plain file with no other name. Returns the PNG,
# or nothing and why.
sub system_decoded {
    my ($file) = @_;
    my $size = length $file >= 16 ? unpack('N', $file) : 0;
    my @brands = $size >= 16 && $size <= 256 && $size % 4 == 0 && length $file >= $size && substr($file, 4, 4) eq 'ftyp' ? (substr($file, 8, 4), unpack('(a4)*', substr($file, 16, $size - 16))) : ();
    return (undef, 'it is not an AVIF, HEIC or HEIF file') unless grep { /^(?:avif|avis|heic|heix|heim|heis|hevc|hevx|mif1|msf1)$/ } @brands;
    my $folder = abs_path($DIR) // return (undef, 'no folder could be made for it');
    $folder .= '/decode.' . $$ . '.' . join('', map { sprintf '%02x', int rand 256 } 1 .. 6);
    (() = decoding($folder, $SIPS)) or return (undef, "the folder for it has a name lzrprf does not pass on");
    mkdir($folder, 0700) or return (undef, 'no folder could be made for it');
    if (!mkdir("$folder/t", 0700)) { remove_tree($folder); return (undef, 'no folder could be made for it') }    # no empty folder is left
    my ($in, @result) = (undef, undef, 'the file could not be written');
    if (sysopen($in, "$folder/in", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) && (syswrite($in, $file) // -1) == length $file && close $in) {
        local $ENV{LZRPRF_TMPDIR} = "$folder/t/";
        local $SAID_INSIDE = 1;           # each run is asked about while it runs, before it is waited for (sub said)
        my ($png, $why) = ('', 'it wrote no PNG');
        my ($wide, $high) = stated_size($file);
        for my $run (1, 2) {
            my ($w, $h) = $run == 1 ? ($wide, $high) : substr($png, 0, 16) eq "\x89PNG\r\n\x1a\n\0\0\0\rIHDR" ? unpack('NN', substr($png, 16, 8)) : ();
            my $smaller = $w && $h && ($w > $DECODED_SIDE || $h > $DECODED_SIDE);
            last if $run == 2 && !($smaller && rename("$folder/out.png", "$folder/in"));
            (undef, my $ended) = said($DECODE_SECONDS, decoding($folder, '/usr/bin/perl', '-e', $GATE, $SIPS, '-s', 'format', 'png', $smaller ? ('-Z', $DECODED_SIDE) : (), "$folder/in", '--out', "$folder/out.png"));
            ($png, $why) = ('', defined $ended ? 'it wrote no PNG' : 'the system did not say that sips was in its container');
            last unless $ended;
            my ($read, $large) = plain_read("$folder/out.png", $DECODED_BYTES);
            if (defined $read) { $png = $read } elsif ($large) { $why = 'it wrote a PNG larger than lzrprf takes' }
        }
        @result = substr($png, 0, 8) eq "\x89PNG\r\n\x1a\n" ? ($png) : (undef, $why);
    }
    remove_tree($folder);
    return @result;
}

# What a program in a container of lzrprf's wrote, read only when its name is
# a plain file with one name, at most $most bytes, looked at before it is
# opened (lstat) and again once it is open, the same file: a link, a pipe or
# a device put in its place by a program that misbehaved is never opened or
# never waited on (O_NONBLOCK), and lzrprf goes on to remove the folder.
# Returns the bytes, or nothing and whether a plain file was too large.
# [C21] [C24]
sub plain_read {
    my ($path, $most) = @_;
    my @named = lstat $path or return;
    return (undef, 1) if -f _ && $named[7] > $most;
    return unless -f _ && $named[3] == 1;
    sysopen(my $in, $path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return;
    my @opened = stat $in;
    my $same = -f _ && $opened[0] == $named[0] && $opened[1] == $named[1] && $opened[3] == 1 && $opened[7] <= $most;
    my $bytes = '';
    if ($same) { local $/; $bytes = <$in> // '' }
    close $in;
    return $same && length $bytes <= $most ? ($bytes) : ();
}

# Whether an MPEG-TS stream may carry sound: true unless its program map
# (ISO/IEC 13818-1 2.4.4: the PAT on PID 0 names the PMT's PID, the PMT
# names each stream's type) is found in its first packets and names only
# pictures (MPEG-1 and -2 video, H.264, HEVC). A map not found, or a type
# lzrprf does not know, counts as sound: so a stream goes to the converter
# whenever it is not plainly pictures alone. [C24]
sub ts_sounds {
    my ($ts) = @_;
    my $section = sub {                   # the first section of a table on this PID, in one packet: its bytes after the pointer field, or nothing
        my ($pid) = @_;
        for (my $at = 0; $at + 188 <= length $ts && $at < 188 * 2000; $at += 188) {
            my ($sync, $head, $flags) = unpack('CnC', substr($ts, $at, 4));
            return if $sync != 0x47;
            next unless ($head & 0x1fff) == $pid && $head & 0x4000;    # the start of a table
            my $from = 4;
            $from += 1 + unpack('C', substr($ts, $at + 4, 1)) if $flags & 0x20;    # an adaptation field first
            next if ($flags & 0x10) == 0 || $from >= 188;
            my $pointer = unpack('C', substr($ts, $at + $from, 1));
            return substr($ts, $at + $from + 1 + $pointer, 188 - $from - 1 - $pointer) if $from + 1 + $pointer < 188;
        }
        return;
    };
    my $pat = $section->(0) // return 1;
    return 1 unless length $pat >= 12 && unpack('C', $pat) == 0x00;
    my $length = unpack('n', substr($pat, 1, 2)) & 0x0fff;
    my ($pmt);
    for (my $at = 8; $at + 4 <= 3 + $length - 4 && $at + 4 <= length $pat; $at += 4) {
        my ($number, $pid) = unpack('nn', substr($pat, $at, 4));
        ($pmt = $pid & 0x1fff), last if $number != 0;
    }
    defined $pmt or return 1;
    my $map = $section->($pmt) // return 1;
    return 1 unless length $map >= 12 && unpack('C', $map) == 0x02;
    my $end = 3 + (unpack('n', substr($map, 1, 2)) & 0x0fff) - 4;    # before its CRC
    return 1 if $end > length $map;
    my $at = 12 + (unpack('n', substr($map, 10, 2)) & 0x0fff);
    my $streams = 0;
    while ($at + 5 <= $end) {
        my ($type, undef, $info) = unpack('Cnn', substr($map, $at, 5));
        return 1 unless $type == 0x01 || $type == 0x02 || $type == 0x1b || $type == 0x24;
        $streams++;
        $at += 5 + ($info & 0x0fff);
    }
    return $streams ? 0 : 1;
}

# An MPEG-TS stream with sound made into an MP4 file by the system's own
# avconvert [C24], which the window's player reads without the system's
# register of sound decoders, a name the window's container does not list.
# The preset is PresetPassthrough: the pictures and the sound are copied as
# they came, not decoded and not made again, into an MP4 with its index at
# its start. In a folder of its own, readable by you alone and removed
# after, in incognito too (as for sips [C21]), the stream is written as
# in.ts and avconvert writes out.mp4 in the converter container. An MP4 is
# taken only when the system said, before avconvert started ($GATE), that it
# ran contained, and only when out.mp4 is a plain file with no other name,
# at most $VIDEO_BYTES, whose first box is ftyp. Returns the MP4, or nothing
# and why.
sub system_converted {
    my ($ts) = @_;
    my $folder = abs_path($DIR) // return (undef, 'no folder could be made for it');
    $folder .= '/convert.' . $$ . '.' . join('', map { sprintf '%02x', int rand 256 } 1 .. 6);
    (() = converting($folder, $AVCONVERT)) or return (undef, 'the folder for it has a name lzrprf does not pass on');
    mkdir($folder, 0700) or return (undef, 'no folder could be made for it');
    if (!mkdir("$folder/t", 0700)) { remove_tree($folder); return (undef, 'no folder could be made for it') }    # no empty folder is left
    my ($in, @result) = (undef, undef, 'the stream could not be written for the system\'s converter');
    if (sysopen($in, "$folder/in.ts", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) && (syswrite($in, $ts) // -1) == length $ts && close $in) {
        local $ENV{LZRPRF_TMPDIR} = "$folder/t/";
        local $SAID_INSIDE = 1;           # asked about while it runs, before it is waited for (sub said)
        (undef, my $ended) = said($CONVERT_SECONDS, converting($folder, '/usr/bin/perl', '-e', $GATE, $AVCONVERT, '--preset', 'PresetPassthrough', '--source', "$folder/in.ts", '--output', "$folder/out.mp4"));
        my ($mp4, $why) = ('', defined $ended ? 'the system\'s converter made no MP4 of it' : 'the system did not say that its converter was in its container');
        my ($read, $large) = $ended ? plain_read("$folder/out.mp4", $VIDEO_BYTES) : ();
        if (defined $read) { $mp4 = $read } elsif ($large) { $why = "the system's converter made an MP4 larger than lzrprf takes" }
        @result = substr($mp4, 4, 4) eq 'ftyp' ? ($mp4) : (undef, $why);
    }
    remove_tree($folder);
    return @result;
}

# The size an AVIF or HEIF file says its pictures have: the largest of the
# "ispe" boxes in meta, iprp, ipco (ISO/IEC 23008-12 6.5.3), read as boxes
# are, from the top, and nothing when they are not there. It decides only
# whether sips is told -Z on its first run: a size that is wrong costs a
# second run, or a picture smaller than it could be, and nothing more. [C21]
sub stated_size {
    my ($file) = @_;
    my @boxes = ([0, length $file]);      # where to look next: a range of the file that holds boxes
    my ($wide, $high) = (0, 0);
    for my $want ('meta', 'iprp', 'ipco', 'ispe') {
        my @found;
        for my $range (@boxes) {
            my ($at, $end) = @$range;
            while ($at + 8 <= $end) {
                my ($size, $type) = unpack('Na4', substr($file, $at, 8));
                $size = $end - $at if $size == 0;
                last if $size < 8 || $at + $size > $end;    # a box that says it is larger than what holds it ends the reading of that range
                push @found, [$at + 8 + ($type eq 'meta' ? 4 : 0), $at + $size] if $type eq $want;    # meta is a full box: a version and flags come first
                $at += $size;
            }
            last if @found > 64;
        }
        @boxes = @found or return;
    }
    for (@boxes) {
        my ($at, $end) = @$_;
        next unless $end - $at >= 12;
        my ($w, $h) = unpack('NN', substr($file, $at + 4, 8));    # after its version and flags
        ($wide, $high) = ($w, $h) if $w * $h > $wide * $high;
    }
    return $wide && $high ? ($wide, $high) : ();
}

# The folders of the system's decoder left by picture runs that were ended
# by number (sub pictured): each run names its folder decode.<its number>.
# And, at the start, those of runs whose process is no longer there.  [C21]
sub decoders_removed {
    my (@runs) = @_;
    my $at = abs_path($DIR) // return;
    opendir(my $list, $at) or return;
    my %ended = map { $_ => 1 } @runs;
    for (readdir $list) {
        my ($run) = /^(?:decode|convert)\.([1-9][0-9]{0,9})\.[0-9a-f]{12}\z/ or next;    # [C24] a converter's folder too, named by lzrprf's own number: at the start, one of an lzrprf that is gone
        remove_tree("$at/$_") if @runs ? $ended{$run} : !kill(0, $run) && $!{ESRCH};
    }
    closedir $list;
}

# A video of the page shown, when you click its place V [C22]: the kth MP4
# file or HLS stream of the page's =videos line, which the application named
# as it names pictures. Nothing of it is fetched before you click. Then it is fetched
# once, the way a picture is (sub pictured): a path from the page's own
# host, or an address on another site only when it stands in the page's
# own text, at most $PICTURE_SITES other sites for one page's pictures and
# videos together, "Block pictures from other sites" stops every one, its
# lines in the log first, through Tor when Tor is on, and never inside your
# own network. The request is the fixed request of a picture, with no Range:
# the whole file in one answer, at most $VIDEO_BYTES in $VIDEO_SECONDS, or
# the box says it is too large; an address ending .m3u8 is asked for at
# most $HLS_PLAYLIST, and so is an answer whose type says it is a playlist.
# An answer is refused as soon as its first bytes are not "HTTP/1.1 200 "
# (a 1xx head in front of it too, as sub body_of plays no other answer), and
# so is one whose head does not end within 64 KiB, an MP4 file's as well as
# a playlist's, so no head is long enough to hide a playlist's type. An
# answer that begins as an HLS playlist does
# ("#EXTM3U") is a stream, which sub hls_fetched follows and joins into one
# file. Any other answer that is not 200 or does not begin as an MP4 file
# does ("ftyp" as its first box) is no video. The window is given its bytes
# in base64, $VIDEO_FRAME at a time, "video TAB K begin LENGTH" (with " ts"
# after it for a joined MPEG-TS stream), parts, then "end", or "video TAB K
# none WORDS" for one line in the box; a stream locked by a key is said in
# the bottom bar too. The window holds the file in its memory and hands it to the system's
# video player, whose decoder service decodes it: a site's bytes now reach
# the operating system's decoder through the window, and nothing else of a
# site does (README, [C22]).
sub videoed {
    my ($k) = @_;
    $VIDEO_CLICKED = $k;
    my $back = strip_back();
    my $shown = $SHOWN;
    my $entry = $shown && $shown->{videos} ? $shown->{videos}[$k] : undef;
    my $none = sub { window("video $TAB $k none $_[0]"); $back->() };    # the one line the box shows in place of the video
    return $none->('This video is no longer on the page shown.') unless defined $entry;    # nothing is fetched
    my $host = $shown->{host};
    if (listed($entry =~ m{^/} ? "https://$host$entry" : $entry)) { refused("a video the page $host names", (keeping())[0]) or return $none->($UNWRITTEN); return $none->("$REFUSED $REFUSED_HELP") }    # [C23] nothing is looked up or fetched, and the box says why
    my ($url, $there) = $entry =~ m{^/} ? ("https://$host$entry") : address($entry);    # another host: checked as a typed address is
    return $none->('lzrprf does not fetch this address.') unless defined $url;
    if (my $filter = filter_said($url, 'media', $host)) { record("$url not fetched: $filter", (keeping())[0]) or return $none->($UNWRITTEN); return $none->("This video is not fetched: $filter.") }    # [C27] after [C23]: nothing is looked up or fetched
    my $other = defined $there && elsewhere($there, $host);
    open my $request, '>>', "$DIR/busy" or return $none->($UNWRITTEN);
    flock $request, LOCK_SH or return $none->($UNWRITTEN);    # as in visit: no line of this request falls into a clearing of the log
    my ($kept) = keeping();
    record("you clicked a video of the page $host: $url", $kept) or return $none->($UNWRITTEN);    # [C5] before the name is even looked up
    my $refused = sub { record("$url not fetched: $_[0]", $kept) or return $none->($UNWRITTEN); return $none->(ucfirst "$_[0].") };
    return $refused->("videos from other sites are blocked (Block pictures from other sites, in the cogwheel's menu, holds for videos too)") if $other && !pictures_elsewhere();    # [C4]
    return $refused->("the page $host does not name that address in its text") if $other && !named_in((body_of($shown->{got}) // '') =~ s/&amp;/&/gr, $there, $url);    # [C4] the application named it, and may be hostile
    my $sites = $shown->{sites} //= [];
    return $refused->("the page $host asks more than $PICTURE_SITES other sites for its pictures and videos, and lzrprf asks at most $PICTURE_SITES for one page") if $other && !grep({ $_ eq $there } @$sites) && @$sites >= $PICTURE_SITES;    # [C4]
    my $on = $there // $host;
    if ($on ne $host) { record("the page $host names a video on $on: $url", $kept) or return $none->($UNWRITTEN) }
    my $shield = shield_said($url);
    return $refused->(shield_why($shield)) if $shield ne 'allow';    # [C28] before a video's DNS lookup
    busy($TOR_WANTED ? "Asking Tor for $on." : "Looking up $on.");
    my ($to, $where_why) = $TOR_WANTED ? tor_where($on) : find($on);    # looked up at each click, the page's own host too: Tor turned on since the visit is taken, and a yes you gave once for a host of your own network is not
    if ($to && grep { $_->{own} } @$to) { ($to, $where_why) = (undef, "$on leads inside your own network (" . join(', ', map { $_->{text} } @$to) . '), where no video is fetched') }    # [C8] never for a video, and nothing is asked
    return $refused->($where_why // "$on is at no address lzrprf has") unless $to;
    push @$sites, $on if $other && !grep { $_ eq $on } @$sites;
    my $connects = $TOR_WANTED ? 'through Tor, one circuit for ' . ($there // $host) : 'to the first that answers of: ' . join(', ', map { $_->{text} } @$to);
    record("$url -> lzrprf connects $connects", $kept) or return $none->($UNWRITTEN);    # [C5] written down first, connected second
    busy("Fetching the video: $url");
    my ($until, $stop, $listed) = (now() + $VIDEO_SECONDS, video_stop(), $url =~ m{^https://[^/?]*/[^?]*\.m3u8(?:\?|\z)}i);    # one clock for all of this video: a stream's playlists and segments too are fetched within its 120 seconds
    my ($typed, $over) = (undef, undef);    # whether the answer's head says it is an HLS playlist, and whether more of it came than a playlist is read ('status' when it does not begin as an answer 200, 'head' when its head ran past 64 KiB)
    my $heard = sub {                     # the stop of the first request: yours, an answer that does not begin "HTTP/1.1 200 ", a head longer than 64 KiB, or a playlist by its type that grows past $HLS_PLAYLIST on the wire (the address's name already capped it when it ends .m3u8)
        return 1 if $stop->();
        my ($so_far) = @_;
        return 0 if $listed || !$so_far || defined $typed && !$typed || length $$so_far < 13;
        if (substr($$so_far, 0, 13) ne 'HTTP/1.1 200 ') { $over = 'status'; return 1 }    # sub body_of plays no other answer, so none other is read on: a 1xx head in front, in whatever spelling curl passes over, ends the request here with the rest
        my $end = index($$so_far, "\r\n\r\n");
        if (($end < 0 ? length $$so_far : $end + 4) > 65536) { $over = 'head'; return 1 }    # the head ends within 64 KiB of the answer's first byte, or it is refused: no head is long enough to pass the cap below unread
        return 0 if $end < 0;
        $typed //= substr($$so_far, 0, $end) =~ m{^content-type:[ \t]*(?:application/vnd\.apple\.mpegurl|application/x-mpegurl|audio/mpegurl|audio/x-mpegurl)[ \t]*(?:;|\r?$)}mi ? 1 : 0;
        return $over = $typed && length($$so_far) - $end - 4 > $HLS_PLAYLIST ? 1 : 0;
    };
    my ($got, $why, $from) = fetch($url, $to, undef, undef, [$listed ? $HLS_PLAYLIST : $VIDEO_BYTES, $VIDEO_SECONDS], $heard);    # [C6] [C7] the fixed request, no Range; an address that ends in .m3u8 is asked for no more than a playlist, and so is an answer whose type says it is one
    ($why, $listed) = $over eq 'status' ? ('the site did not answer it with the file (200)', 0) : $over eq 'head' ? ("the site's answer has a head longer than the 64 KiB lzrprf reads", 0) : ('the answer is larger than lzrprf takes', 1) if $over;
    if (defined $why && $why eq 'you stopped it') { record("$url failed: you stopped it", $kept) or return $none->($UNWRITTEN); window("video $TAB $k stopped"); return $back->() }    # its mark is back, and a click fetches it again
    my $body = $why ? undef : body_of($got);
    my $large = defined $why && $why eq 'the answer is larger than lzrprf takes';
    my ($kind, $how) = ('', '');          # " ts" for an MPEG-TS stream, which the window plays as one; and the words of the note on what of a stream was played
    if (defined $body && $body =~ /\A(?:\xEF\xBB\xBF)?#EXTM3U\r?\n/ || $large && $listed) {    # an HLS playlist, by what the site answered, not by its name (sub hls_fetched)
        my ($stream, $words, $locked);
        if ($large) { $words = 'this playlist is larger than the ' . ($HLS_PLAYLIST >> 10) . ' KiB lzrprf reads' }
        else {
            record("$url answered: a playlist of " . length($body) . " bytes from $from", $kept) or return $none->($UNWRITTEN);
            ($stream, $words, $locked, $kind, $how) = hls_fetched($url, $to, $connects, $body, $kept, $until, $stop);
        }
        return $none->($UNWRITTEN) if defined $words && $words eq $UNWRITTEN;
        if (defined $words && $words eq $REFUSED_WHY) {    # [C23] an address the playlist names is on the list: the box says so as for a listed video, naming no address
            close $request;
            window("video $TAB $k none " . (refused('an address a playlist of a video names', $kept) // return $none->($UNWRITTEN)));
            return $back->();
        }
        if (defined $words && $words eq 'you stopped it') { record("$url failed: you stopped it", $kept) or return $none->($UNWRITTEN); window("video $TAB $k stopped"); return $back->() }
        if (defined $words) {
            record("$url not played: $words", $kept) or return $none->($UNWRITTEN);
            close $request;
            window("video $TAB $k none " . ucfirst "$words.");
            return $back->($locked ? "A video of this page is locked ($locked): lzrprf plays no video locked by DRM or a key." : undef);    # [C22] said in the bottom bar too, where it stays for the page
        }
        if ($kind eq ' ts' && ts_sounds($stream)) {    # [C24] a stream with sound, which the window's player reads only as an MP4
            busy("Making an MP4 of the video's stream: $url");
            my ($mp4, $failed) = system_converted($stream);
            if (!defined $mp4) {
                record("$url not played: a stream of " . length($stream) . " bytes$how, which $failed", $kept) or return $none->($UNWRITTEN);
                close $request;
                window("video $TAB $k none This stream has sound, and the system could not make an MP4 of it for the window.");
                return $back->();
            }
            ($how, $kind) = ("$how, made into an MP4 by the system's avconvert from those " . length($stream) . " bytes, its pictures and sound copied as they came", '');
            $stream = $mp4;
        }
        record("$url played: a stream of " . length($stream) . " bytes$how; the window plays it", $kept) or return $none->($UNWRITTEN);
        $body = $stream;
    } else {
        $why //= !defined $body ? 'the site did not answer it with the file (200)' : substr($body, 4, 4) ne 'ftyp' ? 'it is not an MP4 file or an HLS playlist' : undef;
        record("$url " . (defined $why ? 'failed: ' . ($large ? "the video is larger than the $VIDEO_BYTES bytes lzrprf takes" : $why) : 'answered: ' . length($got) . " bytes from $from; the window plays it"), $kept) or return $none->($UNWRITTEN);
        return $none->($large ? 'This video is larger than the ' . ($VIDEO_BYTES >> 20) . ' MiB lzrprf hands to the window.' : 'No video: ' . $why . '.') if defined $why;
    }
    close $request;
    window("video $TAB $k begin " . length($body) . $kind);
    for (my $at = 0; $at < length $body; $at += $VIDEO_FRAME) { window("video $TAB $k part " . encode_base64(substr($body, $at, $VIDEO_FRAME), '')) }
    window("video $TAB $k end");
    video_sound_kept($k, \$body, $url);    # [C22] for its sound, which plays in the sound process once you turn it on
    noted("The video $url came: " . length($body) . " bytes$how, played in the window by the system.");
    return $back->();
}

# An HLS stream of a video you clicked [C22], from its playlist: lzrprf
# follows it itself, as Safari's native HLS does, and hands the window one
# file. Every address a playlist names (each quality's playlist, the stream's
# start, EXT-X-MAP, and each segment) is made whole against the address of
# the playlist that names it (sub hls_address) and taken only when it is
# https, on port 443, on the very host of the first playlist: nothing of a
# stream changes the site or the scheme, and every address of a playlist is
# checked before the first of them is fetched. A master playlist offers at
# most $HLS_VARIANTS qualities; one is chosen up front, the middle of those at
# or under $HLS_BITRATE bits a second (the lower of two in the middle), or the
# lowest when none is, and only it is fetched. A playlist is at most
# $HLS_PLAYLIST bytes and lists at most $HLS_SEGMENTS segments. A locked
# stream is refused before anything more of it is fetched: an EXT-X-KEY or
# EXT-X-SESSION-KEY whose METHOD is not NONE (AES-128, SAMPLE-AES, FairPlay's
# com.apple.streamingkeydelivery). A stream in parts of a file
# (EXT-X-BYTERANGE), which a request with no Range cannot take, is refused
# too. The segments are fetched in order, each written in the log first, by
# the fixed request of a picture, at the addresses the host was looked up at
# for this click (through Tor when it is on), within the one clock and cap
# of the video ($VIDEO_SECONDS, $VIDEO_BYTES, the playlists counted in); when
# the cap or the clock is reached, or a later segment fails, what came is
# played and the note says how much. MPEG-TS segments are joined into one
# MPEG-TS file; fragmented MP4 segments follow their start into one
# fragmented MP4 file. The system's player plays either as one file through
# the window's loader: it does not take an HLS stream's segments from a
# loader at all ("custom url not redirect", CoreMediaErrorDomain -12881,
# measured 2026-11-21 on macOS 27.2), and the window has no network of its
# own to give it. A live stream (no EXT-X-ENDLIST) plays the segments it
# listed at the click, once. Nothing of it is written to a file. Returns the
# stream, no words, '', the kind (" ts" or '') and the words of what was
# played; or nothing and why it is not played, with the key's METHOD for a
# locked stream.
sub hls_fetched {
    my ($url, $to, $connects, $text, $kept, $until, $stop) = @_;
    my ($on) = $url =~ m{^https://([^/?]+)};
    my $left = $VIDEO_BYTES - length $text;
    my $failed = sub { $_[0] eq 'the answer is larger than lzrprf takes' ? 'this stream is larger than the ' . ($VIDEO_BYTES >> 20) . ' MiB lzrprf takes' : now() >= $until - 0.5 ? "this stream took more than the $VIDEO_SECONDS seconds lzrprf gives a video" : "a part of this stream failed: $_[0]" };
    my $get = sub {                       # one more address of the stream, on the host looked up for the click: written in the log first; its body, or nothing and why
        my ($address, $what, $most) = @_;
        my $seconds = $until - now();
        return (undef, "this stream took more than the $VIDEO_SECONDS seconds lzrprf gives a video") if $seconds < 0.5;
        return (undef, 'the answer is larger than lzrprf takes') if $left <= 0;
        record("$address -> lzrprf connects $connects, for $what of the stream $url", $kept) or return (undef, $UNWRITTEN);    # [C5] written down first, connected second
        my ($got, $why) = fetch($address, $to, undef, undef, [$most && $most < $left ? $most : $left, sprintf('%.1f', $seconds)], $stop);    # [C6] [C7]
        my $body = defined $why ? undef : body_of($got);
        $why //= 'the site did not answer it with the file (200)' unless defined $body;
        record("$address " . (defined $why ? "failed: $why" : 'answered: ' . length($body) . ' bytes'), $kept) or return (undef, $UNWRITTEN);
        return (undef, $why) if defined $why;
        $left -= length $body;
        return $body;
    };
    my @lines = hls_lines($text) or return (undef, 'this playlist is not one lzrprf reads');
    my $locked = hls_locked(@lines);
    return (undef, "this video is locked ($locked), and lzrprf plays no locked video", $locked) if $locked;
    my ($playlist, $how, $apart) = ($url, '', 0);
    if (grep { /^#EXT-X-STREAM-INF:/ } @lines) {    # a master playlist: its qualities
        my (@offered, @named, %sound);
        for my $i (0 .. $#lines) {
            if ($lines[$i] =~ /^#EXT-X-MEDIA:(.*)/) {    # a rendition apart: its address is checked as any, and it is never fetched
                my %is = hls_attributes($1);
                push @named, $is{URI} if defined $is{URI};
                push @{ $sound{ $is{'GROUP-ID'} // '' } }, defined $is{URI} if ($is{TYPE} // '') eq 'AUDIO';
            }
            next unless $lines[$i] =~ /^#EXT-X-STREAM-INF:(.*)/;
            my %is = hls_attributes($1);
            my $uri = $lines[$i + 1];
            return (undef, 'this playlist names a quality with no address') unless defined $uri && $uri !~ /^#/;
            return (undef, 'this playlist names a quality without its BANDWIDTH') unless ($is{BANDWIDTH} // '') =~ /^[0-9]{1,10}\z/;
            push @offered, { bits => $is{BANDWIDTH}, uri => $uri, sound => $is{AUDIO} };
        }
        return (undef, "this playlist offers more than the $HLS_VARIANTS qualities lzrprf reads") if @offered > $HLS_VARIANTS;
        for my $uri (map({ $_->{uri} } @offered), @named) { my $at = hls_address($uri, $url, $on); return (undef, $REFUSED_WHY) if hls_listed($uri, $url, $on); defined $at or return (undef, hls_away($uri, $on)) }    # [C22] every address, before any is fetched; [C23] a listed one is refused before anything names its host
        my @by = sort { $a->{bits} <=> $b->{bits} } @offered;
        my @under = grep { $_->{bits} <= $HLS_BITRATE } @by;
        my $chosen = @under ? $under[$#under >> 1] : $by[0];
        my $rate = sprintf('%.2f Mbit/s', $chosen->{bits} / 1e6);
        $playlist = hls_address($chosen->{uri}, $url, $on);
        $how = ", the quality of $rate (" . (1 + grep { $_->{bits} < $chosen->{bits} } @by) . ' of ' . @by . ')';
        my $group = $sound{ $chosen->{sound} // "\n" };
        $apart = $group && !grep { !$_ } @$group;    # its sound only in streams apart, which lzrprf does not join
        my ($media, $why) = $get->($playlist, "the playlist of the quality of $rate", $HLS_PLAYLIST);
        return (undef, $why eq 'the answer is larger than lzrprf takes' ? 'this playlist is larger than the ' . ($HLS_PLAYLIST >> 10) . ' KiB lzrprf reads' : $why =~ /^(?:\Q$UNWRITTEN\E|you stopped it)\z/ ? $why : $failed->($why)) unless defined $media;
        @lines = hls_lines($media) or return (undef, 'the playlist of its quality is not one lzrprf reads');
        return (undef, 'the playlist of its quality offers qualities again') if grep { /^#EXT-X-STREAM-INF:/ } @lines;
        $locked = hls_locked(@lines);
        return (undef, "this video is locked ($locked), and lzrprf plays no locked video", $locked) if $locked;
    }
    return (undef, 'this stream is in parts of a file (EXT-X-BYTERANGE), which lzrprf does not fetch') if grep { /^#EXT-X-BYTERANGE:/ || /^#EXT-X-MAP:.*BYTERANGE=/ } @lines;
    my ($start, @segments);
    for (@lines) {
        if (/^#EXT-X-MAP:(.*)/) {
            my %is = hls_attributes($1);
            return (undef, 'this stream names a start (EXT-X-MAP) with no address') unless defined $is{URI};
            return (undef, 'this stream has more than one start (EXT-X-MAP), which lzrprf does not join') if defined $start && $start ne $is{URI};
            $start = $is{URI};
        }
        elsif (!/^#/) { push @segments, $_ }
    }
    return (undef, "this stream lists more than the $HLS_SEGMENTS segments lzrprf reads") if @segments > $HLS_SEGMENTS;
    return (undef, 'this stream lists no segment') unless @segments;
    my @at;
    for my $uri (defined $start ? $start : (), @segments) { my $at = hls_address($uri, $playlist, $on); return (undef, $REFUSED_WHY) if hls_listed($uri, $playlist, $on); push @at, $at // return (undef, hls_away($uri, $on)) }    # [C22] every address, before any is fetched; [C23] a listed one is refused before anything names its host
    shield_asked(@at);                    # [C28] every part of the stream judged before the first is fetched
    my $stream = '';
    if (defined $start) {
        my ($first, $why) = $get->(shift @at, 'the start of its segments');
        return (undef, $why =~ /^(?:\Q$UNWRITTEN\E|you stopped it)\z/ ? $why : $failed->($why)) unless defined $first;
        return (undef, 'the start of this stream is not an MP4 file') unless substr($first, 4, 4) eq 'ftyp';
        $stream = $first;
    }
    my ($came, $short) = (0, '');
    for my $n (0 .. $#at) {
        my ($piece, $why) = $get->($at[$n], 'segment ' . ($n + 1) . ' of ' . @at);
        if (!defined $piece) {
            return (undef, $why) if $why eq $UNWRITTEN || $why eq 'you stopped it';
            return (undef, $failed->($why)) unless $came;
            $short = '; ' . $failed->($why) =~ s/^this stream/the rest/r =~ s/^a part of this stream failed/the rest was not fetched/r;
            last;
        }
        return (undef, 'segment ' . ($n + 1) . ' of this stream is neither MPEG-TS nor a part of an MP4 file') unless defined $start ? substr($piece, 4, 4) =~ /^(?:styp|moof|sidx|emsg|prft)\z/ : length($piece) >= 188 && substr($piece, 0, 1) eq "\x47" && (length($piece) < 376 || substr($piece, 188, 1) eq "\x47");
        $stream .= $piece;
        $came++;
    }
    my $live = !grep { $_ eq '#EXT-X-ENDLIST' } @lines;
    $how .= ", $came of its " . @at . ' segments' . ($live ? ' listed when you clicked, of a live stream,' : '') . (defined $start ? ' after its start, as one MP4 file' : ', as one MPEG-TS file') . $short . ($apart ? '; its sound is a stream apart, which lzrprf does not join, so it plays without sound' : '');
    return ($stream, undef, '', defined $start ? '' : ' ts', $how);
}

# The lines of an HLS playlist (RFC 8216 §4.1), or none when it is not one
# lzrprf reads: at most $HLS_PLAYLIST bytes of text, with no byte below a
# space but tab and the ends of lines, no line longer than $HLS_LINE, its
# first line #EXTM3U. Blank lines are taken out, and the spaces at the two
# ends of a line. Every pattern here and in sub hls_attributes reads a line
# once from its start: none goes back over what it read, so a playlist the
# site made to be slow to read is read as fast as any (a line of 262,000
# spaces took a pattern that went back about 15 minutes).
sub hls_lines {
    my ($text) = @_;
    $text =~ s/\A\xEF\xBB\xBF//;
    return if length($text) > $HLS_PLAYLIST || $text =~ /[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]/;
    my @lines;
    for my $line (split /\n/, $text) {
        return if length $line > $HLS_LINE;    # refused before anything else reads it
        my ($from, $to) = (0, length $line);
        $from++ while $from < $to && substr($line, $from, 1) =~ tr/ \t//;
        $to-- while $to > $from && substr($line, $to - 1, 1) =~ tr/ \t\r//;
        push @lines, substr($line, $from, $to - $from) if $to > $from;
    }
    return unless @lines && $lines[0] eq '#EXTM3U';
    return @lines;
}

# The attributes of one tag of a playlist: NAME=value, or NAME="text" (RFC
# 8216 §4.2), the first of a name when it stands twice.
sub hls_attributes {
    my ($list) = @_;
    my %is;
    while ($list =~ /\G[ \t]*+([A-Z0-9-]++)=("[^"\r\n]*+"|[^",]*+)[ \t]*+(?:,|\z)/gc) {    # possessive: nothing read is read again
        my ($name, $value) = ($1, $2);
        if (substr($value, 0, 1) eq '"') { $value = substr($value, 1, -1) }
        else { my $to = length $value; $to-- while $to && substr($value, $to - 1, 1) =~ tr/ \t//; $value = substr($value, 0, $to) }    # the spaces after an unquoted value
        $is{$name} //= $value;
    }
    return %is;
}

# The METHOD of a key that locks a stream, when one does: an EXT-X-KEY or
# EXT-X-SESSION-KEY whose METHOD is not NONE, with FairPlay named when its
# KEYFORMAT is com.apple.streamingkeydelivery; '' when none does. [C22]
sub hls_locked {
    for (@_) {
        next unless /^#EXT-X-(?:SESSION-)?KEY:(.*)/;
        my %is = hls_attributes($1);
        my $method = $is{METHOD} // '';
        next if $method eq 'NONE';
        $method =~ s/[^A-Za-z0-9-]//g;
        return 'EXT-X-KEY METHOD=' . (length $method ? substr($method, 0, 20) : '?') . (($is{KEYFORMAT} // '') eq 'com.apple.streamingkeydelivery' ? ', FairPlay' : '');
    }
    return '';
}

# An address a playlist names, made whole against the address of that
# playlist (RFC 3986 §5.2: a whole https address, //host/path, /path, ?query
# or a path beside the playlist's, with . and .. taken out), and taken only
# as a typed address is (sub address) and only on the host $on: so by
# https, on port 443, never on another site. Nothing when it is not. [C22]
sub hls_address {
    my ($ref, $base, $on) = @_;
    return if $ref =~ /[^\x21-\x7e]/ || length $ref > 2000;
    my $whole = hls_whole($ref, $base, $on) // return;
    my ($head, $path, $query) = $whole =~ m{^(https://[^/?]+)(/[^?]*)?(\?.*)?\z}s or return;    # another scheme is no address here
    my @kept;
    my @parts = split m{/}, $path // '/', -1;
    for my $i (1 .. $#parts) {
        if ($parts[$i] eq '..') { pop @kept if @kept }
        elsif ($parts[$i] ne '.') { push @kept, $parts[$i] }
        push @kept, '' if $i == $#parts && ($parts[$i] eq '.' || $parts[$i] eq '..');
    }
    my ($url, $there) = address($head . '/' . join('/', @kept) . ($query // '')) or return;
    return $there eq $on ? $url : undef;
}

# The whole address a playlist's reference stands for: as written when it
# names its own scheme (https:// with //), else where it leads on the
# playlist's host. Shared by sub hls_address and sub hls_listed.
sub hls_whole {
    my ($ref, $base, $on) = @_;
    $ref =~ s/#.*//s;
    my ($beside) = $base =~ m{^https://[^/?]+(/[^?]*)} or return;
    return $ref =~ m{^[A-Za-z][A-Za-z0-9+.-]*:} ? $ref : $ref =~ m{^//} ? "https:$ref" : $ref =~ m{^/} ? "https://$on$ref" : $ref =~ m{^\?} ? "https://$on$beside$ref" : "https://$on" . ($beside =~ s{[^/]*\z}{}r) . $ref;
}

# [C23] Whether an address a playlist names is on the list, read from the
# reference itself and not from what hls_address made of it: sub address gives
# nothing for a listed address, so a listed path on the playlist's own host
# would otherwise read as one lzrprf does not follow. Asked before sub
# hls_away, whose words name the host, so a listed host or path is never named
# in the window or the log: the box gets the sentence of [C23].
sub hls_listed {
    my ($ref, $base, $on) = @_;
    my $whole = hls_whole($ref, $base, $on) // $ref;    # whatever its bytes or its length: sub listed reads it loosely, and one too long to read is listed
    return listed($whole);
}

# Why an address a playlist names is not taken, in a few words that name
# its scheme and its host and nothing more: never its path, its query or a
# name and password before its host, which may hold a key of the site's,
# and which a log of hosts alone must not hold [C12]. An address on the
# playlist's own host written with HTTPS in capitals is not taken either:
# sub address takes https in small letters alone, so it fails closed, and is
# said as an address lzrprf does not follow. [C22]
sub hls_away {
    my ($ref, $on) = @_;
    my ($scheme) = $ref =~ m{^([A-Za-z][A-Za-z0-9+.-]{0,15}):};
    my ($there) = $ref =~ m{^(?:[A-Za-z][A-Za-z0-9+.-]*:)?//(?:[^/?#@]*+@)?([^/?#:@]{1,253})};
    return $REFUSED_WHY if listed($ref) || defined $there && listed("https://$there/");    # [C23] a listed host is never named here, however hls_listed was reached
    $there = lc($there =~ s/[^\x21-\x7e]/?/gr) if defined $there;
    my $where = (defined $scheme ? lc($scheme) . ':' : '') . (defined $there ? "//$there" : '');
    return "this playlist names an address that is not https ($where), and lzrprf follows a stream only by https" if defined $scheme && lc($scheme) ne 'https';
    return "this playlist names an address on another site ($there), and lzrprf follows a stream only on the site of its playlist, $on" if defined $there && $there ne $on;
    return 'this playlist names an address lzrprf does not follow' . (length $where ? " ($where)" : '');
}

# Whether you stopped the video being fetched: "video stop", said from its
# box while it loads, as "tor off" is heard while Tor connects (sub tor_on).
# The window is listened to at most four times a second, and only for what
# it said since: what it said before, and anything but the stop, is kept in
# its order for the loop of sub behind. A window that is gone stops it too.
sub video_stop {
    my $next = 0;
    return sub {
        return 0 if now() < $next || !$FROM && !@EVENTS;    # "lzrprf try": the test's next line, when there is one
        $next = now() + 0.25;
        my ($before, $stop, @heard) = ([splice @HELD], 0);
        my $wait = 0.01;
        while ($FROM || @EVENTS) {        # every line that is ready, read before the stop is looked for, so a stop behind another line is never left for the next poll
            my $event = hear($wait);
            if (!defined $event) { $stop = 1; last }    # the window is gone
            last unless length $event;
            if ($event eq 'video stop' && !$stop) { $stop = 1 } else { push @heard, $event }    # what came after the stop is for after this fetch, a second stop too
            $wait = 0.001;
            last if now() > $next;        # a quarter of a second at most: the rest is read at the next poll
        }
        @HELD = (@$before, @heard);
        return $stop;
    };
}

# Whether the page's own text names an address of another site as it is:
# "//", the host in any case, then the path and query exactly, and nothing
# that could still be part of an address right after it (any character an
# address may hold, RFC 3986), so a page that names /a.png?x=1 does not name
# /a.png?x= or /a.png, nor /a.png when it names /a.png;x or /a.png(1). Two
# ends are read as the page wrote them: an address that opens after ' ends
# at the next ', as in src='...', and one that opens after ( ends at ), as
# in url(...). $text is the body of the page's answer, without the site's
# headers, &amp; read as &. [C4]
sub named_in {
    my ($text, $there, $url) = @_;
    my $rest = substr($url, 8 + length $there);
    my $more = qr{[A-Za-z0-9._~/%?=&,;+!*'()\@\$:\[\]-]};
    return $text =~ m{(?:(')|(\()|)(?i:https:)?(?i://\Q$there\E)\Q$rest\E(?(1)(?='|(?!$more))|(?(2)(?=\)|(?!$more))|(?!$more)))};
}

# Whether a picture's host is another site than the page's: neither the page's
# host, nor that host without "www." (example.com for a page of
# www.example.com), nor a name under it (sub under). [C4]
sub elsewhere {
    my ($there, $host) = @_;
    return $there ne $host && $there ne ($host =~ s/^www\.//r) && !under($there, $host);
}

# Whether a host is a name under a page's host: the page's host with "www."
# taken off, a dot before it, and one name or more in front. Only who holds a
# name can give out the names under it, so a picture there comes from the site
# you visit, and such a host is not counted among the $PICTURE_SITES other
# sites a page's pictures may come from. [C4]
sub under {
    my ($there, $host) = @_;
    my $own = $host =~ s/^www\.//r;
    return $own =~ /\./ && length $there > length($own) + 1 && substr($there, -length($own) - 1) eq ".$own";
}

# A size of the window's page: "view", its width and its height in points,
# each a number in its one form. The page is never laid at the window's own
# size, which differs from one computer to the next and would tell a site who
# you are: the width is taken to the nearest step of 160 points and the height
# to the nearest step of 128, so every window of about that size lays every
# page at one of a few sizes, the same on every computer, and the window fits
# the laid page to itself (function fit). A size outside the bounds a page is
# laid in is taken as the nearer bound. Anything else is no size. Returns
# whether the line was one.
my @VIEW_STEP = (160, 128);
sub viewing {
    my ($event) = @_;
    my ($wide, $high, $scale) = $event =~ /^view ([1-9][0-9]{0,4}) ([1-9][0-9]{0,4})(?: (2))?$/ or return; $VIEW_SCALE = $scale ? 2 : 1;
    @TRMNL_VIEW = ($wide, $high);
    cht_sized($TABS[$TAB]) if $TABS[$TAB]{cht};    # [C32] LZRCHT is drawn at that size too
    trmnl_relaid($TABS[$TAB]) if $TABS[$TAB]{trmnl};    # [C29] a terminal fills the page as it is, not as a page is laid: its panes laid out again in it
    ($wide, $high) = map { my $step = $VIEW_STEP[$_]; $step * int(($_ ? $high : $wide) / $step + 0.5) } 0, 1;
    @VIEW = ($wide < $VIEW_WIDE[0] ? $VIEW_WIDE[0] : $wide > $VIEW_WIDE[1] ? $VIEW_WIDE[1] : $wide, $high < $VIEW_HIGH[0] ? $VIEW_HIGH[0] : $high > $VIEW_HIGH[1] ? $VIEW_HIGH[1] : $high);
    delete $_->{scroll_clamp} for @LIVE;    # [C18] the window's page has another size, so its end is somewhere else: where it stopped short of a page's place says nothing now
    return 1;
}

# The page shown, laid out again at the width the window's page has now: the
# same answer and the same frame of style sheets that were kept when it was
# shown, in a page container as every run. lzrprf fetches no picture and no
# style sheet for it; but the run is a page run in a =live frame, so a page
# that is read with the network asks again, while it is read, for the
# external and module scripts it names, and each such request is written in
# the log and fetched as any request of a page kept running [C19]. Its pictures are the ones
# decoded then, placed where the new layout puts them; a place no picture was
# decoded for stays a grey box. One run at a time: before each run every size
# said so far is read, the latest kept, and the rest of what was said is heard
# after, in its order; and while it runs the window is heard the same way, so a
# newer width ends the run at once (sub outrun). The window says a size when a
# drag pauses for 120 ms too, so the page is laid at the drag's width while the
# button is held, and a release at that width costs the window only the swap. A run that is unfit, late or too large, or a second run that names
# style sheets again, leaves the page as it is shown, scaled by the window;
# that width is not tried again until another is said. The window keeps the
# place it was read at, as a share of the page's height ("relaid").
sub relaid {
    while ($SHOWN && ($SHOWN->{wide} != $VIEW[0] || ($SHOWN->{scale} // 1) != $VIEW_SCALE) && alive()) {    # another width, or the same on a screen of another scale
        if ($FROM) {
            my @later;
            while (defined(my $more = hear(0))) { last if $more eq ''; push @later, $more unless viewing($more) }
            push @HELD, @later;
            last if $SHOWN->{wide} == $VIEW[0] && ($SHOWN->{scale} // 1) == $VIEW_SCALE;    # the latest size is the width and scale shown already
        }
        $SHOWN->{wide} = $VIEW[0]; $SHOWN->{scale} = $VIEW_SCALE;
        my $kept = live_of($TABS[$TAB]);
        if ($kept && $kept->{wide} == $VIEW[0] && ($kept->{scale} // 1) == $VIEW_SCALE && $kept->{shown}) { window("relaid $TAB", @{ $kept->{shown} }, '.'); $kept->{unsent} = 0; $DRAWN = 1; next }    # the page kept running was laid at this width: its last drawing, as its scripts left it, and nothing is laid out
        $OUTRUN = 1; my @again = laid_out($SHOWN->{url}, $SHOWN->{got}, $SHOWN->{frame}, 1, $TABS[$TAB]{kept_app}); $OUTRUN = 0;    # a newer size said while it runs ends it ('outrun'), and the newest is laid next
        if (!$again[0] || $SHOWN->{two} && @{ $again[4] }) { live_dropped($again[5]); next }    # not shown: the page as it is shown stays, and so does the run kept running with it
        my ($shown) = pictured($again[0], $again[2], $SHOWN->{host}, undef, undef, $SHOWN->{pictures});
        window("relaid $TAB", @$shown, '.');
        $SHOWN->{list} = $shown;
        $SHOWN->{videos} = $again[6];     # [C22] the videos of the page as it is laid now, which a click names by number
        $DRAWN = 1;
        live_end($kept, 'it was laid out anew at another width', 1) if $kept;    # the new run is the page kept running now, laid at the width shown
        live_kept($again[5], $TABS[$TAB], $again[0], $again[2], $SHOWN->{host}, $SHOWN->{pictures}, $shown, $again[6]) if $again[5];
    }
    $CURL_WANTED = 1;
    if ($SHOWN && !$TABS[$TAB]{kept_app}) { $SPARE_WANTED = $SHOWN->{url} } else { spare_dropped() }    # a process for the page shown's next run, at the next quiet moment (sub spare_work); none waits for a page that is not shown
    live_told();
}

# The tabs. The window shows them in a strip of lzrprf's own above the bar,
# where no page draws, and says which you chose in one of three lines: "tab
# new", "tab select N" and "tab close N", N a tab that is there, in its one
# form; a fourth, "tab move FROM TO", moves a tab among the others (sub tab_moved). Each tab keeps its own page as $SHOWN keeps it (its address, its
# answer, the frame of style sheets it was laid with, its decoded pictures),
# its title, the addresses it went to, and lzrprf's last words in it. Only the
# selected tab's page is shown: choosing another clears the page and lays the
# chosen tab's page out again from what it kept, at the window's width (sub
# relaid), so nothing is fetched and nothing is written to the log. At most
# $TABS_MOST tabs; closing the last one leaves one empty tab. A new tab opens
# the home page when one is set, and is empty otherwise. After every such
# line lzrprf tells the window all the tabs again: "tabs COUNT SELECTED" and a
# line "title N TEXT" for each, the text checked by sub checked.
sub tabbed {
    my ($how, $n, $kept, $pulled) = @_;
    $TABS[$TAB]{shown} = $SHOWN;
    my $opened;
    if ($how eq 'new' && !defined $n && @TABS < $TABS_MOST) { push @TABS, fresh_tab(); $TAB = $#TABS; $opened = 1; noted('you opened a new tab') }
    elsif ($how eq 'select' && defined $n && $n < @TABS) { $TAB = $n }
    elsif ($how eq 'close' && defined $n && $n < @TABS) {
        my $live = live_of($TABS[$n]);
        live_end($live, 'its tab was closed', 1) if $live;
        cht_end($TABS[$n], 'its tab was closed') if $TABS[$n]{cht};    # [C32]
        trmnl_end($TABS[$n], 'its tab was closed') if $TABS[$n]{trmnl};    # [C29]    # at once: a closed tab's page is not waited for, and the window is not kept waiting the moment it took to end by itself (17 to 40 ms a close, measured 2026-11-23)
        noted(($pulled ? 'you pulled a tab out into a new window' : 'you closed a tab') . (length($TABS[$n]{url} // '') ? ": $TABS[$n]{url}" : ''));
        my ($gone) = splice @TABS, $n, 1;
        undef $PICTURES_BEFORE if $PICTURES_BEFORE && $PICTURES_BEFORE->{tab} == $gone;    # a closed tab keeps nothing for a first list
        closed_kept($gone, $n) unless $pulled;
        @TABS = (fresh_tab()) unless @TABS;
        $TAB-- if $TAB > $n || $TAB > $#TABS;
    }
    $SHOWN = $TABS[$TAB]{shown};
    tab_shown($how eq 'new' && !$opened ? "A window holds $TABS_MOST tabs at most: close one to open another." : undef, $how ne 'new' && $kept);    # a close the window showed at once, with the drawing it kept of the tab now shown, is "kept" as a select is
    my $home = $opened && home();
    go($home, 'you opened your home page') if $home;    # [C4] the address kept from the bar when you made it the home page
}

# A closed tab, kept for "Reopen Closed Tab" (Cmd-Shift-T) with its place: at most $CLOSED_MOST, the
# newest first, in the memory of this process and nowhere else, so an incognito window writes
# nothing for them either. Only the $CLOSED_DRAWN newest keep their page; an older one keeps its
# address, title and history, and is visited again when reopened. A tab with no address is not kept.
sub closed_kept {
    my ($tab, $at) = @_;
    return unless length($tab->{url} // '');
    unshift @CLOSED, [$at, $tab];
    splice @CLOSED, $CLOSED_MOST if @CLOSED > $CLOSED_MOST;
    $_->[1]{shown} = undef for @CLOSED[$CLOSED_DRAWN .. $#CLOSED];
}

# "tab reopen": the tab closed last, put in again at its old place (or last, when fewer tabs stand
# now) and chosen, with its page when lzrprf still has it, laid out again at the window's width
# when it was kept at another (sub relaid); else its address is visited, written in the log first.
sub tab_reopened {
    my $one = shift @CLOSED or return idle('No closed tab to reopen in this window.');
    if (@TABS >= $TABS_MOST) { unshift @CLOSED, $one; return idle("A window holds $TABS_MOST tabs at most: close one to reopen another.") }
    my ($at, $tab) = @$one;
    $TABS[$TAB]{shown} = $SHOWN;
    $at = @TABS if $at > @TABS;
    splice @TABS, $at, 0, $tab;
    $TAB = $at;
    $SHOWN = $tab->{shown};
    noted("you reopened a closed tab $tab->{url}") if $SHOWN;    # the same line "sub go" writes for one that is visited again
    tab_shown();
    go($tab->{url}, 'you reopened a closed tab') unless $SHOWN;    # [C4] an address this tab went to already
}

# The lists sent for the tabs' pages are kept for the $LISTS_KEPT tabs shown last, so a tab chosen
# again is sent its drawing and the application is not run; the others are laid out again when chosen.
# A list holds its pictures as text, so this bounds what lzrprf holds for tabs nobody looks at.
sub lists_bounded {
    my @kept = sort { $b->{used} <=> $a->{used} } grep { $_ && $_->{list} } map { $_ == $TAB ? $SHOWN : $TABS[$_]{shown} } 0 .. $#TABS;
    delete $_->{list} for @kept[$LISTS_KEPT .. $#kept];
}

# A tab dragged along the strip: "tab move FROM TO" takes the tab at FROM out and puts it in at TO,
# both tabs that are there. The selected tab stays the selected one, wherever it now stands, and its
# page stays shown: nothing is laid out again, nothing fetched, nothing written. The window is told
# the tabs again, as after every line of the strip.
sub tab_moved {
    my ($from, $to) = @_;
    return if $from >= @TABS || $to >= @TABS || $from == $to;
    my $chosen = $TABS[$TAB];
    my ($one) = splice @TABS, $from, 1;
    splice @TABS, $to, 0, $one;
    ($TAB) = grep { $TABS[$_] == $chosen } 0 .. $#TABS;
    window('tabs ' . @TABS . " $TAB", map { "title $_ $TABS[$_]{title}" } 0 .. $#TABS);
}

# A tab is shown at once, and the application is not run for it when its drawing was kept: the
# window shows the drawing it kept itself when it says "kept", and nothing of the page is sent; else
# lzrprf sends the list it kept, when it was laid at the width the window has now. Only a page kept
# at another width, or one whose list was let go (sub lists_bounded), is laid out again (sub relaid),
# with the page of the tab before cleared first. A page kept running that drew again while its tab
# was not shown is sent its new drawing.
sub tab_shown {
    my ($says, $kept) = @_;
    my $tab = $TABS[$TAB];
    window('tabs ' . @TABS . " $TAB", map { "title $_ $TABS[$_]{title}" } 0 .. $#TABS);
    return trmnl_shown($tab) if $tab->{trmnl};    # [C29]
    return cht_shown($tab) if $tab->{cht};    # [C32]
    window("address $tab->{url}");
    my $live = live_of($tab);
    my $list = $live && $live->{shown} && ($live->{home} || $live->{wide} == $VIEW[0] && ($live->{scale} // 1) == $VIEW_SCALE) ? $live->{shown} : $SHOWN && $SHOWN->{list} && $SHOWN->{wide} == $VIEW[0] && ($SHOWN->{scale} // 1) == $VIEW_SCALE ? $SHOWN->{list} : undef;
    $DRAWN = 0;
    delete @$live{qw(scroll_sent scroll_echo scroll_echoed scroll_clamp)} if $live;    # the window shows another drawing now: no scroll it was sent for the one before is still owed back, and where it stopped short of one says nothing of this (sub live_input)
    if ($kept && ($SHOWN || $live && $live->{shown})) { live_scroll_told($live); if ($live && $live->{unsent} && $list && $list == $live->{shown}) { window("relaid $TAB", @$list, '.'); $DRAWN = 1 } }    # the window's own drawing stands; a page kept running that drew meanwhile is sent, read where it was, and where its script scrolled it while another tab was shown goes just before
    elsif ($list) { live_scroll_told($live); window("page $TAB", @$list, '.'); $DRAWN = 1 }
    else { window("page $TAB", '.'); $SHOWN->{wide} = 0 if $SHOWN }    # the page of the tab before is gone; no width: sub relaid lays this one out again at the window's, and a scroll waits for a drawing to be shown on
    $live->{unsent} = 0 if $live && $DRAWN;
    if ($SHOWN) { $SHOWN->{used} = ++$LIST_USED; lists_bounded() }
    window($tab->{secure} ? ('secure begin', ($tab->{brief} ? "secure brief $tab->{brief}" : ()), (map { "secure line $_" } @{ $tab->{secure} }), 'secure end') : 'secure none');
    nav_told();
    live_layers_again();                  # [C18] the window let go of every layer with the line "tabs": the page shown makes its own again
    delete $_->{sound_held} for @LIVE;    # [C12] and the sound process of every sound (sub sound_hushed): a sound played again is sent whole again (sub live_sounded)
    idle($says // $tab->{says} // 'A new tab. Type an address above and press Return.', defined $says ? undef : $tab->{brief});
}

# The cogwheel's menu, each item one line of the window. "menu clear-history"
# empties the addresses every tab went to; the pages shown stay, and the log
# is cleared by its own button and by nothing else (sub log_shown).
# "menu clear-sessions" does that and also drops every page lzrprf keeps for a
# tab, its answer and its pictures: all that lzrprf holds of what a site sent.
# It empties the cookie jar too [C7], its file with it: no site knows you
# again through lzrprf, but for a provider you connected; the window warns, as asked, that pages would need a
# new login. "menu forget-cookies" clears the cookies of the shown tab's site alone. "menu home" makes the selected tab's address the home page, when
# it is one lzrprf fetches (sub address), in one plain file of yours, home,
# one line, written beside it and then given its name. The window asks before
# a clearing; what it could do by itself is clear, and keep one address that
# came from the bar.
sub menu {
    my ($what) = @_;
    if ($what eq 'forget-cookies') {      # [C7] the cookies of the shown tab's site, under every site they were set under
        my ($url, $host) = address($TABS[$TAB]{url} // '');
        return idle('No cookie was cleared: this tab shows no site.') unless $url && length $TABS[$TAB]{url};
        my $app = $TABS[$TAB]{kept_app};
        my $gone = $app ? kept_app_jar($app, sub { jar_clear() }) : jar_forget($url);
        my $stored = kept_storage_forget_site($url);
        return idle('The cookies were cleared, but Discord storage could not be cleared.') unless defined $stored;
        return idle('Discord storage and site cookies were cleared. Reload Discord to sign in again.') if $stored && $app;
        noted("you cleared the cookies of $host: $gone");
        return idle("The cookies of $host were cleared: $gone. Reload the page to see it without them.");
    }
    if ($what eq 'bookmarks-bar') {        # shown or hidden, kept in one plain file of yours, marksbar
        my $on = !marks_bar();
        if ($INCOGNITO) { $HELD_BAR = $on ? 1 : 0; window('marksbar ' . ($on ? 'on' : 'off')); return idle(($on ? 'The bookmarks bar is shown' : 'The bookmarks bar is hidden') . ' in this incognito window only: it writes nothing.') }    # [C16]
        unlink "$DIR/marksbar.new";
        return idle('The bookmarks bar could not be changed: its setting could not be written.') unless put("$DIR/marksbar.new", O_EXCL, $on ? 'on' : 'off') && rename("$DIR/marksbar.new", "$DIR/marksbar");
        synced();
        window('marksbar ' . ($on ? 'on' : 'off'));
        return idle($on ? 'The bookmarks bar is shown.' : 'The bookmarks bar is hidden.');
    }
    if ($what eq 'pictures') {            # pictures from other sites allowed or blocked, kept in one plain file of yours, pictures
        return idle('Pictures from other sites are not a choice in this release: nothing was changed.') unless $PICTURES_SHOWN;    # until lzrprf fetches by it, the choice is neither shown nor written
        my $allow = !pictures_elsewhere();
        my $said = $allow ? 'Pictures from other sites are allowed' : 'Pictures from other sites are blocked';
        if ($INCOGNITO) { $HELD_PICTURES = $allow ? 1 : 0; window('pictures ' . ($allow ? 'allow' : 'block')) if $PICTURES_SHOWN; return idle("$said in this incognito window only: it writes nothing.") }    # [C16]
        unlink "$DIR/pictures.new";
        return idle('Pictures from other sites could not be changed: their setting could not be written.') unless put("$DIR/pictures.new", O_EXCL, $allow ? 'allow' : 'block') && rename("$DIR/pictures.new", "$DIR/pictures");
        synced();
        window('pictures ' . ($allow ? 'allow' : 'block')) if $PICTURES_SHOWN;
        return idle("$said.");
    }
    if ($what eq 'home') {
        return idle("$UNKEPT, so the home page was not changed.") if $INCOGNITO;    # [C16]
        my ($url) = address($TABS[$TAB]{url});
        return idle('No home page was set: this tab shows no address lzrprf fetches.') unless $url && length $TABS[$TAB]{url};
        unlink "$DIR/home.new";
        return idle('The home page could not be kept: its file could not be written. Nothing was changed.') unless put("$DIR/home.new", O_EXCL, $url) && rename("$DIR/home.new", "$DIR/home");
        synced();
        return idle("The home page is set: $url. A new tab and the next window open it.");
    }
    my $count = 0;
    $count += @{ $_->{visited} } for @TABS;
    @CLOSED = ();                          # the closed tabs hold the addresses they went to, and their pages
    @$_{qw(visited at)} = ([], -1) for @TABS;
    nav_told();
    window('history clear');               # the pages the bar suggests go with the history
    return idle("The history was cleared: $count " . ($count == 1 ? 'address' : 'addresses') . ' that the tabs went to. The pages shown stay. The log is cleared by its own button.') if $what eq 'clear-history';
    @$_{qw(url title shown says secure)} = ('', '', undef, undef, undef) for @TABS;
    my @live = @LIVE;
    live_end($_, 'the sessions were cleared') for @live;    # a page kept running holds what its site sent, too
    undef $SHOWN;
    my $cookies = jar_clear();            # [C7] every cookie of this window's kind, and its file
    tab_shown("The history and the sessions were cleared: $count " . ($count == 1 ? 'address' : 'addresses') . ", every page lzrprf kept for a tab, and every cookie of this window's sites ($cookies). A provider you connected in the Profiles list keeps its sign-in, which is not cleared here: Remove it there to sign out. The log is cleared by its own button.");
}

# Back, forward and reload: the addresses this tab went to, as sub visit keeps
# them, and where in them the tab stands. Back and forward visit the address
# before or after, reload the address in the bar, each with the checks every
# typed address gets [C4] and written in the log first, as "you went back to",
# "you went forward to" or "you reloaded". The window is told what each would
# do now: "nav BACK FORWARD RELOAD", each 1 or 0.
sub nav_told {
    my $tab = $TABS[$TAB];
    window(join ' ', 'nav', $tab->{at} > 0 ? 1 : 0, $tab->{at} >= 0 && $tab->{at} < $#{ $tab->{visited} } ? 1 : 0, length $tab->{url} ? 1 : 0);
}

sub navigated {
    my ($way) = @_;
    my $tab = $TABS[$TAB];
    return length $tab->{url} ? go($tab->{url}, 'you reloaded') : idle('This tab shows no address to load again.') if $way eq 'reload';
    my $to = $tab->{at} + ($way eq 'back' ? -1 : 1);
    return idle("There is no page to go $way to in this tab.") unless $tab->{at} >= 0 && $to >= 0 && $to <= $#{ $tab->{visited} };
    $tab->{at} = $to;
    go($tab->{visited}[$to], "you went $way to");
}

# Search. Words typed into the bar that are no address (no "://", and a space
# or no dot) go to the search address you chose, kept in one plain file of
# yours, search, one line: an https address lzrprf fetches with %s once where
# the words go, percent-encoded. Three are offered by name; any other is typed
# into the window's own modal. Nothing is sent before one is chosen: the
# window is told "search ask" and asks. The address made is a visit like a
# typed one [C4], written in the log first as "you searched with".

sub engine_fit {                          # a search address lzrprf takes: https, a host by its name, port 443, plain characters, %s exactly once
    my ($text) = @_;
    return unless $text =~ /\A[\x21-\x7e]{1,2000}\z/ && $text =~ m{\Ahttps://}i && (() = $text =~ /%s/g) == 1;
    return (address($text =~ s/%s/x/r))[0] ? $text : undef;
}

sub engine {
    return $HELD_ENGINE if $INCOGNITO && $HELD_ENGINE;
    sysopen(my $in, kept_in() . '/search', O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return;
    my @is = stat $in;
    return unless -f _ && $is[4] == $<;
    defined sysread($in, my $text, 2002) or return;
    my ($line) = $text =~ /\A([\x21-\x7e]{1,2000})\n?\z/ or return;
    return engine_fit($line);
}

sub search_set {
    my ($text) = @_;
    my $fit = engine_fit($text) or return idle('That search address was not kept: it must be https, a host by its name, port 443, in plain characters, with %s exactly once where the words go.');
    if ($INCOGNITO) { $HELD_ENGINE = $fit; window('search set'); return idle('Searches go to ' . ($fit =~ m{^https://([^/?#]+)}i)[0] . " in this incognito window only: $UNKEPT.") }    # [C16]
    unlink "$DIR/search.new";
    return idle('The search address could not be kept: its file could not be written. Nothing was changed.') unless put("$DIR/search.new", O_EXCL, $fit) && rename("$DIR/search.new", "$DIR/search");
    synced();
    window('search set');
    idle('Searches go to ' . ($fit =~ m{^https://([^/?#]+)}i)[0] . ' now: words typed into the bar that are no address are sent there.');
}

sub typed {
    my ($text) = @_;
    my $words = $text =~ s/^[ \t]+|[ \t]+$//gr;
    return barred() if grep { listed($_) } $words, split /[ \t]+/, $words;    # [C23] a listed address is not searched for either: the search address would carry it to the search site
    return go($text) if (address($text))[0] || $words =~ m{://} || $words !~ /[ \t]/ && $words =~ /\./ || !length $words;
    my $engine = engine() or do { window('search ask'); return idle('Choose a search engine first, and the words are sent there. Nothing was sent.') };
    my $query = $words =~ s/([^A-Za-z0-9._~-])/sprintf('%%%02X', ord $1)/ger;
    return go($engine =~ s/%s/$query/r, 'you searched with');
}

# What the lock beside the bar tells of the page shown: the address, the
# server lzrprf connected to, the answer's first line, the redirects on the
# way, and the certificates curl checked, as curl wrote them after the answer
# ("--write-out", sub fetch), each field plain characters and cut, so nothing
# in them acts on the window. Lines "# HEADING" or "NAME: VALUE".
sub secured {
    my ($url, $from, $got, $certs) = @_;
    my $plain = sub { my $one = $_[0] // ''; $one =~ s/[^\x20-\x7e]/?/g; return substr($one, 0, $_[1] // 300) };
    my ($status) = ($got // '') =~ /\A(HTTP\/[0-9.]+ [0-9]{3}[^\r\n]{0,80})/;
    my @lines = ('# Connection', 'Address: ' . $plain->($url, 2100), 'Server: ' . $plain->($from // 'unknown'),
        'Encryption: TLS 1.2 or newer, HTTP/1.1; the certificate checked against the roots lzrprf holds', 'Answer: ' . $plain->($status // 'unknown'),
        'Cookies: ' . (do { my ($host) = ($url // '') =~ m{\Ahttps://([^/:]+)}; my $key = sso_on() ? sso_of($host) : undef; defined $key && sso_state($key) ne 'none' ? 'only those of ' . sso_providers()->{$key}[0] . ', which you connected in this profile, sent to its own sites and kept until you remove it' : jar_kept() ? 'the site\'s own, kept apart under each site you visit, sealed in this profile until they expire or you clear them' : 'the site\'s own, kept apart under each site you visit, in this window\'s memory until it closes' }), '# Redirects on the way here');
    push @lines, @WAY ? map { ($_ + 1) . '. ' . $plain->($WAY[$_], 600) } 0 .. $#WAY : 'None: the address answered with the page itself.';
    my @chain = grep { /\S/ } split /-----END CERTIFICATE-----/, $certs // '';
    my %named = ('Subject' => 'Subject', 'Issuer' => 'Issuer', 'Start date' => 'Valid from', 'Expire date' => 'Valid until', 'Serial Number' => 'Serial number',
        'Signature Algorithm' => 'Signature', 'Public Key Algorithm' => 'Public key', 'X509v3 Subject Alternative Name' => 'Names it covers');
    for my $at (0 .. ($#chain < 5 ? $#chain : 5)) {
        push @lines, '# Certificate ' . ($at + 1) . ' of ' . @chain . ($at == 0 ? ': the site' : $at == $#chain ? ': the root side' : ': an issuer');
        for my $field ('Subject', 'Issuer', 'Start date', 'Expire date', 'Serial Number', 'Signature Algorithm', 'Public Key Algorithm', 'X509v3 Subject Alternative Name') {
            my ($value) = $chain[$at] =~ /^\Q$field\E:[ \t]*([^\r\n]*)/m or next;
            push @lines, "$named{$field}: " . $plain->($value, $field =~ /Alternative/ ? 500 : 300);
        }
    }
    push @lines, '# Certificate', 'curl wrote no certificate for this answer.' unless @chain;
    return \@lines;
}

sub home {                                # the home page you set, when it is still an address lzrprf fetches; a plain file of yours and no link
    sysopen(my $in, kept_in() . '/home', O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return;
    my @is = stat $in;
    return unless -f _ && $is[4] == $<;
    defined sysread($in, my $text, 2102) or return;
    my ($line) = $text =~ /\A([\x21-\x7e]{1,2100})\n?\z/ or return;
    return (address($line))[0];
}

# A visit and what follows from it: a redirect you chose to follow is a new
# visit, made here after the one before has ended, as if its address had been
# typed (sub visit checks it the same way). Every one of them needs your yes.
sub go {
    my @next = @_;
    @WAY = ();
    $WENT = now();                        # the strip says how long the whole of it took, redirects followed and pictures fetched
    while (@next) {
        undef $NEXT;
        visit(@next);
        @next = $NEXT ? @$NEXT : ();
        relaid();
    }
}

# A redirect. curl follows none [C7]: an answer 301, 302, 303, 307 or 308
# is never laid out as a page. lzrprf shows it in its own modal: the address
# you went to, and the address the answer names, resolved against the first,
# and nothing is fetched for it unless you say so. Proceed is a new visit to
# it, with the checks every typed address gets; an address lzrprf does not
# fetch gets Cancel alone, and the modal says why in plain words (sub
# unfit). One redirect a visit is followed without asking: to the same
# address with "www." put in front of its host or taken off, https, the same
# path and query, written in the log first. The Location is read here by
# lzrprf, before the application sees the answer, and only when it is plain
# characters (0x21 to 0x7e), so nothing in it acts on the window. Returns the
# status and the whole address (undef when the answer names none, or one too
# long), or nothing when the answer is no redirect.
sub redirected {
    my ($got, $url) = @_;
    my ($status, $head) = $got =~ m{\AHTTP/1\.[01] (30[12378])[^\r\n]*\r\n(.*?)(?:\r\n\r\n|\z)}s or return;
    my ($to) = $head =~ /^location:[ \t]*([\x21-\x7e]{1,2000})[ \t]*\r?$/mi or return ($status, undef);
    my $whole = resolved($url, $to);
    return ($status, length $whole <= 2100 ? $whole : undef);
}

sub unfit {                               # why lzrprf does not fetch an address a page redirects to, in plain words
    my ($to) = @_;
    my $rule = 'lzrprf does not open this address: an address must be https, a host by its name, port 443, in plain characters without a space.';
    my ($scheme, $host, $port) = $to =~ m{^([A-Za-z][A-Za-z0-9+.-]*)://(?:[^/?#\@]*\@)?(\[[^\]/]*\]|[^/?#:]*)(?::([0-9]*))?} or return $rule;
    my @why;
    push @why, lc $scheme eq 'http' ? 'This address is not encrypted (http), and lzrprf opens https addresses only, so it cannot be opened.' : "This address is $scheme, not https, and lzrprf opens https addresses only." if lc $scheme ne 'https';
    push @why, 'Its host is a bare number, not a site name: lzrprf opens a site by its name only.' if $host =~ /^\[|^[0-9.]+\z/;
    push @why, "It names port $port, and lzrprf opens port 443 only." if defined $port && length $port && $port ne '443';
    return @why ? join(' ', @why) : $rule;
}

sub resolved {                            # a Location against the address it came from (RFC 3986 section 5.2, without a base that has a fragment)
    my ($base, $to) = @_;
    return $to if $to =~ m{^[A-Za-z][A-Za-z0-9+.-]*:};
    my ($origin, $path, $query) = $base =~ m{^(https://[^/?#]+)([^?#]*)(\?[^#]*)?};
    return "https:$to" if $to =~ m{^//};
    return "$origin$path" . ($query // '') . $to if $to =~ /^#/;
    return "$origin$path$to" if $to =~ /^\?/;
    my $joined = $to =~ m{^/} ? $to : ($path =~ s{[^/]*\z}{}r || '/') . $to;
    my ($rest) = $joined =~ /([?#].*)\z/s;
    $joined =~ s/[?#].*\z//s;
    my @out;
    my @parts = split m{/}, $joined, -1;
    for my $at (0 .. $#parts) {
        my $part = $parts[$at];
        if ($part eq '..') { pop @out if @out > 1; push @out, '' if $at == $#parts }
        elsif ($part eq '.') { push @out, '' if $at == $#parts }
        else { push @out, $part }
    }
    return $origin . join('/', @out) . ($rest // '');
}


# The application's local home scene uses the ordinary sealed page/layers/sound protocol.
# It receives no fetched answer and has no network, history entry or address in the bar.
# Only the window can ask for it; its dimensions stay local and are not a site fingerprint.
sub home_shown {
    my ($wide, $high, $game) = @_;
    my $fit = $wide > $VIEW_WIDE[1] ? $VIEW_WIDE[1] / $wide : 1;    # a window wider than a page is ever laid: the home is laid at the widest and as much lower, and the window scales it to its room as it does a page (function fit). The application refuses a =view outside the bounds and ends, which left the home black in a window 1611 wide (release 98)
    ($wide, $high) = map { my ($least, $most) = $_ ? @VIEW_HIGH : @VIEW_WIDE; my $is = int(($_ ? $high : $wide) * $fit + 0.5); $is < $least ? $least : $is > $most ? $most : $is } 0, 1;
    return if $TABS[$TAB]{trmnl} || $TABS[$TAB]{cht};    # [C29] [C32] a terminal's tab is no home, nor LZRCHT's
    if (length($TABS[$TAB]{url} // '')) {
        return unless $game && @TABS < $TABS_MOST;
        $TABS[$TAB]{shown} = $SHOWN; push @TABS, fresh_tab(); $TAB = $#TABS; undef $SHOWN; tab_shown();
    }
    my $old = live_of($TABS[$TAB]);
    return if $old && $old->{home} && $old->{wide} == $wide && $old->{home_high} == $high && !$game;
    if ($old && $old->{home}) {
        $old->{wide} = $wide; $old->{home_high} = $high; delete @$old{qw(home_ready home_owed home_first)};
        live_wrote($old, "resize $wide $high");
        live_wrote($old, 'key Enter') if $game;
        return;
    }
    live_end($old, 'the local home is shown', 1) if $old;
    my ($soon) = grep { $_->{starting} && $_->{starting}{tab} == $TABS[$TAB] } @LIVE;    # a home of this tab already being made
    return if $soon && $soon->{wide} == $wide && $soon->{starting}{high} == $high && !$game;
    live_end($soon, 'the local home is made at another size', 1) if $soon;
    my @before = @VIEW;
    @VIEW = ($wide, $high);
    $LAID_WIDE = $wide;
    my (undef, undef, $live) = contained('https://lzrbrwsr.invalid/_home', '', "=sheets\n", 1, undef, 1, 1);    # not waited for: the window's presses are taken while it makes its first list (a new tab held lzrprf 350 to 550 ms, measured 2026-11-23)
    @VIEW = @before;
    return window('startup ready'), idle('The local home could not be drawn.') unless $live;
    $live->{starting} = { tab => $TABS[$TAB], high => $high, game => $game };
    push @LIVE, $live;
}

sub home_arrived {                        # the first list of a home being made (sub home_shown), read in the loop of sub behind: drawn when its tab is still at home
    my ($live) = @_;
    while (!$live->{ended} && live_due($live)) {
        if (!defined $live->{whole} && !$live->{gone} && now() < $live->{until} && length $live->{held} <= $PAGE_BYTES && ref(my $asked = live_asked($live))) { live_fetched($live, $asked); next }    # [C19] as sub contained answers one before the first list
        my ($start, $at) = (delete $live->{starting}, delete $live->{whole});
        my ($tab, $wide) = ($start->{tab}, $live->{wide});
        my ($index) = grep { $TABS[$_] == $tab } 0 .. $#TABS;
        my $wrote = defined $at && $at >= 0 ? substr(substr($live->{held}, 0, $at + 8, ''), 0, $at + 1) : undef;
        @LIVE = grep { $_ != $live } @LIVE;
        my @before = @VIEW;
        @VIEW = ($wide, $start->{high});
        my ($lines, $hosts, $paths, $said, $named, $videos) = defined($wrote) && defined($index) && !length($tab->{url} // '') && !live_of($tab) ? checked($wrote) : ();
        @VIEW = @before;
        unless ($lines && !@$hosts && !@$paths && !@$named && !@$videos) { live_end($live, 'it is not shown', 1); return defined $index && $index == $TAB ? (window('startup ready'), idle('The local home could not be drawn.')) : undef }
        @$live{qw(looked until bytes tally)} = (0, now() + $LIVE_SECONDS, length $live->{held}, $LAID_TALLY);
        my ($shown) = pictured($lines, [], '', undef, undef, {});
        live_kept($live, $tab, $lines, [], '', {}, $shown, []);
        $live->{home_high} = $start->{high};
        if ($index == $TAB) { window("page $TAB", @$shown, '.'); $DRAWN = 1; live_told() } else { $live->{unsent} = 1 }    # a tab shown meanwhile: its own drawing stays, and this one is sent when the tab is chosen (sub tab_shown)
        live_wrote($live, 'key Enter') if $start->{game};    # Other > LZRDFNDR: show Start here; no address or new page
        return;
    }
}
# Bookmarks. They are files of yours in $DIR/bookmarks: one plain file a
# bookmark, NAME.mark, of two lines, the name it is shown by and its address;
# a folder of bookmarks is a real folder. A file or folder name is plain
# letters, digits, space, dot, underscore and hyphen, never begins with a dot
# or a space, and is at most 64 characters; anything else there is passed
# over, as is a link, something not yours, a file of more than 4 KiB, a line
# that is not in that shape, and an address lzrprf does not fetch (sub
# address). Folders go at most $MARKS_DEEP deep and at most $MARKS_MOST
# bookmarks are read. lzrprf reads them and tells the window the whole tree:
# "marks begin", "mark F FOLDER" for each folder, "mark B N FOLDER\tNAME\tADDRESS"
# for bookmark N, "marks end". The window says "mark open N", "mark remove N"
# or "mark save\tN-or-\tFOLDER\tNAME\tADDRESS", each checked here. A
# bookmark's address came from the window's bar, or was typed into the
# window's own modal [C4]; opening it is a visit like a typed one.
my $MARKS_MOST = 1000;                    # the most bookmarks read: the owner's order of 2026-11-20
my $MARKS_DEEP = 4;                       # how deep folders of bookmarks go: the owner's order of 2026-11-20
my $PART = qr/[A-Za-z0-9_-][A-Za-z0-9 ._-]{0,63}/;    # one name in the bookmarks folder

sub marks_root { kept_in() . '/bookmarks' }    # read, never written, by an incognito window [C16]

# The bookmarks bar shows one folder, "Bookmarks bar" (Chrome's own name for it), and nothing
# else; the star's modal offers it first. Before the bar had a folder of its own it showed the
# bookmarks at the top of the folder, so the first time the folder is read without it, those move
# into it, each by one change of name, and the bar shows what it showed. The folder is made then
# even when there is nothing to move, so a bookmark kept at the top later stays there.
my $BAR = 'Bookmarks bar';                # the owner's order of 2026-11-20

sub marks_into_bar {
    return if $INCOGNITO;                 # [C16]
    my $root = marks_root();
    return unless owned_folder($root);
    my $bar = "$root/$BAR";
    return if -e $bar || -l $bar;
    mkdir $bar, 0700 or return;
    opendir(my $in, $root) or return;
    for my $entry (grep { /^$PART\z/ && /\.mark\z/ } readdir $in) {
        my @is = lstat "$root/$entry" or next;
        rename "$root/$entry", "$bar/$entry" if -f _ && $is[3] == 1 && $is[4] == $<;
    }
    synced();
}

sub owned_folder { my @is = lstat $_[0]; return @is && -d _ && $is[4] == $< }    # a folder of yours, and no link to one

sub marks_read {
    my (@found, @folders);
    marks_walk('', 0, \@found, \@folders) if owned_folder(marks_root());
    return (\@found, \@folders);
}

sub marks_walk {
    my ($folder, $deep, $found, $folders) = @_;
    my $dir = length $folder ? marks_root() . "/$folder" : marks_root();
    for my $entry (order_shown($dir)) {    # in the folder's order (sub order_set)
        last if @$found >= $MARKS_MOST;
        my ($path, $inner) = ("$dir/$entry", length $folder ? "$folder/$entry" : $entry);
        my @is = lstat $path or next;
        if (-d _) {
            next unless $deep < $MARKS_DEEP && $is[4] == $<;
            push @$folders, $inner;
            marks_walk($inner, $deep + 1, $found, $folders);
        } elsif (-f _ && $entry =~ /\.mark\z/ && $is[3] == 1 && $is[4] == $< && $is[7] <= 4096) {
            sysopen(my $file, $path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or next;
            defined sysread($file, my $text, 4097) or next;
            my ($name, $where) = $text =~ /\A([^\n]{1,800})\n([\x21-\x7e]{1,2100})\n?\z/ or next;
            my ($url) = address($where) or next;
            push @$found, [$path, plain_name($name), $url, $folder];
        }
    }
}

sub plain_name {                          # a name to show: at most $TITLE characters, nothing that acts on the display, never empty: what stands for an empty one is given, or "Bookmark"
    my ($name, $instead) = @_;
    no warnings 'utf8';
    utf8::decode($name) or $name =~ s/[^\x00-\x7f]/?/g;
    $name =~ s/(?!\x{200D})[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\p{NChar}]|[^\x{0}-\x{10ffff}]//g;
    $name =~ s/(?<!\p{Extended_Pictographic})(?<!\x{FE0F})(?<![\x{1F3FB}-\x{1F3FF}])\x{200D}|\x{200D}(?!\p{Extended_Pictographic})//g;    # the joiner only inside an emoji of several, so that no word holds one unseen (Pay, a joiner, Pal is not PayPal)
    $name =~ s/^[ \p{M}]+| +$//g;
    $name = substr($name, 0, $TITLE);
    $name = $instead // 'Bookmark' unless length $name;
    utf8::encode($name);
    return $name;
}

sub marks_told {
    marks_into_bar();
    my ($found, $folders) = marks_read();
    @MARKS = @$found;
    window('marks begin', (map { "mark F $_" } @$folders), (map { "mark B $_ $MARKS[$_][3]\t$MARKS[$_][1]\t$MARKS[$_][2]" } 0 .. $#MARKS), 'marks end');
}

sub mark_written {                        # a bookmark's two lines into a new file beside its place, then given its place's name in one step
    my ($dir, $file, $name, $url) = @_;
    my $new = "$dir/.new.$$";             # begins with a dot: never read as a bookmark
    unlink $new;
    put($new, O_EXCL, $name, $url) && rename($new, $file) or (unlink($new), return 0);
    synced();
    return 1;
}

sub mark_saved {
    my ($edit, $folder, $name, $where) = @_;
    return idle("$UNKEPT, so no bookmark was added or changed.") if $INCOGNITO;    # [C16]
    return idle("The bookmark was not saved. $REFUSED $REFUSED_HELP") if listed($where);    # [C23] nothing of it is written
    my ($url) = address($where);
    return idle('The bookmark was not saved: lzrprf does not fetch that address. An address must be https, a host by its name, port 443, in plain characters without a space.') unless $url;
    my @parts = length $folder ? split(m{/}, $folder, -1) : ();
    return idle("The bookmark was not saved: a folder is at most $MARKS_DEEP deep, and each name in it is letters, digits, space, dot, underscore or hyphen, not beginning with a dot or a space.") if @parts > $MARKS_DEEP || grep { !/^$PART\z/ } @parts;
    my $old = $edit eq '-' ? undef : $MARKS[$edit] // return idle('The bookmark was not saved: it is no longer there.');
    my ($found) = marks_read();
    return idle("The bookmark was not saved: there are $MARKS_MOST bookmarks already.") if !$old && @$found >= $MARKS_MOST;
    my $dir = marks_root();
    for my $part ('', @parts) {
        $dir .= "/$part" if length $part;
        mkdir $dir, 0700 unless -e $dir || -l $dir;
        return idle("The bookmark was not saved: $dir is not a folder of yours.") unless owned_folder($dir);
        marks_into_bar() unless length $part;    # the top folder may be new: the bar's folder is made before anything is kept at the top
    }
    $name = plain_name($name);
    my $file = mark_file($dir, $name, $old ? $old->[0] : undef) // return idle('The bookmark was not saved: too many of that name.');
    return idle('The bookmark could not be written. Nothing was changed.') unless mark_written($dir, $file, $name, $url);
    unlink $old->[0] if $old && $old->[0] ne $file && -f $old->[0] && !-l $old->[0];
    my ($was_in, $was) = $old ? $old->[0] =~ m{\A(.*)/([^/]+)\z} : ();
    order_set($dir, defined $was_in && $was_in eq $dir ? $was : undef, basename($file)) if !$old || $old->[0] ne $file;    # a new bookmark last in its folder; one renamed in its place; one moved last in its new folder
    marks_told();
    return idle(($old ? 'The bookmark was changed: ' : 'The bookmark was added: ') . "$name, $url.");
}

sub mark_removed {
    my ($n) = @_;
    return idle("$UNKEPT, so no bookmark was removed.") if $INCOGNITO;    # [C16]
    my $mark = $MARKS[$n] // return idle('That bookmark is no longer there.');
    my @is = lstat $mark->[0];
    unlink $mark->[0] if @is && -f _;
    my ($dir, $gone) = $mark->[0] =~ m{\A(.*)/([^/]+)\z};
    order_set($dir, $gone) if defined $dir && -f "$dir/.order";    # its name leaves its folder's order, so a later bookmark of that name is added last
    marks_told();
    return idle("The bookmark was removed: $mark->[1].");
}

sub mark_moved {                          # a bookmark's address made the one its page redirects to, after you said so
    my ($n, $url) = @_;
    my $mark = $MARKS[$n] or return 0;
    return 0 if $INCOGNITO;               # [C16]
    my ($dir) = $mark->[0] =~ m{\A(.*)/[^/]+\z} or return 0;
    mark_written($dir, $mark->[0], $mark->[1], $url) or return 0;
    marks_told();
    return 1;
}

# The window's size and place, kept so the next window opens as this one was left: one line in a
# plain file of yours, frame, "X Y W H" in points from the bottom left of the main screen, or "full"
# when it filled the screen (full screen, or as large as the screen lets it), which opens the next
# window as large as the desktop lets it. An incognito window reads it and writes nothing.    # [C16]
sub frame_kept {
    sysopen(my $in, kept_in() . '/frame', O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return 'none';
    my @is = stat $in;
    return 'none' unless -f _ && $is[4] == $<;
    defined sysread($in, my $text, 64) or return 'none';
    return $text =~ /\A(full|-?[0-9]{1,5} -?[0-9]{1,5} [1-9][0-9]{1,4} [1-9][0-9]{1,4})\n?\z/ ? $1 : 'none';
}

sub frame_said {
    my ($frame) = @_;
    return if $INCOGNITO || frame_kept() eq $frame;
    unlink "$DIR/frame.new";
    put("$DIR/frame.new", O_EXCL, $frame) && rename("$DIR/frame.new", "$DIR/frame");
    return;
}

sub checked_kept {                       # the last look for a newer release, as checked keeps it, or "never"
    sysopen(my $in, "$ROOT/checked", O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return 'never';
    my @is = stat $in;
    return 'never' unless -f _ && $is[4] == $<;
    defined sysread($in, my $text, 64) or return 'never';
    return $text =~ /\A([1-9][0-9]{8,10} (?:same|newer) [0-9]{1,6}|[1-9][0-9]{8,10} failed)\n?\z/ ? $1 : 'never';
}

sub checked_said {
    my ($result, $asked) = @_;
    if ($result ne 'none' && !$INCOGNITO) {
        unlink "${\ shared()}/checked.new";
        put("${\ shared()}/checked.new", O_EXCL, time . " $result") && rename("${\ shared()}/checked.new", "${\ shared()}/checked");
    }
    window('checked ' . ($result eq 'none' ? 'none' : $INCOGNITO ? time . " $result" : checked_kept()));
    return 1;
}

sub marks_bar {                           # whether the bookmarks bar is shown: one line "on" in a plain file of yours
    return $HELD_BAR if $INCOGNITO && defined $HELD_BAR;
    sysopen(my $in, kept_in() . '/marksbar', O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return 0;
    my @is = stat $in;
    return 0 unless -f _ && $is[4] == $<;
    defined sysread($in, my $text, 8) or return 0;
    return $text =~ /\Aon\n?\z/ ? 1 : 0;
}

sub pictures_elsewhere {                  # 1 when pictures from other sites are allowed, as they are until you block them; 0 when one line "block" in a plain file of yours, pictures, says so
    return $HELD_PICTURES if $INCOGNITO && defined $HELD_PICTURES;
    sysopen(my $in, kept_in() . '/pictures', O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return 1;
    my @is = stat $in;
    return 1 unless -f _ && $is[4] == $<;
    defined sysread($in, my $text, 8) or return 1;
    return $text =~ /\Ablock\n?\z/ ? 0 : 1;
}

# Whether LZRDFNDR's satellite fights in the home page's minigame (H-0071): its switch in the Other tab of
# LZRDFNDR's panel says "game helper on" or "off", and the game page's Activate LZRDFNDR says on. One plain
# file of yours, gamehelper, holds "on" while it is chosen and is removed when it is not; an incognito
# window holds the choice in its memory alone [C16]. The window is told "game helper 1" or "0". The home
# page is started with it (sub contained, LZRPRF_HOME "home satellite"), so a page kept running with the
# other choice is ended and the home shown again: off is off from that moment.
sub game_helper {                         # 1 while LZRDFNDR's satellite plays in the minigame
    return 0 unless part_on('lzrdfndr') && part_on('lzrgm');    # neither plays without both parts
    return $HELD_HELPER if $INCOGNITO && defined $HELD_HELPER;
    sysopen(my $in, kept_in() . '/gamehelper', O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return 0;
    my @is = stat $in;
    return 0 unless -f _ && $is[3] == 1 && $is[4] == $<;
    defined sysread($in, my $text, 8) or return 0;
    return $text =~ /\Aon\n?\z/ ? 1 : 0;
}

sub game_helper_set {                     # "game helper on" or "off"; $kept: the home page runs on (its Activate LZRDFNDR already let the satellite in)
    my ($on, $kept) = @_;
    my $was = game_helper();
    if ($INCOGNITO) { $HELD_HELPER = $on }
    elsif ($on) { unlink "$DIR/gamehelper.new"; synced() if put("$DIR/gamehelper.new", O_EXCL, 'on') && rename("$DIR/gamehelper.new", "$DIR/gamehelper") }
    elsif (unlink "$DIR/gamehelper") { synced() }
    my $is = game_helper();
    window("game helper $is");
    return if $kept;
    return idle("LZRDFNDR's satellite could not be switched " . ($on ? 'on' : 'off') . ': its setting could not be written.') if $is != $on;
    if ($is != $was) {
        my $home = live_of($TABS[$TAB]);
        my ($wide, $high) = $home && $home->{home} ? ($home->{wide}, $home->{home_high}) : ();
        live_end($_, "LZRDFNDR's satellite was switched " . ($on ? 'on' : 'off'), 1) for grep { $_->{home} } @LIVE;
        home_shown($wide, $high) if $wide;
    }
    return idle($on ? "LZRDFNDR's satellite fights in the home page's minigame." : "LZRDFNDR's satellite stays out of the home page's minigame.");
}

# The order of a bookmarks folder. Each folder may hold one plain file of yours, .order, that names
# what is in it, one name a line, in the order the bar, the folder menus and the bookmarks page show
# it: bookmarks and folders mixed, as Chrome mixes them. Its name begins with a dot, so it is never
# read as a bookmark. A name it holds that is not there is passed over; what is there and not named
# follows the named, by name, as every folder was shown before it had an order. A bookmark added is
# named last; one renamed keeps its place. It is written as every file of the bookmarks is: beside
# its place, then given its name in one step (sub order_set).
my $ORDER = '.order';
my $ORDER_BYTES = 128 * 1024;             # DECLARED(the most of an order that is read: $MARKS_MOST names of at most 64 characters and a line end each is 65,000 bytes; twice that for a folder of folders)

sub order_of {                            # the names an order holds, in order, each once; nothing when there is none
    my ($dir) = @_;
    sysopen(my $in, "$dir/$ORDER", O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return;
    my @is = stat $in;
    return unless -f _ && $is[4] == $< && $is[7] <= $ORDER_BYTES;
    defined sysread($in, my $text, $ORDER_BYTES + 1) or return;
    my %seen;
    return grep { /^$PART\z/ && !$seen{$_}++ } split /\n/, $text;
}

sub order_shown {                         # what a folder shows, in its order: the named first, then the rest by name
    my ($dir) = @_;
    opendir(my $in, $dir) or return;
    my %there = map { $_ => 1 } grep { /^$PART\z/ } readdir $in;
    return ((grep { delete $there{$_} } order_of($dir)), sort keys %there);
}

sub order_set {                           # a folder's order written: what it named, with one old name replaced by the new ones, then the rest by name, then the new ones not placed yet
    my ($dir, $old, @new) = @_;
    opendir(my $in, $dir) or return 0;
    my %there = map { $_ => 1 } grep { /^$PART\z/ } readdir $in;
    my %new = map { $_ => 1 } @new;
    my @names = grep { delete $there{$_} } map { defined $old && $_ eq $old ? @new : $_ } order_of($dir);
    push @names, grep { !$new{$_} && delete $there{$_} } sort keys %there;
    push @names, grep { delete $there{$_} } @new;
    unlink "$dir/$ORDER.new";
    put("$dir/$ORDER.new", O_EXCL, @names) && rename("$dir/$ORDER.new", "$dir/$ORDER") or (unlink("$dir/$ORDER.new"), return 0);
    synced();
    return 1;
}

sub mark_file {                           # the file a bookmark of this name gets in that folder: its own name kept to plain characters, numbered when it is taken; nothing when 999 of it are
    my ($dir, $name, $old) = @_;
    my $base = substr($name =~ s/[^A-Za-z0-9 ._-]/_/gr =~ s/^[ .]+//r, 0, 50) =~ s/ +\z//r;
    $base = 'bookmark' unless length $base;
    my $file = "$dir/$base.mark";
    for (my $n = 2; (defined $old ? $file ne $old : 1) && (-e $file || -l $file); $n++) { return if $n > 999; $file = "$dir/$base $n.mark" }
    return $file;
}

# Importing bookmarks from another browser. "Import bookmarks..." in the cogwheel's menu opens the
# window's wizard: you choose a browser, then one of its profiles, and that profile is imported at
# once. Another browser's files are read by the reader alone: a fresh system perl running the few
# lines of $IMPORT_READER, started by lzrprf in a container of its own ($CONTAINER, and on top of it
# $IMPORT_ALLOWED), with no network, no writing and no program but itself. It may read these files
# under your home folder and nothing else of it:                                          [C15]
#   Chrome, Edge, Brave, Vivaldi   "Local State" (the names of the profiles) and each profile's "Bookmarks"
#   Firefox                        profiles.ini, a profile's bookmarkbackups folder and the *.jsonlz4 in it
#   Safari                         Library/Safari/Bookmarks.plist
# and it may look whether each browser's own folder, a profile's folder and the folders above them
# are there. It hands back each file whole on its standard output, a plain file of yours of one
# name (a hard link is refused: it may be any file of yours), no link and in no folder that is a
# link, of at most $IMPORT_BYTES. So whatever macOS
# lets LZRBRWSR read, lzrprf reads of another browser these files and nothing else: a profile's
# History or Login Data is refused to the reader by its container (selftest tries that).
# macOS asks nobody about these folders: from macOS 27 it keeps Chrome's and Firefox's (its
# Application Support protection) and, since long before, Safari's from every app that has no Full
# Disk Access, with no prompt an app can ask for. What lzrprf tries, short of Full Disk Access, is
# your choice in the system's Open panel: when the reader is kept out of a browser you chose other
# than Safari (whose files only Full Disk Access lets through), the window opens that panel at the
# browser's own folder with its button "Allow", once a browser in an import (sub import_kept).
# Allow on exactly that folder has the reader try again at once (sub import_allowed); another
# folder, or Cancel, ends in one sentence. Whether the panel opens from the window's container and
# whether Allow lets the reader through is for a real Mac to show: a panel that could not be shown
# is a line of the log (sub import_unshown), and the words say "try". What Allow sends lzrprf is only
# a word: the reader's container is the same before and after, and what changes is what macOS
# itself lets through. lzrprf never asks for Full Disk Access and never opens System Settings; an
# HTML file exported by the browser still works. An HTML file of
# yours (in Downloads, Desktop or Documents, or a path typed) is read by lzrprf itself.
# Firefox's places.sqlite would need a program (sqlite3) and is not read: its own backups hold the
# same bookmarks. Each bookmark goes through the checks a bookmark you add gets: its name through
# sub plain_name, its address through sub address (one lzrprf does not fetch is skipped and
# counted), at most $MARKS_MOST in all and folders at most $MARKS_DEEP deep, at most
# $IMPORT_FOLDERS folders and none without a bookmark in it (what does not fit is left out and
# counted), and it is written by sub mark_written and named last in its folder's
# order (sub order_set). The source's bookmarks bar goes into "Bookmarks bar", folders and all;
# each of its other top folders keeps its name at the top ("Other bookmarks", "Mobile bookmarks",
# "Bookmarks menu", "Reading List"). A bookmark whose folder and address are there already is
# passed over, so importing a profile twice adds nothing twice; folder names are compared as the
# disk compares them, without case, and a folder there already keeps the name it has. Nothing imported is fetched [C4]:
# a bookmark is fetched when you open it, as one you made.
my $IMPORT_BYTES = 32 * 1024 * 1024;      # DECLARED(the most of one file that is read: Chrome's own file for ten thousand bookmarks is about 3 MB)
my $IMPORT_OUT = 64 * 1024 * 1024;        # DECLARED(the most a Firefox backup may unpack to: twice the most of a file that is read)
my $IMPORT_NODES = 100_000;               # DECLARED(the most bookmarks and folders taken from one file: a hundred times $MARKS_MOST; the rest is left out)
my $IMPORT_DEPTH = 64;                    # DECLARED(the most folders inside folders read from one file: what is deeper is left out; four are kept)
my $IMPORT_FOUND = 20;                    # DECLARED(the most bookmarks files the HTML step offers: the newest)
my $IMPORT_SECONDS = 30;                  # DECLARED(the most one step of the reader is given: 32 MiB from a disk takes well under a second)
my %BROWSERS = (chrome => ['Chrome', 'Library/Application Support/Google/Chrome'], edge => ['Edge', 'Library/Application Support/Microsoft Edge'],
    brave => ['Brave', 'Library/Application Support/BraveSoftware/Brave-Browser'], vivaldi => ['Vivaldi', 'Library/Application Support/Vivaldi'],
    firefox => ['Firefox', 'Library/Application Support/Firefox'], safari => ['Safari', 'Library/Safari'], file => ['HTML file', '']);
my @BROWSERS = qw(chrome edge brave firefox safari vivaldi);    # in the wizard's order; Vivaldi is the owner's pick of a sixth
my ($IMPORT_KEY, @IMPORT_FROM);           # the browser chosen; its profiles or files: [what the window shows, the file]
my $IMPORT_CUT = 0;                       # whether the property list being read asked for more work than its budget: what lies past it was not read
my $IMPORT_SEEN = 0;                      # how many bookmarks and folders the file being read has given so far
my $IMPORT_PROBE = 255;                   # DECLARED(Chrome names its profiles Default and Profile 1, 2, ... and never uses a number twice: when its Local State cannot be read, Profile 1 to this one are looked for, in one request of the reader, and the log names the bound)
my $IMPORT_PROFILES = 99;                 # DECLARED(the most profiles of one browser that are looked at and listed: the window takes a profile's number below 100; the rest are left out and said)
my $IMPORT_MORE = 0;                      # how many profiles of the browser chosen were left out
my $IMPORT_UNNAMED = '';                  # why the browser chosen had its profiles' names unread, said in the log; "" when they were read
my $IMPORT_FOLDERS = 1000;                # DECLARED(the most folders one import makes, as many as bookmarks fit: a folder past it is left out with what is in it, counted)
my %IMPORT_LIFTED;                        # "lzrprf try" alone: each browser whose own folder an Allow chose in this import, for the test's refusals that an Allow lifts
my ($IMPORT_ASKING, $IMPORT_AGAIN, %IMPORT_ASKED) = ('', '');    # the browser whose folder the Open panel asks for now, what is read again after Allow ("profiles" or a profile's number), and each browser asked for in this import
my %IMPORT_WHY = (refused => 'macOS kept it out', denied => 'its permissions do not let you read it', home => 'the path of your home folder holds a character the reader does not take', start => 'the reader could not start', missing => 'it is not there', link => 'it is a link, or a folder above it is, and lzrprf follows no link', other => 'it is not a plain file of yours', large => 'it is larger than 32 MiB', unreadable => 'it could not be read');

# The reader's container, on top of $CONTAINER (sub contain): HOME is your home folder, HOME_RE the
# same as a pattern. The patterns are the files above and no other; a name in them is any name
# without a slash, so they reach no folder deeper than the one named. One or two levels inside a
# browser's folder it may look at what is there (stat) only of a folder or a link, the profiles and
# the links the reader looks for; a file there, as Last Version or places.sqlite, it may not even
# see unless it is one of the files it reads.
my $IMPORT_ALLOWED = <<'END';
(allow file-read-metadata
  (literal (string-append (param "HOME") "/Library/Application Support"))
  (literal (string-append (param "HOME") "/Library/Application Support/Google"))
  (literal (string-append (param "HOME") "/Library/Application Support/BraveSoftware"))
  (literal (string-append (param "HOME") "/Library/Application Support/Google/Chrome"))
  (literal (string-append (param "HOME") "/Library/Application Support/Microsoft Edge"))
  (literal (string-append (param "HOME") "/Library/Application Support/BraveSoftware/Brave-Browser"))
  (literal (string-append (param "HOME") "/Library/Application Support/Vivaldi"))
  (literal (string-append (param "HOME") "/Library/Application Support/Firefox"))
  (literal (string-append (param "HOME") "/Library/Safari"))
  (require-all (require-any (vnode-type DIRECTORY) (vnode-type SYMLINK))
    (require-any
      (regex (string-append "^" (param "HOME_RE") "/Library/Application Support/(Google/Chrome|Microsoft Edge|BraveSoftware/Brave-Browser|Vivaldi)/[^/]+$"))
      (regex (string-append "^" (param "HOME_RE") "/Library/Application Support/Firefox/[^/]+(/[^/]+)?$")))))
(allow file-read*
  (regex (string-append "^" (param "HOME_RE") "/Library/Application Support/(Google/Chrome|Microsoft Edge|BraveSoftware/Brave-Browser|Vivaldi)/(Local State|[^/]+/Bookmarks)$"))
  (regex (string-append "^" (param "HOME_RE") "/Library/Application Support/Firefox/(profiles[.]ini|([^/]+/)?[^/]+/bookmarkbackups(/[^/]+[.]jsonlz4)?)$"))
  (literal (string-append (param "HOME") "/Library/Safari/Bookmarks.plist")))
END

# The reader: the most bytes of one file, the home folder, then requests, each "r:" (a file's
# bytes), "l:" (the names of the *.jsonlz4 in a folder) or "s:" (what is there: a folder, a file, a
# link or other) and a path. It says "reader" first, then for each "ok LENGTH", a line end and that
# many bytes, or "no WHY" and a line end. WHY "refused" is EPERM, which is how macOS keeps a folder
# out; "denied" is EACCES, a file's own permissions; "link" is a link, a file of more than one name
# (a hard link) or a folder on the way that is a link, as a browser's data folder moved elsewhere.
my $IMPORT_READER = <<'END';
use Fcntl qw(O_RDONLY O_NOFOLLOW O_NONBLOCK);
my ($most, $home) = (shift, shift);
binmode STDOUT;
my $why = sub { $!{EPERM} ? 'refused' : $!{EACCES} ? 'denied' : $!{ELOOP} ? 'link' : $!{ENOENT} || $!{ENOTDIR} ? 'missing' : 'unreadable' };
my $linked = sub { my $up = $_[0]; while ($up =~ s{/[^/]+\z}{} && length $up > length "$home/Library") { return 1 if lstat($up) && -l _ } return 0 };
print "reader\n";
for my $asked (@ARGV) {
    my ($do, $path) = $asked =~ m{\A([rls]):(/.*)\z}s or (print("no unreadable\n"), next);
    my ($out, $no);
    if ($do eq 's') { $out = lstat($path) ? (-l _ ? 'link' : -d _ ? 'folder' : -f _ ? 'file' : 'other') : undef; $no = $why->() unless defined $out }
    elsif ($do eq 'l') {
        if (!lstat $path) { $no = $why->() } elsif (!-d _) { $no = -l _ ? 'link' : 'other' }
        elsif (opendir my $in, $path) { $out = join "\n", sort grep { /\A[^.\/][^\/\n]{0,200}\.jsonlz4\z/ } readdir $in } else { $no = $why->() }
    } elsif (!sysopen my $in, $path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) { $no = $why->() }
    else {
        my @is = stat $in;
        if (!-f _ || $is[4] != $<) { $no = 'other' } elsif ($is[3] != 1) { $no = 'link' } elsif ($is[7] > $most) { $no = 'large' }
        else {
            my $got;
            $out = '';
            while (($got = sysread $in, $out, 1 << 20, length $out) && length $out <= $most) { }
            ($no, $out) = ('unreadable', undef) unless defined $got && length $out <= $most;
        }
    }
    ($out, $no) = (undef, 'link') if ($no // '') ne 'link' && $linked->($path);    # read or not: a folder on the way that is a link, even one that leads back inside the browser's folder, is a link, and nothing of it is taken
    print defined $out ? 'ok ' . length($out) . "\n$out" : "no $no\n";
}
END

sub import_home { $TRY ? "$ROOT/home" : $HOME }    # "lzrprf try": the test's own folder stands for the home folder

sub import_base { (abs_path(import_home()) // import_home()) . '/' . $BROWSERS{$_[0]}[1] }    # by the resolved path of your home folder, as the reader's container names it

sub import_reader {                       # what the reader said of each request: [the bytes, or undef and why]
    my @asked = @_;
    my $home = abs_path(import_home()) // '';
    my $none = sub { my ($why) = @_; return map { [undef, $why] } @asked };
    return $none->('home') unless $home =~ m{\A/[A-Za-z0-9 ._/+@,-]*\z};    # a home folder whose path a pattern could misread: nothing is read
    (my $pattern = $home) =~ s/([^A-Za-z0-9 \/_-])/[$1]/g;
    my $kept = '';                        # "lzrprf try" alone: the files its folder's "kept" names are refused to the reader as macOS refuses them (EPERM: looked at, not read), so that a test can stand for macOS
    if ($TRY && open my $list, '<', "$ROOT/kept") { $kept .= qq{(deny file-read-data (literal (string-append (param "HOME") "/$_")))\n} for grep { m{\A[A-Za-z0-9 ._/-]{1,300}\z} && !m{(?:^|/)\.\.?(?:/|$)} } map { my $line = s/\n\z//r; $line =~ s/^allowed:// && grep({ index($line, "$BROWSERS{$_}[1]/") == 0 } keys %IMPORT_LIFTED) ? () : $line } <$list> }    # a line "allowed:FILE" is refused only until an Allow on its browser's folder in this import, as macOS lifts its refusal for the folder chosen in the Open panel
    pipe(my $from, my $to) or return $none->('start');
    my $child = fork // return $none->('start');
    if (!$child) {
        close $from;
        become(undef, $to, undef, $FETCH_LIMITS, contain($IMPORT_ALLOWED . $kept, '/usr/bin/perl', '-D', "HOME=$home", '-D', "HOME_RE=$pattern"), '-e', $IMPORT_READER, $IMPORT_BYTES, $home, @asked);
    }
    close $to;
    my ($text, $until, $most) = ('', now() + $IMPORT_SECONDS, (grep { /^r:/ } @asked) * ($IMPORT_BYTES + 64) + 65536 * @asked);
    while ((my $left = $until - now()) > 0 && length $text <= $most) {
        my $ready = '';
        vec($ready, fileno $from, 1) = 1;
        select($ready, undef, undef, $left > 1 ? 1 : $left) > 0 or next;
        my $got = sysread($from, $text, 1 << 20, length $text);
        next if !defined $got && $!{EINTR};
        last unless $got;
    }
    close $from;
    ended($child, 2);
    return $none->('start') unless $text =~ /\Greader\n/gc;    # the reader did not start: no answer of it stands
    my @said;
    for (@asked) {
        if ($text =~ /\Gok (\d{1,9})\n/gc && pos($text) + $1 <= length $text) { push @said, [substr($text, pos($text), $1)]; pos($text) += $1 }
        elsif ($text =~ /\Gno (refused|denied|missing|link|other|large|unreadable)\n/gc) { push @said, [undef, $1] }
        else { last }
    }
    push @said, [undef, 'unreadable'] while @said < @asked;    # the reader ended before it said them all
    return @said;
}

sub import_read {                         # an HTML file's bytes, read by lzrprf itself, or nothing and why (a key of %IMPORT_WHY)
    my ($file) = @_;
    sysopen(my $in, $file, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return (undef, $!{EPERM} ? 'refused' : $!{EACCES} ? 'denied' : $!{ELOOP} ? 'link' : 'missing');
    my @is = stat $in;
    return (undef, 'other') unless -f _ && $is[4] == $<;
    return (undef, 'link') if $is[3] != 1;    # a hard link: the same file by another name, which may be any file of yours
    return (undef, 'large') if $is[7] > $IMPORT_BYTES;
    my ($text, $got) = ('', 0);
    while (($got = sysread($in, $text, 1 << 20, length $text)) && length $text <= $IMPORT_BYTES) { }
    return (undef, 'unreadable') unless defined $got && length $text <= $IMPORT_BYTES;
    return $text;
}

sub import_node {                         # one bookmark or folder of a file, or nothing once $IMPORT_NODES were taken
    my ($name, $url, $kids) = @_;
    return if ++$IMPORT_SEEN > $IMPORT_NODES;
    $name //= '';
    utf8::encode($name) if utf8::is_utf8($name);
    return $kids ? { name => $name, kids => $kids } : { name => $name, url => $url // '' };
}

sub import_json {                         # a JSON text, decoded by the JSON code that comes with the system's perl, or nothing and why in $@
    my ($text) = @_;
    require JSON::PP;
    my $all = eval { JSON::PP->new->utf8->max_depth(2 * $IMPORT_DEPTH + 8)->decode($text) };
    return $all if defined $all || $@ !~ /malformed UTF-8|surrogate/;
    my $first = $@;
    require Encode;                       # one bad character anywhere would lose the whole file: a byte that is no UTF-8, or half of a pair written as \uD800 to \uDFFF, becomes U+FFFD, as a browser shows it, and the file is read again
    my $chars = Encode::decode('UTF-8', $text);
    $chars =~ s/(?<!\\)((?:\\\\)*)\\u(d[89ab][0-9a-f]{2})(?!\\ud[c-f][0-9a-f]{2})/$1\\ufffd/gi;
    $chars =~ s/(?<!\\)((?:\\\\)*)(\\ud[89ab][0-9a-f]{2})?\\u(d[c-f][0-9a-f]{2})/defined $2 ? "$1$2\\u$3" : "$1\\ufffd"/gie;
    $all = eval { JSON::PP->new->max_depth(2 * $IMPORT_DEPTH + 8)->decode($chars) };
    $@ = $first unless defined $all;
    return $all;
}

sub import_json_member {                  # the text of one member of a JSON object's top level, found without decoding the rest, or nothing: strings, brackets and words are stepped over and counted
    my ($text, $name) = @_;
    my ($depth, $wanted, $from) = (0, 0);
    pos($text) = 0;
    while ($text =~ /\G\s*(?:(")|([{\[])|([}\]])|([:,])|(-?[0-9][0-9.eE+-]*+|true|false|null))/gc) {
        if (defined $1) {                 # a string, stepped over here and not by one pattern, which gives up past some thousands of escapes
            my $at = pos($text) - 1;
            while (1) { $text =~ /\G[^"\\]*+/gc; last if $text =~ /\G"/gc; $text =~ /\G\\./gcs or return }    # no end: not JSON
            if (defined $from) { return substr($text, $from, pos($text) - $from) if $depth == 1; next }    # the member is a string
            $wanted = $depth == 1 && substr($text, $at, pos($text) - $at) eq qq("$name");
            next;
        }
        if (defined $2) { $depth++; next }
        if (defined $3) { $depth--; return substr($text, $from, pos($text) - $from) if defined $from && $depth == 1; return if $depth < 1; next }
        if (defined $from) { return substr($text, $from, pos($text) - $from) if $depth == 1 && !defined $4; next }    # a value that is no object or array
        if (defined $4 && $4 eq ':' && $wanted && $depth == 1) { $text =~ /\G\s*/gc; $from = pos($text) }
    }
    return;
}

sub lz4_block {                           # an LZ4 block (the block format of lz4) unpacked, at most $most bytes; nothing for one that is not well formed
    my ($in, $most) = @_;
    my ($at, $end, $out) = (0, length $in, '');
    my $more = sub { my $n = 0; while (1) { return -1 if $at >= $end; my $byte = ord substr($in, $at++, 1); $n += $byte; return $n if $byte != 255 } };
    while ($at < $end) {
        my $token = ord substr($in, $at++, 1);
        my $literals = $token >> 4;
        if ($literals == 15) { my $n = $more->(); return if $n < 0; $literals += $n }
        return if $at + $literals > $end || length($out) + $literals > $most;
        $out .= substr($in, $at, $literals);
        $at += $literals;
        last if $at == $end;              # the last sequence holds literals alone
        return if $at + 2 > $end;
        my $back = unpack 'v', substr($in, $at, 2);
        $at += 2;
        return if !$back || $back > length $out;
        my $length = $token & 15;
        if ($length == 15) { my $n = $more->(); return if $n < 0; $length += $n }
        $length += 4;
        return if length($out) + $length > $most;
        my $from = substr($out, length($out) - $back, $back < $length ? $back : $length);
        $out .= $back >= $length ? $from : substr($from x (int($length / $back) + 1), 0, $length);    # a copy that overlaps itself repeats what it copies
    }
    return $out;
}

sub plist_binary {                        # a binary property list (bplist00) as Perl data, or nothing: strings, numbers, arrays and dictionaries; what else it holds is undef
    my ($text) = @_;
    return unless length $text >= 40 && substr($text, 0, 8) eq 'bplist00';
    my ($size, $refs, $count, $top, $table) = unpack 'x6 C C Q> Q> Q>', substr($text, -32);
    return unless $size >= 1 && $size <= 8 && $refs >= 1 && $refs <= 8 && $count <= length($text) && $top < $count && $table + $count * $size <= length($text) - 32;
    my $int = sub { my ($at, $n) = @_; my $v = 0; $v = $v * 256 + ord substr($text, $at + $_, 1) for 0 .. $n - 1; return $v };
    my ($steps, %path) = (0);              # %path: the objects being read, from the top to here; one that holds itself is not read again
    my $object; $object = sub {
        my ($ref, $deep) = @_;
        return if ++$steps > 4 * $IMPORT_NODES || $ref >= $count || $deep > $IMPORT_DEPTH * 2 + 8 || $path{$ref};
        local $path{$ref} = 1;
        my $at = $int->($table + $ref * $size, $size);
        return if $at >= length($text) - 32;
        my $marker = ord substr($text, $at, 1);
        my ($kind, $n) = ($marker >> 4, $marker & 15);
        my $body = $at + 1;
        if ($kind != 0 && $kind != 1 && $kind != 2 && $kind != 3 && $kind != 8 && $n == 15) {    # a length of 15 or more follows as a number of its own
            my $head = ord substr($text, $body, 1);
            return unless $head >> 4 == 1;
            my $bytes = 1 << ($head & 15);
            return if $bytes > 8;
            $n = $int->($body + 1, $bytes);
            $body += 1 + $bytes;
        }
        if ($kind == 1) { return $int->($body, 1 << $n) if (1 << $n) <= 8; return }
        if ($kind == 5) { return if $body + $n > length $text; return substr($text, $body, $n) }
        if ($kind == 6) {
            return if $body + 2 * $n > length $text;
            require Encode;
            my $chars = eval { Encode::decode('UTF-16BE', substr($text, $body, 2 * $n)) } // return;
            utf8::encode($chars);
            return $chars;
        }
        if ($kind == 10) {
            return if $body + $n * $refs > length $text;
            my @list;
            for my $k (0 .. $n - 1) { last if $steps > 4 * $IMPORT_NODES; push @list, $object->($int->($body + $k * $refs, $refs), $deep + 1) }    # past the budget nothing more is read
            return \@list;
        }
        if ($kind == 13) {
            return if $body + 2 * $n * $refs > length $text;
            my %dict;
            for my $k (0 .. $n - 1) {
                last if $steps > 4 * $IMPORT_NODES;
                my $key = $object->($int->($body + $k * $refs, $refs), $deep + 1);
                $dict{$key} = $object->($int->($body + ($n + $k) * $refs, $refs), $deep + 1) if defined $key && !ref $key;
            }
            return \%dict;
        }
        return;
    };
    my $all = $object->($top, 0);
    $IMPORT_CUT = 1 if $steps > 4 * $IMPORT_NODES;    # past the budget: what was read within it stands, and the rest is said not read
    return $all;
}

sub html_text {                           # the text of HTML with its entities as characters, in UTF-8
    my ($text) = @_;
    my $char = sub { my $n = $_[0]; return '?' if $n > 0x10ffff || $n >= 0xd800 && $n <= 0xdfff; my $c = chr $n; utf8::encode($c); return $c };
    $text =~ s/&(?:#(\d{1,7})|#[xX]([0-9A-Fa-f]{1,6})|(amp|lt|gt|quot|apos|nbsp));/defined $1 ? $char->($1) : defined $2 ? $char->(hex $2) : { amp => '&', lt => '<', gt => '>', quot => '"', apos => "'", nbsp => ' ' }->{$3}/ge;
    return $text;
}

sub import_html {                         # the Netscape bookmarks file every browser exports: (its bar, the rest)
    my ($text) = @_;
    return unless $text =~ /NETSCAPE-Bookmark-file-1/i;
    my (@stack, $waiting) = ([]);
    my $root = $stack[0];
    while ($text =~ m{<(/?)(DL|H3|A)\b([^>]*)>(?:([^<]*)</(?:H3|A)\s*>)?}gi) {
        my ($close, $tag, $attributes, $inner) = ($1, uc $2, $3, $4 // '');
        if ($tag eq 'DL') {
            if ($close) { pop @stack if @stack > 1 }
            else { push @stack, $waiting ? $waiting->{kids} : $stack[-1]; undef $waiting }
            next;
        }
        next if $close;
        my $name = html_text($inner =~ s/\s+/ /gr);
        if ($tag eq 'H3') {
            my $folder = @stack <= $IMPORT_DEPTH ? import_node($name, undef, []) : undef;
            $waiting = $folder // { kids => [] };    # a folder too deep, or one too many, takes what is in it with it
            $folder->{bar} = 1 if $folder && $attributes =~ /PERSONAL_TOOLBAR_FOLDER\s*=\s*"true"/i;
            $folder->{unfiled} = 1 if $folder && $attributes =~ /UNFILED_BOOKMARKS_FOLDER\s*=\s*"true"/i;    # Firefox's Other Bookmarks
            push @{ $stack[-1] }, $folder if $folder;
        } else {
            my ($href) = $attributes =~ /\bHREF\s*=\s*"([^"]*)"/i;
            my $mark = import_node($name, html_text($href // '')) or next;
            push @{ $stack[-1] }, $mark;
        }
    }
    my ($bar) = grep { $_->{kids} && $_->{bar} } @$root;
    ($bar) = grep { $_->{kids} && $_->{name} =~ /^(?:Bookmarks ?bar|Bookmarks Toolbar|Favou?rites|BookmarksBar)$/i } @$root unless $bar;    # Safari's export names its bar Favorites and marks it no other way
    my @rest = grep { !$bar || $_ != $bar } @$root;
    my ($unfiled) = grep { $_->{kids} && $_->{unfiled} } @rest;
    return ($bar ? $bar->{kids} : [], import_tops('Bookmarks menu' => [grep { $_ != $unfiled } @rest], 'Other bookmarks' => $unfiled->{kids})) if $unfiled;    # Firefox's export: what is at its top is its Bookmarks Menu, as in its own backups
    my @loose = grep { !$_->{kids} } @rest;
    my ($other) = grep { $_->{kids} && $_->{name} =~ /^Other bookmarks$/i } @rest;
    push @{ $other->{kids} }, @loose if $other;    # bookmarks at the top of the file go into Other bookmarks, as Chrome keeps them
    return ($bar ? $bar->{kids} : [], [(grep { $_->{kids} } @rest), $other ? () : @{ import_tops('Other bookmarks' => \@loose) }]);
}

sub import_chromium {                     # Chrome's Bookmarks file, and that of each browser made from Chromium: (its bar, the rest)
    my ($text) = @_;
    my $all = import_json($text);
    return unless ref $all eq 'HASH' && ref $all->{roots} eq 'HASH';
    my $nodes; $nodes = sub {
        my ($list, $deep) = @_;
        return [] unless ref $list eq 'ARRAY' && $deep <= $IMPORT_DEPTH;
        return [map { ref $_ ne 'HASH' ? () : ($_->{type} // '') eq 'folder' ? (import_node($_->{name}, undef, $nodes->($_->{children}, $deep + 1)) // ()) : ($_->{type} // '') eq 'url' ? (import_node($_->{name}, $_->{url}) // ()) : () } @$list];
    };
    my $roots = $all->{roots};
    my $top = sub { ref $roots->{$_[0]} eq 'HASH' ? $nodes->($roots->{$_[0]}{children}, 1) : [] };
    return ($top->('bookmark_bar'), import_tops('Other bookmarks' => $top->('other'), 'Mobile bookmarks' => $top->('synced')));
}

sub import_tops { my @tops = @_; return [map { my ($name, $kids) = @tops[2 * $_, 2 * $_ + 1]; @$kids ? import_node($name, undef, $kids) // () : () } 0 .. $#tops / 2] }    # a source's top folders but its bar, each under its own name, the empty ones left out


sub import_firefox {                      # a Firefox backup, bookmarkbackups/*.jsonlz4: "mozLz40", a zero byte, the size unpacked in 4 bytes, then one LZ4 block
    my ($text) = @_;
    return unless length $text > 12 && substr($text, 0, 8) eq "mozLz40\0";
    my $size = unpack 'V', substr($text, 8, 4);
    return if $size > $IMPORT_OUT;
    my $json = lz4_block(substr($text, 12), $size) // return;
    return unless length $json == $size;
    my $all = import_json($json);
    return unless ref $all eq 'HASH' && ref $all->{children} eq 'ARRAY';
    my $nodes; $nodes = sub {
        my ($list, $deep) = @_;
        return [] unless ref $list eq 'ARRAY' && $deep <= $IMPORT_DEPTH;
        return [map { ref $_ ne 'HASH' ? () : ($_->{type} // '') eq 'text/x-moz-place-container' ? (import_node($_->{title}, undef, $nodes->($_->{children}, $deep + 1)) // ()) : ($_->{type} // '') eq 'text/x-moz-place' ? (import_node($_->{title}, $_->{uri}) // ()) : () } @$list];
    };
    my %root = map { ref $_ eq 'HASH' && defined $_->{guid} ? ($_->{guid} => $_->{children}) : () } @{ $all->{children} };
    return ($nodes->($root{toolbar_____}, 1), import_tops('Bookmarks menu' => $nodes->($root{menu________}, 1), 'Other bookmarks' => $nodes->($root{unfiled_____}, 1), 'Mobile bookmarks' => $nodes->($root{mobile______}, 1)));
}

sub import_safari {                       # Safari's Bookmarks.plist: (its bar, the rest)
    my ($text) = @_;
    my $all = plist_binary($text);
    return unless ref $all eq 'HASH' && ref $all->{Children} eq 'ARRAY';
    my $nodes; $nodes = sub {
        my ($list, $deep) = @_;
        return [] unless ref $list eq 'ARRAY' && $deep <= $IMPORT_DEPTH;
        return [map {
            my $one = $_;
            my $type = ref $one eq 'HASH' ? $one->{WebBookmarkType} // '' : '';
            $type eq 'WebBookmarkTypeList' ? (import_node($one->{Title}, undef, $nodes->($one->{Children}, $deep + 1)) // ())
                : $type eq 'WebBookmarkTypeLeaf' ? (import_node(ref $one->{URIDictionary} eq 'HASH' ? $one->{URIDictionary}{title} : '', $one->{URLString}) // ()) : ()
        } @$list];
    };
    my %root = map { ref $_ eq 'HASH' ? (($_->{Title} // '') => $_) : () } @{ $all->{Children} };
    my $top = sub { $root{$_[0]} ? $nodes->($root{$_[0]}{Children}, 1) : [] };
    return ($top->('BookmarksBar'), import_tops('Bookmarks menu' => $top->('BookmarksMenu'), 'Reading List' => $top->('com.apple.ReadingList')));
}

sub import_profiles_of {                  # a browser's profiles that hold bookmarks: why none was found, or undef; then each [the name shown, the file]
    my ($key) = @_;
    my $base = import_base($key);
    if ($key eq 'safari') {
        my ($there) = import_reader("s:$base/Bookmarks.plist");
        return (undef, ['Safari', "$base/Bookmarks.plist"]) if defined $there->[0] || $there->[1] =~ /^(?:refused|denied|link)$/;    # kept out, or not a plain file: why is said when it is chosen
        return import_why($there);
    }
    if ($key eq 'firefox') {
        my ($ini) = import_reader("r:$base/profiles.ini");
        return $ini->[1] unless defined $ini->[0];
        my (@dirs, %one);
        for my $line (split /\r?\n/, "$ini->[0]\n[end]") {
            if ($line =~ /^\[/) {
                my $path = $one{Path} // '';
                $path = index($path, "$base/") == 0 ? substr($path, length "$base/") : '' if ($one{IsRelative} // '1') ne '1';    # an absolute path is read only in Firefox's own folder
                push @dirs, [plain_name($one{Name} // $path), "$base/$path"] if $path =~ m{\A[^/.][^/]*(?:/[^/.][^/]*)?\z};
                %one = ();
            } elsif ($line =~ /^(Name|Path|IsRelative)=(.{1,500})$/) { $one{$1} = $2 }
        }
        ($IMPORT_MORE, $#dirs) = (@dirs - $IMPORT_PROFILES, $IMPORT_PROFILES - 1) if @dirs > $IMPORT_PROFILES;
        my @lists = import_reader(map { "l:$_->[1]/bookmarkbackups" } @dirs);
        my @found = map { my ($newest) = reverse split /\n/, $lists[$_][0] // ''; $newest ? [$dirs[$_][0], "$dirs[$_][1]/bookmarkbackups/$newest"] : () } 0 .. $#dirs;    # the names come sorted, and begin with the day: the last is the newest
        return (@found ? undef : import_why(@lists), @found);
    }
    my ($state) = import_reader("r:$base/Local State");    # the names of the profiles, as the browser's own profile picker shows them
    my $part = defined $state->[0] ? import_json_member($state->[0], 'profile') : undef;    # a Local State is often megabytes: the one member read alone takes a thousandth of the time
    my $all = defined $part ? import_json(qq({"profile":$part})) : undef;
    $all = import_json($state->[0]) if defined $state->[0] && ref $all ne 'HASH';    # not found so: the whole is read, and why it fails is said
    my $cache = ref $all eq 'HASH' && ref $all->{profile} eq 'HASH' && ref $all->{profile}{info_cache} eq 'HASH' ? $all->{profile}{info_cache} : undef;
    if (!$cache && ($state->[1] // '') eq 'refused' && !$IMPORT_ASKED{$key}) {    # macOS lets the reader see the profiles' files and not read the names: the Open panel asks first, so that after Allow the names are read with the rest
        noted("macOS kept lzrprf's reader out of $BROWSERS{$key}[0]'s Local State (EPERM), where the names of its profiles are, so the Open panel asks for $BROWSERS{$key}[0]'s folder before they are listed.");    # the line a real Mac's log shows of it
        return 'refused';
    }
    $IMPORT_UNNAMED = $cache ? '' : defined $state->[0] ? (defined $all ? 'it holds no list of profiles' : 'it is not JSON lzrprf reads (' . ($@ =~ s/\s+at \S+ line \d+.*//sr =~ s/[^\x20-\x7e]/?/gr) . ')') : $IMPORT_WHY{ $state->[1] };    # why the folders' names are shown, for the log
    $IMPORT_UNNAMED .= "; the profiles were looked for as Default and Profile 1 to Profile $IMPORT_PROBE" if !$cache;
    my $probed = !$cache;
    $cache //= { map { $_ => {} } 'Default', map { "Profile $_" } 1 .. $IMPORT_PROBE };    # no names to read: the profiles are looked for by their usual folders
    my @dirs = grep { /^[A-Za-z0-9][A-Za-z0-9 ._-]{0,63}\z/ } sort keys %$cache;
    ($IMPORT_MORE, $#dirs) = (@dirs - $IMPORT_PROFILES, $IMPORT_PROFILES - 1) if !$probed && @dirs > $IMPORT_PROFILES;    # folders looked for are counted once found
    my @there = import_reader(map { "s:$base/$_/Bookmarks" } @dirs);
    my $bytes = sub { my ($text) = @_; utf8::encode($text) if utf8::is_utf8($text); return $text };
    my $chars = sub { my ($text) = @_; utf8::decode($text); return $text };
    my @found = map {    # each as shown: the name and the address made plain first, so that two alike on the screen are alike here; a Bookmarks that is a link or no plain file is shown, and why it is not read is said when it is chosen
        my ($name, $address, $dir) = ($there[$_][0] // '') =~ /^(?:file|link|other)$/ ? @{ import_profile_name($dirs[$_], $cache->{ $dirs[$_] }) } : ();
        defined $dir ? [plain_name($bytes->($name), $dir), "$base/$dir/Bookmarks", length $address ? plain_name($bytes->($address), '') : '', $dir] : ();
    } 0 .. $#dirs;
    ($IMPORT_MORE, $#found) = (@found - $IMPORT_PROFILES, $IMPORT_PROFILES - 1) if @found > $IMPORT_PROFILES;
    require Unicode::Normalize; my $alike = sub { lc Unicode::Normalize::NFC($chars->($_[0])) };    # composed and lower case: an a with a ring as one character or as two is the same name
    my %named; $named{ $alike->("$_->[0]\t$_->[2]") }++ for @found;
    require Unicode::Collate;
    my $order = Unicode::Collate->new(level => 2);    # by name as the browser's picker lists them, Å with A and ö with o
    @found = map { [$_->[1][0], $_->[1][1], $named{ $alike->("$_->[1][0]\t$_->[1][2]") } > 1 ? $_->[1][3] : $_->[1][2]] }    # the account's address beside a name, and the folder only where two are alike in both
        sort { $order->cmp($a->[0][0], $b->[0][0]) || $order->cmp($a->[0][1], $b->[0][1]) || $a->[1][3] cmp $b->[1][3] }
        map { [[$chars->($_->[0]), $chars->($_->[2])], $_] } @found;
    return (@found ? undef : import_why($state, @there), @found);
}

sub import_profile_name {                 # one profile of a browser made from Chromium as its picker shows it: (the name, the account's address or "", the folder), in characters
    my ($dir, $one) = @_;
    $one = {} unless ref $one eq 'HASH';
    my $text = sub { my $v = $one->{ $_[0] }; return defined $v && !ref $v ? $v =~ s/\s+/ /gr =~ s/^ | $//gr : '' };
    my ($name, $gaia) = ($text->('name'), length $text->('gaia_given_name') ? $text->('gaia_given_name') : $text->('gaia_name'));
    $name = $gaia if length $gaia && ($one->{is_using_default_name} || !length $name);    # "Person 1" or "Your Chrome" while the name is the default: the picker shows the account's given name
    $name = $dir unless length $name;    # the folder, as a last resort
    my $address = $text->('user_name');
    $address = '' unless $address =~ /\A[^\s\@]{1,200}\@[^\s\@]{1,200}\z/;
    return [$name, $address, $dir];
}

sub import_why { my %is = map { ($_->[1] // '') => 1 } @_; return (grep { $is{$_} } qw(home start refused denied link other large unreadable))[0] // 'missing' }    # why nothing was found, of the reader's answers: the weightiest

sub import_files {                        # the bookmarks files in Downloads, Desktop and Documents, the newest first: [the name shown, the file]
    my @found;
    for my $where (qw(Downloads Desktop Documents)) {
        opendir(my $in, import_home() . "/$where") or next;    # macOS may not let lzrprf look there: then nothing is found there
        for my $entry (grep { /^[^.].{0,200}\.html?\z/is } readdir $in) {
            my $file = import_home() . "/$where/$entry";
            my @is = lstat $file or next;
            next unless -f _ && $is[4] == $< && $is[7] <= $IMPORT_BYTES;
            sysopen(my $one, $file, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or next;
            defined sysread($one, my $head, 512) or next;
            push @found, [plain_name("$where/$entry"), $file, $is[9]] if $head =~ /NETSCAPE-Bookmark-file-1/i;
        }
    }
    @found = sort { $b->[2] <=> $a->[2] || $a->[0] cmp $b->[0] } @found;
    return @found[0 .. ($#found < $IMPORT_FOUND - 1 ? $#found : $IMPORT_FOUND - 1)];
}

sub import_sources {                      # the browsers on this Mac, by whether the reader finds each one's own folder (or macOS keeps it out, which means it is there), then an HTML file
    return import_refused("$UNKEPT, so it imports no bookmarks.") if $INCOGNITO;    # [C16]
    ($IMPORT_ASKING, %IMPORT_ASKED, %IMPORT_LIFTED) = ('');    # a new import: each browser may be asked for once again
    my @there = import_reader(map { 's:' . import_base($_) } @BROWSERS);
    my $why = import_why($there[0]);
    if ($why eq 'home' || $why eq 'start') {    # no browser can be looked at: said and logged, and an HTML file still works
        my $words = "No browser's bookmarks can be read: $IMPORT_WHY{$why}.";
        noted($words);
        window('import begin', "import source file $BROWSERS{file}[0]", 'import step source', "import refused $words");
        return idle($words);
    }
    window('import begin', (map { "import source $BROWSERS[$_] $BROWSERS{ $BROWSERS[$_] }[0]" } grep { defined $there[$_][0] || $there[$_][1] =~ /^(?:refused|denied|link)$/ } 0 .. $#BROWSERS), "import source file $BROWSERS{file}[0]", 'import step source');
    return idle('Choose a browser.');
}

sub import_profiles {
    return import_refused("$UNKEPT, so it imports no bookmarks.") if $INCOGNITO;    # [C16]
    my ($key) = @_;
    my $why;
    ($IMPORT_MORE, $IMPORT_UNNAMED) = (0, '');
    ($IMPORT_KEY, $why, @IMPORT_FROM) = ($key, $key eq 'file' ? (undef, import_files()) : import_profiles_of($key));
    return import_kept($key, 'profiles') if ($why // '') eq 'refused';
    return import_refused($why eq 'missing' ? "No profile of $BROWSERS{$key}[0] holds bookmarks." : "$BROWSERS{$key}[0] could not be read: $IMPORT_WHY{$why}.") if $key ne 'file' && !@IMPORT_FROM;
    my $unnamed = length $IMPORT_UNNAMED ? "$BROWSERS{$key}[0]'s profile names could not be read: folders are shown." : '';
    noted("$BROWSERS{$key}[0]'s profile names could not be read from its Local State: $IMPORT_UNNAMED. The profiles are shown by their folders' names.") if $unnamed;    # never silent: the log says why
    window('import begin', (map { "import profile $_ $IMPORT_FROM[$_][0]" . ($key ne 'file' && length $IMPORT_FROM[$_][2] ? "\t$IMPORT_FROM[$_][2]" : '') } 0 .. $#IMPORT_FROM), $unnamed ? "import note $unnamed" : (), 'import step profile');    # always shown, also when there is one; after a tab what tells two alike apart, the account's address or the folder
    return idle(join ' ', $key eq 'file' ? 'Choose a file, or type its path.' : $IMPORT_MORE ? "Choose a profile; $IMPORT_MORE more " . ($IMPORT_MORE == 1 ? 'was' : 'were') . ' left out.' : 'Choose a profile.', $unnamed || ());
}

sub import_refused { window("import refused $_[0]"); return idle($_[0]) }    # one sentence, in the wizard and in the strip

sub import_kept_out {                     # macOS keeps them out: what works, in one sentence; Safari's are let through by Full Disk Access alone, which lzrprf never asks for
    return "macOS keeps Safari's bookmarks out and offers no prompt for them; export them as an HTML file instead." if $_[0] eq 'safari';
    return "macOS keeps $BROWSERS{$_[0]}[0]'s bookmarks out with no prompt; if Privacy & Security, Files & Folders lists LZRBRWSR, switch it on there, or export an HTML file instead.";    # whether that switch reaches the reader is for a real Mac to show
}

sub import_kept {                         # macOS kept the reader out of a browser you chose: the window's Open panel asks for its folder, once a browser in an import
    my ($key, $again) = @_;
    my $folder = import_base($key);
    return import_refused(import_kept_out($key)) if $key eq 'safari' || $IMPORT_ASKED{$key}++ || $folder !~ m{\A/[\x20-\x7e]{1,1000}\z};
    ($IMPORT_ASKING, $IMPORT_AGAIN) = ($key, $again);
    window("import ask $key $folder");
    return idle("Choose Allow to let LZRBRWSR try to read $BROWSERS{$key}[0]'s bookmarks.");
}

sub import_cancelled { $IMPORT_ASKING = ''; return }    # the wizard closed with an Open panel asked for: its answer, if one comes, is "Choose the browser again."

sub import_unshown {                      # the window could not show the Open panel, or it closed before anyone could choose: one line of this window's log, so that a run on a real Mac says which
    my ($key, $how) = @_;
    noted("The Open panel for $BROWSERS{$key}[0]'s folder " . ($how eq 'failed' ? 'could not be shown' : 'closed at once, before anyone could choose') . ', so nothing was read.');
}

sub import_allowed {                      # the Open panel's answer: Allow on the folder asked for reads again at once; another folder, or Cancel (no path), ends in one sentence
    my ($key, $path) = @_;
    my $asked = $IMPORT_ASKING;
    $IMPORT_ASKING = '';
    return import_refused('Choose the browser again.') unless $key eq $asked;
    return import_profiles($key) if !defined $path && $IMPORT_AGAIN eq 'profiles';    # Cancel on the names: the profiles found are listed by their folders, said so, or why none can be read is said
    return import_refused(import_kept_out($key)) unless defined $path;
    $path =~ s{(?<=.)/+\z}{};
    my $folder = import_base($key);
    return import_refused("That is not $BROWSERS{$key}[0]'s own folder, so nothing was read.") unless $path eq $folder || $path eq (abs_path($folder) // $folder);
    $IMPORT_LIFTED{$key} = 1 if $TRY;      # only the try-mode stand-in of a refusal reads it
    return $IMPORT_AGAIN eq 'profiles' ? import_profiles($key) : import_go($key, $IMPORT_AGAIN);    # asked once: kept out again, it is said at once
}

sub import_path {                         # a bookmarks file typed as a path: in your home folder, by a path that does not climb out of it
    return import_refused("$UNKEPT, so it imports no bookmarks.") if $INCOGNITO;    # [C16]
    my ($path) = @_;
    $path =~ s/^\s+|\s+$//g;
    $path =~ s{^~/}{import_home() . '/'}e;
    return import_refused('That is not a path in your home folder.') unless index($path, import_home() . '/') == 0 && $path !~ m{(?:^|/)\.\.?(?:/|$)};
    ($IMPORT_KEY, @IMPORT_FROM) = ('file', [plain_name(substr($path, length(import_home()) + 1)), $path]);
    return import_go('file', 0);
}

sub import_plan {                         # what an import writes, in order: ['F', folder] and ['B', folder, name, address]; with what it counts and leaves out
    my ($bar, $rest, $over) = @_;
    my ($found) = marks_read();
    my $root = marks_root();
    my %had = map { (lc($_->[3]) . "\t$_->[2]" => 1) } @$found;    # each bookmark there already, by its folder, the case folded as the disk folds names, and its address as it is: two addresses that differ in case may be two pages
    my %plan = (steps => [], marks => 0, there => 0, twice => 0, skipped => 0, left => 0, over => $over);
    my ($room, $folders, %used, %planned, %disk) = ($MARKS_MOST - @$found, 0);
    my $named = sub {                     # a folder's name in a folder: the name a folder there has already, when the two differ in case alone
        my ($folder, $name) = @_;
        my $in = length $folder ? "$root/$folder" : $root;
        $disk{$in} //= do { my %on; if (opendir my $dir, $in) { for (sort readdir $dir) { $on{ lc $_ } //= $_ if !/^\./ && !-l "$in/$_" && -d _ } } \%on };
        return $disk{$in}{ lc $name } // $name;
    };
    my $walk; $walk = sub {               # the steps for these nodes in this folder; when $counting, what is in them is only counted
        my ($nodes, $folder, $level, $counting) = @_;
        my @steps;
        for my $node (@$nodes) {
            if ($node->{kids}) {
                if ($counting || $level >= $MARKS_DEEP || $folders >= $IMPORT_FOLDERS) { $walk->($node->{kids}, '', $level + 1, 1); next }    # too deep, or one folder too many: left out with what is in it
                my $base = substr($node->{name} =~ s/[^A-Za-z0-9 ._-]/_/gr =~ s/^[ .]+//r, 0, 60) =~ s/ +\z//r;
                $base = 'Folder' unless length $base;
                my $name = $named->($folder, $base);
                for (my $k = 2; $used{ lc "$folder/$name" }; $k++) { $name = $named->($folder, "$base $k") }    # two folders of one name in one place stay two
                $used{ lc "$folder/$name" } = 1;
                my $inner = length $folder ? "$folder/$name" : $name;
                $folders++;
                my @inside = $walk->($node->{kids}, $inner, $level + 1, 0);
                if (grep { $_->[0] eq 'B' } @inside) { push @steps, ['F', $inner], @inside } else { $folders-- }    # a folder is made only for a bookmark in it
            } else {
                my ($url) = address($node->{url});
                if (!$url) { $plan{skipped}++; next }
                my $key = lc($folder) . "\t$url";
                if ($counting) { $plan{left}++; next }
                if ($had{$key}) { $plan{there}++; next }
                if ($planned{$key}) { $plan{twice}++; next }
                if ($room <= 0) { $plan{left}++; next }
                ($room--, $planned{$key} = 1);
                push @steps, ['B', $folder, plain_name($node->{name}), $url];
                $plan{marks}++;
            }
        }
        return @steps;
    };
    $plan{steps} = [$walk->($bar, $BAR, 1, 0), $walk->($rest, '', 0, 0)];    # the other top folders, each under its own name at the top
    return \%plan;
}

sub import_go {                           # a profile or a file chosen: read, and imported at once
    return import_refused("$UNKEPT, so it imports no bookmarks.") if $INCOGNITO;    # [C16]
    my ($key, $n) = @_;
    my $from = $key eq ($IMPORT_KEY // '') ? $IMPORT_FROM[$n] : undef;
    return import_refused('Choose the browser again.') unless $from;
    my $source = $key eq 'file' || $key eq 'safari' ? $from->[0] : "$BROWSERS{$key}[0] ($from->[0])";    # Safari has one list of bookmarks
    busy("Importing from $source.");
    my ($text, $why) = $key eq 'file' ? import_read($from->[1]) : @{ (import_reader("r:$from->[1]"))[0] };
    return $key ne 'file' && $why eq 'refused' ? import_kept($key, $n) : import_refused("$source could not be read: $IMPORT_WHY{$why}.") unless defined $text;
    ($IMPORT_SEEN, $IMPORT_CUT) = (0, 0);
    my ($bar, $rest) = { chrome => \&import_chromium, edge => \&import_chromium, brave => \&import_chromium, vivaldi => \&import_chromium, firefox => \&import_firefox, safari => \&import_safari, file => \&import_html }->{$key}->($text);
    return import_refused("$source holds no bookmarks lzrprf can read.") unless $bar;
    my $plan = import_plan($bar, $rest, $IMPORT_SEEN > $IMPORT_NODES ? $IMPORT_SEEN - $IMPORT_NODES : $IMPORT_CUT ? -1 : 0);
    my ($root, %order, @order_of) = (marks_root());
    mkdir $root, 0700 unless -e $root || -l $root;
    return import_refused("Nothing was imported: $root is not a folder of yours.") unless owned_folder($root);
    marks_into_bar();
    my ($written, $stopped) = (0, '');
    for my $step (@{ $plan->{steps} }) {
        my $dir = "$root/$step->[1]";
        my ($parent, $name);
        if ($step->[0] eq 'F') {
            my $made = !(-e $dir || -l $dir) && mkdir($dir, 0700);
            ($stopped = "$dir is not a folder of yours"), last unless owned_folder($dir);
            next unless $made;            # a folder there already keeps its place
            ($parent, $name) = $dir =~ m{\A(.*)/([^/]+)\z};
        } else {
            my $file = mark_file($dir, $step->[2]) or next;
            ($stopped = "a bookmark could not be written in $dir"), last unless mark_written($dir, $file, $step->[2], $step->[3]);
            $written++;
            ($parent, $name) = ($dir, basename($file));
        }
        push @order_of, $parent unless $order{$parent};
        push @{ $order{$parent} }, $name;
    }
    order_set($_, undef, @{ $order{$_} }) for @order_of;    # each folder's new names last in its order, in the source's order
    marks_told();
    window('import done');
    my @also = ($plan->{there} ? "$plan->{there} " . ($plan->{there} == 1 ? 'was' : 'were') . ' there already' : (), $plan->{twice} ? "$plan->{twice} appeared twice in it" : (),
        $plan->{skipped} ? ($plan->{skipped} == 1 ? '1 is not an address' : "$plan->{skipped} are not addresses") . ' lzrprf opens' : (), $plan->{left} ? "$plan->{left} did not fit" : (), $plan->{over} > 0 ? "the rest of it, past $IMPORT_NODES entries, was not read" : $plan->{over} ? 'the rest of it, past the work lzrprf gives one file, was not read' : ());    # each number counts bookmarks, and what its words say
    my $also = @also > 1 ? join(', ', @also[0 .. $#also - 1]) . " and $also[-1]" : $also[0];
    return idle("Imported $written " . ($written == 1 ? 'bookmark' : 'bookmarks') . " from $source" . (defined $also ? "; $also" : '') . (length $stopped ? ", then stopped: $stopped" : '') . '.');
}

# The style sheets a page names. Its first run may write a line
# "=sheets /path ..." of up to eight paths on its own host, and each is
# fetched the way a picture is: its line in the log first, then "fetch" to the
# same checked addresses the page came from. One clock of $SHEET_SECONDS is
# for starting them all. A sheet not begun by then, a fetch that failed and an
# answer larger than $SHEET_BYTES each go with length 0. Returns the frame for
# the second run, "=sheets", the length of each, a line end, then the answers
# as the site sent them, and how many had bytes; or nothing when a line of the
# log could not be written.                                              # [C14]
sub sheeted {
    my ($named, $host, $where, $kept) = @_;
    %BESIDE_LOGGED = (); if (my @had = beside_sheets($named)) { return @had }    # taken beside the first run, which named exactly these (07-visit-beside.pl)
    timed('sheets-begin ' . scalar @$named) if $TIMED;
    open my $request, '>>', "$DIR/busy" or return;
    flock $request, LOCK_SH or return;    # as in visit: no line of these requests falls into a clearing of the log
    my (@got, @jobs);
    for my $n (0 .. $#$named) {
        my $url = "https://$host$named->[$n]";
        if (listed($url)) { refused("a style sheet the page $host names", $kept) or return; push @got, ''; next }    # [C23] handed over with length 0
        if (my $filter = filter_said($url, 'stylesheet', $host)) { record("$url not fetched: $filter", $kept) or return; push @got, ''; next }    # [C27] after [C23]: handed over with length 0
        $BESIDE_LOGGED{$url} or $AHEAD{$url} && $AHEAD{$url}{logged} && $AHEAD{$url}{key} eq ahead_key([$url, $where, undef, ['style', $host]]) or record("$url -> lzrprf connects to the first that answers of: " . join(', ', map { $_->{text} } @$where), $kept) or return;    # [C5] written down first, connected second; a sheet taken beside a first run that then named other sheets has its two lines already, and its one fetch is not written down twice; one begun ahead for this very request (the key sub fetched_together takes it by) has this line already, any other is fetched afresh and written down here
        push @got, undef;
        push @jobs, [$n, $url];
    }
    busy('Fetching the ' . @jobs . (@jobs == 1 ? ' style sheet' : ' style sheets') . " of the page $host") if @jobs;
    my @answers = fetched_together(map { [$_->[1], $where, undef, ['style', $host]] } @jobs);    # [C6] [C7] side by side, each the request it always was
    for my $i (0 .. $#jobs) {
        my ($n, $url) = @{ $jobs[$i] };
        my ($got, $why, $from) = @{ $answers[$i] };
        delete $BESIDE_LOGGED{$url} or record("$url " . ($why ? "failed: $why" : 'answered: ' . length($got) . " bytes from $from"), $kept) or return;
        $got[$n] = !$why && length $got <= $SHEET_BYTES ? $got : '';
    }
    %BESIDE_LOGGED = ();
    close $request;
    ($BESIDE_FIRST ? sub { $BESIDE_FONTS = [@_] } : \&ahead_fonts)->($host, $where, $kept, map { ["https://$host$named->[$_]", $got[$_]] } grep { length $got[$_] } 0 .. $#got);    # [C30] the fonts these sheets name, begun now: here when the next run names them
    return (join(' ', '=sheets', map { length } @got) . "\n" . join('', @got), scalar grep { length } @got);
}

# The web fonts a page's sheets name. A run handed sheets may write a line
# "=webfonts /path|/path ..." of up to $FONTS fonts on the page's own host,
# which the application chose from the sheets' @font-face rules (https on
# the page's origin alone, of a format it draws), each up to $FONT_TRIES
# paths tried in order until one answers 200, as a src entry that fails
# falls through to the next. Each path is fetched as a sheet is:
# held to the illegal-content list, then the filter lists as a font, its line
# in the log first, then "fetch" to the same checked addresses the page came
# from, which holds it to LZRDFNDR's judgement and to Tor when Tor is on.
# One clock of $FONT_SECONDS is for starting them all, and each is cut at
# $FONT_BYTES; a font not begun in time, refused, failed, larger, or past
# $FONTS_TOTAL of all of them is not handed over; a font none of whose paths
# is goes with length 0, and the application draws
# that face's text in its own. Nothing of a font is written to the disk: the
# answers are held in memory for the page shown alone, in an incognito window
# as in any. Returns the frame for the next run, "=webfonts", the length of
# each, a line end, then the answers as the site sent them, and how many had
# bytes; or nothing when a line of the log could not be written.        # [C30]
sub fonted {
    my ($named, $host, $where, $kept) = @_;
    timed('fonts-begin ' . scalar @$named) if $TIMED;
    open my $request, '>>', "$DIR/busy" or return;
    flock $request, LOCK_SH or return;    # as in visit: no line of these requests falls into a clearing of the log
    my ($until, $total) = (now() + $FONT_SECONDS, 0);
    my @paths = map { [split /\|/, $_] } @$named;    # each font its paths in order, until one answers 200
    my @got = ('') x @$named;
    while (grep { scalar @$_ } @paths) {      # a round: the next path of every font that has none yet, side by side
        last if now() >= $until || !alive();  # not begun in time: nothing more is fetched
        my @jobs;
        for my $n (0 .. $#paths) {
            while (@{ $paths[$n] }) {
                my $url = "https://$host" . shift @{ $paths[$n] };
                if (listed($url)) { refused("a web font the page $host names", $kept) or return; next }    # [C23] not handed over
                if (my $filter = filter_said($url, 'font', $host)) { record("$url not fetched: $filter", $kept) or return; next }    # [C27] after [C23]: not handed over
                record("$url -> lzrprf connects to the first that answers of: " . join(', ', map { $_->{text} } @$where), $kept) or return;    # [C5] written down first, connected second
                push @jobs, [$n, $url];
                last;
            }
        }
        last unless @jobs;
        busy('Fetching the ' . @jobs . (@jobs == 1 ? ' web font' : ' web fonts') . " of the page $host");
        my @answers = fetched_together(map { [$_->[1], $where, [$FONT_BYTES, $FONT_SECONDS], ['font', $host]] } @jobs);    # [C6] [C7] side by side, each the request it always was
        for my $i (0 .. $#jobs) {
            my ($n, $url) = @{ $jobs[$i] };
            my ($got, $why, $from) = @{ $answers[$i] };
            $why ||= length($got) > $FONT_BYTES ? "it is larger than $FONT_BYTES bytes" : $total + length($got) > $FONTS_TOTAL ? "the page's fonts would be more than $FONTS_TOTAL bytes" : $got !~ m{\AHTTP/[0-9.]+ 200[ \r]} ? 'its answer is not 200' : undef;
            record("$url " . ($why ? "not handed over: $why" : 'answered: ' . length($got) . " bytes from $from, handed to $APP for a web font"), $kept) or return;
            next if $why;
            ($got[$n], $total) = ($got, $total + length $got);
            @{ $paths[$n] } = ();         # this font is here: its other paths are not tried
        }
    }
    close $request;
    return (join(' ', '=webfonts', map { length } @got) . "\n" . join('', @got), scalar grep { length } @got);
}

sub pixels {                            # what a picture run wrote: [wide, high, each row in base64], or nothing when it is not exactly a picture
    my ($wrote) = @_;
    return unless $wrote =~ s/\n\z//;
    my ($head, @rows) = split /\n/, $wrote, -1;
    my ($w, $h) = ($head // '') =~ /^P$N,$N$/ or return;
    return unless $w >= 1 && $h >= 1 && $w <= $DECODED_SIDE && $h <= $DECODED_SIDE && $w * $h <= $PICTURE_PIXELS && @rows == $h;
    return if grep { !/^p[0-9a-f]+$/ || length != 8 * $w + 1 } @rows;
    return [$w, $h, map { encode_base64(pack('H*', substr($_, 1)), '') } @rows];
}

# The application did not give a page. What is said is one of the fixed
# phrases below. And when the application's maker named an address for
# reports, you are asked whether to send one, shown the whole address first:
# one of two words, the release, the build of macOS. Not the address you
# typed, and nothing of the page. It is sent the way a typed address is, and
# written in the log the same way. The question also says what no request can
# hide: the server that receives it sees your internet address and the time.
# Two words and not the seven phrases, because five of the seven are the
# application's own doing: it could fail in one of five ways on purpose, and
# a report that named the way would carry what the application chose. So a
# report says "page" for all five, and "container" for the two that lzrprf
# and the system decide. Ending at once, before the system was asked about
# it, is one of the five: a process that is gone is "ended", never
# "uncontained", so the application cannot choose the word by how fast it
# ends. One thing stays the application's choice and cannot
# be taken from it: whether it fails on a page at all. A report you send
# therefore tells its maker that some page failed on your computer at that
# moment, and not which.
my %FAULT = (
    unstarted => 'its container could not be started',
    uncontained => 'the system did not say that it was in its container, so the answer was not handed to it',
    ended => 'it ended before it was given the page',
    late => 'it did not finish in time',
    large => 'it wrote more than lzrprf takes',
    unfit => 'what it wrote is not a page',
    flagged => 'LZRDFNDR blocked it as harmful or prohibited content',
    undrawn => 'the window could not draw what it wrote',
    changed => 'its program on the disk is another file than when this window opened, as after an update, so it was not started. Quit, and start it again',
);

sub fault {
    my ($which) = @_;
    my $says = "$APP did not show this page: $FAULT{$which}.";
    return idle($says) if $which eq 'changed';    # nothing of the application ran: there is nothing to report
    my ($release, undef, $to) = beside();
    my ($build) = mark() =~ /^macOS build (\w+)/;
    my $word = $which =~ /^un(?:started|contained)$/ ? 'container' : 'page';
    my ($url, $host) = $to && $build ? address("$to?fault=$word&release=$release&macos=$build") : ();
    return idle($says) unless $url;
    return idle($says) unless ask("$says Send a report to its developer? It holds one of two words, the number of the release and this Mac's build of macOS, and nothing else. The server that receives it sees your internet address and the time, as every site does. This is all of it, and it is written in the log: $url", "Don't send", 'Send') == 2;    # [C4]
    idle("$says " . (fixed("you sent a report: $url", $url, $host) ? 'The report was sent.' : $UNSAID ? 'lzrprf tried to send the report. Whether it arrived is not shown: the line that says how it ended could not be written to the log.' : 'The report could not be sent.'));
}

sub fault_said { return $FAULT{$_[0]} // "it failed ($_[0])" }    # the plain words for why a run of the application is not shown, as a log line says them
sub asked_words { my ($n) = @_; return $n ? "asked for $n " . ($n == 1 ? 'address' : 'addresses') . ', fetched or refused' : 'asked for no address' }    # [C19] what a run asked for while it was read, in words (sub contained)


# Where a host is. The name is looked up outside every container, after the
# address is in the log, by the system's perl running the few lines of
# $LOOKUP (the same as sub lookup, without the rest of this file to read
# first), given ten seconds. Not by a fork of this process: the system's
# libraries refuse a lookup in a copy that was not started afresh. The way to
# each address it gave is then asked of the system for all of them at once.
my $LOOKUP = 'use Socket qw(SOCK_STREAM NI_NUMERICHOST NI_NUMERICSERV getaddrinfo getnameinfo); my ($failed, @all) = getaddrinfo($ARGV[0], 443, { socktype => SOCK_STREAM }); print map { (getnameinfo($_->{addr}, NI_NUMERICHOST | NI_NUMERICSERV))[1] . "\n" } $failed ? () : @all;';
# An address written as a number, as the system's own: its family and the
# address to connect to, or nothing for text that is not a number. Never a
# lookup (AI_NUMERICHOST), so it is safe in a copy made by fork too. The same
# call find made before, given one place: this and sub lookup are the only
# places in this file that call getaddrinfo, and a name is looked up only by
# $LOOKUP in a fresh perl or by "lzrprf lookup", as before.
sub numbered {
    my ($failed, $one) = getaddrinfo($_[0], 443, { socktype => SOCK_STREAM, flags => AI_NUMERICHOST });
    return $failed || !$one ? undef : $one;
}

# The lookup of a name begun and not waited for: sub find reads what it says
# when the name is asked for. The same program, the same name and the same
# checks before it as sub find makes; a name that is never asked for after
# all was looked up and nothing more. At most $FINDING_MOST wait at a time.
sub find_ahead {
    my ($host) = @_;
    return if listed($host) || $TOR_SESSION || $TOR_WANTED || $PEER ne '-' || $FINDING{$host} || keys %FINDING >= $FINDING_MOST;    # [C23] [C17] as sub find: never a listed name, never past Tor
    my $cached = $FOUND{$host};
    return if $cached && now() - $cached->[0] < $FOUND_SECONDS;
    timed("find-ahead $$ $host") if $TIMED;
    pipe(my $from, my $to) or return;
    my $pid = fork // return;
    if (!$pid) {                          # a copy that waits for the lookup, in a fresh perl as ever, then asks the system the ways to what it gave, all at once, and writes both: asked by sub find itself after the lookup, the ways took 13 ms in which a page's waiting requests stood still (yle.fi, measured 2026-11-25)
        close $from;
        setpgrp(0, 0);                    # a group of its own, so the lookup it waits for ends with it (sub find_dropped)
        spare_dropped(); curl_ended($CURL_SPARE); undef $CURL_SPARE;
        $RUN = getppid();
        my ($found) = said($FIND_SECONDS, '/usr/bin/perl', '-e', $LOOKUP, $host);
        syswrite $to, $found // '';        # the lookup's answer at once: were the ways never told, sub find has it and asks them itself
        my ($numbers, $families, $told) = find_numbers($found // '');
        my @says = said_all(5, (map { route_asked($_->{family}, $_->{text}) } @$numbers), map { route_asked($_, 'default') } @$families);
        print $to "=ways\n", map { "=way $told->[$_]\n" . ($says[$_] // '') . "\n" } 0 .. $#$told;
        close $to;
        POSIX::_exit(0);
    }
    close $to;
    $FINDING{$host} = [$from, $pid];
    return;
}

sub find_numbers {                        # ($found): of what a lookup printed, the first $LOOKED addresses that are numbers, their families, and the name each way is told under (an address, default4, default6)
    my ($found) = @_;
    my (@numbers, %had, $looked);
    for my $text (grep { /^[0-9A-Fa-f:.]+(?:%[A-Za-z0-9]+)?$/ && !$had{$_}++ } split /\n/, $found) {
        last if ++$looked > $LOOKED;
        my $one = numbered($text) or next;
        push @numbers, { %$one, text => $text };
    }
    my @families = do { my %once; grep { !$once{$_}++ } map { $_->{family} } @numbers };
    return (\@numbers, \@families, [(map { $_->{text} } @numbers), map { $_ == AF_INET6 ? 'default6' : 'default4' } @families], scalar keys %had);
}

sub find_dropped {                        # the lookups begun and never asked for, ended
    for my $one (values %FINDING) { close $one->[0]; kill 'KILL', -$one->[1]; kill 'KILL', $one->[1]; waitpid $one->[1], 0 }    # the copy and, by its group, the lookup it waits for
    %FINDING = ();
    return;
}

# Returns the addresses the name leads to, each with whether it is "own":
# not on the public internet, or reached by a route of its own. At most eight
# are returned: the first eight this computer has a way to. An address it has
# no way to is passed over and is not one of the eight. The first sixteen the
# lookup gave are looked at, and no more.
sub find {
    my ($host) = @_;
    return (undef, $REFUSED_WHY) if listed($host);    # [C23] a listed name is never looked up, here or by a test's listener
    return (undef, 'this is a Tor window: no name is looked up on this Mac, and nothing goes out past Tor') if $TOR_SESSION;    # [C17]
    if ($PEER ne '-') {                   # "lzrprf try" only: every name leads to the test's listener
        timed('looked-up');               # the same diagnostic mark as a real lookup, so the selftest can prove one never began
        my ($to, $port) = split /:/, $PEER;
        my ($public, $names) = (0);
        $public = grep { chomp; $_ eq $host } <$names> if open $names, '<', "$ROOT/public";    # the names the test's file "public" lists are taken for hosts on the public internet, to try what is fetched there
        return [{ family => AF_INET, addr => pack_sockaddr_in($port, inet_aton($to)), text => $to, own => !$public && !public($to) }];
    }
    my $cached = $FOUND{$host};
    return [map { {%$_} } @{ $cached->[1] }] if $cached && now() - $cached->[0] < $FOUND_SECONDS;    # looked up a moment ago in this window: the same addresses, and the same ways to them, without the five processes a lookup starts
    timed("find-begin $$ $host") if $TIMED;    # "lzrprf try" with "times": each name looked up, and when its addresses and their ways were known (scripts/load-timeline.pl)
    my $begun = delete $FINDING{$host};    # the same lookup, begun while the page's answer was read (sub find_ahead): only what is left of it is waited for
    my ($found) = $begun ? @{ (said_read($FIND_SECONDS, $begun))[0] } : said($FIND_SECONDS, '/usr/bin/perl', '-e', $LOOKUP, $host);
    timed('looked-up');
    timed("find-looked $$ $host") if $TIMED;
    my %way;                              # what a lookup begun ahead was told of the ways (sub find_ahead)
    if ($begun && defined $found && $found =~ s/^=ways\n(.*)\z//ms) { my @told = split /^=way (\S{1,64})\n/m, $1; shift @told; %way = @told if @told % 2 == 0 }
    my @where;
    my ($numbers, $families, $told, $had) = find_numbers($found // '');
    my @numbers = @$numbers; my @families = @$families;
    my @says = %way && !(grep { !defined $way{$_} } @$told) ? @way{@$told} : said_all(5, (map { route_asked($_->{family}, $_->{text}) } @numbers), map { route_asked($_, 'default') } @families);    # the way to each address and the default way: told by the lookup begun ahead, or asked of the system all at once
    my %usual = map { $families[$_] => $says[@numbers + $_] } 0 .. $#families;
    for my $at (0 .. $#numbers) {
        last if @where >= $FOUND;
        my $one = $numbers[$at];
        my $route = route_of($one->{family}, $one->{text}, $says[$at], $usual{ $one->{family} }) or next;    # this computer has no way there at all
        push @where, { %$one, text => $one->{text}, own => $route eq 'own' || !public($one->{text}) };
    }
    timed("find-end $$ $host " . scalar @where) if $TIMED;
    return (undef, $had ? 'this computer has no way to that host' : 'no such host') unless @where;
    %FOUND = () if keys %FOUND >= 256;
    $FOUND{$host} = [now(), [map { {%$_} } @where]];    # only an answer with addresses is kept: a failure is looked up again
    return \@where;
}

# How this computer would send to an address: "internet" by the way it uses
# for the internet at large, "own" by a route of its own (a network this
# computer is in, another computer's network behind a VPN, this computer
# itself), nothing when there is no way. The address being in a public range
# does not make it public for you: a route can lead it into a network of
# your own, and then you are asked.
sub route_asked { my ($family, $text) = @_; return ['/sbin/route', '-n', 'get', ($family == AF_INET6 ? '-inet6' : ()), $text =~ s/%.*//r] }    # the question to the system about the way to one address
sub route {
    my ($family, $text) = @_;
    my ($says) = said(5, @{ route_asked($family, $text) });
    return route_of($family, $text, $says);
}
sub route_of {                            # the answer, from what the system said of the way to the address and, when it was asked already, of the default way
    my ($family, $text, $says, $usual) = @_;
    my ($to) = $says =~ /^\s*destination: (\S+)/m or return;
    return 'internet' if $to eq 'default' || $says =~ /^\s*mask: default\s*$/m;    # the default route: a mask of no bits at all. For IPv6 the system writes its destination as "::" and not as "default", and only the mask says so
    if ($says =~ /^\s*flags: <[^>]*\bWASCLONED\b/m && $text ne 'default') {
        # macOS keeps a route of its own for every address it spoke to a moment ago, a copy of the route
        # that led there. It is the internet's when it leaves by the same door as the default route.
        ($usual) = said(5, @{ route_asked($family, 'default') }) unless defined $usual;
        my @door = map { my $all = $_; join ' ', map { $all =~ /^\s*$_: (\S+)/m ? $1 : '?' } 'gateway', 'interface' } $says, $usual // '';
        return 'internet' if $door[0] eq $door[1] && $door[0] !~ /\?/ && ($usual // '') =~ /^\s*(?:destination|mask): default\s*$/m;    # the mask again: over IPv6 the default route's destination reads "::"
    }
    my ($mask) = $says =~ /^\s*mask: (\S+)/m or return 'own';
    my $bits = inet_pton($family, $mask) // return 'own';
    return unpack('%32b*', $bits) < 8 ? 'internet' : 'own';    # a route for half of all addresses is how some VPNs carry the whole internet
}

# The one connection to the site, made by lzrprf: to an address that was just
# checked and written down, never to the name again. This is the only place
# in this file that connects to anything outside this computer.          # [C6]
sub reach {
    my ($where, $until) = @_;
    return tor_reach($where->[0]{host}, $until) if $where->[0]{tor};    # [C17] through Tor, and never past it: a Tor that does not answer is a request that fails
    return if $TOR_SESSION;               # [C17] a Tor window connects to nothing but Tor
    for my $one (@$where) {
        my $left = $until - now();
        last if $left <= 0;
        socket(my $site, $one->{family}, SOCK_STREAM, 0) or next;
        unblocked($site);
        connect($site, $one->{addr});     # [C6]
        my $ready = '';
        vec($ready, fileno $site, 1) = 1;
        return ($site, $one->{text}) if select(undef, $ready, undef, $left < 10 ? $left : 10) > 0 && !unpack 'i', getsockopt($site, SOL_SOCKET, SO_ERROR);
    }
    return;
}

# The application's tool, opened by its icon at the right end of the strip.
# lzrprf looks at this computer with the system's own programs: its processes
# (ps), the launchd jobs of your account and of the system (launchctl, and
# the property lists of the three LaunchAgents and LaunchDaemons folders,
# read with plutil), and who signed their programs (codesign). What it saw
# goes to the application in its container, as an answer does for a page: no
# network and no file, so nothing of the look leaves this computer. The
# application answers with a list, and lzrprf holds every line of it to its
# own rules before the window is given it (sub tool_checked, sub tool_may).
# A look changes nothing. A change is made only for a row you ticked and then
# confirmed in the window, where each change is said in lzrprf's own words,
# and each is written in the log first: a launchd job of your account is
# switched off (launchctl disable, then bootout), a process of yours is asked
# to end (TERM). Never a job or a process of the system or of Apple, never
# lzrprf's own, never with a password. A job you switched off is kept in
# ~/.lzrprf/quieted, looked at again at each start and every $TOOL_WATCH
# seconds while a window is open, switched off again when it came back, and
# switched on again when you say so (launchctl enable, then bootstrap). An
# incognito window has no tool: it would write.                     # [C20]
my $TOOL_ROWS = 200;                      # DECLARED([C20] the most rows the application may name: more than a list a person ticks through)
my $TOOL_ACTS = 12;                       # DECLARED([C20] the most changes of one row: a product with a dozen jobs and helpers)
my $TOOL_PROCS = 4000;                    # DECLARED([C20] the most processes of one look that are handed on: several times what a busy Mac runs)
my $TOOL_FILES = 400;                     # DECLARED([C20] the most property lists read in one folder of launchd jobs)
my $TOOL_SIGNED = 80;                     # DECLARED([C20] the most programs whose signature is read anew in one look, each about a twentieth of a second of codesign; what one look left out the next reads)
my $TOOL_ASKED = 40;                      # DECLARED([C20] the most loaded jobs with no property list in the three folders that launchd is asked about one by one)
my $TOOL_WATCH = 300;                     # DECLARED([C20] seconds between two looks at the jobs you switched off, while a window is open)
my $TOOL_LABEL = qr/[A-Za-z0-9][A-Za-z0-9._-]{0,199}/;    # a launchd label lzrprf acts on: one written any other way is listed nowhere and never acted on
my (%TOOL, %TOOL_SIGN, %TOOL_FILE);       # the last look (its processes, jobs and rows); the signatures and the property lists read already, each by its file's time and size
my $TOOL_LOOKED;                          # when the jobs you switched off were last looked at; nothing before the first look of a window
my $TOOL_MANS = 800;                      # DECLARED([C20] the most names of programs whose manual page is read in one look for Show all processes: more than the programs a busy Mac runs at once)
my $TOOL_NOTE = 500;                      # DECLARED([C20] the most characters of one note you write to a process: a few sentences, as a cell of the list holds)
my $TOOL_NOTES = 2000;                    # DECLARED([C20] the most notes kept in procnotes: more programs than a Mac holds)
my (%TOOL_MAN, $TOOL_ALL);               # the manual pages read already, each by the name of its program; whether the window shows every process (its last look was "tool all")

sub tool_stand { my $stand = "$ROOT/toolstand"; return $TRY && -d $stand ? $stand : undef }    # "lzrprf try" only: a folder whose files stand for what the system's programs say, so a test acts on no real job and no real process
sub tool_asked {                          # what one of the system's programs says, and whether it ended well
    my ($name, $seconds, @command) = @_;
    my $stand = tool_stand() // return said($seconds, @command);
    open my $in, '<', "$stand/$name" or return ('', 0);
    local $/;
    return (scalar(<$in>) // '', 1);
}
sub tool_ran {                            # [C20] a change, made by one of the system's programs; a test's stand-in notes it and changes nothing
    my ($note, @command) = @_;
    my $stand = tool_stand() // return (said(10, @command))[1];
    return put("$stand/done", O_APPEND, $note);
}
sub tool_plain {                          # text of the system as one line of at most $most bytes: no control character, and UTF-8 or plain ASCII
    my ($text, $most) = @_;
    utf8::encode($text) if utf8::is_utf8($text);
    $text =~ s/[\x00-\x1f\x7f]/ /g;
    if (length $text > $most) { $text = substr($text, 0, $most); $text =~ s/[\xc0-\xff][\x80-\xbf]*\z// }    # not cut inside a character
    my $copy = $text;
    $text =~ s/[^\x20-\x7e]/?/g unless utf8::decode($copy);
    return $text;
}
sub tool_text {                           # [C20] text of the application, shown as text and nowhere acted on: 1 to $most characters, none a control or format character
    my ($text, $most) = @_;
    no warnings 'utf8';
    my $copy = $text;
    return unless utf8::decode($copy) && length $copy >= 1 && length $copy <= $most && $copy !~ /[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\p{NChar}]|[^\x{0}-\x{10ffff}]/;
    return $text;
}
sub tool_places {                         # where launchd jobs are written down: [whose, folder]; the first two are your account's
    if (defined(my $stand = tool_stand())) { return (['gui', "$stand/agents"], ['system', "$stand/daemons"]) }
    return (['gui', "$HOME/Library/LaunchAgents"], ['gui', '/Library/LaunchAgents'], ['system', '/Library/LaunchDaemons']);
}
sub tool_services {                       # of what launchctl prints of a domain: the jobs loaded there, each with its process (0: none runs), and the jobs switched off there
    my ($said) = @_;
    my (%loaded, %off);
    my ($block) = $said =~ /^\tservices = \{\n(.*?)^\t\}/ms;
    for (split /\n/, $block // '') { $loaded{$2} = $1 if /^\s+(\d+)\s+\S+\s+(\S+)\s*$/ }
    my ($set) = $said =~ /^\tdisabled services = \{\n(.*?)^\t\}/ms;
    for (split /\n/, $set // '') { $off{$1} = 1 if /^\s+"([^"]+)" => disabled\s*$/ }
    return (\%loaded, \%off);
}
sub tool_file {                           # a launchd property list: its label, the program it runs, that program's arguments, and when it runs (R at load, K kept alive, I on an interval, C by the calendar)
    my ($file) = @_;
    my @is = stat $file or return;
    return unless -f _ && $is[7] <= 1024 * 1024;
    my $key = "$is[9] $is[7]";
    return @{$TOOL_FILE{$file}[1]} if $TOOL_FILE{$file} && $TOOL_FILE{$file}[0] eq $key;
    my ($text, $ok) = said(5, '/usr/bin/plutil', '-convert', 'json', '-o', '-', '--', $file);
    my $list = $ok ? import_json($text) : undef;
    my @got;
    if (ref $list eq 'HASH') {
        my @args = ref $list->{ProgramArguments} eq 'ARRAY' ? grep { defined && !ref } @{$list->{ProgramArguments}} : ();
        my $flags = join '', map { $list->{$_->[0]} ? $_->[1] : () } [RunAtLoad => 'R'], [KeepAlive => 'K'], [StartInterval => 'I'], [StartCalendarInterval => 'C'];
        my $first = @args ? $args[0] : undef;    # read into a name of its own: $args[0] in a list given to grep would make that element when @args is empty, and the join would warn of it
        @got = ($list->{Label}, (grep { defined && !ref } $list->{Program}, $first, $list->{BundleProgram}, '')[0], join(' ', @args), $flags);
    }
    else {                                # a list with a date or data in it, which is no JSON: its label and its program are asked for one by one
        my @one = map { my ($said, $there) = said(5, '/usr/bin/plutil', '-extract', $_, 'raw', '-o', '-', '--', $file); chomp $said; $there ? $said : undef } 'Label', 'Program', 'ProgramArguments.0';
        @got = ($one[0], $one[1] // $one[2] // '', '', '');
    }
    @got = defined $got[0] && !ref $got[0] && $got[0] =~ /^$TOOL_LABEL\z/ ? ($got[0], tool_plain($got[1], 1000), tool_plain($got[2], 400), $got[3]) : ();
    $TOOL_FILE{$file} = [$key, \@got];
    return @got;
}
sub tool_signed {                         # who signed these programs, as codesign says: [path, the team (or "adhoc", "none", "-"), the identifier]
    my @paths = @_;
    my (%key, @ask);
    for my $path (@paths) {
        my @is = stat $path or next;
        $key{$path} = "$is[9] $is[7]";
        push @ask, $path if @ask < $TOOL_SIGNED && !($TOOL_SIGN{$path} && $TOOL_SIGN{$path}[0] eq $key{$path});
    }
    if (@ask) {
        my %asked = map { $_ => 1 } @ask;
        my ($said) = tool_asked('sign', 60, '/bin/sh', '-c', 'for p; do printf "=%s\n" "$p"; "$0" -dv --verbose=2 "$p" 2>&1; done', '/usr/bin/codesign', @ask);
        for my $part (split /^=/m, $said) {
            my ($path, $rest) = split /\n/, $part, 2;
            next unless defined $path && $asked{$path};
            $rest //= '';
            my ($team) = $rest =~ /^TeamIdentifier=([A-Za-z0-9]{1,20})$/m;
            my ($name) = $rest =~ /^Identifier=([\x21-\x7e]{1,200})$/m;
            $team //= $rest =~ /^Signature=adhoc$/m ? 'adhoc' : $rest =~ /not signed at all/ ? 'none' : '-';
            $TOOL_SIGN{$path} = [$key{$path}, $team, $name // '-'];
        }
    }
    return map { $TOOL_SIGN{$_} && $TOOL_SIGN{$_}[0] eq $key{$_} ? [$_, @{$TOOL_SIGN{$_}}[1, 2]] : () } grep { defined $key{$_} } @paths;
}
sub tool_kept {                           # [C20] the launchd jobs you switched off here: [label, its property list or nothing, when]
    open my $in, '<', "${\ shared()}/quieted" or return [];
    return [map { chomp; my @one = split /\t/, $_, -1; @one == 3 && $one[0] =~ /^$TOOL_LABEL\z/ && $one[1] =~ m{^(?:/[\x20-\x7e]{1,1000})?\z} && $one[2] =~ /^[0-9TZ:-]{1,30}\z/ ? [@one] : () } <$in>];
}
sub tool_keep {                           # [C20] that list, written beside the old one and through to the disk, then given its name in one step
    my ($kept) = @_;
    unlink "${\ shared()}/quieted.new";
    if (!@$kept) { return !-e "${\ shared()}/quieted" || unlink "${\ shared()}/quieted" }
    unless (put("${\ shared()}/quieted.new", O_EXCL, map { join "\t", @$_ } @$kept) && rename "${\ shared()}/quieted.new", "${\ shared()}/quieted") { unlink "${\ shared()}/quieted.new"; return 0 }
    synced(shared());
    return 1;
}

# One look. With $full, everything named above; without, only the jobs you
# switched off, which is all the tool needs to open. What is handed to the
# application is lines of text: "me", "proc", "open" (an app that is open
# now), "job", "sign" and "kept". What lzrprf itself saw is held in %TOOL,
# and a change is made against that, never against the application's word.
sub tool_look {
    my ($full) = @_;
    my (%procs, %jobs, %own, %open, @lines);
    my $kept = tool_kept();
    if ($full) {
        my ($list, $listed) = tool_asked('procs', 10, '/bin/ps', '-axww', '-o', 'pid=,ppid=,uid=,lstart=,comm=');
        return unless $listed;
        for (split /\n/, $list) {
            my ($pid, $ppid, $owner, $began, $path) = /^\s*(\d+)\s+(\d+)\s+(\d+)\s+(\S+\s+\S+\s+\d+\s+[\d:]+\s+\d+)\s+(.*?)\s*$/ or next;
            last if keys %procs >= $TOOL_PROCS;
            $procs{$pid} = { ppid => $ppid, uid => $owner, began => $began =~ s/\s+/ /gr, path => tool_plain($path, 1000), args => '' };
        }
        my ($args) = tool_asked('args', 10, '/bin/ps', '-axww', '-o', 'pid=,args=');
        for (split /\n/, $args) { my ($pid, $rest) = /^\s*(\d+)\s+(.*)$/ or next; $procs{$pid}{args} = tool_plain($rest, 400) if $procs{$pid} }
        for (my $up = $$; $up > 1 && $procs{$up} && !$own{$up}; $up = $procs{$up}{ppid}) { $own{$up} = 1 }    # lzrprf's own: this process and what started it, up to launchd
        my %mine = ($$ => 1);
        for (my $grew = 1; $grew;) { $grew = 0; for (keys %procs) { next if $mine{$_} || !$mine{$procs{$_}{ppid}}; $mine{$_} = $own{$_} = $grew = 1 } }    # and all it started: the window's pages, their keepers, the Tor client
        my ($gui, $gui_said) = tool_asked('jobs', 10, '/bin/launchctl', 'print', "gui/$<");
        return unless $gui_said;
        my ($system) = tool_asked('system', 10, '/bin/launchctl', 'print', 'system');
        my %in = (gui => [tool_services($gui)], system => [tool_services($system)]);
        for my $place (tool_places()) {
            my ($domain, $folder) = @$place;
            opendir(my $dir, $folder) or next;
            my @names = sort grep { /\.plist\z/ && !/[\x00-\x1f\x7f]/ } readdir $dir;
            closedir $dir;
            splice @names, $TOOL_FILES if @names > $TOOL_FILES;
            for my $name (@names) {
                my ($label, $program, $with, $flags) = tool_file("$folder/$name") or next;
                next if $jobs{$domain}{$label};
                my ($loaded, $off) = @{$in{$domain}};
                $jobs{$domain}{$label} = { pid => $loaded->{$label} // 0, state => exists $loaded->{$label} ? ($loaded->{$label} ? 'run' : 'load') : $off->{$label} ? 'off' : 'file',
                    program => $program, file => tool_plain("$folder/$name", 1000), flags => $flags . ($off->{$label} ? 'D' : ''), args => $with };
            }
        }
        my $asked = 0;
        for my $domain ('gui', 'system') {    # what is loaded and written down in none of the three folders: an open app, or a job an app registered from inside itself
            my ($loaded, $off) = @{$in{$domain}};
            for my $label (sort keys %$loaded) {
                next if $jobs{$domain}{$label} || $label =~ /^com\.apple\./ || $label !~ /^$TOOL_LABEL\z/;
                if ($label =~ /^application\.(.+?)\.\d+\.\d+\z/) { $open{$1} = 1; next }
                my ($one) = $asked++ < $TOOL_ASKED ? tool_asked("job.$label", 5, '/bin/launchctl', 'print', ($domain eq 'gui' ? "gui/$<" : 'system') . "/$label") : ('');
                my ($program) = $one =~ /^\tprogram = (.+)$/m;
                $jobs{$domain}{$label} = { pid => $loaded->{$label}, state => $loaded->{$label} ? 'run' : 'load', program => tool_plain($program // '', 1000), file => '', flags => $off->{$label} ? 'D' : '', args => '' };
            }
        }
        my $ours = qr{^/(?:System|bin|sbin|usr(?!/local/)|Library/Apple)/};    # the system's own programs: Apple signed them, and they are never changed here
        my (%want, @want);
        for my $path ((map { $_->{program} } map { values %$_ } values %jobs), map { $_->{path} =~ m{^(/.*?\.app)/} ? $1 : $_->{path} } @procs{sort { $a <=> $b } keys %procs}) {
            push @want, $path if $path =~ m{^/} && $path !~ $ours && !$want{$path}++;
        }
        push @lines, map { "proc $_ $procs{$_}{ppid} $procs{$_}{uid} " . ($procs{$_}{began} =~ tr/ /_/r) . "\t$procs{$_}{path}\t$procs{$_}{args}" } sort { $a <=> $b } keys %procs;
        push @lines, map { "open $_" } sort keys %open;
        for my $domain ('gui', 'system') { push @lines, map { my $job = $jobs{$domain}{$_}; "job $domain $_ $job->{pid} $job->{state}\t$job->{program}\t$job->{file}\t$job->{flags}\t$job->{args}" } sort keys %{$jobs{$domain} // {}} }
        push @lines, map { "sign $_->[0]\t$_->[1]\t$_->[2]" } tool_signed(@want);
    }
    push @lines, map { "kept $_->[0]\t$_->[1]\t$_->[2]" } @$kept;
    %TOOL = (procs => \%procs, jobs => \%jobs, own => \%own, kept => { map { $_->[0] => $_ } @$kept });
    return join '', map { "$_\n" } "me $<", @lines;
}

# lzrprf's own rules for a change the application names, whatever the
# application says of it: what the change is, in lzrprf's own words, or
# nothing when lzrprf does not make it. A process: one of yours that lzrprf
# itself saw in this look, not lzrprf, what it started or what started it,
# and not a program of the system. A launchd job: one of your account that
# lzrprf itself saw, written down in one of your account's two folders or in
# none, and not one of Apple's or an open app. A job switched on again: one
# you switched off here.                                             # [C20]
sub tool_may {
    my ($kind, $what) = @_;
    if ($kind eq 'stop') {
        my $proc = $what =~ /^[1-9][0-9]{0,6}\z/ ? $TOOL{procs}{$what} : undef;
        return unless $proc && $what > 1 && $proc->{uid} == $< && !$TOOL{own}{$what};
        return unless $proc->{path} =~ m{^/} && $proc->{path} !~ m{^/(?:System|bin|sbin|usr(?!/local/)|Library/Apple)/};
        return "the process $what, started $proc->{began}, $proc->{path}";
    }
    return unless $what =~ /^$TOOL_LABEL\z/ && $what !~ /^(?:com\.apple\.|application\.)/i;
    if ($kind eq 'quiet') {
        my $job = $TOOL{jobs}{gui}{$what} or return;
        return if $job->{state} eq 'off';
        my ($folder) = $job->{file} =~ m{^(.*)/[^/]+\z};
        return if $job->{file} ne '' && !grep { $_->[0] eq 'gui' && $_->[1] eq $folder } tool_places();
        return "the launchd job $what of your account" . ($job->{file} ne '' ? ", written down in $job->{file}" : '') . ($job->{program} ne '' ? ", which runs $job->{program}" : '');
    }
    my $kept = $kind eq 'wake' ? $TOOL{kept}{$what} : undef or return;
    return "the launchd job $what, switched off here on $kept->[2]" . ($kept->[1] ne '' ? ", written down in $kept->[1]" : '');
}

# The application's answer, checked: its title, its words, the heading of its
# list, the words of its three buttons (look, switch off, switch on again),
# and its rows, each a tag, a title and a sentence, with the changes it names
# for that row. Text is shown as text. A change is kept only when sub
# tool_may lets it be made, and a row with none left cannot be ticked. An
# answer with one line in no such form is not shown at all.           # [C20]
sub tool_checked {
    my ($wrote) = @_;
    return unless defined $wrote && $wrote =~ s/\n\z//;
    my @lines = split /\n/, $wrote, -1;
    return if @lines > ($TOOL_ACTS + 1) * $TOOL_ROWS + 8 + $TOOL_PROCS;
    my (%said, %rows, @order, %about);
    for (@lines) {
        if (/^(title|head) (.+)\z/s) { defined($said{$1} = tool_text($2, 60)) or return }
        elsif (/^words (.+)\z/s) { defined($said{words} = tool_text($1, 600)) or return }
        elsif (/^button (sense|act|undo) (.+)\z/s) { defined($said{$1} = tool_text($2, 40)) or return }
        elsif (/^row (0|[1-9][0-9]{0,2}) ([^\t]*)\t([^\t]*)\t([^\t]*)\z/s) {
            return if $1 >= $TOOL_ROWS || $rows{$1};
            my %row = (tag => tool_text($2, 24), title => tool_text($3, 100), detail => tool_text($4, 600), acts => []);
            return if grep { !defined } @row{qw(tag title detail)};
            $rows{$1} = \%row;
            push @order, $1;
        }
        elsif (/^(stop|quiet|wake) (0|[1-9][0-9]{0,2}) ([\x21-\x7e]{1,200})\z/) {
            my $row = $rows{$2} or return;
            return if @{$row->{acts}} >= $TOOL_ACTS;
            push @{$row->{acts}}, [$1, $3];
        }
        elsif (/^about ([1-9][0-9]{0,6}) (core|known)\t([^\t]*)\t([^\t]*)\t([^\t]*)\z/s) {    # Show all processes: what the application can say of one process; shown as text, and nothing is ever changed for it
            return if $about{$1} || keys %about >= $TOOL_PROCS;
            my %one = (group => $2, title => tool_text($3, 100), about => tool_text($4, 600), source => tool_text($5, 100));
            return if grep { !defined } values %one;
            $about{$1} = \%one;
        }
        else { return }
    }
    return unless defined $said{title};
    for my $row (values %rows) {
        my @acts = map { my $fact = tool_may(@$_); defined $fact ? [@$_, $fact] : () } @{$row->{acts}};
        my @wake = grep { $_->[0] eq 'wake' } @acts;
        @acts = @wake ? @wake : ((grep { $_->[0] eq 'quiet' } @acts), grep { $_->[0] eq 'stop' } @acts);    # a job is switched off before its process is asked to end, so launchd does not start it again
        @$row{qw(acts mode)} = (\@acts, @wake ? 'undo' : @acts ? 'act' : 'none');
        $row->{fact} = tool_plain(join('; ', map { ($_->[0] eq 'stop' ? 'Ends ' : $_->[0] eq 'quiet' ? 'Switches off ' : 'Switches on again ') . $_->[2] } @acts), 4000);
    }
    return { %said, rows => \%rows, order => \@order, about => \%about };
}

sub tool_none { window('tool none'); return idle($_[0]) }

# "tool open", "tool sense" and "tool all", from the window: the look, the
# application's answer to it, and the list the window shows; "tool all" (Show
# all processes) adds every process of the look (sub tool_procs). $said: what
# lzrprf did a moment ago, in its own words, shown over the list.
sub tool_shown {
    my ($how, $said) = @_;
    return tool_none('An incognito window has no tool of the application: it would write what you switch off.') if $INCOGNITO;
    return tool_none('LZRDFNDR is not installed. Add it in Add or remove LZR modules, in the cogwheel menu.') unless part_on('lzrdfndr');
    $TOOL_ALL = $how eq 'all' if $how ne 'open';
    window('tool busy ' . ($how eq 'all' ? 'Reading every process of this computer' : $how eq 'sense' ? 'Reading the processes and the launchd jobs of this computer' : 'Asking the application'));
    my $look = tool_look($how ne 'open');
    return tool_none('The system did not list its processes and launchd jobs, so the application was asked nothing.') unless defined $look;
    my ($wrote, $why) = contained('tool', "=tool $how\n$look", undef, 0, 1);    # [C1] [C3] in the page container, as a picture is: no network, no file
    my $list = defined $wrote ? tool_checked($wrote) : undef;
    return tool_none(defined $wrote ? 'This application has no tool, or its answer was not in the form lzrprf takes, so nothing of it is shown.' : "The application's tool was not run: " . ($why // 'it did not start') . '.') unless $list;
    $TOOL{rows} = $list->{rows};
    record("You looked at this computer's processes and launchd jobs with the application's tool: " . @{$list->{order}} . ' rows' . ($how eq 'all' ? ' and every process shown' : '') . ', nothing changed') if $how ne 'open' && !defined $said;
    window('tool begin', "tool title $list->{title}", (map { defined $list->{$_} ? "tool $_ $list->{$_}" : () } 'words', 'head'), (map { defined $list->{$_} ? "tool button $_ $list->{$_}" : () } 'sense', 'act', 'undo'),
        (map { my $row = $list->{rows}{$_}; "tool row $_ $row->{mode}\t$row->{tag}\t$row->{title}\t$row->{detail}\t$row->{fact}" } @{$list->{order}}), ($how eq 'all' ? tool_procs($list->{about}) : ()), defined $said ? "tool said $said" : (), 'tool end');
    return;
}

# "tool act I,I,.." and "tool undo I,I,..", from the window, after you ticked
# those rows and, for a switching off, confirmed lzrprf's own words for each.
# A list is acted on once: after it the computer is looked at again.  # [C20]
sub tool_done {
    my ($kind, $picked) = @_;
    my $rows = delete $TOOL{rows};
    return tool_none('That list is no longer the newest look at this computer, so nothing was changed. Look again.') if $INCOGNITO || !$rows;
    window('tool busy ' . ($kind eq 'act' ? 'Switching off what you ticked' : 'Switching on again what you ticked'));
    my (%seen, @did, @not);
    for my $i (split /,/, $picked) {
        my $row = $rows->{$i};
        next if $seen{"row $i"}++ || !$row || $row->{mode} ne $kind;
        for my $act (@{$row->{acts}}) {
            next if $seen{"$act->[0] $act->[1]"}++;
            my ($ok, $says) = $act->[0] eq 'stop' ? tool_stop($act->[1]) : $act->[0] eq 'quiet' ? tool_quiet($act->[1]) : tool_wake($act->[1]);
            push @{$ok ? \@did : \@not}, $says;
        }
    }
    my $said = join ' ', @did ? 'Done: ' . join('; ', @did) . '.' : (), @not ? 'Not done: ' . join('; ', @not) . '.' : ();
    return tool_shown($TOOL_ALL ? 'all' : 'sense', tool_plain($said, 3000) || 'Nothing you ticked is a change lzrprf makes.');
}

# Show all processes, the button at the bottom left of On Your Computer:
# every process of the look, each as one line "tool proc" of fifteen fields
# parted by tabs: its number, its share of a processor now (ps %cpu), its
# memory in KiB (ps rss), its group, its title, what it is, where that was
# read, the note you wrote to it, the number of its parent, its user, when it
# started, its program, its command line, who signed it and the launchd job
# that runs it. What it is comes from the application's word for it (a
# process of the core project by its name, or one its table names), else
# from the manual page of its program on this Mac (sub tool_man), else
# nothing: nothing of the look is sent anywhere to be described. The window
# copies a row's fields to the clipboard on its Copy info, and a row is shown
# and never changed from here: a process is ended only as a ticked row of the
# list above (sub tool_done).                                        # [C20]
sub tool_procs {
    my ($about) = @_;
    my (%use, %user, %job);
    my ($said, $ok) = tool_asked('usage', 10, '/bin/ps', '-axww', '-o', 'pid=,%cpu=,rss=');
    for (split /\n/, $ok ? $said : '') { $use{$1} = [$2, $3] if /^\s*(\d+)\s+([\d.]+)\s+(\d+)\s*$/ }
    for my $domain ('gui', 'system') { for my $label (sort keys %{$TOOL{jobs}{$domain} // {}}) { my $pid = $TOOL{jobs}{$domain}{$label}{pid}; $job{$pid} //= "$domain $label" if $pid } }
    my $notes = tool_notes();
    my $read = 0;
    my $system = qr{^/(?:System|bin|sbin|usr(?!/local/)|Library/Apple)/};
    return map {
        my ($pid, $proc) = ($_, $TOOL{procs}{$_});
        my $name = $proc->{path} =~ m{([^/]+)\z} ? $1 : $proc->{path};
        my $told = $about->{$pid};
        my ($text, $source) = $told ? @$told{qw(about source)} : tool_man($name, \$read);
        my $group = $told && $told->{group} eq 'core' ? 'core' : $TOOL{own}{$pid} ? 'lzrbrwsr' : $proc->{path} =~ $system ? 'macos' : $proc->{uid} == $< ? 'yours' : 'others';
        my $sign = $TOOL_SIGN{$proc->{path} =~ m{^(/.*?\.app)/} ? $1 : $proc->{path}};
        $user{$proc->{uid}} //= tool_plain((getpwuid $proc->{uid})[0] // $proc->{uid}, 64);
        'tool proc ' . join("\t", $pid, $use{$pid} ? @{$use{$pid}} : ('-', '-'), $group, $told ? $told->{title} : tool_plain($name, 100), map({ $_ // '' } $text, $source), $notes->{$proc->{path}} // '',
            $proc->{ppid}, $user{$proc->{uid}}, $proc->{began}, $proc->{path}, $proc->{args}, $sign ? "$sign->[1] $sign->[2]" : '', $job{$pid} // '');
    } sort { $a <=> $b } keys %{$TOOL{procs}};
}
sub tool_man {                            # [C20] what the manual page of a program on this Mac says it is, its NAME line, and which page; nothing when none is there or $TOOL_MANS were read in this look
    my ($name, $read) = @_;
    return @{$TOOL_MAN{$name}} if $TOOL_MAN{$name};
    return unless $name =~ /\A[A-Za-z0-9][A-Za-z0-9._+-]{0,100}\z/ && $$read++ < $TOOL_MANS;
    my $stand = tool_stand();
    for my $dir (defined $stand ? "$stand/man" : ('/usr/share/man', '/usr/local/share/man', '/opt/homebrew/share/man')) {
        for my $section (8, 1, 5) {
            my $file = "$dir/man$section/$name.$section";
            next unless -f $file && -s _ <= 1024 * 1024 && open my $in, '<', $file;
            read $in, my $text, 16384;
            my ($what) = $text =~ /^\.Nd\s+(.+)$/m;    # mdoc: .Nm NAME, then .Nd what it is
            ($what) = $text =~ /^\.SH\s+"?NAME"?\s*\n(?:\.[^\n]*\n)*([^\n]*?\\-\s*[^\n]+)$/m unless defined $what;    # man: NAME \- what it is, under .SH NAME
            next unless defined $what;
            $what =~ s/^.*?\\-\s*//;    # the name before "\-" goes: the title column has it
            $what =~ s/\\f[A-Z]|\\\(..|\\[&|^]//g;
            $what =~ s/\\(.)/$1/g;
            $what = tool_plain($what =~ s/^\s+|\s+$//gr, 300);
            next unless length $what;
            return @{$TOOL_MAN{$name} = [ucfirst($what) . ($what =~ /[.!?]\z/ ? '' : '.'), "the manual page $name($section) on this Mac"]};
        }
    }
    $TOOL_MAN{$name} = [];
    return;
}
sub tool_notes {                          # [C20] the notes you wrote to processes, each by the program of the process: { program => note }
    open my $in, '<', "${\ shared()}/procnotes" or return {};
    my %notes;
    while (my $line = <$in>) {
        last if keys %notes >= $TOOL_NOTES;
        chomp $line;
        my ($key, $note) = split /\t/, $line, 2;
        $notes{$key} = $note if defined $note && $key =~ /\A[^\x00-\x1f\x7f]{1,1000}\z/ && defined tool_text($note, $TOOL_NOTE);
    }
    return \%notes;
}
# "tool note PROGRAM<tab>TEXT", from the window: the note you wrote in the Notes
# column of a process, kept by its program (the same note for every process
# of it) in ~/.lzrprf/procnotes, written beside the old list and given its
# name in one step; an empty note takes it away. Never in an incognito
# window, which has no tool. The window is told "tool noted kept" or "tool
# noted failed".                                                    # [C20]
sub tool_note {
    my ($key, $note) = @_;
    $note =~ s/^\s+|\s+$//g;
    return window('tool noted failed') if $INCOGNITO || length($note) && !defined tool_text($note, $TOOL_NOTE);
    my $notes = tool_notes();
    if (length $note) { $notes->{$key} = $note } else { delete $notes->{$key} }
    return window('tool noted failed') if keys %$notes > $TOOL_NOTES;
    record("You wrote a note to the processes of $key in LZRDFNDR's Show all processes") or return window('tool noted failed');
    my $file = "${\ shared()}/procnotes";
    unlink "$file.new";
    my $kept = !%$notes ? (!-e $file || unlink $file) : put("$file.new", O_EXCL, map { "$_\t$notes->{$_}" } sort keys %$notes) && rename("$file.new", $file);
    unlink "$file.new";
    synced(shared()) if $kept;
    return window('tool noted ' . ($kept ? 'kept' : 'failed'));
}
sub tool_stop {                           # [C20] a process of yours is asked to end: looked at again first, and ended only when it is still the one that was listed; the log line says who ended it (lzr says its own command)
    my ($pid, $who) = @_;
    my $fact = tool_may('stop', $pid) or return (0, "process $pid is not one lzrprf ends");
    my $proc = $TOOL{procs}{$pid};
    my ($now) = tool_asked("proc.$pid", 5, '/bin/ps', '-o', 'uid=,lstart=,comm=', '-p', $pid);
    my ($owner, $began, $path) = $now =~ /^\s*(\d+)\s+(\S+\s+\S+\s+\d+\s+[\d:]+\s+\d+)\s+(.*?)\s*$/ or return (1, "process $pid had ended already");
    return (0, "process $pid is no longer the one that was listed") unless $owner == $proc->{uid} && ($began =~ s/\s+/ /gr) eq $proc->{began} && tool_plain($path, 1000) eq $proc->{path};
    record(($who // "You ended a process from the application's tool") . ": $fact") or return (0, "process $pid: the log could not be written, so it was left running");    # written down first
    return (tool_ran("TERM $pid"), "process $pid was asked to end") if defined tool_stand();
    kill('TERM', $pid) or return (0, "process $pid could not be asked to end");
    for (my $until = now() + 2; now() < $until && kill(0, $pid);) { Time::HiRes::sleep(0.05) }
    return (1, kill(0, $pid) ? "process $pid was asked to end and is still ending" : "process $pid ended");
}
sub tool_off {                            # [C20] a launchd job of your account, switched off and taken out of launchd; true when launchd no longer holds it
    my ($label) = @_;
    my $off = tool_ran("disable $label", '/bin/launchctl', 'disable', "gui/$</$label");
    tool_ran("bootout $label", '/bin/launchctl', 'bootout', "gui/$</$label");    # of a job that is not loaded there is nothing to take out, and launchctl says so: that is no failure
    for (my $until = now() + 3; now() < $until;) {
        return $off unless (tool_asked("job.$label.after", 5, '/bin/launchctl', 'print', "gui/$</$label"))[1];
        Time::HiRes::sleep(0.2);
    }
    return 0;
}
sub tool_quiet {                          # [C20]
    my ($label) = @_;
    my $fact = tool_may('quiet', $label) or return (0, "launchd job $label is not one lzrprf switches off");
    my $job = $TOOL{jobs}{gui}{$label};
    record("You switched a launchd job off from the application's tool: $fact") or return (0, "launchd job $label: the log could not be written, so it was left as it is");    # written down first
    my $kept = tool_kept();
    @$kept = ((grep { $_->[0] ne $label } @$kept), [$label, $job->{file} =~ m{^/[\x20-\x7e]{1,1000}\z} ? $job->{file} : '', strftime('%Y-%m-%dT%H:%M:%SZ', gmtime)]);
    tool_keep($kept) or return (0, "launchd job $label: the list of what you switched off could not be written, so it was left as it is");
    return tool_off($label) ? (1, "launchd job $label is switched off") : (0, "launchd job $label could not be switched off");
}
sub tool_wake {                           # [C20] a job you switched off here, switched on again: enabled, and loaded again when its property list is still there
    my ($label) = @_;
    my $fact = tool_may('wake', $label) or return (0, "launchd job $label is not one you switched off here");
    my $file = $TOOL{kept}{$label}[1];
    record("You switched a launchd job on again from the application's tool: $fact") or return (0, "launchd job $label: the log could not be written, so it was left switched off");
    my $on = tool_ran("enable $label", '/bin/launchctl', 'enable', "gui/$</$label");
    tool_ran("bootstrap $label", '/bin/launchctl', 'bootstrap', "gui/$<", $file) if $file ne '' && -f $file;
    tool_keep([grep { $_->[0] ne $label } @{tool_kept()}]);
    return $on ? (1, "launchd job $label is switched on again" . ($file ne '' && -f $file ? '' : ', and starts when its app or the next login starts it')) : (0, "launchd job $label could not be switched on again");
}

# The jobs you switched off, looked at again: at the start of a window and
# every $TOOL_WATCH seconds while it is open. One that is loaded again, or
# no longer switched off, was put back by its app or its installer: it is
# switched off again, as you chose, written in the log first, and the window
# lights the tool's icon. Nothing else of the computer is read for this, and
# with nothing switched off nothing is read at all. The programs you
# deactivated with lzr are looked for on a cadence of their own (sub
# lzr_watch), with nothing read while none is deactivated.            # [C20]
sub tool_due {                            # the seconds until the next such look, or the next look for deactivated programs; nothing when there is nothing to look at
    return if $INCOGNITO;
    my @due = sort { $a <=> $b } lzr_due(), -s "${\ shared()}/quieted" && part_on('lzrdfndr') ? ($TOOL_LOOKED // now()) + $TOOL_WATCH - now() : ();
    return unless @due;
    return $due[0] > 1 ? $due[0] : 1;
}
sub tool_watch {
    return if $INCOGNITO;
    lzr_watch();
    return if !part_on('lzrdfndr') || defined $TOOL_LOOKED && now() < $TOOL_LOOKED + $TOOL_WATCH;    # what LZRDFNDR switched off is looked at only while it is installed; what lzr deactivated, always
    $TOOL_LOOKED = now();
    my $kept = tool_kept();
    return unless @$kept;
    my ($gui, $said) = tool_asked('jobs', 10, '/bin/launchctl', 'print', "gui/$<");
    return unless $said;
    my ($loaded, $off) = tool_services($gui);
    my @back = grep { exists $loaded->{$_} || !$off->{$_} } map { $_->[0] } @$kept;
    @back = grep { record("The launchd job $_, which you switched off, was switched on again by something else, and lzrprf switched it off again") && tool_off($_) } @back;
    window('tool back ' . @back) if @back;
    return;
}


