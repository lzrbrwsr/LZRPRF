sub lzr_main {                            # "lzrprf lzr WORDS": what lzr does with the words, and the number it ends with
    my ($flags, $words, $bad) = lzr_parsed(@_);
    $LZR_COLOR = !$flags->{'no-color'} && !length($SHOWN{NO_COLOR} // '') && -t STDOUT;
    return lzr_wrong($bad, '') if defined $bad;
    my ($path, $args, $why) = lzr_found(@$words);
    return lzr_wrong($why, $path // '') if defined $why;
    return lzr_help($path) if $flags->{help};
    return lzr_version() if $path eq '' && $flags->{version} || $path eq 'version';
    my @extra = grep { my $f = $_; !grep { $_ eq $f } 'help', 'no-color', @{ $LZR_COMMAND{$path}{flags} // [] } } sort keys %$flags;
    return lzr_wrong("--$extra[0] is not a flag of lzr" . ($path eq '' ? '' : " $path") . (lzr_near($extra[0], @{ $LZR_COMMAND{$path}{flags} // [] }) ? '. Did you mean --' . join(' or --', lzr_near($extra[0], @{ $LZR_COMMAND{$path}{flags} // [] })) . '?' : ''), $path) if @extra;
    return lzr_help('') if $path eq '';
    if ($path eq 'help') {
        my ($at, undef, $wrong) = lzr_found(@$args);
        return lzr_wrong($wrong, $at // '') if defined $wrong;
        return lzr_help($at);
    }
    my $want = $LZR_COMMAND{$path}{args} ? 1 : 0;
    return lzr_wrong("lzr $path needs an ID: the process to act on", $path) if @$args < $want;
    return lzr_wrong("lzr $path takes " . ($want ? 'one ID' : 'no word') . ", and \"$args->[$want]\" is one more", $path) if @$args > $want;
    return lzr_processes($path =~ s/^processes ?//r || 'list', $args->[0], $flags);
}

sub lzr_parsed {                          # the words and the flags, apart: the flags anywhere after lzr, "--" ends them; an error of form, in words
    my (%flags, @words, $rest);
    my %short = map { $LZR_FLAG{$_}[0] ? ($LZR_FLAG{$_}[0] => $_) : () } keys %LZR_FLAG;
    while (@_) {
        my $word = shift;
        if ($rest || $word !~ /^-./) { push @words, $word; next }
        if ($word eq '--') { $rest = 1; next }
        my @names;
        my $value;
        if ($word =~ /^--([a-z][a-z-]*)(?:=(.*))?\z/s) {
            return (\%flags, \@words, "--$1 is not a flag of lzr" . (lzr_near($1, keys %LZR_FLAG) ? '. Did you mean --' . join(' or --', lzr_near($1, keys %LZR_FLAG)) . '?' : '')) unless $LZR_FLAG{$1};
            @names = ($1);
            $value = $2;
        }
        elsif ($word =~ /^-([a-zA-Z]+)\z/) {
            for my $letter (split //, $1) { return (\%flags, \@words, "-$letter is not a flag of lzr") unless $short{$letter}; push @names, $short{$letter} }
        }
        else { return (\%flags, \@words, "\"$word\" is not a flag lzr reads") }
        for my $name (@names) {
            my $takes = $LZR_FLAG{$name}[1];
            if (!length $takes) { return (\%flags, \@words, "--$name takes no value") if defined $value; $flags{$name} = 1; next }
            $value //= shift;
            return (\%flags, \@words, "--$name needs a value: $takes") unless defined $value && length $value;
            $flags{$name} = $value;
            undef $value;
        }
    }
    return (\%flags, \@words, undef);
}

sub lzr_named {                           # the command a word names among the commands of a group (its own name or an alias), or nothing
    my ($group, $word) = @_;
    for my $name (@{ $LZR_COMMAND{$group}{commands} // [] }) {
        my $path = length $group ? "$group $name" : $name;
        return $name if $word eq $name || grep { $_ eq $word } @{ $LZR_COMMAND{$path}{aliases} // [] };
    }
    return;
}

sub lzr_id_like { $_[0] =~ /\A(?:[1-9][0-9]{0,6}|(?=[a-z]*[0-9])[0-9a-hjkmnp-tv-z]{3,5})\z/ }    # a process number, or the start of an ID of lzr's (at least three of its letters and digits, one a digit)

sub lzr_found {                           # the command the words name, the words after it, or what is wrong
    my @words = @_;
    return ('', []) unless @words;
    my $first = shift @words;
    my $group = lzr_named('', $first);
    return (undef, undef, "\"$first\" is not a command of lzr" . lzr_hint($first, '')) unless defined $group;
    return ($group, \@words) unless $LZR_COMMAND{$group}{commands} && @words;
    my $verb = lzr_named($group, $words[0]);
    return ("$group $verb", [@words[1 .. $#words]]) if defined $verb;
    if (lzr_id_like($words[0])) {
        my $after = @words > 1 ? lzr_named($group, $words[1]) : undef;
        return ("$group $after", [$words[0], @words[2 .. $#words]]) if defined $after;
        return ($group, undef, "say what to do with $words[0]: lzr $group $words[0] " . join('|', grep { $LZR_COMMAND{"$group $_"}{args} } @{ $LZR_COMMAND{$group}{commands} })) if @words == 1;
        return ($group, undef, "\"$words[1]\" is not a command of lzr $group" . lzr_hint($words[1], $group));
    }
    return ($group, undef, "\"$words[0]\" is not a command of lzr $group" . lzr_hint($words[0], $group));
}

sub lzr_hint {                            # ". Did you mean ...?" with the nearest commands of a group, or nothing
    my ($word, $group) = @_;
    my @names = map { my $path = length $group ? "$group $_" : $_; ($_, @{ $LZR_COMMAND{$path}{aliases} // [] }) } @{ $LZR_COMMAND{$group}{commands} };
    my @near = lzr_near($word, @names);
    return @near ? '. Did you mean ' . join(' or ', map { "\"lzr " . (length $group ? "$group " : '') . "$_\"" } @near) . '?' : '';
}

sub lzr_near {                            # the names nearest a word that was typed: a name it begins, or within a few changes of a letter (one for a short word, two, three for a long one)
    my ($typed, @names) = @_;
    $typed = lc $typed;
    my @starts = grep { length $typed >= 2 && index($_, $typed) == 0 } @names;
    return @starts if @starts == 1;
    my $most = length $typed <= 4 ? 1 : length $typed <= 8 ? 2 : 3;
    my %far = map { $_ => lzr_distance($typed, $_) } @names;
    my @near = sort { $far{$a} <=> $far{$b} || $a cmp $b } grep { $far{$_} <= $most } @names;
    return grep { $far{$_} == $far{$near[0]} } @near if @near;
    return @starts;
}

sub lzr_distance {                        # the changes of one letter that make one word the other: put in, taken out, changed, or two side by side swapped (the optimal string alignment distance)
    my ($s, $t) = @_;
    my @d = map { [$_] } 0 .. length $s;
    $d[0][$_] = $_ for 0 .. length $t;
    for my $i (1 .. length $s) {
        for my $j (1 .. length $t) {
            my $cost = substr($s, $i - 1, 1) eq substr($t, $j - 1, 1) ? 0 : 1;
            my $best = (sort { $a <=> $b } $d[$i - 1][$j] + 1, $d[$i][$j - 1] + 1, $d[$i - 1][$j - 1] + $cost)[0];
            $best = $d[$i - 2][$j - 2] + 1 if $i > 1 && $j > 1 && substr($s, $i - 1, 1) eq substr($t, $j - 2, 1) && substr($s, $i - 2, 1) eq substr($t, $j - 1, 1) && $d[$i - 2][$j - 2] + 1 < $best;
            $d[$i][$j] = $best;
        }
    }
    return $d[length $s][length $t];
}

sub lzr_wrong {                           # words not in lzr's form: what is wrong, where to read more, and 2
    my ($why, $path) = @_;
    print STDERR "lzr: $why" . ($why =~ /[.?]\z/ ? '' : '.') . "\n", 'Run "lzr help' . (length $path ? " $path" : '') . "\" to see how it is used.\n";
    return 2;
}

sub lzr_said {                            # something lzr did not do: why, on standard error, and 1
    my ($why) = @_;
    print STDERR "lzr: $why\n";
    return 1;
}

sub lzr_paint { my ($code, $text) = @_; return $LZR_COLOR ? "\e[${code}m$text\e[m" : $text }    # colour, only on a terminal and when not asked for none

sub lzr_wrapped {                         # a paragraph in lines of at most $wide characters, each begun with $indent
    my ($text, $indent, $wide) = @_;
    my (@lines, $line);
    for my $word (split ' ', $text) {
        if (defined $line && length($line) + 1 + length($word) > $wide - length $indent) { push @lines, $line; undef $line }
        $line = defined $line ? "$line $word" : $word;
    }
    push @lines, $line if defined $line;
    return map { "$indent$_\n" } @lines;
}

sub lzr_help {                            # the help of a command: what it does, how it is used, its commands, flags and examples
    my ($path) = @_;
    my $c = $LZR_COMMAND{$path};
    my $name = length $path ? "lzr $path" : 'lzr';
    my @out = (lzr_paint(1, $name) . ": $c->{brief}\n\n", lzr_paint(1, 'USAGE') . "\n", map({ "  $_\n" } @{ $c->{usage} }));
    push @out, "\n", lzr_wrapped($c->{about}, '  ', 80) if $c->{about};
    if (my @names = @{ $c->{commands} // [] }) {
        my %line = map { my $sub = length $path ? "$path $_" : $_; my @also = @{ $LZR_COMMAND{$sub}{aliases} // [] }; ($_ => (@also ? "$LZR_COMMAND{$sub}{brief} (also: @also)" : $LZR_COMMAND{$sub}{brief})) } @names;
        push @out, "\n", lzr_paint(1, 'COMMANDS') . "\n", map { sprintf "  %s%s\n", lzr_paint(96, sprintf '%-12s', $_), $line{$_} } @names;
    }
    my @flags = (@{ $c->{flags} // [] }, 'help', ($path eq '' ? 'no-color' : ()));
    my %form = map { my ($short, $takes) = @{ $LZR_FLAG{$_} }; ($_ => ($short ? "-$short, " : '    ') . "--$_" . (length $takes ? " $takes" : '')) } @flags;
    my $wide = (sort { $b <=> $a } map { length } values %form)[0] + 2;
    push @out, "\n", lzr_paint(1, 'FLAGS') . "\n", map { sprintf "  %-${wide}s%s\n", $form{$_}, $LZR_FLAG{$_}[2] } @flags;
    push @out, "\n", lzr_paint(1, 'EXAMPLES') . "\n", map { "  $_\n" } @{ $c->{examples} } if $c->{examples};
    push @out, "\n", lzr_paint(1, 'LEARN MORE') . "\n", $c->{commands} ? "  Run \"lzr help $path <command>\" for more on a command." =~ s/help  /help /r . ($path eq '' ? ' Every command also takes --help.' : '') . "\n" : '', $path ne '' ? "  Run \"lzr\" for every command.\n" : ();
    print @out;
    return 0;
}

sub lzr_version { print "lzr $LZR_VERSION, the command of lzrprf ", substr(sum_of($SELF) // 'unknown', 0, 12), "\n"; return 0 }

# The folder lzr is started from in LZRTRMNL: ~/.lzrprf/bin, holding one file,
# lzr, written again at each terminal so it always names this lzrprf: three
# lines that start the system's perl with this file and "lzr". Nothing when
# that cannot be written, and the terminal opens without it.        # [C20]
sub lzr_bin {
    return if $INCOGNITO || $SELF =~ /['\n\\]/;
    my $bin = "${\ shared()}/bin";
    mkdir $bin, 0700;
    my @is = lstat $bin;
    return unless @is && -d _ && $is[4] == $<;
    unlink "$bin/lzr.new";
    put("$bin/lzr.new", O_EXCL, '#!/bin/sh', '# lzr, the command of LZRTRMNL: written by lzrprf when a terminal opens (lzrprf help: lzr help)', "exec /usr/bin/perl '$SELF' lzr \"\$\@\"") && chmod(0700, "$bin/lzr.new") && rename("$bin/lzr.new", "$bin/lzr") or return;
    return $bin;
}

# lzr processes [C20]: LZRDFNDR from the terminal. The look is the tool's own
# (ps, as sub tool_look reads it, into %TOOL), and every change goes through
# the tool's rules: sub tool_may says which process may be ended, sub
# tool_stop ends it after asking ps again, sub tool_quiet switches a launchd
# job off and keeps it in ~/.lzrprf/quieted, sub tool_wake switches it on.
# Every change is written in the log first, and is made only on your word
# (a question on the terminal, or --yes). On top of those:
#
# - A program you deactivated is kept in ~/.lzrprf/deactivated (its path and
#   when). Each process of it is closed whenever LZRDFNDR sees it: at every
#   "lzr processes", and every $LZR_SEEN seconds while a window is open
#   (sub tool_watch). Its launchd jobs of your account are switched off.
# - A process you contained is ended and its program started again, with the
#   arguments it ran with, in the page container ($CONTAINER), as a child of
#   a keeper of its own ("core-lzrprf-contain ID", sub lzr_keeper). Each is a
#   file of ~/.lzrprf/contained, written whole: what was started, its
#   number, whether the system says it is contained, and how it ended.
#
# An ID is five of the letters and digits of $LZR_ALPHABET, at least one a
# digit, made from a SHA-256: of a process's number and start, of a program's
# path, of a launchd job's label, of a contained process's start. So it stays
# the same for as long as what it names does.
my $LZR_ALPHABET = '0123456789abcdefghjkmnpqrstvwxyz';    # no i, l, o or u: no two that look alike
my $LZR_SEEN = 10;                        # DECLARED([C20] seconds between two looks for deactivated programs while a window is open: a ps of every process, about 30 ms)
my $LZR_DEACTIVATED = 500;                # DECLARED([C20] the most programs kept deactivated: more than a person switches off)
my $LZR_CONTAINED = 64;                   # DECLARED([C20] the most contained processes kept: more than a person runs that way at once)
my $LZR_ARGS = 262_144;                   # DECLARED([C20] the most bytes of a process's arguments and environment read to start it again contained: the system's own limit, kern.argmax, is 1 MiB, and arguments longer than this are not contained)
my $LZR_SYSTEM = qr{^/(?:System|bin|sbin|usr(?!/local/)|Library/Apple)/};    # the system's own programs, as sub tool_may has them
my (%LZR_USE, $LZR_LOOKED, $LZR_WATCHED); # each process's share of a processor and memory (KiB) in the last look; when that look was; when a window last looked for deactivated programs

sub lzr_id {                              # the ID of what a key names (sub lzr_processes says which keys)
    my @bytes = unpack 'C*', Digest::SHA::sha256("lzr $_[0]");
    my $id = join '', map { substr $LZR_ALPHABET, $bytes[$_] % 32, 1 } 0 .. 4;
    substr($id, $bytes[5] % 5, 1) = $bytes[6] % 10 unless $id =~ /[0-9]/;    # one digit at least, so an ID is never a word
    return $id;
}

sub lzr_look {                            # every process the system lists, into %TOOL as the tool's look holds them, with what each uses; false when ps said nothing
    my ($list, $listed) = tool_asked('procs', 10, '/bin/ps', '-axww', '-o', 'pid=,ppid=,uid=,lstart=,comm=');
    return 0 unless $listed;
    my (%procs, %own);
    for (split /\n/, $list) {
        my ($pid, $ppid, $owner, $began, $path) = /^\s*(\d+)\s+(\d+)\s+(\d+)\s+(\S+\s+\S+\s+\d+\s+[\d:]+\s+\d+)\s+(.*?)\s*$/ or next;
        $procs{$pid} = { ppid => $ppid, uid => $owner, began => $began =~ s/\s+/ /gr, path => tool_plain($path, 1000), args => '' };
    }
    for (my $up = $$; $up > 1 && $procs{$up} && !$own{$up}; $up = $procs{$up}{ppid}) { $own{$up} = 1 }    # lzr and what started it: this terminal's shell, lzrprf, the window, up to launchd (what those started besides is LZRBRWSR's own program, or a system program, or yours to name)
    my ($use, $used) = tool_asked('usage', 10, '/bin/ps', '-axww', '-o', 'pid=,%cpu=,rss=');
    %LZR_USE = ();
    for (split /\n/, $used ? $use : '') { $LZR_USE{$1} = [$2, $3] if /^\s*(\d+)\s+([\d.]+)\s+(\d+)\s*$/ }
    @TOOL{qw(procs own)} = (\%procs, \%own);
    $LZR_LOOKED = now();
    return 1;
}

sub lzr_deactivated {                     # [C20] the programs you deactivated: [path, when]
    open my $in, '<', "${\ shared()}/deactivated" or return [];
    my @kept = map { chomp; my @one = split /\t/, $_, -1; @one == 2 && $one[0] =~ m{\A/[^\x00-\x1f\x7f]{1,1000}\z} && $one[1] =~ /\A[0-9TZ:-]{1,30}\z/ ? [@one] : () } <$in>;
    splice @kept, $LZR_DEACTIVATED if @kept > $LZR_DEACTIVATED;
    return \@kept;
}
sub lzr_keep_deactivated {                # [C20] that list, written beside the old one and through to the disk, then given its name in one step
    my ($kept) = @_;
    my $file = "${\ shared()}/deactivated";
    unlink "$file.new";
    return !-e $file || unlink $file unless @$kept;
    unless (put("$file.new", O_EXCL, map { join "\t", @$_ } @$kept) && rename "$file.new", $file) { unlink "$file.new"; return 0 }
    synced(shared());
    return 1;
}

sub lzr_contained {                       # [C20] the contained processes: one hash a file of ~/.lzrprf/contained, each by its ID
    my $dir = "${\ shared()}/contained";
    opendir my $folder, $dir or return {};
    my %all;
    for my $id (sort grep { /\A[0-9a-hjkmnp-tv-z]{5}\z/ } readdir $folder) {
        open my $in, '<', "$dir/$id" or next;
        my %one = (id => $id, args => []);
        while (my $line = <$in>) {
            chomp $line;
            my ($key, $value) = $line =~ /\A([a-z]+) (.*)\z/s or next;
            if ($key eq 'arg') { push @{ $one{args} }, $value =~ s/\\n/\n/gr =~ s/\\\\/\\/gr } else { $one{$key} = $value }
        }
        $all{$id} = \%one if ($one{program} // '') =~ m{\A/} && keys %all < $LZR_CONTAINED;
    }
    return \%all;
}
sub lzr_write_contained {                 # [C20] one contained process's file, written whole under a name of its own first
    my ($one) = @_;
    my $dir = "${\ shared()}/contained";
    mkdir $dir, 0700;
    my $file = "$dir/$one->{id}";
    unlink "$file.$$";
    my @lines = ((map { defined $one->{$_} ? "$_ $one->{$_}" : () } qw(id program own since keeper child began contained ended status by said)), map { 'arg ' . (s/\\/\\\\/gr =~ s/\n/\\n/gr) } @{ $one->{args} });
    unless (put("$file.$$", O_EXCL, @lines) && rename "$file.$$", $file) { unlink "$file.$$"; return 0 }
    return 1;
}

sub lzr_alive { my ($pid, $began) = @_; return 0 unless $pid && kill 0, $pid; my ($now) = tool_asked("proc.$pid", 5, '/bin/ps', '-o', 'lstart=', '-p', $pid); return ($now =~ s/^\s+|\s+$//gr =~ s/\s+/ /gr) eq ($began // '') }    # this process number is still the process that had it: the same start

# Everything an ID can name, now: [id, kind, what], kind "proc" (a process,
# what: its number), "program" (deactivated: its path), "job" (a launchd job
# switched off in LZRDFNDR: its label) or "box" (a contained process: its
# file's hash).
sub lzr_named_all {
    my @all = map { [lzr_id("proc $_ $TOOL{procs}{$_}{began}"), 'proc', $_] } sort { $a <=> $b } keys %{ $TOOL{procs} };
    push @all, map { [lzr_id("program $_->[0]"), 'program', $_->[0]] } @{ lzr_deactivated() };
    push @all, map { [lzr_id("job $_->[0]"), 'job', $_->[0]] } @{ tool_kept() };
    my $boxes = lzr_contained();
    push @all, map { [$_, 'box', $boxes->{$_}] } sort keys %$boxes;
    return @all;
}

sub lzr_which {                           # what an ID (or a process number) names: [id, kind, what], or nothing and why
    my ($typed) = @_;
    if ($typed =~ /\A[1-9][0-9]{0,6}\z/) {
        return (undef, "no process has the number $typed now") unless $TOOL{procs}{$typed};
        return ([lzr_id("proc $typed $TOOL{procs}{$typed}{began}"), 'proc', $typed]);
    }
    my @all = lzr_named_all();
    my @hit = grep { $_->[0] eq $typed } @all;
    @hit = grep { index($_->[0], $typed) == 0 } @all if !@hit && length $typed >= 3;
    return ($hit[0]) if @hit == 1;
    return (undef, "$typed is the start of " . @hit . ' IDs: ' . join(', ', map { $_->[0] } @hit[0 .. ($#hit > 7 ? 7 : $#hit)]) . '. Type more of it') if @hit;
    return (undef, "nothing has the ID $typed now. \"lzr processes all\" shows every ID; the ID of a process that ended is gone with it");
}

sub lzr_running {                         # the processes of a program now, by number
    my ($path) = @_;
    return sort { $a <=> $b } grep { $TOOL{procs}{$_}{path} eq $path } keys %{ $TOOL{procs} };
}

sub lzr_why_not {                         # [C20] why lzr does not end this process, in words; nothing when sub tool_may lets it
    my ($pid) = @_;
    my $proc = $TOOL{procs}{$pid} or return "process $pid is not running";
    return if defined tool_may('stop', $pid);
    my $user = (getpwuid $proc->{uid})[0] // $proc->{uid};
    return "process $pid is ${user}'s, and lzr changes your own processes only" if $proc->{uid} != $<;
    return "process $pid is this terminal, LZRBRWSR or lzr itself, or what started them" if $TOOL{own}{$pid};
    return "process $pid is a program of the system ($proc->{path}), which lzr never changes" if $proc->{path} =~ $LZR_SYSTEM || $proc->{path} !~ m{^/};
    return "process $pid is not one lzr ends";
}

sub lzr_program_why_not {                 # [C20] why a program cannot be deactivated or contained, in words; nothing when it can
    my ($path) = @_;
    return "$path is no program's full path" unless $path =~ m{\A/[^\x00-\x1f\x7f]{1,1000}\z};
    return "$path holds a character lzrprf does not pass to a container" if $path =~ /["\\]/;
    return "$path is a program of the system, which lzr never changes" if $path =~ $LZR_SYSTEM;
    return "$path is LZRBRWSR's own" if $path =~ m{/LZRBRWSR[^/]*\.app/} || grep { $TOOL{procs}{$_} && $TOOL{procs}{$_}{path} eq $path } keys %{ $TOOL{own} };
    return;
}

sub lzr_jobs_of {                         # [C20] the launchd jobs of your account that run this program, read as the tool reads them into %TOOL: their labels
    my ($path, @pids) = @_;
    my ($gui, $said) = tool_asked('jobs', 10, '/bin/launchctl', 'print', "gui/$<");
    return () unless $said;
    my ($loaded, $off) = tool_services($gui);
    my %jobs;
    for my $place (grep { $_->[0] eq 'gui' } tool_places()) {
        opendir(my $dir, $place->[1]) or next;
        for my $name (sort grep { /\.plist\z/ && !/[\x00-\x1f\x7f]/ } readdir $dir) {
            my ($label, $program, $with, $flags) = tool_file("$place->[1]/$name") or next;
            $jobs{$label} //= { pid => $loaded->{$label} // 0, state => exists $loaded->{$label} ? ($loaded->{$label} ? 'run' : 'load') : $off->{$label} ? 'off' : 'file', program => $program, file => tool_plain("$place->[1]/$name", 1000), flags => $flags, args => $with };
        }
        closedir $dir;
    }
    my %of = map { $_ => 1 } @pids;
    for my $label (grep { !$jobs{$_} && $of{ $loaded->{$_} } && /^$TOOL_LABEL\z/ } keys %$loaded) {    # a job written down in no folder: asked about only when one of the program's processes is its
        my ($one) = tool_asked("job.$label", 5, '/bin/launchctl', 'print', "gui/$</$label");
        my ($program) = $one =~ /^\tprogram = (.+)$/m;
        $jobs{$label} = { pid => $loaded->{$label}, state => 'run', program => tool_plain($program // '', 1000), file => '', flags => '', args => '' };
    }
    $TOOL{jobs}{gui} = \%jobs;
    return sort grep { $jobs{$_}{program} eq $path || $jobs{$_}{pid} && $of{ $jobs{$_}{pid} } } keys %jobs;
}

sub lzr_asked {                           # your word before a change: --yes, or y typed on the terminal; nothing is asked where lzr cannot ask
    my ($question, $flags) = @_;
    return 1 if $flags->{yes};
    unless (-t STDIN) { print STDERR "lzr: nothing was done: lzr is not in a terminal, so it cannot ask first. Add --yes to do it anyway.\n"; return 0 }
    print "$question [y/N] ";
    my $answer = <STDIN>;
    return 1 if defined $answer && $answer =~ /\A\s*y(?:es)?\s*\z/i;
    print "Nothing was done.\n";
    return 0;
}

sub lzr_seen {                            # [C20] the deactivated programs seen running: each of their processes closed, after its log line; what was closed, in words
    my $kept = lzr_deactivated();
    return () unless @$kept;
    my @closed;
    for my $one (@$kept) {
        for my $pid (lzr_running($one->[0])) {
            next if defined lzr_why_not($pid);
            my ($ok, $says) = tool_stop($pid, "LZRDFNDR closed a program you deactivated, seen running again");
            push @closed, "$says ($one->[0], deactivated)" if $ok;
        }
    }
    return @closed;
}

sub lzr_processes {                       # lzr processes COMMAND [ID]: the look, what it found closed, then the command
    my ($command, $typed, $flags) = @_;
    return lzr_said('an incognito window has no LZRDFNDR.') if $INCOGNITO;
    mkdir $DIR, 0700;
    lzr_look() or return lzr_said('the system did not list its processes (ps), so nothing was looked at or done.');
    my @closed = lzr_seen();
    if (@closed) { lzr_look(); print STDERR map { "lzr: $_\n" } @closed }
    return lzr_list($flags) if $command eq 'list';
    return lzr_all($flags) if $command eq 'all';
    my ($what, $why) = lzr_which($typed);
    return lzr_said("$why.") unless $what;
    return lzr_analyze($what, $flags) if $command eq 'analyze';
    return lzr_kill($what, $flags) if $command eq 'kill';
    return lzr_deactivate($what, $flags) if $command eq 'deactivate';
    return lzr_reactivate($what, $flags) if $command eq 'reactivate';
    return lzr_contain($what, $flags) if $command eq 'contain';
    return lzr_release($what, $flags);
}

sub lzr_kib { my ($kib) = @_; return '-' unless defined $kib && length $kib; return $kib >= 1048576 ? sprintf('%.1f GiB', $kib / 1048576) : $kib >= 1024 ? sprintf('%.1f MiB', $kib / 1024) : "$kib KiB" }
sub lzr_json { my ($v) = @_; return 'null' unless defined $v; return $v if !ref $v && $v =~ /\A-?(?:0|[1-9][0-9]{0,15})(?:\.[0-9]{1,6})?\z/; return '[' . join(',', map { lzr_json($_) } @$v) . ']' if ref $v eq 'ARRAY'; return '{' . join(',', map { lzr_json("$_") . ':' . lzr_json($v->{$_}) } sort keys %$v) . '}' if ref $v eq 'HASH'; return '"' . ("$v" =~ s/(["\\])/\\$1/gr =~ s/([\x00-\x1f])/sprintf '\\u%04x', ord $1/ger) . '"' }    # numbers bare, the rest as strings
sub lzr_when { my ($iso) = @_; return $iso =~ /\A(\d{4}-\d\d-\d\d)T(\d\d:\d\d)/ ? "$1 $2 UTC" : $iso }
sub lzr_state_of { my ($pid) = @_; my $box = (grep { ($_->{child} // 0) == $pid && !defined $_->{ended} } values %{ lzr_contained() })[0]; return $box ? "contained ($box->{id})" : (grep { $_->[0] eq $TOOL{procs}{$pid}{path} } @{ lzr_deactivated() }) ? 'deactivated' : '' }

sub lzr_list {                            # lzr processes: what LZRDFNDR deactivated, and what it contains
    my ($flags) = @_;
    my (@off, @in);
    for my $one (@{ lzr_deactivated() }) { push @off, { id => lzr_id("program $one->[0]"), kind => 'program', what => $one->[0], since => $one->[1], running => [lzr_running($one->[0])] } }
    for my $one (@{ tool_kept() }) { push @off, { id => lzr_id("job $one->[0]"), kind => 'launchd job', what => $one->[0], since => $one->[2], running => [] } }
    my $boxes = lzr_contained();
    for my $box (map { $boxes->{$_} } sort keys %$boxes) {
        my $alive = !defined $box->{ended} && lzr_alive($box->{child}, $box->{began});
        push @in, { id => $box->{id}, pid => $alive ? 0 + $box->{child} : undef, program => $box->{program}, args => $box->{args}, since => $box->{since}, contained => ($box->{contained} // '') eq 'yes' ? 1 : 0,
            state => $alive ? 'running' : defined $box->{ended} ? "ended ($box->{status}, $box->{by})" : !defined $box->{child} ? 'starting' : 'gone', cpu => $alive ? $LZR_USE{ $box->{child} }[0] : undef, rss => $alive ? $LZR_USE{ $box->{child} }[1] : undef };
    }
    if ($flags->{json}) { print lzr_json({ deactivated => \@off, contained => \@in }), "\n"; return 0 }
    print lzr_paint(1, 'Deactivated by LZRDFNDR') . ' (' . @off . ")\n";
    print @off ? (sprintf("  %-6s %-12s %-18s %s\n", 'ID', 'KIND', 'SINCE', 'WHAT'), map { sprintf "  %s %-12s %-18s %s%s\n", lzr_paint(96, sprintf '%-6s', $_->{id}), $_->{kind}, lzr_when($_->{since}), $_->{what}, @{ $_->{running} } ? lzr_paint(33, '  running now: ' . join(' ', @{ $_->{running} })) : '' } @off) : "  none\n";
    print "\n", lzr_paint(1, 'Contained by LZRDFNDR') . ' (' . @in . ")\n";
    print @in ? (sprintf("  %-6s %-7s %-18s %-26s %s\n", 'ID', 'PID', 'SINCE', 'STATE', 'PROGRAM'), map { sprintf "  %s %-7s %-18s %-26s %s\n", lzr_paint(96, sprintf '%-6s', $_->{id}), $_->{pid} // '-', lzr_when($_->{since}), $_->{state} . ($_->{pid} ? ', ' . ($_->{contained} ? 'contained' : 'NOT SAID CONTAINED') : ''), $_->{program} } @in) : "  none\n";
    print "\n", lzr_paint(2, '"lzr processes all" lists every process with its ID; "lzr processes ID analyze|kill|deactivate|contain" acts on one; "lzr help processes" says more.'), "\n";
    return 0;
}

sub lzr_all {                             # lzr processes all: every process, each with its ID
    my ($flags) = @_;
    my $sort = $flags->{sort} // 'cpu';
    return lzr_wrong("--sort takes cpu, memory, pid or name, not \"$sort\"", 'processes all') unless $sort =~ /\A(?:cpu|memory|pid|name)\z/;
    my (%user, @rows);
    for my $pid (keys %{ $TOOL{procs} }) {
        my $proc = $TOOL{procs}{$pid};
        next if $flags->{mine} && $proc->{uid} != $<;
        $user{ $proc->{uid} } //= tool_plain((getpwuid $proc->{uid})[0] // $proc->{uid}, 32);
        push @rows, { id => lzr_id("proc $pid $proc->{began}"), pid => 0 + $pid, ppid => 0 + $proc->{ppid}, user => $user{ $proc->{uid} }, uid => 0 + $proc->{uid}, cpu => $LZR_USE{$pid} ? 0 + $LZR_USE{$pid}[0] : undef, rss_kib => $LZR_USE{$pid} ? 0 + $LZR_USE{$pid}[1] : undef,
            name => $proc->{path} =~ m{([^/]+)\z} ? $1 : $proc->{path}, program => $proc->{path}, started => $proc->{began}, lzrdfndr => lzr_state_of($pid) };
    }
    my %by = (cpu => sub { ($_[1]{cpu} // -1) <=> ($_[0]{cpu} // -1) || ($_[1]{rss_kib} // -1) <=> ($_[0]{rss_kib} // -1) }, memory => sub { ($_[1]{rss_kib} // -1) <=> ($_[0]{rss_kib} // -1) }, name => sub { lc $_[0]{name} cmp lc $_[1]{name} });
    @rows = sort { ($by{$sort} ? $by{$sort}->($a, $b) : 0) || $a->{pid} <=> $b->{pid} } @rows;
    if ($flags->{json}) { print lzr_json(\@rows), "\n"; return 0 }
    my $wide = lzr_columns() // 1000;
    printf "%-6s %7s %-10s %6s %10s %-22s %-16s %s\n", qw(ID PID USER CPU% MEMORY NAME LZRDFNDR PROGRAM);
    for my $row (@rows) {
        my $line = sprintf "%7s %-10s %6s %10s %-22s %-16s %s", $row->{pid}, substr($row->{user}, 0, 10), defined $row->{cpu} ? sprintf('%.1f', $row->{cpu}) : '-', lzr_kib($row->{rss_kib}), substr($row->{name}, 0, 22), $row->{lzrdfndr}, $row->{program};
        print lzr_paint(96, $row->{id}), ' ', substr($line, 0, $wide - 7), "\n";
    }
    print lzr_paint(2, scalar(@rows) . ' processes. "lzr processes ID analyze" watches one; "lzr help processes" says more.'), "\n";
    return 0;
}

sub lzr_columns { return unless -t STDOUT; my $size = "\0" x 8; return ioctl(STDOUT, 0x40087468, $size) && (unpack 'S2', $size)[1] ? (unpack 'S2', $size)[1] : undef }    # TIOCGWINSZ: the terminal's width

sub lzr_pid_of {                          # the process an ID stands for now: a process, a deactivated program's one process, a contained process; or nothing and why
    my ($what) = @_;
    my ($id, $kind, $it) = @$what;
    return $it if $kind eq 'proc';
    if ($kind eq 'box') { return (undef, "the contained process $id has ended") unless !defined $it->{ended} && lzr_alive($it->{child}, $it->{began}); return $it->{child} }
    my @pids = $kind eq 'program' ? lzr_running($it) : ();    # a job switched off runs nothing that launchd holds
    return (undef, "$id is " . ($kind eq 'job' ? "the launchd job $it" : $it) . ', and nothing of it runs now') unless @pids;
    return (undef, "$id is $it, which runs as " . @pids . ' processes now: name one by its own ID (lzr processes all)') if @pids > 1;
    return $pids[0];
}

sub lzr_sample {                          # [C20] what a process uses now: its share of a processor over half a second (from the time ps says it ran), its resident memory and, for your own process, its footprint, both in KiB
    my ($pid) = @_;
    my @at;
    for my $n (0, 1) {
        Time::HiRes::sleep(0.5) if $n;
        my ($said) = tool_asked("sample.$pid", 5, '/bin/ps', '-o', 'time=,rss=', '-p', $pid);
        my ($time, $rss) = $said =~ /^\s*(\S+)\s+(\d+)\s*$/ or return;
        push @at, [now(), lzr_seconds($time), $rss];
    }
    my $share = $at[1][0] > $at[0][0] ? 100 * ($at[1][1] - $at[0][1]) / ($at[1][0] - $at[0][0]) : 0;
    my $foot = lzr_footprint($pid);
    return (($share < 0 ? 0 : $share), $at[1][2], $foot);
}
sub lzr_seconds { my ($t) = @_; my ($d, $h, $m, $s) = $t =~ /\A(?:(\d+)-)?(?:(\d+):)?(\d+):(\d+(?:\.\d+)?)\z/ or return 0; return ((($d // 0) * 24 + ($h // 0)) * 60 + $m) * 60 + $s }    # ps's [[DD-]HH:]MM:SS.cc as seconds
sub lzr_footprint {                       # [C20] macOS's answer about a process of yours (proc_pid_rusage, the call libproc makes): its footprint in KiB, as Activity Monitor's Memory; nothing for another user's
    my ($pid) = @_;
    return unless $^O eq 'darwin' && $TOOL{procs}{$pid} && $TOOL{procs}{$pid}{uid} == $<;
    my $usage = "\0" x 296;
    return unless syscall(336, 9, $pid + 0, 4, 0, $usage, 296) == 0;    # proc_info: PROC_INFO_CALL_PIDRUSAGE, RUSAGE_INFO_V4
    return int((unpack 'Q<*', substr($usage, 16))[7] / 1024);     # ri_phys_footprint
}

sub lzr_kill {                            # [C20] lzr processes kill: what the process uses now, your word, then TERM, and KILL three seconds on
    my ($what, $flags) = @_;
    my ($pid, $why) = lzr_pid_of($what);
    return lzr_said("$why.") unless $pid;
    $why = lzr_why_not($pid);
    return lzr_said("$why. Nothing was done.") if defined $why;
    my $proc = $TOOL{procs}{$pid};
    my ($share, $rss, $foot) = lzr_sample($pid) or return lzr_said("process $pid ended before it was measured.");
    print "Process $pid ($what->[0]), started $proc->{began}: $proc->{path}\n", sprintf("  now: %.1f%% of a processor, memory %s%s\n", $share, lzr_kib($rss), defined $foot ? ' resident, ' . lzr_kib($foot) . ' footprint' : '');
    if ($flags->{'dry-run'}) { print "Would ask it to end (TERM), and end it (KILL) if it has not after three seconds. It may start again later. Nothing was done.\n"; return 0 }
    return 1 unless lzr_asked('Kill it? It ends now, and may start again when something starts it.', $flags);
    my ($ok, $says) = tool_stop($pid, 'You ended a process with lzr processes kill');
    return lzr_said("$says.") unless $ok;
    for (my $until = now() + 1; now() < $until && kill(0, $pid);) { Time::HiRes::sleep(0.05) }
    if (kill 0, $pid) {
        return lzr_said("process $pid is no longer the one that was listed; it was left as it is.") unless lzr_alive($pid, $proc->{began});
        record("You ended a process with lzr processes kill, which did not end when asked: the process $pid, started $proc->{began}, $proc->{path}") or return lzr_said("process $pid: the log could not be written, so it was left running.");
        kill 'KILL', $pid;
        for (my $until = now() + 2; now() < $until && kill(0, $pid);) { Time::HiRes::sleep(0.05) }
        $says = kill(0, $pid) ? "process $pid was ended (KILL) and is still going" : "process $pid did not end when asked, and was ended (KILL)";
    }
    print ucfirst($says), ". It may start again when something starts it; \"lzr processes $what->[0] deactivate\" keeps it off.\n";
    return 0;
}

sub lzr_deactivate {                      # [C20] lzr processes deactivate: the program kept in the list, its jobs switched off, its processes closed
    my ($what, $flags) = @_;
    my ($id, $kind, $it) = @$what;
    return lzr_said("$id is deactivated already.") if $kind eq 'program' || $kind eq 'job';
    my $path = $kind eq 'proc' ? $TOOL{procs}{$it}{path} : $it->{program};
    my $why = lzr_program_why_not($path);
    return lzr_said("$why. Nothing was done.") if defined $why;
    if ($kind eq 'proc') { $why = lzr_why_not($it); return lzr_said("$why. Nothing was done.") if defined $why }
    my @pids = lzr_running($path);
    my @jobs = grep { defined tool_may('quiet', $_) } lzr_jobs_of($path, @pids);
    print "Deactivate $path?\n", "  closes now: " . (@pids ? join(' ', map { "process $_" } @pids) : 'nothing (it does not run)') . "\n", '  switches off: ' . (@jobs ? join(', ', map { "the launchd job $_" } @jobs) : 'no launchd job of your account runs it') . "\n", "  and LZRDFNDR closes it whenever it sees it run again, until \"lzr processes reactivate " . lzr_id("program $path") . "\".\n";
    if ($flags->{'dry-run'}) { print "Nothing was done.\n"; return 0 }
    return 1 unless lzr_asked('Deactivate it?', $flags);
    record("You deactivated a program with lzr processes deactivate: $path") or return lzr_said('the log could not be written, so nothing was done.');
    my $kept = lzr_deactivated();
    lzr_keep_deactivated([(grep { $_->[0] ne $path } @$kept), [$path, strftime('%Y-%m-%dT%H:%M:%SZ', gmtime)]]) or return lzr_said('the list of deactivated programs could not be written, so nothing was done.');
    my @said = map { (tool_quiet($_))[1] } @jobs;
    push @said, map { (tool_stop($_, 'You deactivated its program with lzr processes deactivate'))[1] } grep { !defined lzr_why_not($_) } @pids;
    print map({ ucfirst("$_.\n") } @said), "Deactivated: $path (ID " . lzr_id("program $path") . ").\n";
    return 0;
}

sub lzr_reactivate {                      # [C20] lzr processes reactivate: off the list; a job switched on again
    my ($what, $flags) = @_;
    my ($id, $kind, $it) = @$what;
    return lzr_said("$id is not deactivated: \"lzr processes\" lists what is.") unless $kind eq 'program' || $kind eq 'job';
    print 'Reactivate ' . ($kind eq 'job' ? "the launchd job $it (switched on again)" : $it) . "? Nothing is started.\n";
    if ($flags->{'dry-run'}) { print "Nothing was done.\n"; return 0 }
    return 1 unless lzr_asked('Reactivate it?', $flags);
    if ($kind eq 'job') {
        $TOOL{kept} = { map { $_->[0] => $_ } @{ tool_kept() } };
        my ($ok, $says) = tool_wake($it);
        print ucfirst("$says.\n");
        return $ok ? 0 : 1;
    }
    record("You reactivated a program with lzr processes reactivate: $it") or return lzr_said('the log could not be written, so nothing was done.');
    lzr_keep_deactivated([grep { $_->[0] ne $it } @{ lzr_deactivated() }]) or return lzr_said('the list of deactivated programs could not be written, so it stays deactivated.');
    print "Reactivated: $it. It may run again; LZRDFNDR no longer closes it.\n";
    return 0;
}

# A window looks for the programs you deactivated every $LZR_SEEN seconds,
# from sub tool_watch, and closes each one it sees. With none deactivated
# nothing is read at all.                                             # [C20]
sub lzr_due { return unless -s "${\ shared()}/deactivated"; return ($LZR_WATCHED // 0) + $LZR_SEEN - now() }    # the seconds until that look; nothing when none is deactivated
sub lzr_watch {
    return if $INCOGNITO || !-s "${\ shared()}/deactivated" || defined $LZR_WATCHED && now() < $LZR_WATCHED + $LZR_SEEN;
    $LZR_WATCHED = now();
    local @TOOL{qw(procs own)};           # the window's own look at the tool stays as it was
    lzr_look() or return;
    lzr_seen();
    return;
}

sub lzr_argv {                            # [C20] the arguments a process of yours was started with, exactly, as macOS keeps them (sysctl KERN_PROCARGS2): the first is how it was named; nothing when they cannot be read
    my ($pid) = @_;
    return unless $^O eq 'darwin';
    my ($buffer, $size) = ("\0" x $LZR_ARGS, pack('Q', $LZR_ARGS));
    return unless syscall(202, pack('i3', 1, 49, $pid + 0), 3, $buffer, $size, 0, 0) == 0;    # __sysctl: CTL_KERN, KERN_PROCARGS2, the process
    $buffer = substr $buffer, 0, unpack('Q', $size);
    my ($count, $rest) = unpack 'i a*', $buffer;
    $rest =~ s/\A[^\0]+\0+// or return;     # its program, and the padding after it
    my @strings = split /\0/, $rest, -1;     # the arguments, each as it was (an empty one too), then the environment
    return unless $count >= 1 && $count <= @strings;
    return @strings[0 .. $count - 1];
}

sub lzr_contain {                         # [C20] lzr processes contain: the process ended and its program started again, with the same arguments, in the container, by a keeper of its own
    my ($what, $flags) = @_;
    my ($id, $kind, $pid) = @$what;
    return lzr_said("$id is contained already.") if $kind eq 'box';
    return lzr_said("$id is deactivated: reactivate it first (lzr processes reactivate $id), then contain one of its processes.") unless $kind eq 'proc';
    my $proc = $TOOL{procs}{$pid};
    my $why = lzr_why_not($pid) // lzr_program_why_not($proc->{path});
    return lzr_said("$why. Nothing was done.") if defined $why;
    my @argv = lzr_argv($pid);
    return lzr_said("the arguments process $pid runs with could not be read (or are longer than $LZR_ARGS bytes), so it could not be started again the same way. Nothing was done.") unless @argv;
    my $own = $proc->{path} =~ m{^(.*\.app)/Contents/MacOS/[^/]+$} ? $1 : $proc->{path};    # what the container lets it read of its own, as sub contain says
    my @jobs = grep { defined tool_may('quiet', $_) } lzr_jobs_of($proc->{path}, $pid);
    print "Contain process $pid ($id): $proc->{path}\n", "  ends it now, and starts it again with the same arguments in LZRDFNDR's container: no network, no file written, no other program started,\n  no system service, no variable of yours, and nothing to read but the system and $own.\n",
        '  switches off: ' . (@jobs ? join(', ', map { "the launchd job $_" } @jobs) : 'no launchd job of your account runs it') . "\n", "  A program that needs what the container refuses stops at once; \"lzr processes\" says how it ended.\n";
    if ($flags->{'dry-run'}) { print "Nothing was done.\n"; return 0 }
    return 1 unless lzr_asked('Contain it?', $flags);
    record("You contained a process with lzr processes contain: " . tool_may('stop', $pid)) or return lzr_said('the log could not be written, so nothing was done.');
    my @said = map { (tool_quiet($_))[1] } @jobs;
    my ($ok, $says) = tool_stop($pid, 'You contained a process with lzr processes contain, which ended it to start it again contained');
    return lzr_said("$says, so nothing was started.") unless $ok;
    for (my $until = now() + 3; now() < $until && kill(0, $pid);) { Time::HiRes::sleep(0.05) }
    return lzr_said("process $pid did not end, so no contained copy of it was started. \"lzr processes $id kill\" ends it.") if lzr_alive($pid, $proc->{began});
    my $box = { id => lzr_id("box $proc->{path} $pid $proc->{began} " . now()), program => $proc->{path}, own => $own, args => [@argv[1 .. $#argv]], since => strftime('%Y-%m-%dT%H:%M:%SZ', gmtime) };
    lzr_write_contained($box) && lzr_keeper($box) or return lzr_said("process $pid was ended, and its contained copy could not be started.");
    my $now = {};
    for (my $until = now() + 15; now() < $until && !defined $now->{contained}; Time::HiRes::sleep(0.1)) { $now = lzr_contained()->{ $box->{id} } // {} }
    print map({ ucfirst("$_.\n") } @said, $says);
    return lzr_said("the keeper of $box->{id} did not say within 15 seconds whether it started; \"lzr processes\" shows it when it does.") unless defined $now->{contained};
    return lzr_said("$proc->{path} started, and the system did not say it was in the container, so it was ended at once. Nothing of it runs.") if $now->{contained} eq 'no';
    return lzr_said("$proc->{path} ended at once in the container ($now->{status}" . (defined $now->{said} ? ", saying: $now->{said}" : '') . "): it needs what the container refuses. \"lzr processes release $box->{id}\" forgets it.") if defined $now->{ended};
    print "Contained: $proc->{path} runs as process $now->{child}, and the system says it is in the container (ID $box->{id}; \"lzr processes release $box->{id}\" ends it).\n";
    return 0;
}

sub lzr_keeper {                          # [C20] the keeper of a contained process, apart from this terminal: it starts the program in the container, asks the system whether it is there, holds it, and writes how it ended
    my ($box) = @_;
    my $first = fork // return 0;
    if ($first) { waitpid $first, 0; return $? == 0 }
    POSIX::setsid();
    my $keeper = fork // POSIX::_exit(1);
    POSIX::_exit(0) if $keeper;
    open STDIN, '<', '/dev/null'; open STDOUT, '>', '/dev/null'; open STDERR, '>', '/dev/null';
    $0 = "core-lzrprf-contain $box->{id}";
    @$box{qw(keeper by)} = ($$, 'its keeper');
    my ($released, $child) = (0);
    local $SIG{ALRM} = sub { kill 'KILL', $child if $child };    # a program that does not end when asked is ended three seconds on
    local $SIG{TERM} = sub { $released = 1; if ($child) { kill 'TERM', $child; alarm 3 } };    # a release: sub lzr_release
    pipe(my $heard, my $says) or do { @$box{qw(ended status)} = (strftime('%Y-%m-%dT%H:%M:%SZ', gmtime), 'not started'); lzr_write_contained($box); POSIX::_exit(1) };
    $child = fork // do { @$box{qw(ended status)} = (strftime('%Y-%m-%dT%H:%M:%SZ', gmtime), 'not started'); lzr_write_contained($box); POSIX::_exit(1) };
    unless ($child) {                     # the program: no byte written into a file, no memory dump, no variable, no descriptor but nowhere; sandbox-exec puts it in the container, then becomes it
        my $none = pack 'QQ', 0, 0;       # a variable: perl hands syscall a constant's bytes as read-only, and dies
        syscall(195, 1, $none) == 0 && syscall(195, 4, $none) == 0 or POSIX::_exit(127);    # setrlimit: RLIMIT_FSIZE and RLIMIT_CORE, now and for good
        %ENV = ();
        become(undef, undef, $says, contain('', $box->{program}), @{ $box->{args} });    # the page container, as sub contain writes it for the program
    }
    $SIG{TERM}->() if $released;          # a release that came before fork gave the number
    close $says;
    my ($began) = tool_asked("proc.$child", 5, '/bin/ps', '-o', 'lstart=', '-p', $child);
    @$box{qw(child began)} = ($child, $began =~ s/^\s+|\s+$//gr =~ s/\s+/ /gr);
    my $in = inside($child);
    my $held = waitpid($child, POSIX::WNOHANG()) == 0;    # still running after the answer, so the answer was about it running
    my $status = $held ? undef : $?;
    if ($witness) { close $to_witness; waitpid $witness, 0; undef $witness }
    $box->{contained} = $in && $held ? 'yes' : $held ? 'no' : 'unknown';
    if ($box->{contained} eq 'no') { kill 'KILL', $child; $box->{by} = 'lzrprf, as the system did not say it was contained' }
    lzr_write_contained($box);
    my ($last, $got) = ('');
    while (($got = sysread $heard, my $more, 4096) || !defined $got && $!{EINTR}) { $last = substr($last . ($more // ''), -400) }    # what it wrote on its errors, to its end: the last words kept
    $box->{said} = tool_plain($last =~ s/\s+/ /gr =~ s/^ | $//gr, 400) if length $last;
    unless (defined $status) { 1 while waitpid($child, 0) == -1 && $!{EINTR}; $status = $?; alarm 0 }
    $box->{by} = 'lzr processes release' if $released;
    @$box{qw(ended status)} = (strftime('%Y-%m-%dT%H:%M:%SZ', gmtime), $status & 127 ? 'ended by signal ' . ($status & 127) : 'exit ' . ($status >> 8));
    record("A process LZRDFNDR contained ended ($box->{status}, by $box->{by}): the process $child, $box->{program}");
    lzr_write_contained($box) unless $released;    # a release forgets it: lzr removes its file
    POSIX::_exit(0);
}

sub lzr_keeper_is { my ($box) = @_; return 0 unless ($box->{keeper} // '') =~ /\A[1-9][0-9]{0,6}\z/; my ($said) = tool_asked("keeper.$box->{keeper}", 5, '/bin/ps', '-ww', '-o', 'uid=,args=', '-p', $box->{keeper}); return $said =~ /\A\s*(\d+)\s+core-lzrprf-contain ([0-9a-z]{5})(?:\s|\z)/ && $1 == $< && $2 eq $box->{id} }    # the keeper is still running as that keeper: yours, by its name (macOS shows what was in the place its name was written over after it)

sub lzr_release {                         # [C20] lzr processes release: the contained process ended by its keeper, and forgotten; nothing is started outside
    my ($what, $flags) = @_;
    my ($id, $kind, $box) = @$what;
    return lzr_said("$id is not contained: \"lzr processes\" lists what is.") unless $kind eq 'box';
    my $keeper = !defined $box->{ended} && lzr_keeper_is($box);
    my $orphan = !$keeper && !defined $box->{ended} && ($box->{child} // '') =~ /\A[1-9][0-9]{0,6}\z/ && lzr_alive($box->{child}, $box->{began}) && ($TOOL{procs}{ $box->{child} }{uid} // -1) == $<;
    print $keeper || $orphan ? "Release $id? Its contained process $box->{child} ($box->{program}) is ended, and not started again outside: start it as you usually do.\n" : "Forget $id? $box->{program} runs no more" . (defined $box->{status} ? " ($box->{status})" : '') . ".\n";
    if ($flags->{'dry-run'}) { print "Nothing was done.\n"; return 0 }
    return 1 unless lzr_asked('Release it?', $flags);
    record("You released a contained process with lzr processes release: $id, $box->{program}" . ($keeper || $orphan ? ", the process $box->{child}" : ', which had ended')) or return lzr_said('the log could not be written, so nothing was done.');
    if ($keeper || $orphan) {
        my $whom = $keeper ? $box->{keeper} : $box->{child};
        kill 'TERM', $whom;
        for (my $until = now() + 6; now() < $until && kill(0, $whom);) { Time::HiRes::sleep(0.05) }
        return lzr_said("the keeper of $id did not end; it is still listed.") if kill 0, $whom;
    }
    unlink "${\ shared()}/contained/$id";
    print "Released: $id ($box->{program}).\n";
    return 0;
}

# lzr processes analyze [C20]: one process watched until you close the view.
# Every --interval seconds (1 when left out) ps says how much processor time
# the process has had and its resident memory, and for a process of yours
# macOS says its footprint (sub lzr_footprint); its share of a processor is
# the processor time it had since the last sample over the time between the
# two. Two graphs show those against time, newest on the right, under a box
# of what it is: its program, where that lives, whose it is, what started it,
# when, who signed the program (codesign, as LZRDFNDR's tool asks it), and
# what LZRDFNDR does with it. Of another user's process the system shows
# anyone its processor time and resident memory; the rest is not shown, and
# the box says so. A process that ends stays in view, marked ended.
#
# On a terminal the view has the screen to itself (the alternate screen, the
# terminal's own scrollback untouched), and asks the terminal for presses: a
# press on [ Close ] at the top right closes it, as q, Esc and Ctrl-C do.
# Whatever way it ends, the terminal is given back as it was. --frames N
# draws N frames and stops, also outside a terminal, for scripts and tests.
my $LZR_SAMPLES = 2000;                   # DECLARED([C20] the most samples kept of one process: wider than any screen, so a graph is always full from the right)
my $LZR_CLOSE = '[ Close ]';
my @LZR_BLOCKS = (' ', "\x{2581}", "\x{2582}", "\x{2583}", "\x{2584}", "\x{2585}", "\x{2586}", "\x{2587}", "\x{2588}");    # an eighth of a row more each

sub lzr_size {                            # the terminal's columns and rows: as the terminal says, else COLUMNS and LINES, else 100 by 30
    my $size = "\0" x 8;
    my ($rows, $cols) = -t STDOUT && ioctl(STDOUT, 0x40087468, $size) ? unpack('S2', $size) : (0, 0);    # TIOCGWINSZ
    $cols ||= ($SHOWN{COLUMNS} // '') =~ /\A([1-9][0-9]{0,3})\z/ ? $1 : 100;
    $rows ||= ($SHOWN{LINES} // '') =~ /\A([1-9][0-9]{0,3})\z/ ? $1 : 30;
    return ($cols < 50 ? 50 : $cols, $rows < 20 ? 20 : $rows);
}

sub lzr_ceiling { my ($most) = @_; return 1 unless $most > 0; my $ten = 10**int(log($most) / log(10)); for my $step (1, 2, 5, 10) { return $step * $ten if $step * $ten >= $most } return 10 * $ten }    # a round top for a graph: 1, 2 or 5 times a power of ten, at least the most it shows

sub lzr_about {                           # [C20] the box: what the process is, as far as you may see it
    my ($pid) = @_;
    my $proc = $TOOL{procs}{$pid};
    my $path = $proc->{path};
    my $mine = $proc->{uid} == $<;
    my $parent = $TOOL{procs}{ $proc->{ppid} };
    my ($signed) = $path =~ m{^/} ? tool_signed($path) : ();
    my $who = !$signed ? 'not known (codesign was not asked, or did not say)' : $signed->[1] eq 'adhoc' ? 'ad hoc (by no one named)' : $signed->[1] eq 'none' ? 'not signed' : $signed->[1] eq '-' ? "signed, by no team ($signed->[2])" : "team $signed->[1] ($signed->[2])";
    my $state = lzr_state_of($pid);
    my $may = lzr_why_not($pid);
    return (
        ['Program', $path],
        ['Lives in', $path =~ m{\A(/.+?\.app)/} ? "$1 (an app)" : $path =~ m{\A(.*)/[^/]+\z} ? ($1 || '/') : 'not a path: the system gave its name only'],
        ['Owner', ((getpwuid $proc->{uid})[0] // 'unknown') . " (uid $proc->{uid})" . ($mine ? ', you' : '')],
        ['Parent', $parent ? "$proc->{ppid} " . ($parent->{path} =~ m{([^/]+)\z} ? $1 : $parent->{path}) : $proc->{ppid}],
        ['Started', $proc->{began}],
        ['Signed', $who],
        ['LZRDFNDR', ($state || 'neither deactivated nor contained') . (defined $may ? '; lzr does not change it: ' . ($may =~ s/^process \d+ is //r) : '')],
        ['Seen', $mine ? 'processor time and resident memory (ps), its footprint (macOS)' : "processor time and resident memory (ps) alone: its footprint, arguments and files are another user's, which macOS shows no one without privilege"],
    );
}

sub lzr_analyze {                         # [C20] lzr processes analyze: the live view, until it is closed
    my ($what, $flags) = @_;
    my ($pid, $why) = lzr_pid_of($what);
    return lzr_said("$why.") unless $pid;
    my $every = $flags->{interval} // 1;
    return lzr_wrong("--interval takes seconds from 0.2 to 60, not \"$every\"", 'processes analyze') unless $every =~ /\A[0-9]{1,2}(?:\.[0-9]{1,3})?\z/ && $every >= 0.2 && $every <= 60;
    my $frames = $flags->{frames};
    return lzr_wrong("--frames takes a number of frames from 1 to 100000, not \"$frames\"", 'processes analyze') if defined $frames && $frames !~ /\A[1-9][0-9]{0,4}\z/;
    return lzr_said('the live view needs a terminal; add --frames N to draw N frames anyway.') unless defined $frames || -t STDOUT;
    my $live = -t STDOUT;
    my @box = lzr_about($pid);
    my $mine = $TOOL{procs}{$pid}{uid} == $<;
    my $name = $TOOL{procs}{$pid}{path} =~ m{([^/]+)\z} ? $1 : $TOOL{procs}{$pid}{path};
    my (@cpu, @mem, $last, $ended, $close);
    my $since = strftime('%H:%M:%S', localtime);
    binmode STDOUT, ':encoding(UTF-8)';
    my $term = $live && -t STDIN ? POSIX::Termios->new : undef;
    my $was = $term && $term->getattr(0) ? [$term->getlflag, $term->getcc(POSIX::VMIN()), $term->getcc(POSIX::VTIME())] : undef;
    my $restore = sub {
        return unless $live;
        $live = 0;
        print "\e[?1006l\e[?1000l\e[?25h\e[?1049l";    # presses no longer asked for, the cursor back, the screen as it was
        STDOUT->flush;
        if ($was) { $term->setlflag($was->[0]); $term->setcc(POSIX::VMIN(), $was->[1]); $term->setcc(POSIX::VTIME(), $was->[2]); $term->setattr(0, POSIX::TCSANOW()) }
    };
    local $SIG{INT} = local $SIG{TERM} = local $SIG{HUP} = sub { $close = 'a signal' };
    local $SIG{WINCH} = sub { };          # a new size is read at the next frame
    if ($live) {
        print "\e[?1049h\e[?25l\e[?1000h\e[?1006h";    # the alternate screen, no cursor, presses asked for (sent back in the SGR form)
        if ($was) { $term->setlflag($was->[0] & ~(POSIX::ICANON() | POSIX::ECHO())); $term->setcc(POSIX::VMIN(), 1); $term->setcc(POSIX::VTIME(), 0); $term->setattr(0, POSIX::TCSANOW()) }    # each key as it comes, unseen; Ctrl-C is still a signal
    }
    my ($typed, $open) = ('', 1);
    my $ok = eval {
        while (!defined $close) {
            my $at = now();
            if (!$ended) {
                my ($said) = tool_asked("analyze.$pid", 5, '/bin/ps', '-o', 'time=,rss=,lstart=', '-p', $pid);
                my ($time, $rss, $began) = $said =~ /^\s*(\S+)\s+(\d+)\s+(.+?)\s*$/;
                if (!defined $time || ($began =~ s/\s+/ /gr) ne $TOOL{procs}{$pid}{began}) { $ended = strftime('%H:%M:%S', localtime) }
                else {
                    my $seconds = lzr_seconds($time);
                    push @cpu, $last ? ($seconds - $last->[1] < 0 ? 0 : 100 * ($seconds - $last->[1]) / (($at - $last->[0]) || 1)) : undef;
                    my $foot = $mine ? lzr_footprint($pid) : undef;
                    push @mem, $foot // $rss;
                    $last = [$at, $seconds];
                    splice @$_, 0, @$_ - $LZR_SAMPLES for grep { @$_ > $LZR_SAMPLES } \@cpu, \@mem;
                }
            }
            my ($cols, $rows) = lzr_size();
            print $live ? "\e[H\e[2J" : "\f\n", join("\n", lzr_frame($cols, $rows, $what->[0], $pid, $name, \@box, \@cpu, \@mem, $mine, $ended, $since, $every)), $live ? '' : "\n";
            STDOUT->flush;
            last if defined $frames && --$frames <= 0;
            my $until = $at + $every;
            while (!defined $close && (my $left = $until - now()) > 0) {
                my $ready = '';
                vec($ready, fileno STDIN, 1) = 1 if $open;
                my $seen = select($open ? $ready : undef, undef, undef, $left);
                next unless $seen > 0;
                my $got = sysread STDIN, my $bytes, 256;
                if (!$got) { $open = 0; next }    # nothing more will be typed (a pipe, or /dev/null): the view runs on until its frames or a signal
                $typed .= $bytes;
                $close = lzr_closing(\$typed, $cols);
            }
        }
        1;
    };
    my $error = $@;
    $restore->();
    die $error unless $ok;
    print 'Closed ' . ($close // "after its frames") . ". Process $pid " . ($ended ? "ended at $ended" : 'runs on') . ".\n" if defined $close || !defined $frames;
    return 0;
}

sub lzr_closing {                         # what the keys and presses typed so far say: the way the view was closed, or nothing yet
    my ($typed, $cols) = @_;
    while (length $$typed) {
        if ($$typed =~ s/\A\e\[<(\d+);(\d+);(\d+)([Mm])//) { return 'with its Close button' if $1 == 0 && $4 eq 'M' && $3 == 1 && $2 > $cols - length($LZR_CLOSE) && $2 <= $cols; next }    # a press, in the SGR form: the left button, on the button
        if ($$typed =~ s/\A\e\[M(.)(.)(.)//s) { return 'with its Close button' if (ord($1) & 3) == 0 && ord($3) - 32 == 1 && ord($2) - 32 > $cols - length($LZR_CLOSE); next }    # the older form, for a terminal that does not send the SGR one
        return if $$typed =~ /\A\e(?:\[[<0-9;]*)?\z/ && length $$typed < 32 && $$typed ne "\e";    # the start of a sequence: the rest comes
        return 'with Esc' if $$typed =~ s/\A\e(?!\[)//;
        $$typed =~ s/\A\e\[[0-9;<]*[A-Za-z~]// and next;    # another key's sequence (an arrow): nothing to do
        my $key = substr $$typed, 0, 1, '';
        return 'with q' if $key eq 'q' || $key eq 'Q';
        return 'with Ctrl-C' if $key eq "\x03";
    }
    return;
}

sub lzr_frame {                           # one frame of the view, as its lines
    my ($cols, $rows, $id, $pid, $name, $box, $cpu, $mem, $mine, $ended, $since, $every) = @_;
    my $title = "lzr processes analyze  $id  process $pid  $name";
    my $room = $cols - length $LZR_CLOSE;    # the button takes the last columns of the first row
    my @lines = (sprintf('%-*s', $room, substr($title, 0, $room - 1)) . lzr_paint('7', $LZR_CLOSE));
    my $inner = $cols - 4;
    push @lines, '+' . '-' x ($cols - 2) . '+';
    for my $row (@$box) {
        my $text = sprintf '%-9s %s', $row->[0], $row->[1];
        for (my $first = 1; $first || length $text; $first = 0) { push @lines, '| ' . sprintf('%-*s', $inner, substr($text, 0, $inner, '')) . ' |'; $text = ' ' x 10 . $text if length $text }
    }
    push @lines, '+' . '-' x ($cols - 2) . '+';
    my $left = $rows - @lines - 5;
    my $high = $left < 4 ? 2 : int($left / 2) - 1;
    my @shown_cpu = grep { defined } @$cpu;
    my $now_cpu = @shown_cpu ? $shown_cpu[-1] : undef;
    my $top_cpu = lzr_ceiling((sort { $b <=> $a } 100, @shown_cpu[($#shown_cpu > $inner ? -$inner : 0) .. $#shown_cpu])[0]);
    push @lines, lzr_paint(1, 'CPU') . sprintf(' %s of one processor now, top of graph %d%%', defined $now_cpu ? sprintf('%.1f%%', $now_cpu) : '-', $top_cpu), lzr_graph([map { $_ // 0 } @$cpu], $top_cpu, $inner, $high);
    my $top_mem = lzr_ceiling((sort { $b <=> $a } 1024, @$mem[($#$mem > $inner ? -$inner : 0) .. $#$mem])[0]);
    push @lines, lzr_paint(1, 'Memory') . sprintf(' %s %s now, top of graph %s', @$mem ? lzr_kib($mem->[-1]) : '-', $mine ? 'footprint' : 'resident', lzr_kib($top_mem)), lzr_graph($mem, $top_mem, $inner, $high);
    push @lines, lzr_paint(2, sprintf 'Since %s, a sample every %ss. q, Esc, Ctrl-C or %s closes.', $since, $every, $LZR_CLOSE) . ($ended ? ' ' . lzr_paint(33, "The process ended at $ended.") : '');
    splice @lines, $rows if @lines > $rows;
    return @lines;
}

sub lzr_graph {                           # the last $wide values as $high rows of blocks, each column one sample, the newest on the right (the scale is said above it)
    my ($values, $top, $wide, $high) = @_;
    my @last = @$values[($#$values >= $wide ? @$values - $wide : 0) .. $#$values];
    my @rows;
    for my $row (reverse 0 .. $high - 1) {
        my $line = join '', map { my $eighths = int($_ / $top * $high * 8 + 0.5) - $row * 8; $LZR_BLOCKS[$eighths < 0 ? 0 : $eighths > 8 ? 8 : $eighths] } @last;
        push @rows, '  ' . lzr_paint(96, ' ' x ($wide - @last) . $line);
    }
    push @rows, '  ' . "\x{2594}" x $wide;
    return @rows;
}
# Tor, on one click. The client is Arti, the Tor Project's own, built from
# source and put beside the program by the installer, named in the release file like every file
# there (sub paired) and compared again before it starts. It runs only between "tor on" and
# "tor off" from the window, or until the window ends: nothing of it is held before or after. It
# runs in a container of its own: it reads its program, the system's libraries and one folder of
# lzrprf's, $DIR/tor, where it keeps the directory of relays it downloaded; it connects out over
# TCP and listens on the loopback alone. lzrprf hands it the host name over SOCKS5 and carries
# the bytes as for any request; nothing is looked up on this computer, and every site goes out
# under its own SOCKS name, so two sites never share a circuit. A small shell stands between
# lzrprf and the client and ends it when lzrprf's end of a pipe closes, so a window that ends in
# any way ends its Tor too. While Tor is wanted and not ready, nothing is fetched: never directly.
my $TOR_CONTAINER = <<'END';
(version 1)
(deny default)
(allow process-exec (literal (param "BIN")))
(allow process-fork)
(allow signal (target self))
(allow sysctl-read)
(allow file-read* file-map-executable
  (subpath "/usr/lib") (subpath "/System/Library") (subpath "/System/Cryptexes")
  (subpath "/Library/Apple/System/Library") (subpath "/private/var/db/dyld")
  (literal (param "BIN")))
(allow file-read-data (literal "/"))
(allow file-read-metadata (literal "/") (literal "/private") (literal "/private/tmp") (literal "/tmp")
  (literal "/private/var") (literal "/var") (literal "/Users") (literal "/private/etc") (literal "/etc"))
(allow file-read* (literal "/dev/urandom") (literal "/dev/random") (literal "/dev/null"))
(allow file-write-data (literal "/dev/null"))
(allow file-read* file-write* (subpath (param "DATA")))
(allow file-read-metadata (path-ancestors (param "DATA")))
(allow network-outbound (remote tcp "*:*"))
(allow network-bind network-inbound (local tcp "localhost:*"))
END
my $TOR_SECONDS = 90;                     # DECLARED(the most a start may take; a cold start measured 2 to 4 s, a slow network takes longer)
my @TOR_STEPS = (                         # the client's own log lines, each the first of a step the window shows
    [qr/Looking for a consensus|usable directory from cache|good directory from cache|Fetching a consensus/, 1, 10, 'Reading the directory of relays'],
    [qr/Downloading certificates/, 2, 30, 'Checking the directory'],
    [qr/Downloading microdescriptors/, 3, 55, 'Learning the relays'],
    [qr/Marked consensus usable|Directory is complete|enough information to build circuits/, 4, 85, 'Building circuits'],
    [qr/Sufficiently bootstrapped; proxy now functional/, 5, 100, 'Connected to Tor'],
);
sub tor_client {                        # the client, and whether it is a test's stand-in
    if ($TRY && open my $instead, '<', "$ROOT/torclient") { chomp(my $line = <$instead> // ''); return ($line, 1) }    # "lzrprf try" only: the test's stand-in, a perl script
    return (dirname($PROGRAM) . '/arti', 0);
}
sub tor_where { return (undef, $REFUSED_WHY) if listed($_[0]); return (undef, 'this Tor window is not open for browsing, so nothing was fetched: not through Tor, and not directly') if $TOR && $TOR_SESSION && $TOR_SESSION->{phase} ne 'browsing'; return $TOR ? [{ tor => 1, host => $_[0], text => 'Tor' }] : (undef, 'Tor is on and not connected, so nothing was fetched: not through Tor, and not directly') }    # [C23] Tor is not asked for a listed host
sub tor_on {                              # [C17] started on request only, in its own container, and checked against the release file
    return window('tor on') if $TOR;
    jar_end();                            # [C17] a new identity, a new jar: none of the window before it goes through Tor
    $TOR_WANTED = 1;
    return tor_failed('LZRTNNL is not installed: add it in Add or remove LZR modules') unless part_on('lzrtnnl');
    if (my $why = tnnl_ready()) { return tor_failed($why) }    # with the VPN, Tor starts only while it is there
    my ($bin, $stand_in) = tor_client();
    my ($named) = map { /^file arti ([0-9a-f]{64})$/ ? $1 : () } release_lines();
    return tor_failed("the Tor client is not beside $APP: this release has none") unless -f $bin && ($stand_in || -x _);    # a stand-in is run by perl
    return tor_failed('the Tor client is another file than the release names') if !$TRY && ($named // '') ne (sum_of($bin) // '');
    my $data = "$DIR/tor";
    mkdir $data, 0700;
    return tor_failed("lzrprf could not make the folder $data") unless -d $data && !-l $data;
    unlink "$data/port", "$data/log";
    open my $cfg, '>', "$data/config.toml" or return tor_failed("lzrprf could not write $data/config.toml");
    print $cfg join("\n", '[proxy]', 'socks_listen = "127.0.0.1:auto"', 'dns_listen = 0', '[logging]', 'console = "info"', '[storage]', qq{cache_dir = "$data/cache"}, qq{state_dir = "$data/state"}, qq{port_info_file = "$data/port"},
        '[address_filter]', 'allow_onion_addrs = true', '[preemptive_circuits]', 'disable_at_threshold = 2', 'initial_predicted_ports = [443]', 'min_exit_circs_for_port = 1', 'prediction_lifetime = "10 minutes"',
        '[circuit_timing]', 'disused_circuit_timeout = "5 minutes"', '[system]', 'max_files = 1024', 'memory.max = "64 MiB"', 'memory.low_water = "48 MiB"', tnnl_lines(), '');    # with the VPN, [channel]: every connection through lzrprf's relay
    close $cfg;
    pipe(my $hold, my $guard) or return tor_failed('lzrprf could not start the Tor client');
    open my $log, '>', "$data/log" or return tor_failed("lzrprf could not write $data/log");
    my $pid = fork // return tor_failed('lzrprf could not start the Tor client');
    if (!$pid) {
        close $guard;
        my @client = $stand_in ? ('/usr/bin/perl', $bin) : ('/usr/bin/sandbox-exec', '-D', "BIN=$bin", '-D', "DATA=$data", '-p', tnnl_container($TOR_CONTAINER), $bin);    # a test's stand-in is a script, which the container (one named program, nothing it starts) cannot run: the selftest tries the container on its own
        become($hold, $log, $log, '/bin/sh', '-c', '"$@" & child=$!; read held; kill $child; wait', 'lzrprf-tor', @client, 'proxy', '-c', "$data/config.toml");
    }
    close $hold;
    close $log;
    select((select($guard), $| = 1)[0]);    # autoflush
    $TOR = { pid => $pid, guard => $guard };
    record("you turned Tor on: lzrprf starts the Tor client, $bin, in its own container" . (tnnl_on() ? ", through the VPN on " . tnnl_said() . " alone" : '')) or return tor_off('the log could not be written');
    window('tor step 0 0 Starting the Tor client');
    my ($until, $read, $step) = (now() + $TOR_SECONDS, 0, 0);
    while (now() < $until) {
        my $event = hear(0.2);
        return tor_off('the window closed') unless defined $event;
        if ($event eq 'tor off') {
            return tor_off('you stopped Tor before it connected') unless $TOR_SESSION;
            my $asking = now();           # [C17] Stop Tor while a Tor window connects: asked as from the ready modal; Stop Tor ends the window here (sub leave), Cancel goes on connecting
            tor_session_asked();
            $until += now() - $asking;    # the time the question stood is not taken from the start
            next;
        }
        push @HELD, $event if length $event;    # the rest is heard once Tor is connected or stopped
        return if tnnl_watch();           # the VPN dropped while Tor started: stopped, and still wanted
        return tor_failed('the Tor client ended') if waitpid($pid, 1) == $pid;    # 1: WNOHANG
        open my $in, '<', "$data/log" or next;
        seek $in, $read, 0;
        while (my $line = <$in>) {
            last unless $line =~ /\n\z/;
            $read += length $line;
            return tor_failed('Tor could not build a circuit') if $line =~ /circuit build retry limit|Unable to bootstrap/;
            for my $one (grep { $_->[1] > $step && $line =~ $_->[0] } @TOR_STEPS) { $step = $one->[1]; window("tor step $one->[1] $one->[2] $one->[3]") }
        }
        if ($step == 5 && open my $port, '<', "$data/port") {
            my ($number) = (join '', <$port>) =~ /"socks"[^\]]*?127\.0\.0\.1:(\d{1,5})"/s;
            next unless $number;
            $TOR->{port} = $number;
            record('Tor is connected: every address is fetched through it from here on, one circuit for each site') or return tor_off('the log could not be written');
            window('tor on');
            return idle('Tor is connected. Every address is fetched through it, one circuit for each site, and nothing is looked up on this Mac.');
        }
    }
    return tor_failed("Tor did not connect in $TOR_SECONDS seconds");
}
sub tor_failed {
    my ($why) = @_;
    tor_off();
    $TOR_WANTED = 1;                      # still wanted: nothing is fetched directly until Tor is turned off
    record("Tor did not connect: $why");
    window("tor failed $why");
    return idle("Tor did not connect: $why. Nothing is fetched until it connects or you turn it off.");
}
sub tor_off {
    my ($why) = @_;
    tnnl_relay_end();                     # LZRTNNL's relay goes with the client: no watch of a VPN outlives the Tor it carried
    jar_end() if $TOR;                    # [C17] the identity's jar ends with it, written nowhere
    $TOR_WANTED = 0;
    my $was = $TOR or return defined $why ? (window('tor off'), idle('Tor is off.')) : ();
    $TOR = undef;
    close $was->{guard};                  # the shell between ends the client as its pipe closes
    my $until = now() + 3;
    while (now() < $until) { last if waitpid($was->{pid}, 1) == $was->{pid}; Time::HiRes::sleep(0.05) }
    if (waitpid($was->{pid}, 1) == 0) { kill 'KILL', $was->{pid}; waitpid($was->{pid}, 0) }
    return unless defined $why;
    record("Tor is off: $why");
    window('tor off');
    return idle('Tor is off: every address is fetched directly again.');
}
# One connection through Tor: to the client on the loopback, then SOCKS5 with the host name, and
# the site's host as the user name, so Tor gives each site its own circuit.
sub tor_reach {
    my ($host, $until) = @_;
    return if listed($host);              # [C23] Tor is never asked for a listed host, an onion address or any other, whatever led here
    return unless $TOR && $TOR->{port} && waitpid($TOR->{pid}, 1) == 0;
    socket(my $tor, AF_INET, SOCK_STREAM, 0) or return;
    connect($tor, pack_sockaddr_in($TOR->{port}, inet_aton('127.0.0.1'))) or return;    # the loopback: this computer, never the internet
    my $said = sub {
        my ($send, $want) = @_;
        syswrite($tor, $send) == length $send or return '' if length $send;
        my $got = '';
        while (length $got < $want) {
            my $ready = '';
            vec($ready, fileno $tor, 1) = 1;
            my $left = $until - now();
            return '' if $left <= 0 || select($ready, undef, undef, $left) <= 0;
            sysread($tor, $got, $want - length $got, length $got) or return '';
        }
        return $got;
    };
    return unless $said->("\x05\x01\x02", 2) eq "\x05\x02";
    return unless $said->(pack('C C/a* C/a*', 1, substr($host, 0, 255), 'lzrbrwsr'), 2) eq "\x01\x00";
    my $head = $said->(pack('C4 C/a* n', 5, 1, 0, 3, $host, 443), 4);
    return unless length $head == 4 && substr($head, 0, 2) eq "\x05\x00";
    my $kind = ord substr($head, 3, 1);
    my $rest = $kind == 1 ? 6 : $kind == 4 ? 18 : $kind == 3 ? 2 + ord $said->('', 1) : return;
    return unless length $said->('', $rest) == $rest;
    unblocked($tor);
    return ($tor, 'Tor');
}

# The Tor window [C17]. Tor never carries a window that is not one: the onion icon of such a window
# opens a Tor window apart from it (sub tor_window_opened), a second lzrprf with a fresh incognito
# folder of its own, so no cookie, cache, storage or kept answer of the first reaches it, and nothing
# of it reaches the first. Its steps come in one order, held by sub tor_phase: made; connecting, while
# Tor starts; sealed, once it is connected and the window is shown to reach nothing past it (a name is
# not looked up, a direct connection is refused: sub tor_sealed); browsing, the only phase in which an
# address is fetched. Its end, by Tor off after your yes or by the window closing: closing, from which
# no new navigation or request is taken; ended, every page and its processes ended and shown gone;
# wiped, its data removed from its folder and its tables in memory emptied; checked, nothing of either
# left; released, only then Tor is turned off. The folder itself, with Tor's own directory of relays,
# goes last, as every incognito folder does (sub leave).
my $TOR_STOP_ASK = 'Stopping Tor: a. all tabs of this window will be closed; b. Tor will be disconnected and this incognito window will be closed, with all it held removed. Stop Tor?';    # [C17] the words of Stop Tor's question, in the window's Tor modal
my %TOR_ORDER = (made => 'connecting closing', connecting => 'sealed closing', sealed => 'browsing closing', browsing => 'closing', closing => 'ended', ended => 'wiped', wiped => 'checked', checked => 'released', released => '');
sub tor_phase {                           # [C17] the next step of the Tor window, when it may follow the one it is in: true, and it is that step now; else false, and nothing changes
    my ($to) = @_;
    my $from = $TOR_SESSION->{phase} // return 0;
    return 0 unless grep { $_ eq $to } split / /, $TOR_ORDER{$from} // '';
    $TOR_SESSION->{phase} = $to;
    return 1;
}

sub tor_window_opened {                   # [C17] the onion icon of a window that is not a Tor window, or File > New Tor Window in any window: a Tor window apart from it, and this one as it was
    window('tor off') unless $TOR_WINDOW;    # the onion of a Tor window stays as its own Tor says
    return idle('LZRTNNL is not installed, so no Tor window opens. Add it in Add or remove LZR modules, in the cogwheel menu.') unless part_on('lzrtnnl');
    return idle('A Tor window was asked for: "lzrprf try" starts none. Tor never carries this window.') if $TRY;
    return idle('No Tor window was started: lzrprf could not start a process.') unless apart(undef, '/usr/bin/perl', $SELF, 'tor', defined $PROFILE ? ('--profile', $PROFILE) : (), $PROGRAM, @ARGUMENTS);
    return idle('A Tor window is opening, apart from this one. It shares nothing with this window, and Tor never carries this one.');
}

sub tor_session_on {                      # [C17] Tor connected for the Tor window, sealed, and only then open for browsing
    tor_phase('connecting') if $TOR_SESSION->{phase} eq 'made';
    return idle('This Tor window is closing.') unless $TOR_SESSION->{phase} eq 'connecting' || $TOR_SESSION->{phase} eq 'browsing';
    window('torsession connecting') if $TOR_SESSION->{phase} eq 'connecting';
    tor_on();
    return unless $TOR && $TOR->{port} && $TOR_SESSION->{phase} eq 'connecting';
    tor_phase('sealed');
    if (my $why = tor_sealed()) { record("the Tor window was not sealed: $why"); return tor_session_end("it was not sealed: $why") }
    tor_phase('browsing');
    window('torsession browsing');
    record('the Tor window is sealed: no name is looked up on this Mac and no connection goes past Tor; it browses from here on');
    return idle('Tor is connected, and this window reaches nothing past it. Every address is fetched through Tor, one circuit for each site.');
}

sub tor_sealed {                          # [C17] why the Tor window could still reach the network past Tor, or nothing
    my (undef, $why) = find('example.test');
    return 'a name could be looked up on this Mac' unless defined $why;
    return 'a direct connection could still be made' unless $TOR_SESSION;    # sub reach refuses every address while a Tor window is open
    return 'Tor is not the one way out' unless ($TOR_WANTED && $TOR && $TOR->{port});
    return;
}

sub tor_session_asked {                   # [C17] Stop Tor in a Tor window, asked in its Tor modal: the window is closed whole first, after your yes
    return idle('Tor stays on, and this Tor window stays open.') unless ask($TOR_STOP_ASK, 'Cancel', 'Stop Tor') == 2;
    record('you closed the Tor window');
    leave();
}

sub tor_session_tables {                  # [C17] how many entries the Tor window's tables in memory hold
    return sends_count() + essential_web_count() + keys(%REDIRECTS) + @LIVE + @CLOSED + @SESSION + @WAY + @PICTURED + @PERMIT_SEEN + @FILTER_SEEN + @PERMIT_HELD + @HELD + @LATER + keys(%PERMIT_PASSWORD) + keys(%PERMIT_PATHS) + keys(%PERMIT_DENIED) + keys(%PERMIT_NEXT) + keys(%PERMIT_ONCE) + keys(%PERMIT_INFO) + keys(%PERMIT_WEB) + listed_said() + @MARKS + length($TITLED)
        + (grep { length($_->{url} // '') || @{ $_->{visited} // [] } } @TABS) + (defined $SHOWN) + (defined $FLAGGED) + (defined $PERMIT_ASK) + (defined $NEXT);
}

sub tor_session_files {                   # [C17] what its folder holds besides Tor's own folder and the files of its life (held, behind, sweeper, torwindow)
    opendir my $in, $DIR or return ();
    return grep { !/^\.\.?\z/ && !/^(?:tor|held|behind|sweeper|torwindow)\z/ } readdir $in;
}

sub tor_told { print "$_\n" for @_; return }    # [C17] lines to the window in a Tor window's end: a window already gone does not cut the end short, as sub window would (sub leave)

sub tor_session_end {                     # [C17] the end of a Tor window, step by step, each after the one before held
    my ($why) = @_;
    return unless $TOR_SESSION && tor_phase('closing');
    tor_told('torsession closing');
    record("the Tor window closes: $why. No new navigation or request is taken");
    my @processes = grep { defined } map { @$_{qw(page keeper)} } @LIVE;
    live_end($_, 'the Tor window closed', 1) for @{ [@LIVE] };
    jar_end();                            # its cookies with its pages, written nowhere
    kill 'KILL', $witness if $witness;
    my @left = grep { kill 0, $_ } @processes;
    kill 'KILL', @left if @left;
    waitpid $_, 0 for @left;
    tor_phase('ended');
    tor_told('torsession ended ' . scalar(grep { kill 0, $_ } @processes));
    if ($TRY) { print STDERR "test session $_\n" for @SESSION }    # "lzrprf try" only: what the window's log held, for the test to read, written before it is emptied
    remove_tree("$DIR/$_", { safe => 0 }) for tor_session_files();
    @$_ = () for \@LIVE, \@CLOSED, \@SESSION, \@WAY, \@PICTURED, \@PERMIT_SEEN, \@FILTER_SEEN, \@PERMIT_HELD, \@HELD, \@LATER;
    undef $_ for $PERMIT_UNREAD, $PERMIT_STRIPPED; %$_ = () for \%PERMIT_PASSWORD, \%PERMIT_PATHS, \%PERMIT_DENIED, \%PERMIT_NEXT, \%PERMIT_ONCE, \%PERMIT_INFO, \%PERMIT_WEB;
    @MARKS = ();
    %REDIRECTS = (); sends_clear(); essential_web_clear();
    listed_said(1);
    ($TAB, $TITLED, @TABS) = (0, '', fresh_tab());
    ($SHOWN, $FLAGGED, $PERMIT_ASK, $NEXT) = ();
    tor_phase('wiped');
    tor_told('torsession wiped');
    my ($files, $tables) = (scalar(tor_session_files()), tor_session_tables());
    tor_phase('checked');
    tor_told("torsession checked $files $tables");
    return tor_told('torsession held') if $files || $tables;    # not all of it is gone: Tor is not released by this step, and the window's end takes it with the folder (sub leave)
    tor_phase('released');
    tor_off();
    tor_told('torsession released', 'tor off');
    return;
}

# The list. lzrprf never opens an address on the list of child sexual abuse
# material and other illegal content, and nothing it runs can get past it:
# every request of every page goes through lzrprf, which alone looks a name
# up, starts curl and asks Tor to connect. The list is one file, blocklist,
# beside lzrprf itself, read once when a window starts and held in memory. It
# holds digests and no address: of an onion address, the MD5 of its last two
# labels ("<56 characters>.onion"), as Ahmia publishes its list; of a host,
# the SHA-256 of its name in small letters; of an address, the SHA-256 of
# its host and path with its query, "host/path?query", without https://, the
# port or the part after #. So the file says no address to whoever reads it,
# and an address is matched here, on this computer, by computing its digests
# and looking them up: no address and no digest of one is sent anywhere.
# The file is plain text: its first line "lzrprf blocklist 2 form 2" (the
# layout, then the form of the addresses, $LIST_FORM), then lines "# " that
# say where its parts come from, then four parts in this order, each a line
# "onion-md5 N", "host-sha256 N", "url-sha256 N" or "query-sha256 N" and N
# digests in small hex letters, one a line, in increasing order and each
# once; query-sha256 holds "host/path" of each listed address with a query. A
# part of another length, a digest out of order or a line in another form is
# a damaged list. The application's release file names the list's SHA-256
# in a line "blocklist <sha256>", as it names lzrprf's, and a list that is
# another file is no list. Without a list that is held, lzrprf opens nothing:
# the window says why (sub behind), and "sub listed" says yes to everything.
# There is no setting, no variable and no button that changes any of it.  # [C23]
sub list_read {                           # [C23] true when the list is held: read now, the first time
    return 1 if $LIST_HELD;
    return 0 if defined $LIST_WHY;
    my $file = dirname($SELF) . '/blocklist';
    my $no = sub { $LIST_WHY = $_[0]; %LISTED = (); return 0 };
    sysopen(my $in, $file, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return $no->(-l $file ? "$file is a link, and lzrprf reads its list from a plain file" : "$file is not there");
    my @is = stat $in;
    return $no->("$file is not a plain file") unless -f _;
    return $no->("$file is larger than lzrprf reads") if $is[7] > $LIST_BYTES;
    binmode $in;
    my $text = '';
    while (1) {
        my $got = sysread($in, $text, 1048576, length $text);
        return $no->("$file could not be read") unless defined $got;
        last unless $got;
        return $no->("$file is larger than lzrprf reads") if length $text > $LIST_BYTES;
    }
    close $in;
    if (length $PROGRAM) {               # a window: the list must be the one the application's release file names, when there is such a file (sub paired holds the rest of that file)
        my @lines = release_lines();
        my ($named) = map { /^blocklist ([0-9a-f]{64})$/ ? $1 : () } @lines;
        return $no->("the application's release file names no list, so lzrprf cannot tell that $file is the one installed with it") if !defined $named && (@lines || $PROGRAM =~ m{\.app/Contents/MacOS/});
        return $no->("$file is another file than the application's release file names") if defined $named && $named ne Digest::SHA::sha256_hex($text);
    }
    $text =~ s/\Alzrprf blocklist 2 form ([1-9][0-9]{0,3})\n(?:# [\x20-\x7e]{0,300}\n){0,100}// or return $no->("$file does not begin as a list of lzrprf");
    return $no->("$file was made for form $1 of the addresses, and this lzrprf matches form $LIST_FORM") if $1 != $LIST_FORM;
    my $count = 0;
    for my $part (['onion', 'onion-md5', 32], ['host', 'host-sha256', 64], ['url', 'url-sha256', 64], ['query', 'query-sha256', 64]) {
        my ($kind, $word, $hex) = @$part;
        $text =~ s/\A\Q$word\E (0|[1-9][0-9]{0,7})\n// or return $no->("$file has no part $word where it belongs");
        my $n = $1;
        my $digests = substr($text, 0, $n * ($hex + 1), '');
        return $no->("$file is cut short in its part $word") if length $digests != $n * ($hex + 1);
        return $no->("$file holds a line in its part $word that is no digest") unless $digests =~ /\A(?:[0-9a-f]{$hex}\n)*\z/;
        my $all = pack 'H*', $digests =~ tr/\n//dr;
        my $wide = $hex / 2;
        for my $at (1 .. $n - 1) { return $no->("$file holds its part $word out of order") unless substr($all, ($at - 1) * $wide, $wide) lt substr($all, $at * $wide, $wide) }
        $LISTED{$kind} = $all;
        $count += $n;
    }
    return $no->("$file holds more after its last part") if length $text;
    ($LIST_HELD, $LIST_COUNT) = (1, $count);
    return 1;
}

sub list_has {                            # [C23] whether one digest is in one part of the list: a search by halves of the sorted part, at most 21 steps for a million
    my ($kind, $digest) = @_;
    my $all = $LISTED{$kind} // return 0;
    my $wide = length $digest;
    my ($low, $high) = (0, int(length($all) / $wide));
    while ($low < $high) {
        my $mid = ($low + $high) >> 1;
        my $order = substr($all, $mid * $wide, $wide) cmp $digest;
        ($LIST_HIT = $kind), return 1 unless $order;    # which part held it: sub refused words an onion refused by Ahmia's list on its own
        if ($order < 0) { $low = $mid + 1 } else { $high = $mid }
    }
    return 0;
}

# The one form of an address the list's digests are made of (README, "The
# digests"), for hosts and addresses alike: the host in small letters, its
# %-escapes read and its dots at either end taken away; the path read
# segment by segment, a segment's ";" and what follows dropped, an escape of
# a letter, digit, "-", ".", "_" or "~" read, every other escape written in
# capitals and every other byte escaped in capitals ("%2F" and "%5C" stay
# escapes and never split a path), empty segments, "." and ".." taken away
# as a browser and a server take them, and a backslash read as "/"; the
# query split at "&" and ";", "+" read as a space, each part written the
# same way but with "=" kept, the empty ones and the repeated ones dropped
# and the rest in sorted order. So "/./a//b/../x;y/" is "/a/x", "%78" is
# "x", "/a b" is "/a%20b" and "?b=2&a=1&a=1" is "?a=1&b=2". An address too
# long to be read gives no host (undef), and sub listed refuses it. It is read loosely, as no address lzrprf fetches is (any
# scheme, a name and password before the host, a port), so whatever could
# stand for a listed address in front of you is held to the list. The same
# text is run by scripts/blocklist.pl of the application, so a list made
# from plain addresses and the matching here agree by construction.  # [C23]
sub url_form {
    my ($text) = @_;
    return unless defined $text;
    utf8::encode($text) if utf8::is_utf8($text);    # bytes, as they go on the wire
    $text =~ s/^[ \t\r\n]+|[ \t\r\n]+$//g;
    $text = "https:$text" if $text =~ m{^//};
    $text = "https://$text" unless $text =~ m{^[A-Za-z][A-Za-z0-9+.-]*:};
    my ($host, $path, $query) = $text =~ m{^[A-Za-z][A-Za-z0-9+.-]*://(?:[^/?#\@]*\@)?(\[[^\]]*\]|[^/?#:\@\\]*)(?::[^/?#\\]*)?([^?#]*)(?:\?([^#]*))?}s or return;
    $host =~ s/%([0-9A-Fa-f]{2})/chr hex $1/ge;
    $host = lc $host;
    $host =~ s/^\.+|\.+$//g;
    return unless length $host;
    return (undef) unless length $host <= 1000 && length($path) + length($query // '') <= 8192;    # too long to be read: listed, never let past
    my $unreserved = join '', 'A' .. 'Z', 'a' .. 'z', '0' .. '9', '-._~';    # the bytes an address may carry plain or escaped with the same meaning (RFC 3986 2.3): written plain
    my $plain = sub {                     # one segment or query part: unreserved escapes read, every other escape and byte in capital %XX, and the bytes of $keep as they are
        my ($part, $keep) = @_;
        $part =~ s{%([0-9A-Fa-f]{2})|(.)}{my ($hex, $byte) = ($1, $2); my $char = defined $hex ? chr hex $hex : $byte; index($unreserved, $char) >= 0 || (!defined $hex && index($keep, $char) >= 0) ? $char : sprintf('%%%02X', ord $char)}gse;
        return $part;
    };
    my @path;
    for my $segment (split m{[/\\]}, $path) {
        $segment = $plain->($segment =~ s/;.*//sr, '');
        next if $segment eq '' || $segment eq '.';
        if ($segment eq '..') { pop @path; next }
        push @path, $segment;
    }
    my %seen;
    return ($host, '/' . join('/', @path), join('&', sort grep { length && !$seen{$_}++ } map { $plain->(s/\+/%20/gr, '=') } split /[&;]/, $query // ''));
}

# Whether an address is listed: what was typed, a bookmark, what a redirect
# names, the address of a picture, a style sheet, a video or of what a page
# asks for, or a host alone, in the form above. An onion address is held to
# the list by its last two labels, any other host by itself and by every
# name it stands under, and an address by its path with every choice of its
# query's parts (so a listed query with parts added or repeated is still
# listed; with more than $QUERY_SUBSETS parts, a path that has any listed
# query is refused whole; the choices are tried only on a path the query
# part names, so any other address costs one search), then by that path and every path above it down to
# the first segment without one: a listed page is listed with whatever is put
# after it. "host/" listed blocks that one page; a whole host is blocked by
# the host part. An address too long to be read is listed. While no list is
# held, every address is.                                                 # [C23]
my %LISTED_SAID;                          # [C23] what sub listed said of each text since the list was read: the list never changes while it is held, so a page that names one address a thousand times costs one match
sub listed_said { %LISTED_SAID = () if $_[0]; return scalar keys %LISTED_SAID }    # [C17] how many texts it holds what sub listed said of; a true argument empties it first (a Tor window's end, sub tor_session_end)
sub listed {
    my ($text) = @_;
    return 1 unless list_read();
    return 0 unless $LIST_COUNT && defined $text;
    %LISTED_SAID = () if keys %LISTED_SAID >= 4096;    # held small: a page of many addresses starts the memory afresh
    my $was = $LIST_HIT;                  # the part that refused the last listed text: a text not listed leaves it as it was
    $LIST_HIT = undef;
    my $said = length $text > 2100 ? listed_now($text) && ($LIST_HIT // 'whole') : ($LISTED_SAID{$text} //= listed_now($text) && ($LIST_HIT // 'whole'));    # a text longer than any address lzrprf fetches is matched each time and not kept: the memory holds at most 4096 texts of 2100 bytes; each holds the part that refused it (onion, host, url, query, or whole for one too long to be read), so a match from the memory words its refusal as the first did
    $LIST_HIT = $said || $was;
    return $said ? 1 : 0;
}
sub listed_now {                          # [C23] the match itself, for sub listed
    my ($text) = @_;
    my ($host, $path, $query) = url_form($text) or return 0;
    return 1 unless defined $host;        # too long to be read in the form of the list: refused rather than let past
    my @labels = split /\./, $host;
    require Digest::MD5 if @labels >= 2 && $labels[-1] eq 'onion';    # loaded for the first onion address, not at every start
    return 1 if @labels >= 2 && $labels[-1] eq 'onion' && list_has(onion => Digest::MD5::md5("$labels[-2].onion"));    # an onion address and every name under it
    for my $at (0 .. ($#labels > 1 ? $#labels - 1 : 0)) { return 1 if list_has(host => Digest::SHA::sha256(join '.', @labels[$at .. $#labels])) }    # the host, and every name it stands under but the last label alone
    if (length $query) {
        return 1 if list_has(url => Digest::SHA::sha256("$host$path?$query"));    # the query as it is
        if (list_has(query => Digest::SHA::sha256("$host$path"))) {    # only a path that has a listed query is tried further: one search for every other address
            my @parts = split /&/, $query;
            return 1 if @parts > $QUERY_SUBSETS;    # too many parts to try each choice: refused whole
            for my $choice (1 .. (1 << @parts) - 2) { return 1 if list_has(url => Digest::SHA::sha256("$host$path?" . join '&', @parts[grep { $choice >> $_ & 1 } 0 .. $#parts])) }    # every other choice of the parts, in their sorted order
        }
    }
    return 1 if list_has(url => Digest::SHA::sha256("$host$path"));
    my @segments = split m{/}, substr($path, 1);
    for my $n (reverse 1 .. ($#segments < 64 ? $#segments : 64)) { return 1 if list_has(url => Digest::SHA::sha256("$host/" . join('/', @segments[0 .. $n - 1]))) }    # every path above it down to its first segment, of a longer one the 64 nearest the host: "host/" alone is never a parent
    return 0;
}

# A line for the log, or for this window's lines in memory, that names no
# listed address: one that does is given as the sentence of a refusal, whole,
# and nothing of the line it stood for is kept. Each word of it that could be
# a host or an address is held to the list. This is the last of the checks:
# every place that refuses a listed address does so before it writes a line,
# and this one holds should a line ever be written otherwise.            # [C23]
sub unlisted {
    my ($line) = @_;
    return $line unless $LIST_HELD && $LIST_COUNT;    # a list of nothing names nothing; with no list held nothing is fetched or written for a page
    for my $word ($line =~ m{([A-Za-z][A-Za-z0-9+.-]*://[^\s"'<>]+|[A-Za-z0-9%_-]+(?:\.[A-Za-z0-9%_-]+)+)}g) {
        return "an address on the list was named here, and is not written: $REFUSED" if listed($word);
    }
    return $line;
}

sub refused {                             # [C23] a listed address refused: the sentence, in the log with no address, and the words for the window after it; $what says what it was, in words that name no address
    my ($what, $kept) = @_;
    my $ahmia = ($LIST_HIT // '') eq 'onion';    # refused by the onion part, Ahmia's list: the window says whose list it is, that it can be wrong and where to report a wrong entry
    $LIST_HIT = undef;
    record((defined $what ? "$what: " : '') . $REFUSED, $kept) or return;
    return "$REFUSED $REFUSED_HELP" unless $ahmia;
    my $report = (beside())[2];           # the release file's report address, when it names one
    return "$REFUSED $REFUSED_AHMIA" . (defined $report ? " and to LZRBRWSR ($report)" : '') . ". $REFUSED_HELP";
}

sub barred {                              # [C23] a visit to a listed address: the tab is left showing no address and no page, nothing of it is kept in the tab or its history, and the window says why
    my $tab = $TABS[$TAB];
    live_end($_, 'its tab went elsewhere') for grep { $_->{tab} && $_->{tab} == $tab } @LIVE;
    @$tab{qw(url title secure)} = ('', '', undef);
    window('address ', "title $TAB ", "page $TAB", '.', 'secure none');
    nav_told();
    my $says = refused(undef) // return idle($UNWRITTEN);
    return idle($says);
}

# LZRDFNDR's blocked page [C28]. The application judges every page against LZRDFNDR's lists
# (lzrbrwsr src/page/shield.rs) before it reads any of it, and for a page they block it writes one
# line and nothing else: "=flagged", the confidence, the list's name, the category in words and the
# address with only its host and path, each checked here to its form and length. The detection is
# the application's; lzrprf holds no list of it and passes only this line on. Nothing of the page
# is drawn and none of it runs: the window shows a red page of its own over the whole page, with
# two buttons, Close the Tab, the first and the answer when the time is over, and Report False
# Positive Anonymously. There is no button that shows the page. A report is shown whole before it
# is sent and is sent only on Send: the category, the list, the confidence and the host and path,
# and nothing else; it goes to the address the release file names in a line "flagreport", through
# Tor when Tor is on, and not at all when Tor is on and not connected. Either way the tab closes.
sub flag_of {                             # [C28] a =flagged line in its one form: {confidence, list, category, context}; else nothing
    my ($wrote) = @_;
    my ($confidence, $list, $category, $context) = $wrote =~ /\A=flagged (high|medium) ([a-z0-9-]{1,40})\t([a-z ,-]{1,80})\t([\x21-\x7e]{1,300})\n\z/ or return;
    return { confidence => $confidence, list => $list, category => $category, context => $context };
}

sub flagged_by {                          # [C28] the run's =flagged line checked and kept: 'flagged', or 'unfit' for a line out of its form
    $FLAGGED = flag_of($_[0]) // return 'unfit';
    return 'flagged';
}

# Before anything is sent [C28]. An address is judged by LZRDFNDR before lzrprf looks its name up or
# fetches it: a page you visit, a picture, a style sheet, a video and each part of a stream, and what
# a page kept running asks for. lzrprf hands the application the addresses alone, one a line, in a
# run of its own in the page container (LZRPRF_JUDGE=1, at most 64 a run), and reads one line back
# for each: "=allow", or the =flagged line, held to its form, for an address its lists block, or
# "=unfit". A block sends nothing to that site; neither does an answer in no form, a run that did
# not end well, or an address not judged. The application's lists stay its own: what lzrprf learns
# is the verdict alone. The fixed addresses of the release file are the maker's and are not asked.
sub shield_ahead {                        # [C28] the same question, asked beside what lzrprf does next: one run of at most 64 addresses in a copy of lzrprf, its verdicts taken by sub shield_heard before any of them is read. Judging yle.fi's 17 pictures held its waiting script requests 25 ms (measured 2026-11-25)
    return if $SHIELD_CHILD || $SHIELD_AHEAD;
    my %once;
    my @new = grep { defined && !exists $SHIELD_SAID{$_} && !$once{$_}++ } @_;
    splice @new, 64 if @new > 64;
    return unless @new;
    pipe(my $from, my $to) or return;
    my $pid = fork // return;
    if (!$pid) {
        spare_dropped(); curl_ended($CURL_SPARE); undef $CURL_SPARE;
        close $from;
        $RUN = getppid();
        ($PREFETCH_LATER, $PREFETCH_NAMED, @PREFETCH_WAITING) = ();    # a copy begins nothing of the page's: its run started the page's scripts a second time (17 requests more on yle.fi, measured 2026-11-25)
        my ($wrote) = contained($new[0], join('', map { "$_\n" } @new), undef, 0, 'judge');
        syswrite $to, $wrote // '';
        POSIX::_exit(0);
    }
    close $to;
    $SHIELD_AHEAD = { owner => $$, pid => $pid, from => $from, these => \@new, until => now() + $FETCH_SECONDS };    # owner: a later copy of lzrprf neither reads its pipe nor ends it
    return;
}

sub shield_heard {                        # [C28] the verdicts of the run begun beside, waited for and taken as sub shield_asked takes its own: all in their form, or none
    my $ahead = $SHIELD_AHEAD or return;
    undef $SHIELD_AHEAD;
    return if $ahead->{owner} != $$;
    my ($wrote, $these) = ('', $ahead->{these});
    while (now() < $ahead->{until} && length $wrote <= 4096 * @$these) {
        my $ready = '';
        vec($ready, fileno $ahead->{from}, 1) = 1;
        next unless select($ready, undef, undef, 1) > 0;
        sysread($ahead->{from}, $wrote, 65536, length $wrote) or last;
    }
    close $ahead->{from};
    kill 'KILL', $ahead->{pid} if now() >= $ahead->{until};
    waitpid $ahead->{pid}, 0;
    my @said = split /(?<=\n)/, $wrote;
    return unless @said == @$these && !grep { $_ ne "=allow\n" && $_ ne "=unfit\n" && !flag_of($_) } @said;
    return if keys(%SHIELD_SAID) + @$these > $SHIELD_CACHE;    # the bound of the window's verdicts holds here too: they are asked again
    $SHIELD_SAID{ $these->[$_] } //= $said[$_] for 0 .. $#$these;
    return;
}

sub shield_asked {                        # [C28] each address not judged yet in this window, asked of the application in runs of at most 64
    return if $SHIELD_CHILD;              # a picture child keeps exactly the verdicts inherited from its parent
    my $today = int(time / 86400);
    %SHIELD_SAID = () if $today != $SHIELD_DAY || keys(%SHIELD_SAID) + @_ > $SHIELD_CACHE;
    $SHIELD_DAY = $today;
    shield_heard();
    my %once;
    my @new = grep { defined && !exists $SHIELD_SAID{$_} && !$once{$_}++ } @_;
    splice @new, $SHIELD_CACHE if @new > $SHIELD_CACHE;    # a later fetch asks again for an uncached address
    return unless @new;
    my $read_asked = $READ_ASKED;         # a judging run is not the page whose script request is being read
    while (my @these = splice @new, 0, 64) {
        my ($wrote) = contained($these[0], join('', map { "$_\n" } @these), undef, 0, 'judge');
        my @said = split /(?<=\n)/, $wrote // '';
        next unless @said == @these && !grep { $_ ne "=allow\n" && $_ ne "=unfit\n" && !flag_of($_) } @said;    # all in their form, or none is taken
        $SHIELD_SAID{$these[$_]} = $said[$_] for 0 .. $#these;
    }
    $READ_ASKED = $read_asked;
    return;
}

sub shield_said {                         # [C28] what LZRDFNDR said of one address, asked first if it was not: 'allow', 'flagged' (and $FLAGGED is what it said), or 'unjudged'
    my ($url) = @_;
    shield_asked($url);
    my $said = $SHIELD_SAID{$url} // return 'unjudged';
    return 'allow' if $said eq "=allow\n";
    return 'unjudged' unless flag_of($said);
    flagged_by($said);
    return 'flagged';
}

sub shield_why {                          # [C28] why nothing was sent, for the log and the bar
    my ($said) = @_;
    return $said eq 'flagged' ? "LZRDFNDR blocked it as $FLAGGED->{category}, by its list $FLAGGED->{list} ($FLAGGED->{confidence} confidence); nothing was sent to that site" : 'LZRDFNDR could not judge the address, so nothing was sent to that site';
}

sub flag_shown {                          # [C28] the red page for the page blocked, then the tab closes
    my ($url) = @_;
    my $flag = $FLAGGED;
    window("page $TAB", '.');             # the tab's page is emptied: nothing of the blocked page is drawn, before or after
    $DRAWN = 0;
    $TABS[$TAB]{title} = 'Content flagged';
    window("title $TAB Content flagged");
    record("$url was not shown: LZRDFNDR blocked it as $flag->{category}, by its list $flag->{list} ($flag->{confidence} confidence)") or return idle($UNWRITTEN);
    my $press = asked("flagged $flag->{category}", 'Close the Tab', 'Report False Positive Anonymously');
    flag_report($flag) if $press == 2;
    $FLAGGED = undef;
    tabbed('close', $TAB);
    return;
}

sub flag_door {                           # [C28] where a report of a wrong block goes: the release file's "flagreport" address, a plain path, or nothing
    my ($line) = map { /^flagreport (https:\/\/\S+)$/ ? $1 : () } release_lines();
    my ($url, $host) = address($line // '');
    return unless $url && $url eq $line && $url =~ m{^https://[^/?#]+(?:/[A-Za-z0-9_-]+)+$};
    return ($url, $host);
}

sub flag_report {                         # [C28] the report previewed whole, and sent only on Send
    my ($flag) = @_;
    my ($url, $host) = flag_door() or return idle('This release names no address for reports of a wrong block, so nothing was sent.');
    return idle('Tor is on and not connected, so the report was not sent: from a Tor window it goes through Tor or not at all.') if ($TOR_WANTED || $TOR_SESSION) && !($TOR && $TOR->{port});
    my $body = "lzrdfndr report 1\ncategory $flag->{category}\nlist $flag->{list}\nconfidence $flag->{confidence}\ncontext $flag->{context}\n";
    return idle('Nothing was sent.') unless asked(join("\t", "flagreport $flag->{category}", @$flag{qw(list confidence context)}, $host . ($TOR_WANTED ? ' through Tor' : '')), 'Cancel', 'Send') == 2;
    busy("Sending the report to $host.");
    my $got = fixed("you sent a report of a wrong block: $flag->{category}, $flag->{list}, $flag->{context}: $url", $url, $host, { method => 'POST', body => $body, type => 'text/plain' });
    return idle($UNSAID ? 'lzrprf tried to send the report. Whether it arrived is not shown: the line that says how it ended could not be written to the log.' : 'The report could not be sent. The log says why.') unless defined $got;
    my ($status) = @{ live_parts($got, 'POST') // [] };
    return idle(($status // '') eq '204' ? 'The report was sent, with nothing that names you.' : 'The report address did not take it' . (($status // '') eq '429' ? ': too many reports reached it just now.' : '.'));
}
# LZRTNNL: Tor, and under it a VPN of your own (Henry, 2026-11-24, HC-0858). The decision and its
# sources: ../lzrbrwsr/architecture/lzrtnnl.md. The order is you, then the VPN, then Tor ("Tor over a
# VPN"): your provider sees that you use Tor and never where you go, Tor's guard sees the VPN's address
# and never yours, and every site keeps its own circuit, onion addresses included. A Tor window opens
# without connecting; its LZRTNNL modal offers Connect to Tor and, ticked, Use also VPN.
# The VPN is the official WireGuard app, which you install and in which you activate your provider's
# configuration file: LZRBRWSR carries no VPN client, makes no network or VPN profile of this Mac and
# asks for no right. You choose the same file in the modal; lzrprf reads its Address, Endpoint and
# AllowedIPs once, keeps those and nothing else (never the private key), and refuses a file whose
# AllowedIPs is not the whole internet (0.0.0.0/0). It then looks for the interface the app made, an
# utun whose IPv4 address is that Address (/sbin/ifconfig -v, read only), and takes its index.
# FAIL CLOSED. With the VPN, Tor reaches out only through a relay of lzrprf's own (sub tnnl_relay): a
# SOCKS5 server on the loopback, named to the client as its outbound proxy ([channel] outbound_proxy),
# that opens each connection with IP_BOUND_IF (and IPV6_BOUND_IF) set to that index, so the system
# sends it through the VPN's interface or not at all: when the VPN drops, its interface is gone, and a
# connection fails rather than taking the plain route. The relay takes numeric addresses only (Tor
# names its relays by address, so nothing is looked up), IPv6 only when the file routes ::/0, and an
# index of 0, which would bind nothing, never. The client's own container then allows it the loopback
# alone (sub tnnl_container): even a client that ignored the proxy line could not reach out past it.
# lzrprf looks at the interface every $TNNL_LOOK seconds while it is used; once it is gone, or holds
# another address, Tor is stopped and stays wanted (sub tor_failed), so nothing is fetched until you
# connect again or close the window. DNS lines of the file are ignored: Tor resolves at its exits.
# SYNC: 15-tor.pl (tor_on, tor_session_on), 28-window2.pl (the LZRTNNL modal), capabilities.json (tnnl)
my $TNNL = {};                            # file: {address, endpoint, v6}; interface, index; relay: {pid, guard, port}; next: when to look again
my $TNNL_LOOK = 2;                        # DECLARED(seconds between two looks at the VPN's interface while Tor goes through it)
my $TNNL_MOST = 65536;                    # DECLARED(the largest WireGuard file read; a provider's is under 1 KB)
my $TNNL_WAIT = 20;                       # DECLARED(the seconds the relay waits for one connection to a relay of Tor to open)
sub tnnl_on { return $TNNL->{index} ? 1 : 0 }    # true once a VPN was found for this Tor window: Tor goes through it

# The file's lines: [Interface] Address, [Peer] Endpoint and AllowedIPs. What is kept, or nothing and why.
sub tnnl_read {
    my ($text) = @_;
    my (%in, $section);
    for my $line (split /\r?\n/, $text) {
        $line =~ s/\s*[#;].*//;
        next unless $line =~ /\S/;
        if ($line =~ /^\s*\[\s*([A-Za-z]+)\s*\]\s*$/) { $section = lc $1; next }
        return (undef, 'it is not a WireGuard configuration file: a line stands before its first [Interface]') unless defined $section;
        next unless $line =~ /^\s*([A-Za-z]+)\s*=\s*(.*?)\s*$/;
        push @{ $in{"$section " . lc $1} }, map { s/^\s+|\s+$//gr } split /,/, $2;
    }
    my ($address) = map { m{^((?:25[0-5]|2[0-4]\d|1?\d?\d)(?:\.(?:25[0-5]|2[0-4]\d|1?\d?\d)){3})(?:/\d{1,2})?\z} ? $1 : () } @{ $in{'interface address'} // [] };
    my @endpoints = @{ $in{'peer endpoint'} // [] };
    my @allowed = @{ $in{'peer allowedips'} // [] };
    return (undef, 'it names no IPv4 Address in [Interface]') unless defined $address;
    return (undef, 'it names no Endpoint in [Peer]') unless @endpoints;
    return (undef, 'it names more than one peer: lzrprf takes a file of one server') if @endpoints > 1;
    return (undef, 'its Endpoint is not a host and a port') unless $endpoints[0] =~ /^(?:\[[0-9A-Fa-f:.]{2,45}\]|[A-Za-z0-9.-]{1,253}):[1-9][0-9]{0,4}\z/;
    return (undef, 'its AllowedIPs is not the whole internet (0.0.0.0/0): a VPN that carries only some addresses would let Tor go out past it') unless grep { $_ eq '0.0.0.0/0' } @allowed;
    return { address => $address, endpoint => $endpoints[0], v6 => (grep { $_ eq '::/0' } @allowed) ? 1 : 0, dns => scalar @{ $in{'interface dns'} // [] } };
}

sub tnnl_asked { return window("tnnl refused $_[0]") unless $TOR_SESSION && !$TOR && $TOR_SESSION->{phase} =~ /^(?:made|connecting|browsing)\z/; return }    # the VPN is set up in a Tor window while Tor is not running in it: before it connects, or after it stopped

# "tnnl vpn file PATH": the file you chose in the modal's Open panel. Read once, and only what is kept is kept.
sub tnnl_file {
    my ($path) = @_;
    return if tnnl_asked('The VPN is chosen in a Tor window while Tor is not running.');
    sysopen(my $in, $path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return window('tnnl refused That file could not be opened. Choose the .conf file your provider gave you, the one you imported into the WireGuard app.');
    my @is = stat $in;
    return window('tnnl refused That is not a plain file, or it is larger than a WireGuard file is.') unless @is && -f _ && $is[7] <= $TNNL_MOST;
    my $text = '';
    while (sysread($in, $text, 65536, length $text)) { last if length $text > $TNNL_MOST }
    close $in;
    my ($vpn, $why) = tnnl_read($text);
    substr($text, 0) = "\0" x length $text;    # its private key is in it: the bytes are overwritten here, and never written anywhere
    return window("tnnl refused $why. Nothing was kept.") unless $vpn;
    $TNNL = { file => $vpn };
    record("you chose a WireGuard file for LZRTNNL: lzrprf keeps its address $vpn->{address} and its server $vpn->{endpoint}, and not its private key" . ($vpn->{dns} ? '; its DNS lines are not used, Tor resolves at its exits' : '')) or return window("tnnl refused $UNWRITTEN");    # [C5]
    return window("tnnl vpn read $vpn->{address} $vpn->{endpoint}" . ($vpn->{v6} ? ' v6' : ''));
}

# Which interface holds the file's address: the name and index, or nothing and why.
sub tnnl_interface {
    my ($address) = @_;
    my ($text) = said(5, '/sbin/ifconfig', '-v');
    return (undef, undef, 'this Mac did not list its network interfaces (ifconfig)') unless length $text;
    my ($name, $index, $up);
    for my $line (split /\n/, $text) {
        if ($line =~ /^([a-z]+[0-9]+): flags=[0-9a-f]+<([A-Z_,]*)>.*\bindex ([0-9]+)/) { ($name, $up, $index) = ($1, $2, $3); next }
        next unless defined $name && $line =~ /^\s+inet ([0-9.]+) / && $1 eq $address;
        return (undef, undef, "the address $address is held by $name, which is not a VPN's interface") unless $name =~ /^utun[0-9]{1,4}\z/ || ($TRY && $name eq 'lo0');    # "lzrprf try": the loopback stands in for the VPN
        return (undef, undef, "$name holds the address and is not up") unless ",$up," =~ /,UP,/ && ",$up," =~ /,RUNNING,/;
        return (undef, undef, "$name has no index") unless $index =~ /^[1-9][0-9]{0,4}\z/;
        return ($name, 0 + $index);
    }
    return (undef, undef, "no interface of this Mac holds the address $address: the VPN is not active in the WireGuard app");
}

# "tnnl vpn look": is the VPN active now? Said to the modal, which goes on to Connect only once it is.
sub tnnl_look {
    return if tnnl_asked('The VPN is looked for in a Tor window while Tor is not running.');
    return window('tnnl refused Choose your WireGuard file first.') unless $TNNL->{file};
    my ($name, $index, $why) = tnnl_interface($TNNL->{file}{address});
    return window("tnnl vpn missing $why") unless $name;
    tnnl_relay_end() if ($TNNL->{index} // $index) != $index;    # the VPN came back on another interface: a relay bound to the old one is not used again
    @$TNNL{qw(interface index)} = ($name, $index);
    record("LZRTNNL found the VPN: the interface $name (index $index) holds $TNNL->{file}{address}; Tor goes out through it alone") or return window("tnnl refused $UNWRITTEN");    # [C5]
    return window("tnnl vpn found $name $index");
}

sub tnnl_forget { tnnl_relay_end(); $TNNL = {}; return window('tnnl vpn none') }    # "tnnl vpn off": the VPN unticked before Connect

# The relay. A process of its own, forked from lzrprf: it ends when lzrprf's end of its pipe closes.
sub tnnl_relay {
    my $index = $TNNL->{index} // 0;
    return (undef, 'the VPN has no interface') unless $index =~ /^[1-9][0-9]{0,4}\z/;    # 0 would bind no interface: refused
    return ($TNNL->{relay}{port}) if $TNNL->{relay};
    my $listen;
    socket($listen, AF_INET, SOCK_STREAM, 0) && bind($listen, pack_sockaddr_in(0, inet_aton('127.0.0.1'))) && listen($listen, 16) or return (undef, 'lzrprf could not listen on the loopback for Tor');
    my ($port) = unpack_sockaddr_in(getsockname $listen);
    pipe(my $hold, my $guard) or return (undef, 'lzrprf could not start the relay');
    my $pid = fork // return (undef, 'lzrprf could not start the relay');
    if (!$pid) {
        close $guard;
        tnnl_serve($listen, $hold, $index, $TNNL->{file}{v6});
        POSIX::_exit(0);
    }
    close $hold;
    close $listen;
    $guard->autoflush(1);
    $TNNL->{relay} = { pid => $pid, guard => $guard, port => $port };
    noted("LZRTNNL's relay listens on 127.0.0.1:$port: each connection of Tor is opened through $TNNL->{interface} alone");
    return ($port);
}
sub tnnl_relay_end {
    my $was = delete $TNNL->{relay} or return;
    close $was->{guard};                  # the relay and every connection it carries end as the pipe closes
    kill 'TERM', $was->{pid};
    waitpid($was->{pid}, 0);
    return;
}

sub tnnl_serve {                          # in the relay's process: one child for each connection, all ended with it
    my ($listen, $hold, $index, $v6) = @_;
    my $nowhere = POSIX::open('/dev/null', O_RDWR) // POSIX::_exit(127);
    POSIX::dup2($nowhere, $_) for 0 .. 2;
    my %keep = map { $_ => 1 } fileno($listen), fileno($hold);
    opendir(my $fds, '/dev/fd') or POSIX::_exit(127);
    POSIX::close($_) for grep { /^\d+$/ && $_ > 2 && !$keep{$_} } readdir $fds;    # the window's pipes and every other descriptor of lzrprf: never the relay's
    my %kids;
    $SIG{TERM} = sub { kill 'KILL', keys %kids; POSIX::_exit(0) };
    while (1) {
        my $ready = '';
        vec($ready, fileno $_, 1) = 1 for $listen, $hold;
        select($ready, undef, undef, 1);
        delete $kids{$_} for grep { waitpid($_, 1) == $_ } keys %kids;
        if (vec($ready, fileno $hold, 1)) { kill 'KILL', keys %kids; POSIX::_exit(0) }    # lzrprf ended, or ended the relay
        my $client;
        next unless vec($ready, fileno $listen, 1) && accept($client, $listen);
        my $kid = fork;
        if (defined $kid && !$kid) { close $listen; tnnl_carried($client, $hold, $index, $v6); POSIX::_exit(0) }
        $kids{$kid} = 1 if $kid;
        close $client;
    }
}

sub tnnl_bound {                          # a socket of the family given, bound to the interface $index; or nothing and why
    my ($family, $index) = @_;
    return (undef, 'no interface') unless $index =~ /^[1-9][0-9]{0,4}\z/;
    socket(my $out, $family, SOCK_STREAM, 0) or return (undef, 'no socket');
    my ($level, $name) = $family == AF_INET ? (0, 25) : (41, 125);    # IPPROTO_IP IP_BOUND_IF, IPPROTO_IPV6 IPV6_BOUND_IF (netinet/in.h, netinet6/in6.h)
    setsockopt($out, $level, $name, pack('L', $index)) or return (undef, "it could not be bound to the interface ($!)");
    my $got = getsockopt($out, $level, $name);
    return (undef, 'the system did not keep the binding') unless defined $got && unpack('L', $got) == $index;
    return ($out);
}

sub tnnl_carried {                        # one connection of Tor: SOCKS5 with a numeric address, then the bytes both ways
    my ($client, $hold, $index, $v6) = @_;
    my $until = now() + $TNNL_WAIT;
    my $read = sub {
        my ($want) = @_;
        my $got = '';
        while (length $got < $want) {
            my $ready = '';
            vec($ready, fileno $client, 1) = 1;
            my $left = $until - now();
            return '' if $left <= 0 || select($ready, undef, undef, $left) <= 0;
            sysread($client, $got, $want - length $got, length $got) or return '';
        }
        return $got;
    };
    my $answer = sub { syswrite($client, pack('C4 a4 n', 5, $_[0], 0, 1, "\0\0\0\0", 0)); return };
    my ($version, $methods) = unpack 'C C', $read->(2);
    return unless ($version // 0) == 5 && $methods;
    my %offered = map { $_ => 1 } unpack 'C*', $read->($methods);
    return syswrite($client, "\x05\xff") unless $offered{0};
    syswrite($client, "\x05\x00");
    my ($v, $command, undef, $kind) = unpack 'C4', $read->(4);
    return $answer->(7) unless ($v // 0) == 5 && ($command // 0) == 1;    # CONNECT only
    $kind //= 0;
    return $answer->(8) unless $kind == 1 || $kind == 4;                 # a name is never taken: nothing is looked up
