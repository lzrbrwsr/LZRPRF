    soundSay('played ' + id + (well ? ' yes ' : ' no ') + said.join('/'));
}
function playing() { return Object.keys(sounds).some(function (k) { return sounds[k].players.some(function (p) { return p.playing; }); }) || Object.keys(soundVideos).some(function (k) { return soundVideos[k].player && soundVideos[k].player.playing; }); }
function soundHeard() {    // what lzrprf wrote: printable ASCII lines; a play whose handling failed is still answered
    var data = from.availableData;
    if (data.length == 0) { ended = true; return; }    // lzrprf closed its end: the process ends
    held += $.NSString.alloc.initWithDataEncoding(data, 5).js;
    for (var at; (at = held.indexOf('\n')) >= 0; held = held.slice(at + 1)) {
        var line = held.slice(0, at), play = /^sound play \d{1,2} ([1-9]\d{0,9}) /.exec(line);
        try { if (line == 'sound clear') { soundsClear(); Object.keys(soundVideos).forEach(soundVideoGone); } else if (line.slice(0, 6) == 'sound ') soundTold(line.slice(6)); else if (line.slice(0, 6) == 'video ') soundVideoTold(line.slice(6)); }
        catch (fault) { if (play) soundSay('played ' + play[1] + ' no it failed: ' + String(fault).replace(/[^\x20-\x7e]/g, '?').slice(0, 120)); }
    }
    from.waitForDataInBackgroundAndNotify;
}
function run(argv) {    // its name, "quiet" or "loud", and its idle seconds
    $.NSProcessInfo.processInfo.processName = $(argv[0] || 'sound');
    quiet = argv[1] == 'quiet'; idle = +argv[2] || idle; busy = Date.now();
    ObjC.registerSubclass({ name: 'LzrprfSoundHand', methods: { 'heard:': { types: ['void', ['id']], implementation: function () { soundHeard(); } } } });
    hand = $.LzrprfSoundHand.alloc.init;
    $.NSNotificationCenter.defaultCenter.addObserverSelectorNameObject(hand, 'heard:', $.NSFileHandleDataAvailableNotification, from);
    from.waitForDataInBackgroundAndNotify;
    soundSay('ready');
    while (!ended) {
        $.NSRunLoop.currentRunLoop.runModeBeforeDate($.NSDefaultRunLoopMode, $.NSDate.dateWithTimeIntervalSinceNow(1));
        if (playing()) { busy = Date.now(); idleSaid = false; }
        else if (!idleSaid && Date.now() - busy > idle * 1000) { idleSaid = true; soundSay('idle'); }    // lzrprf ends it when it has nothing unanswered for it, else it plays on
    }
    soundsClear(); Object.keys(soundVideos).forEach(soundVideoGone);
}
END

# The command of the sound process: the system's osascript in the sound
# container, under its limits, told its name, whether it plays at no volume
# ("lzrprf try"), and its idle seconds.                                 # [C12]
sub sounding {
    my ($quiet) = @_;
    return ('/bin/sh', '-c', $SOUND_LIMITS, 'lzrprf', contain($SOUND_CONTAINER, $SCRIPT), '-l', 'JavaScript', '-e', $SOUND_TEXT, $SOUND_NAME, $quiet ? 'quiet' : 'loud', $SOUND_IDLE);
}

sub sound_told {                          # [C12] sound lines of the page shown: with no window ("lzrprf try") printed for the test, else written to the sound process, started for them when it does not run
    my ($live, @lines) = @_;
    return window(@lines) unless $FROM;
    sound_started() or return;
    $SOUND->{out} .= join '', map { "$_\n" } @lines;
    push @{ $SOUND->{asked} }, map { /^sound play / ? $live->{url} : () } @lines;
    sound_flushed();
}

sub sound_started {                       # [C12] true when the sound process runs, started now when it did not; handed nothing before the system said it is contained [C3]; a start that fails is said in the log, once a window
    return 1 if $SOUND;
    my $fault = sub { record("no sound of a page is played: $_[0]") unless $SOUND_FAULTED++; return 0 };
    pipe(my $in, my $to) && pipe(my $from, my $out) or return $fault->('lzrprf could not make the pipes of its sound process');
    my $pid = fork // return $fault->('lzrprf could not start its sound process');
    become($in, $out, undef, sounding($TRY)) unless $pid;
    close $_ for $in, $out;
    if (!inside($pid)) { close $_ for $to, $from; ended($pid, 0); return $fault->('the system did not say that the sound process is contained, so it was handed nothing') }
    fcntl($_, POSIX::F_SETFL(), O_NONBLOCK) for $to, $from;
    $SOUND = { pid => $pid, to => $to, from => $from, out => '', in => '', asked => [], of => $$ };
    return 1;
}

sub sound_flushed {                       # [C12] what waits for the sound process, written as far as it takes it now; one that reads nothing more is ended
    return unless $SOUND && length $SOUND->{out};
    my $took = syswrite($SOUND->{to}, $SOUND->{out});
    if (defined $took && $took > 0) { substr($SOUND->{out}, 0, $took, '') }
    elsif (defined $took || (!$!{EAGAIN} && !$!{EINTR})) { sound_ended('it read no more of what it was handed') }
}

sub sound_heard {                         # [C12] what the sound process said, each line held to its form: a sound it did not play is said in the log, once a page
    my $got = sysread($SOUND->{from}, $SOUND->{in}, 4096, length $SOUND->{in});
    return if !defined $got && ($!{EINTR} || $!{EAGAIN});
    return sound_ended('it ended by itself') unless $got;
    while ($SOUND && (my $end = index($SOUND->{in}, "\n")) >= 0) {
        my $line = substr($SOUND->{in}, 0, $end + 1, '');
        chomp $line;
        next if $line eq 'ready';
        if ($line eq 'idle') { sound_ended() unless @{ $SOUND->{asked} } || length $SOUND->{out}; next }    # nothing it was handed is unanswered: it ends, and the next sound starts it again
        if (my ($key, $said) = $line =~ /^video ([0-9]{1,2} [0-9]{1,2}) ((?:yes|no|drift) [\x20-\x7e]{1,300})\z/) {    # [C22] a video's sound: whether it started, and how far it was from the picture at each clock
            print STDERR "sound $line\n" if $TRY;
            my $url = $SOUND->{videos}{$key} // next;
            record("the sound of the video $url is not heard: the system's player did not play it (" . substr($said, 3) . ')') if $said =~ /^no / && !$SOUND->{refused}{$url}++;
            next;
        }
        my ($n, $well, $what) = $line =~ /^played ([1-9][0-9]{0,9}) (yes|no) ([\x20-\x7e]{1,600})\z/ or return sound_ended('it said a line of no form');
        my $url = shift @{ $SOUND->{asked} } // return sound_ended('it answered a play it was not handed');
        print STDERR "sound $line\n" if $TRY;    # "lzrprf try" only: what the system's player said, for the test to read
        record("the page $url played a sound that is not heard: the system's player did not play it ($what)") if $well eq 'no' && !$SOUND->{refused}{$url}++;
    }
    sound_ended('it said a line too long') if $SOUND && length $SOUND->{in} > 4096;
}

sub video_sound_kept {                    # [C22] the MP4 of video K of the tab shown, as it was handed to the window, kept when it has a sound track, for the sound process if you turn its sound on; two at most, as the window holds
    my ($k, $body, $url) = @_;
    delete $VIDEO_SOUND{"$TAB $k"};
    return unless $$body =~ /hdlr.{8}soun/s;    # the handler of a sound track, in the MP4's description of its tracks
    my @held = sort { $VIDEO_SOUND{$a}{at} <=> $VIDEO_SOUND{$b}{at} } keys %VIDEO_SOUND;
    delete $VIDEO_SOUND{ shift @held } while @held >= 2;
    $VIDEO_SOUND{"$TAB $k"} = { body => $body, url => $url, at => now() };
}

sub video_sound_at {                      # [C22] the window's clock of video K, whose sound you turned on: its MP4 is handed to the sound process once, then each clock; "gone" lets it go here and there
    my ($k, $clock) = @_;
    my $key = "$TAB $k";
    my $held = $VIDEO_SOUND{$key};
    if ($clock =~ /^gone /) { delete $VIDEO_SOUND{$key}; return unless $SOUND && delete $SOUND->{videos}{$key} }
    elsif (!$held) { record("the video $k of the page shown has no sound lzrprf can hand to its sound process") if $clock =~ /^playing / && !$VIDEO_SOUND_SAID{$key}++; return }
    elsif (!$SOUND || !$SOUND->{videos}{$key}) {
        return if $clock =~ /^off /;
        sound_started() or return;
        my $body = $held->{body};
        $SOUND->{out} .= "video begin $key " . length($$body) . "\n";
        for (my $at = 0; $at < length $$body; $at += $VIDEO_FRAME) { $SOUND->{out} .= "video part $key " . encode_base64(substr($$body, $at, $VIDEO_FRAME), '') . "\n" }
        $SOUND->{out} .= "video end $key\n";
        $SOUND->{videos}{$key} = $held->{url};
    }
    $SOUND->{out} .= "video at $key $clock\n";
    sound_flushed();
}

sub sound_hushed {                        # [C12] another tab, a new page or no page kept running: every sound stops and goes, as the window let them go before
    return unless $SOUND;
    $SOUND->{out} .= "sound clear\n";
    delete $_->{sound_held} for @LIVE;
    delete $SOUND->{videos};              # a video's sound went with them; the window says when it is turned on again
    sound_flushed();
}

sub sound_ended {                         # [C12] the sound process is ended: its pipes closed, two seconds to end by itself, then killed; every page sends its sounds whole again; why, when it was not lzrprf's choice, said in the log
    my ($why) = @_;
    return unless $SOUND && $SOUND->{of} == $$;
    my $pid = $SOUND->{pid};
    close $_ for @$SOUND{qw(to from)};
    undef $SOUND;
    ended($pid, 2);
    delete $_->{sound_held} for @LIVE;
    record("the sound process ended: $why; a sound it was playing stopped") if defined $why;
}

# LZRTRMNL's panes, its tabs and its bar [C29]: the window chrome of a
# terminal, drawn by lzrprf as lines of a laid page around what each pane's
# container draws (24-trmnl.pl).
#
# A browser tab that is a terminal holds a workspace ($tab->{trmnl}): one or
# more terminal tabs, shown in a strip under a bar of two menus, File and
# View. Each terminal tab is a tree of panes. A leaf is one pane, a shell and
# its drawing container (sub trmnl_started); a split holds two parts, side by
# side ("right") or one above the other ("down"), and the share of the first
# in ten-thousandths. Splits nest, and every pane stays in the browser tab it
# was made in: a terminal's tab does not move to another window.
#
# What you do, and how lzrprf hears it:
#   a press on File or View: lzrprf hands the window that menu ("trmnlmenu X
#     Y" and its items), which shows it and says the item you chose ("page
#     menu ID"). An item is taken only when it was offered, and offered as one
#     that can be done, in the menu shown last, and once (sub trmnl_pressed);
#   a right press in the terminal ("page context X Y"): the pane under it gets
#     the focus, and its menu is offered there: the splits, Close pane, Copy
#     and Paste;
#   a key of the window's TRMNL_SHORTCUTS ("page tkey ID"), one of %TRMNL_KEYED;
#   a press on a terminal tab chooses it, on its x closes it, on + adds one;
#   a press on a divider, then a drag, moves it; a press in a pane gives it the
#     focus and starts a selection there, which a drag carries on.
#
# The keys, the common terminals' wherever the browser does not use the key
# for itself already (its menus: Cmd-D, Cmd-T, Cmd-W, Shift-Cmd-T, Cmd-[ and
# Cmd-], Cmd-Option-Left and Right, Ctrl-Tab):
#   Split right             Cmd-\              VS Code's split terminal
#   Split down              Shift-Cmd-D        iTerm2's split horizontally
#   Close pane              Shift-Cmd-W        Windows Terminal's Ctrl-Shift-W, with Cmd as on a Mac
#   Focus a pane            Shift-Cmd-arrow    iTerm2 and VS Code use Cmd-Option-arrow, which the browser's tabs hold
#   Move a divider          Ctrl-Cmd-arrow     iTerm2 and VS Code
#   Equalise sizes          Ctrl-Cmd-=
#   Add terminal tab        Ctrl-Shift-T       Windows Terminal
#   Close terminal tab      Ctrl-Shift-W
#   Next, previous tab      Ctrl-Page Down, Ctrl-Page Up (VS Code, Chrome); with Shift the tab moves
#   Save tabs and views     Cmd-S
#
# Save writes the workspace into the plain file trmnl of this profile's own
# folder (sub trmnl_saved): the terminal tabs in their order, the one shown,
# each tab's number, its tree with every split's direction and share, the pane
# with the focus, and each pane's working folder, which the system says of
# its shell (sub trmnl_cwd). No title a program set, nothing typed and nothing
# shown is written. Opening LZRTRMNL again lays out exactly that (sub
# trmnl_workspace): each pane a new login shell, started in its folder, or in
# the home folder when that folder is gone. A shell that ended cannot be
# brought back, and a new one in the same place is what the common terminals
# restore too.
my $TRMNL_TABS = 9;                       # the most terminal tabs in one LZRTRMNL
my $TRMNL_PANES = 16;                     # the most panes in all its tabs together: each is a shell and a container of about 2 MB
my $TRMNL_BAR = 24;                       # the height of the bar of File and View, in points
my $TRMNL_STRIP = 26;                     # the height of the strip of terminal tabs under it
my $TRMNL_EDGE = 2;                       # the frame round each pane: two panes side by side have 4 points between them, and the focused one's frame is in the beam colour
my @TRMNL_LEAST = (96, 48);               # the smallest pane, in points: 12 columns and 3 rows. A split that would make a pane smaller is not made, and a divider stops there
my @TRMNL_STEP = (8, 16);                 # how far a key moves a divider: a column, a row
my $TRMNL_SAVED = 65_536;                 # the most bytes of the saved file
my $TRMNL_TAB_WIDE = 180;                 # the widest a terminal tab is drawn in the strip
my %TRMNL_INK = (page => '0c0f12ff', bar => '161b20ff', strip => '101418ff', line => '2a323aff', frame => '1d2329ff', focus => '48ddffff', shade => '0c0f1273', text => 'd6dde3', dim => '7f8b96');
my @TRMNL_MENUS = (['file', 'File', 4, 44], ['view', 'View', 48, 48]);    # each menu of the bar: its name, its word, where it starts and how wide its press is
my %TRMNL_SAID = ('tab-new' => 'Add terminal tab', 'tab-close' => 'Close current terminal tab', save => 'Save tabs and views', forget => 'Forget saved tabs and views',
    'tab-next' => 'Next terminal tab', 'tab-prev' => 'Previous terminal tab', 'tab-left' => 'Move terminal tab left', 'tab-right' => 'Move terminal tab right',
    'split-right' => 'Split right', 'split-down' => 'Split down', 'close-pane' => 'Close pane', equalise => 'Equalise sizes', copy => 'Copy', paste => 'Paste',
    'focus-left' => 'Focus pane to the left', 'focus-right' => 'Focus pane to the right', 'focus-up' => 'Focus pane above', 'focus-down' => 'Focus pane below',
    'size-left' => 'Move divider left', 'size-right' => 'Move divider right', 'size-up' => 'Move divider up', 'size-down' => 'Move divider down');
my %TRMNL_KEYED = map { $_ => 1 } qw(split-right split-down close-pane focus-left focus-right focus-up focus-down size-left size-right size-up size-down equalise tab-new tab-close tab-next tab-prev tab-left tab-right save);    # DECLARED(the window's TRMNL_SHORTCUTS)

sub trmnl_leaves { my ($node) = @_; return $node->{split} ? (trmnl_leaves($node->{a}), trmnl_leaves($node->{b})) : ($node) }    # the panes of a tree, left to right and top to bottom
sub trmnl_panes { my ($w) = @_; return map { trmnl_leaves($_->{tree}) } @{ $w->{tabs} } }    # every pane of a workspace, in all its terminal tabs
sub trmnl_shown_tab { my ($w) = @_; return $w->{tabs}[$w->{at}] }    # the terminal tab shown

sub trmnl_path {                          # the splits from the top of a tree down to one of its panes, each with the side the pane is on; nothing when it is not in the tree
    my ($node, $leaf) = @_;
    return [] if $node == $leaf;
    return unless $node->{split};
    for my $side (qw(a b)) { my $below = trmnl_path($node->{$side}, $leaf) or next; return [[$node, $side], @$below] }
    return;
}

sub trmnl_replaced {                      # one part of a terminal tab's tree put in another's place
    my ($tt, $old, $new) = @_;
    return $tt->{tree} = $new if $tt->{tree} == $old;
    my $path = trmnl_path($tt->{tree}, $old) or return;
    my ($parent, $side) = @{ $path->[-1] };
    $parent->{$side} = $new;
}

# Where everything stands. The page is the window's page as it is, as a
# terminal's always was (@TRMNL_VIEW); the bar and the strip take its top, and
# each terminal tab's tree is laid in the rest: a split gives its first part
# its share of the length across, held so both parts keep their least size
# where there is room for both. A pane's cell is its place with its frame; its
# rectangle, the cell less the frame, is what its container draws in.
sub trmnl_page {
    my ($wide, $high) = @TRMNL_VIEW ? @TRMNL_VIEW : @VIEW;
    $wide = $wide < 240 ? 240 : $wide > 8192 ? 8192 : $wide;
    $high = $high < 160 ? 160 : $high > 8192 ? 8192 : $high;
    return ($wide, $high);
}

sub trmnl_least {                         # the least width and height a tree is laid in
    my ($node) = @_;
    return ($TRMNL_LEAST[0] + 2 * $TRMNL_EDGE, $TRMNL_LEAST[1] + 2 * $TRMNL_EDGE) unless $node->{split};
    my ($aw, $ah) = trmnl_least($node->{a});
    my ($bw, $bh) = trmnl_least($node->{b});
    return $node->{split} eq 'right' ? ($aw + $bw, $ah > $bh ? $ah : $bh) : ($aw > $bw ? $aw : $bw, $ah + $bh);
}

sub trmnl_held {                          # where a split's divider may stand in a length $all, from where it would: both parts at least their least size when there is room for both
    my ($split, $first, $all) = @_;
    my $i = $split->{split} eq 'right' ? 0 : 1;
    my ($a, $b) = ((trmnl_least($split->{a}))[$i], (trmnl_least($split->{b}))[$i]);
    if ($a + $b <= $all) { $first = $a if $first < $a; $first = $all - $b if $first > $all - $b }
    else { $first = int($all / 2) }
    return $first < 1 ? 1 : $first;
}

sub trmnl_place {                         # a tree laid in the cell X Y WIDE HIGH
    my ($node, $x, $y, $wide, $high) = @_;
    $node->{cell} = [$x, $y, $wide, $high];
    if (!$node->{split}) {
        my @rect = ($x + $TRMNL_EDGE, $y + $TRMNL_EDGE, $wide - 2 * $TRMNL_EDGE, $high - 2 * $TRMNL_EDGE);
        $_ = $_ < 1 ? 1 : $_ for @rect[2, 3];
        $node->{rect} = \@rect;
        return;
    }
    my $right = $node->{split} eq 'right';
    my $all = $right ? $wide : $high;
    my $first = $node->{at} = trmnl_held($node, int($all * $node->{share} / 10_000 + 0.5), $all);
    trmnl_place($node->{a}, $x, $y, $right ? ($first, $high) : ($wide, $first));
    trmnl_place($node->{b}, $right ? ($x + $first, $y, $wide - $first, $high) : ($x, $y + $first, $wide, $high - $first));
}

sub trmnl_layout {                        # every terminal tab of a workspace laid in the page, and each pane's container told its size (sub trmnl_sized)
    my ($w) = @_;
    my ($wide, $high) = trmnl_page();
    trmnl_place($_->{tree}, 0, $TRMNL_BAR + $TRMNL_STRIP, $wide, $high - $TRMNL_BAR - $TRMNL_STRIP) for @{ $w->{tabs} };
    trmnl_sized($_) for trmnl_panes($w);
}

sub trmnl_relaid {                        # a workspace laid out again and drawn: after a split, a close, a divider moved, another tab or another size of the window
    my ($tab) = @_;
    my $w = $tab->{trmnl} or return;
    trmnl_layout($w);
    trmnl_retitled($tab);
    trmnl_drawn($tab);
}

sub trmnl_span {                          # how wide each terminal tab is drawn in the strip, with room for + after them
    my ($w, $wide) = @_;
    my $span = int(($wide - 32) / @{ $w->{tabs} });
    return $span > $TRMNL_TAB_WIDE ? $TRMNL_TAB_WIDE : $span < 48 ? 48 : $span;
}

sub trmnl_label {                         # what a terminal tab is called: the title its focused pane's program set, or its number
    my ($tt) = @_;
    return $tt->{focus}{title} // "Terminal $tt->{number}";
}

sub trmnl_fitted {                        # text cut to at most $most characters, an ellipsis at its end when it was cut; bytes of UTF-8 in and out
    my ($text, $most) = @_;
    my $chars = $text;
    utf8::decode($chars);
    $most = 1 if $most < 1;
    $chars = substr($chars, 0, $most - 1) . "\x{2026}" if length $chars > $most;
    utf8::encode($chars);
    return $chars;
}

sub trmnl_chrome {                        # the lines of the bar, with File and View, and of the strip of terminal tabs, the one shown marked, each with its x and + after them
    my ($w, $wide) = @_;
    my @lines = ("R0,0,$wide,$TRMNL_BAR,$TRMNL_INK{bar}", "R0," . ($TRMNL_BAR - 1) . ",$wide,1,$TRMNL_INK{line}");
    push @lines, 'X' . ($_->[2] + 10) . ",16,12,\@,$TRMNL_INK{text},$_->[1]" for @TRMNL_MENUS;
    my ($top, $base, $span) = ($TRMNL_BAR, $TRMNL_BAR + 17, trmnl_span($w, $wide));
    push @lines, "R0,$top,$wide,$TRMNL_STRIP,$TRMNL_INK{strip}";
    my $x = "\x{d7}";
    utf8::encode($x);
    for my $i (0 .. $#{ $w->{tabs} }) {
        my ($left, $shown) = ($i * $span, $i == $w->{at});
        push @lines, "R$left,$top,$span,$TRMNL_STRIP,$TRMNL_INK{page}", "R$left,$top,$span,2,$TRMNL_INK{focus}" if $shown;
        push @lines, 'R' . ($left + $span - 1) . ',' . ($top + 5) . ",1,16,$TRMNL_INK{line}";
        push @lines, 'X' . ($left + 10) . ",$base,12," . ($shown ? "A,$TRMNL_INK{text}" : "\@,$TRMNL_INK{dim}") . ',' . trmnl_fitted(trmnl_label($w->{tabs}[$i]), int(($span - 34) / 7));
        push @lines, 'X' . ($left + $span - 18) . ",$base,12,\@,$TRMNL_INK{dim},$x";
    }
    push @lines, 'X' . (@{ $w->{tabs} } * $span + 10) . ",$base,14,\@,$TRMNL_INK{dim},+";
    return @lines;
}

sub trmnl_moved {                         # the lines of a pane's row moved to where its rectangle stands, and cut to it
    my ($lines, $x0, $y0, $wide, $high) = @_;
    my @moved;
    for (@$lines) {
        if (/^R([0-9]+),([0-9]+),([0-9]+),([0-9]+),([0-9a-f]{8})$/) {
            my ($x, $y, $w, $h) = ($1, $2, $3, $4);
            next if $x >= $wide || $y >= $high;
            $w = $wide - $x if $x + $w > $wide;
            $h = $high - $y if $y + $h > $high;
            push @moved, 'R' . ($x + $x0) . ',' . ($y + $y0) . ",$w,$h,$5";
        }
        elsif (/^X([0-9]+),([0-9]+),(.*)\z/s) { push @moved, 'X' . ($1 + $x0) . ',' . ($2 + $y0) . ",$3" unless $1 >= $wide || $2 > $high }
    }
    return \@moved;
}

# The page of a workspace: the bar, the strip, and the panes of the terminal
# tab shown, each in its frame, the focused one's in the beam colour, and the
# others shaded when there is more than one. Within a laid page's bounds: a
# row that would take the page past them is left out, and the window is told
# so once. Gives the list, and whether a row was left out.
sub trmnl_composed {
    my ($w) = @_;
    my ($wide, $high) = trmnl_page();
    my $tt = trmnl_shown_tab($w);
    my @leaves = trmnl_leaves($tt->{tree});
    my @list = ("L${wide}x$high", "R0,0,$wide,$high,$TRMNL_INK{page}", trmnl_chrome($w, $wide));
    my ($r, $x, $text, $cut) = (scalar(@list) + 3 * @leaves, scalar(@list), 0, 0);
    $text += length for @list;
    for my $t (@leaves) {
        my ($cell, $rect) = @$t{qw(cell rect)};
        next unless $cell && $rect;
        push @list, 'R' . join(',', @$cell) . ',' . (@leaves > 1 && $t == $tt->{focus} ? $TRMNL_INK{focus} : $TRMNL_INK{frame}), 'R' . join(',', @$rect) . ",$TRMNL_INK{page}";
        my $at = "@$rect";
        @$t{qw(moved moved_at)} = ([], $at) if ($t->{moved_at} // '') ne $at;
        for my $n (0 .. $#{ $t->{rows} // [] }) {
            my ($row, $tally) = ($t->{rows}[$n], $t->{tally}[$n]);
            next unless $row && $tally;
            if ($r + $tally->[0] > $LAID{R} || $x + $tally->[1] > $LAID{X} || $text + $tally->[2] > $ALL_TEXT) { $cut = 1; next }
            ($r, $x, $text) = ($r + $tally->[0], $x + $tally->[1], $text + $tally->[2]);
            push @list, @{ $t->{moved}[$n] //= trmnl_moved($row, @$rect) };
        }
    }
    push @list, map { 'R' . join(',', @{ $_->{rect} }) . ",$TRMNL_INK{shade}" } grep { $_ != $tt->{focus} && $_->{rect} } @leaves if @leaves > 1;
    return (\@list, $cut);
}

sub trmnl_retitled {                      # the browser tab's title: the title the focused pane's program set, or LZRTRMNL
    my ($tab) = @_;
    my $w = $tab->{trmnl} or return;
    my $title = trmnl_shown_tab($w)->{focus}{title} // 'LZRTRMNL';
    return if $title eq ($tab->{title} // '');
    $tab->{title} = $title;
    my ($n) = grep { $TABS[$_] == $tab } 0 .. $#TABS;
    window("title $n $title") if defined $n;
}

# A new workspace: the tabs and views saved for this profile, laid out as they
# were saved, or one terminal tab of one pane when none was saved or what was
# saved cannot be read. Gives the workspace, or nothing and why in full.
sub trmnl_workspace {
    my $w = { tabs => [], at => 0, started => [] };
    my $kept = trmnl_kept();
    if ($kept) {
        for my $one (@{ $kept->{tabs} }) {
            my $tree = trmnl_grown($w, $one->{tree});
            if (!$tree) { trmnl_pane_end($_) for @{ $w->{started} }; return (undef, "LZRTRMNL could not be started: $w->{why}. No shell was started.") }
            my @leaves = trmnl_leaves($tree);
            push @{ $w->{tabs} }, { tree => $tree, focus => $leaves[$one->{focus}], number => $one->{number} };
        }
        $w->{at} = $kept->{at};
        delete $w->{started};
        noted('LZRTRMNL opened the tabs and views saved for this profile');
        return $w;
    }
    my ($t, $why) = trmnl_pane_new($w, undef);
    return (undef, "LZRTRMNL could not be started: $why. No shell was started.") unless $t;
    push @{ $w->{tabs} }, { tree => $t, focus => $t, number => 1 };
    delete $w->{started};
    return $w;
}

sub trmnl_grown {                         # a saved tree with each of its panes started; nothing when one could not be, and why in $w->{why}
    my ($w, $node) = @_;
    if ($node->{split}) {
        my $a = trmnl_grown($w, $node->{a}) or return;
        my $b = trmnl_grown($w, $node->{b}) or return;
        return { split => $node->{split}, share => $node->{share}, a => $a, b => $b };
    }
    my ($t, $why) = trmnl_pane_new($w, $node->{cwd});
    $w->{why} = $why unless $t;
    return $t;
}

sub trmnl_pane_new {                      # a pane: its container started now, its shell once the container says its size, in the folder $cwd (the home folder when that is none or gone)
    my ($w, $cwd) = @_;
    my @panes = $w->{started} ? @{ $w->{started} } : trmnl_panes($w);    # while a saved workspace is laid out, the panes started so far
    return (undef, "LZRTRMNL holds $TRMNL_PANES panes at most") if @panes >= $TRMNL_PANES;
    my ($program, $why) = trmnl_program();
    return (undef, $why) unless $program;
    my ($t, $fault) = trmnl_started($program, defined $cwd && -d $cwd ? $cwd : undef);
    return (undef, $fault) unless $t;
    push @{ $w->{started} }, $t if $w->{started};
    return $t;
}

# What the window says of a press, a drag, a right press, an item of a menu
# and a key of the list, in a terminal's tab [C29].
sub trmnl_pressed {
    my ($tab, $what) = @_;
    my $w = $tab->{trmnl} or return;
    if ($what =~ /^click ([0-9]+) ([0-9]+)$/) { return trmnl_clicked($tab, 0 + $1, 0 + $2) }
    if ($what =~ /^drag ([0-9]+) ([0-9]+)$/) { return trmnl_dragged($tab, 0 + $1, 0 + $2) }
    if ($what =~ /^context ([0-9]+) ([0-9]+)$/) {
        my ($x, $y) = (0 + $1, 0 + $2);
        my $t = trmnl_pane_at($w, $x, $y) or return;
        trmnl_focused($tab, $t);
        return trmnl_menu_offered($w, "pane", $x, $y);
    }
    if ($what =~ /^menu ([a-z-]+)$/) { my ($id, $offered) = ($1, delete $w->{offered}); return $offered && $offered->{$id} ? trmnl_act($tab, $id) : undef }    # only what the menu shown last offered as one that can be done, and once
    if ($what =~ /^tkey ([a-z-]+)$/ && $TRMNL_KEYED{$1}) { return trmnl_act($tab, $1) }
}

sub trmnl_pane_at { my ($w, $x, $y) = @_; my ($t) = grep { my $c = $_->{cell}; $c && $x >= $c->[0] && $y >= $c->[1] && $x < $c->[0] + $c->[2] && $y < $c->[1] + $c->[3] } trmnl_leaves(trmnl_shown_tab($w)->{tree}); return $t }    # the pane of the tab shown whose cell holds a point

sub trmnl_divider_at {                    # the split whose divider is within 3 points of a point, the deepest first
    my ($node, $x, $y) = @_;
    return unless $node->{split};
    for my $side (qw(a b)) { my $below = trmnl_divider_at($node->{$side}, $x, $y); return $below if $below }
    my ($cx, $cy, $cw, $ch) = @{ $node->{cell} // return };
    return $node if $node->{split} eq 'right' ? abs($x - $cx - $node->{at}) <= 3 && $y >= $cy && $y < $cy + $ch : abs($y - $cy - $node->{at}) <= 3 && $x >= $cx && $x < $cx + $cw;
    return;
}

sub trmnl_clicked {
    my ($tab, $x, $y) = @_;
    my $w = $tab->{trmnl};
    delete $w->{press};
    my ($wide) = trmnl_page();
    if ($y < $TRMNL_BAR) {
        for (@TRMNL_MENUS) { my ($menu, undef, $left, $span) = @$_; return trmnl_menu_offered($w, $menu, $left, $TRMNL_BAR) if $x >= $left && $x < $left + $span }
        return;
    }
    if ($y < $TRMNL_BAR + $TRMNL_STRIP) {
        my $span = trmnl_span($w, $wide);
        my $i = int($x / $span);
        return trmnl_act($tab, 'tab-new') if $i == @{ $w->{tabs} } && $x - $i * $span < 30;
        return unless $i < @{ $w->{tabs} };
        return trmnl_tab_closed($tab, $i) if $x >= ($i + 1) * $span - 24;
        return trmnl_tab_chosen($tab, $i);
    }
    my $tt = trmnl_shown_tab($w);
    if (my $split = trmnl_divider_at($tt->{tree}, $x, $y)) { $w->{press} = { split => $split }; return }
    my $t = trmnl_pane_at($w, $x, $y) or return;
    trmnl_focused($tab, $t) if $t != $tt->{focus};
    $w->{press} = { pane => $t };
    $t->{pressed}++ if $t->{mouse} && $t->{pressed} < 8;    # a press of yours while the shell asked for presses: its container may answer it with =mouse once (sub trmnl_reported)
    trmnl_inside($t, 'p', $x, $y);
}

sub trmnl_inside { my ($t, $what, $x, $y) = @_; my ($px, $py, $pw, $ph) = @{ $t->{rect} }; ($x, $y) = ($x - $px, $y - $py); $x = $x < 0 ? 0 : $x >= $pw ? $pw - 1 : $x; $y = $y < 0 ? 0 : $y >= $ph ? $ph - 1 : $y; trmnl_send($t, "$what $x $y\n") if $t->{to} }    # a press or a drag to a pane's container, in its own points, held inside it

sub trmnl_dragged {                       # a drag after a press: a divider moved with it, or the pane's selection carried on
    my ($tab, $x, $y) = @_;
    my $w = $tab->{trmnl};
    my $press = $w->{press} or return;
    return trmnl_inside($press->{pane}, 'g', $x, $y) if $press->{pane} && !$press->{pane}{ended};
    my $split = $press->{split} or return;
    my ($cx, $cy, $cw, $ch) = @{ $split->{cell} };
    trmnl_shared($split, $split->{split} eq 'right' ? $x - $cx : $y - $cy);
    trmnl_relaid($tab);
}

sub trmnl_shared {                        # a split's share, from where its divider is to stand
    my ($split, $first) = @_;
    my $all = $split->{cell}[$split->{split} eq 'right' ? 2 : 3];
    return if $all < 2;
    my $share = int(trmnl_held($split, $first, $all) * 10_000 / $all + 0.5);
    $split->{share} = $share < 1 ? 1 : $share > 9999 ? 9999 : $share;
}

sub trmnl_focused {                       # a pane given the focus: its frame drawn in the beam colour, the keys go to its shell
    my ($tab, $t) = @_;
    my $tt = trmnl_shown_tab($tab->{trmnl});
    $tt->{focus} = $t;
    trmnl_retitled($tab);
    trmnl_drawn($tab);
}

sub trmnl_neighbour {                     # the pane beside the focused one in a direction: of those wholly that way that overlap it across, the nearest, then the one that overlaps most
    my ($tt, $way) = @_;
    my ($fx, $fy, $fw, $fh) = @{ $tt->{focus}{cell} // return };
    my ($best, $gap_best, $over_best);
    for my $t (trmnl_leaves($tt->{tree})) {
        next if $t == $tt->{focus} || !$t->{cell};
        my ($x, $y, $w, $h) = @{ $t->{cell} };
        my ($gap, $low, $high) = $way eq 'left' ? ($fx - $x - $w, $y, $y + $h) : $way eq 'right' ? ($x - $fx - $fw, $y, $y + $h) : $way eq 'up' ? ($fy - $y - $h, $x, $x + $w) : ($y - $fy - $fh, $x, $x + $w);
        my ($flow, $fhigh) = $way =~ /left|right/ ? ($fy, $fy + $fh) : ($fx, $fx + $fw);
        my $over = ($high < $fhigh ? $high : $fhigh) - ($low > $flow ? $low : $flow);
        next if $gap < 0 || $over <= 0;
        ($best, $gap_best, $over_best) = ($t, $gap, $over) if !$best || $gap < $gap_best || $gap == $gap_best && $over > $over_best;
    }
    return $best;
}

sub trmnl_divider_for {                   # the divider a key in a direction moves: the nearest above the focused pane that runs across that way
    my ($tt, $way) = @_;
    my $path = trmnl_path($tt->{tree}, $tt->{focus}) or return;
    my $dir = $way =~ /left|right/ ? 'right' : 'down';
    my ($split) = grep { $_->{split} eq $dir } map { $_->[0] } reverse @$path;
    return $split;
}

sub trmnl_across { my ($node, $dir) = @_; return 1 unless $node->{split}; my ($a, $b) = (trmnl_across($node->{a}, $dir), trmnl_across($node->{b}, $dir)); return $node->{split} eq $dir ? $a + $b : $a > $b ? $a : $b }    # how many panes stand side by side in a tree, across a direction

sub trmnl_even {                          # Equalise sizes: every split's share set so the panes side by side across it share its length alike
    my ($node) = @_;
    return unless $node->{split};
    my ($a, $b) = (trmnl_across($node->{a}, $node->{split}), trmnl_across($node->{b}, $node->{split}));
    $node->{share} = int(10_000 * $a / ($a + $b) + 0.5);
    trmnl_even($_) for @$node{qw(a b)};
}

sub trmnl_splits {                        # whether the focused pane can be split that way: a pane left to be had, and room for two
    my ($w, $way) = @_;
    my @panes = trmnl_panes($w);
    return 0 if @panes >= $TRMNL_PANES;
    my $cell = trmnl_shown_tab($w)->{focus}{cell} or return 1;
    my $i = $way eq 'right' ? 0 : 1;
    return $cell->[2 + $i] >= 2 * ($TRMNL_LEAST[$i] + 2 * $TRMNL_EDGE) ? 1 : 0;
}

# The menus: File, View, and a pane's own (its right press). Each item is
# offered as one that can be done (1) or not (0), with a line ("-") between
# groups; the window shows each item's key beside it from its own list.
sub trmnl_items {
    my ($w, $menu) = @_;
    my $tt = trmnl_shown_tab($w);
    my @panes = trmnl_panes($w);
    my @here = trmnl_leaves($tt->{tree});
    my $tabs = @{ $w->{tabs} };
    my %can = ('tab-new' => $tabs < $TRMNL_TABS && @panes < $TRMNL_PANES, 'tab-close' => $tabs > 1, 'tab-next' => $tabs > 1, 'tab-prev' => $tabs > 1, 'tab-left' => $w->{at} > 0, 'tab-right' => $w->{at} < $tabs - 1,
        save => 1, forget => -e trmnl_file() ? 1 : 0, 'split-right' => trmnl_splits($w, 'right'), 'split-down' => trmnl_splits($w, 'down'), "close-pane" => @here > 1 || $tabs > 1, equalise => @here > 1, copy => 1, paste => 1,
        map { ("focus-$_" => trmnl_neighbour($tt, $_) ? 1 : 0, "size-$_" => trmnl_divider_for($tt, $_) ? 1 : 0) } qw(left right up down));
    my @ids = $menu eq 'file' ? qw(tab-new tab-close - tab-next tab-prev tab-left tab-right - save forget)
        : $menu eq 'view' ? qw(split-right split-down - close-pane - focus-left focus-right focus-up focus-down - size-left size-right size-up size-down - equalise)
        : qw(split-right split-down - close-pane - copy paste);
    return map { $_ eq '-' ? '-' : [$_, $can{$_} ? 1 : 0] } @ids;
}

sub trmnl_menu_offered {                  # a menu handed to the window to show at a point of the page; the items it may say back, kept until the next menu or the item chosen
    my ($w, $menu, $x, $y) = @_;
    my @items = trmnl_items($w, $menu);
    $w->{offered} = { map { ref && $_->[1] ? ($_->[0] => 1) : () } @items };
    window("trmnlmenu $x $y\t" . join("\t", map { ref ? "$_->[0]|$TRMNL_SAID{$_->[0]}|$_->[1]" : '-' } @items));
}

sub trmnl_act {                           # [C29] what an item of a menu, or its key, does
    my ($tab, $id) = @_;
    my $w = $tab->{trmnl} or return;
    my $tt = trmnl_shown_tab($w);
    my @here = trmnl_leaves($tt->{tree});
    if ($id =~ /^split-(right|down)$/) { return trmnl_split($tab, $1) }
    if ($id eq 'close-pane') { return trmnl_pane_closed($tab, $tt->{focus}) }    # the last pane of a terminal tab closes the tab, and the last tab stays
    if ($id =~ /^focus-(left|right|up|down)$/) { my $t = trmnl_neighbour($tt, $1) or return; return trmnl_focused($tab, $t) }
    if ($id =~ /^size-(left|right|up|down)$/) {
        my $way = $1;
        my $split = trmnl_divider_for($tt, $way) or return;
        my $i = $split->{split} eq "right" ? 0 : 1;
        trmnl_shared($split, $split->{at} + ($way =~ /left|up/ ? -1 : 1) * $TRMNL_STEP[$i]);
        return trmnl_relaid($tab);
    }
    if ($id eq 'equalise') { trmnl_even($tt->{tree}); return trmnl_relaid($tab) }
    if ($id eq 'tab-new') { return trmnl_tab_added($tab) }
    if ($id eq 'tab-close') { return trmnl_tab_closed($tab, $w->{at}) }
    if ($id =~ /^tab-(next|prev)$/) { return trmnl_tab_chosen($tab, ($w->{at} + ($1 eq 'next' ? 1 : -1)) % @{ $w->{tabs} }) }
    if ($id =~ /^tab-(left|right)$/) {
        my $to = $w->{at} + ($1 eq 'left' ? -1 : 1);
        return unless $to >= 0 && $to < @{ $w->{tabs} };
        @{ $w->{tabs} }[$w->{at}, $to] = @{ $w->{tabs} }[$to, $w->{at}];
        $w->{at} = $to;
        return trmnl_drawn($tab);
    }
    if ($id eq 'save') { return trmnl_saved($tab) }
    if ($id eq 'forget') { unlink trmnl_file(); return aside('The saved tabs and views were forgotten: LZRTRMNL opens one shell from now on.') }
}

sub trmnl_split {                         # [C29] the focused pane split in two: a new shell beside it or under it, in the folder its shell is in, with the focus
    my ($tab, $way) = @_;
    my $w = $tab->{trmnl};
    my $tt = trmnl_shown_tab($w);
    my $old = $tt->{focus};
    return aside("No pane was added: LZRTRMNL holds $TRMNL_PANES panes at most, or this pane has no room for two.") unless trmnl_splits($w, $way);
    my ($t, $why) = trmnl_pane_new($w, trmnl_cwd($old));
    return aside("No pane was added: $why.") unless $t;
    trmnl_replaced($tt, $old, { split => $way, share => 5000, a => $old, b => $t });
    $tt->{focus} = $t;
    trmnl_relaid($tab);
}

sub trmnl_pane_closed {                   # [C29] a pane closed: its shell hung up and its container ended, and the part beside it takes its place and the focus. The last pane of a terminal tab closes the tab
    my ($tab, $t) = @_;
    my $w = $tab->{trmnl};
    my ($i) = grep { my $tt = $w->{tabs}[$_]; grep { $_ == $t } trmnl_leaves($tt->{tree}) } 0 .. $#{ $w->{tabs} };
    return unless defined $i;
    my $tt = $w->{tabs}[$i];
    return trmnl_tab_closed($tab, $i) if $tt->{tree} == $t;
    my $path = trmnl_path($tt->{tree}, $t);
    my ($parent, $side) = @{ $path->[-1] };
    my $other = $parent->{$side eq 'a' ? 'b' : 'a'};
    trmnl_replaced($tt, $parent, $other);
    trmnl_pane_end($t);
    my @near = trmnl_leaves($other);
    $tt->{focus} = $side eq 'a' ? $near[0] : $near[-1] if $tt->{focus} == $t;
    trmnl_relaid($tab);
}

sub trmnl_tab_added {                     # [C29] Add terminal tab: one pane, a new shell in your home folder, after the others and shown
    my ($tab) = @_;
    my $w = $tab->{trmnl};
    return aside("LZRTRMNL holds $TRMNL_TABS terminal tabs at most: close one to add another.") if @{ $w->{tabs} } >= $TRMNL_TABS;
    my ($t, $why) = trmnl_pane_new($w, undef);
    return aside("No terminal tab was added: $why.") unless $t;
    my %used = map { $_->{number} => 1 } @{ $w->{tabs} };
    my $number = 1;
    $number++ while $used{$number};
    push @{ $w->{tabs} }, { tree => $t, focus => $t, number => $number };
    $w->{at} = $#{ $w->{tabs} };
    trmnl_relaid($tab);
}

sub trmnl_tab_closed {                    # [C29] Close current terminal tab, or the x of one: the shells of all its panes hung up. The last one stays: the browser tab is closed instead
    my ($tab, $i) = @_;
    my $w = $tab->{trmnl};
    return aside('This is the last terminal tab of LZRTRMNL: close the browser tab to end it.') if @{ $w->{tabs} } <= 1;
    my ($tt) = splice @{ $w->{tabs} }, $i, 1;
    trmnl_pane_end($_) for trmnl_leaves($tt->{tree});
    $w->{at}-- if $w->{at} > $i || $w->{at} >= @{ $w->{tabs} };
    trmnl_relaid($tab);
}

sub trmnl_tab_chosen { my ($tab, $i) = @_; my $w = $tab->{trmnl}; return if $i == $w->{at}; $w->{at} = $i; delete $w->{press}; trmnl_relaid($tab) }    # a terminal tab shown; the shells of the others run on, drawn when shown again

# Saving and reading the tabs and views. The file is lines of one form each:
#   lzrtrmnl 1
#   at N                      the terminal tab shown, from 0
#   tab NUMBER FOCUS          a terminal tab, in its order: its number, and its focused pane among its panes, from 0
#   split right|down SHARE    a split, its first part's share in ten-thousandths (1 to 9999), then its two parts
#   pane FOLDER               a pane: its shell's working folder, its bytes outside A-Z a-z 0-9 / . _ ~ + - as %XX, or - for none
#   end
sub trmnl_file { return "$DIR/trmnl" }    # in this profile's own folder: never in an incognito or Tor window, where no terminal opens

sub trmnl_cwd {                           # the folder a pane's shell works in now, as the system says it (proc_pidinfo, PROC_PIDVNODEPATHINFO, for a process of yours: no question is asked); the folder it was started in when it cannot say
    my ($t) = @_;
    return $t->{cwd} unless $t->{shell};
    my $info = "\0" x 2352;               # struct proc_vnodepathinfo: the working folder's vnode_info (152 bytes) and its path (1024), then the root's
    return $t->{cwd} unless syscall(336, 2, $t->{shell}, 9, 0, $info, 2352) == 2352;    # proc_info, PROC_INFO_CALL_PIDINFO, PROC_PIDVNODEPATHINFO
    my $cwd = unpack 'Z*', substr($info, 152, 1024);
    return $cwd =~ m{\A/[^\x00-\x1f\x7f]{0,1023}\z} && -d $cwd ? $cwd : $t->{cwd};
}

sub trmnl_tree_lines {                     # the lines of a tree, its splits before their parts
    my ($node) = @_;
    return ("split $node->{split} $node->{share}", map { trmnl_tree_lines($_) } @$node{qw(a b)}) if $node->{split};
    my $cwd = trmnl_cwd($node);
    return "pane " . (defined $cwd ? $cwd =~ s/([^A-Za-z0-9\/._~+-])/sprintf '%%%02X', ord $1/ger : "-");
}

sub trmnl_written {                       # the lines a workspace is saved as
    my ($w) = @_;
    my @lines = ('lzrtrmnl 1', "at $w->{at}");
    for my $tt (@{ $w->{tabs} }) {
        my @leaves = trmnl_leaves($tt->{tree});
        my ($focus) = grep { $leaves[$_] == $tt->{focus} } 0 .. $#leaves;
        push @lines, "tab $tt->{number} " . ($focus // 0), trmnl_tree_lines($tt->{tree});
    }
    return (@lines, 'end');
}

sub trmnl_saved {                         # [C29] Save tabs and views: the workspace written into the plain file trmnl of this profile's folder, in place of what was there
    my ($tab) = @_;
    my $w = $tab->{trmnl};
    my $file = trmnl_file();
    unlink "$file.new";
    return aside('The tabs and views could not be saved: their file could not be written. Nothing was changed.') unless put("$file.new", O_EXCL, trmnl_written($w)) && rename("$file.new", $file);
    synced();
    my @panes = trmnl_panes($w);
    my $tabs = @{ $w->{tabs} };
    noted("LZRTRMNL saved $tabs terminal tabs and " . @panes . ' panes for this profile');
    aside('Saved ' . ($tabs == 1 ? '1 terminal tab' : "$tabs terminal tabs") . ' and ' . (@panes == 1 ? '1 pane' : @panes . ' panes') . ', with their folders: LZRTRMNL opens them so the next time.');
}

sub trmnl_kept {                          # the tabs and views saved for this profile, read and checked; nothing when there are none or they are not of their one form
    sysopen(my $in, trmnl_file(), O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return;
    my @is = stat $in;
    return unless -f _ && $is[4] == $< && $is[7] <= $TRMNL_SAVED;
    my $text = '';
    while (length $text <= $TRMNL_SAVED) { my $got = sysread($in, $text, 16_384, length $text); last unless $got }
    my $kept = length $text <= $TRMNL_SAVED && $text =~ /\n\z/ ? trmnl_read_saved(split /\n/, $text) : undef;
    aside('The saved tabs and views could not be read, so LZRTRMNL opened one shell.') unless $kept;
    return $kept;
}

sub trmnl_read_saved {                    # the saved lines, checked: { at, tabs => [{ number, focus, tree }] } with each pane's folder, or nothing
    my @lines = @_;
    return unless @lines >= 5 && shift(@lines) eq 'lzrtrmnl 1' && pop(@lines) eq 'end';
    my ($at) = shift(@lines) =~ /^at ([0-8])$/ or return;
    my ($panes, @tabs, %numbers) = (0);
    while (@lines) {
        my ($number, $focus) = shift(@lines) =~ /^tab ([1-9]) (0|[1-9][0-9]?)$/ or return;
        return if $numbers{$number}++ || @tabs >= $TRMNL_TABS;
        my $tree = trmnl_tree_read(\@lines, \$panes, 0) or return;
        my @leaves = trmnl_leaves($tree);
        return unless $focus < @leaves;
        push @tabs, { number => 0 + $number, focus => 0 + $focus, tree => $tree };
    }
    return unless $at < @tabs;
    return { at => 0 + $at, tabs => \@tabs };
}

sub trmnl_tree_read {                     # one tree of the saved lines, taken from their front: a split and its two parts, or a pane; nothing past $TRMNL_PANES panes
    my ($lines, $panes, $depth) = @_;
    return if $depth >= $TRMNL_PANES || !@$lines;
    my $line = shift @$lines;
    if ($line =~ /^split (right|down) ([1-9][0-9]{0,3})$/) {
        my ($way, $share) = ($1, 0 + $2);
        my $a = trmnl_tree_read($lines, $panes, $depth + 1) or return;
        my $b = trmnl_tree_read($lines, $panes, $depth + 1) or return;
        return { split => $way, share => $share, a => $a, b => $b };
    }
    my ($said) = $line =~ m{^pane (-|/[A-Za-z0-9/._~+%-]{0,3071})$} or return;
    return if ++$$panes > $TRMNL_PANES;
    return { cwd => undef } if $said eq '-';
    (my $cwd = $said) =~ s/%([0-9A-F]{2})/chr hex $1/ge;
    return unless $cwd =~ m{\A/[^\x00-\x1f\x7f]{0,1023}\z};
    return { cwd => $cwd };
}

# LZRTRMNL in the window [C29]: the part of the window's text that a
# terminal's tab alone uses, joined after the rest of it by sub run.
# The view of a laid page (LzrprfLaid) is given its wheel, drag, copy, paste
# and the Edit menu's check here; each does nothing but in a terminal's tab
# ("live on 1 trmnl"), where the page fills the view and has nothing of its
# own to scroll.
#   the wheel: "page wheel N", rows to look back (N > 0) or forward;
#   a drag after a press: "page drag X Y", in the page's points;
#   your copy (Cmd-C, or Copy in the Edit menu): "page copy", and the text
#     lzrprf hands back ("trmnlcopy TEXT", sub trmnl_copied) is written to the
#     clipboard only within five seconds of that copy;
#   your paste (Cmd-V, or Paste in the Edit menu): the one place the window
#     reads the clipboard, as plain text, handed to lzrprf as "page paste
#     TEXT" (sub trmnl_pasted), at most $TRMNL_PASTE bytes;
#   Copy and Paste in the Edit menu are offered only while a terminal's tab
#     is shown.
#   a right press: "page context X Y"; lzrprf answers with a menu to show
#     there ("trmnlmenu X Y" and its items, sub trmnl_menu_offered), and the
#     item you choose is said as "page menu ID" (Copy and Paste of that menu
#     are the window's own copy and paste, above);
#   a press on File or View in the terminal's bar is a press like any other,
#     and lzrprf answers it with that menu the same way;
#   a key of TRMNL_SHORTCUTS, while the terminal has the keyboard: "page tkey
#     ID", and the key goes nowhere else (24-trmnl-panes.pl lists them).
# LZRCHT's tab ("live on 0 cht", [C32]) takes the wheel and the press of this
# part and nothing else of it: no key of the terminal's, no paste and no read
# of the clipboard, and a copy it hands back ("trmnlcopy TEXT", sub
# cht_copied) is written only within five seconds of your press in it.
sub window_trmnl_text {
    return <<'END';
var TRMNL_PASTE = 65536, trmnlCopyAsked = 0, trmnlWheelHeld = 0, trmnlDragSaid = '', trmnlPressAt = 0, chtTab = false;    // DECLARED(lzrprf $TRMNL_PASTE); chtTab: the tab shown is LZRCHT's [C32]
var TRMNL_SHORTCUTS = { 'c \\': 'split-right', 'cs d': 'split-down', 'cs w': 'close-pane', 'cs left': 'focus-left', 'cs right': 'focus-right', 'cs up': 'focus-up', 'cs down': 'focus-down',
    'ct left': 'size-left', 'ct right': 'size-right', 'ct up': 'size-up', 'ct down': 'size-down', 'ct =': 'equalise', 'ts t': 'tab-new', 'ts w': 'tab-close',
    't pagedown': 'tab-next', 't pageup': 'tab-prev', 'ts pagedown': 'tab-right', 'ts pageup': 'tab-left', 'c s': 'save' };    // DECLARED(lzrprf %TRMNL_KEYED): none of them is a key of the window's menus
var TRMNL_NAMED_KEYS = { 123: 'left', 124: 'right', 125: 'down', 126: 'up', 116: 'pageup', 121: 'pagedown' }, TRMNL_KEY_GLYPHS = { left: 0xF702, right: 0xF703, down: 0xF701, up: 0xF700, pageup: 0xF72C, pagedown: 0xF72D };
var trmnlOffered = [], trmnlHand = null;
function trmnlMethods(methods) {    // the methods of LzrprfLaid, with the terminal's own added
    methods['scrollWheel:'] = { types: ['void', ['id']], implementation: function (event) { if (!trmnlWheeled(event)) { canvas.nextResponder.scrollWheel(event); try { momentumMore(event); } catch (lost) { } } } };    // OBSERVABILITY-EXEMPT(the extra of a momentum move left out is the system's own move alone)    // on any other page the wheel goes where it always went
    var pressed = methods['mouseDown:'].implementation, typed = methods['keyDown:'].implementation;
    methods['mouseDown:'] = { types: ['void', ['id']], implementation: function (event) { trmnlDragSaid = ''; trmnlPressAt = Date.now(); pressed(event); } };    // a press starts a selection afresh, and is the press a copy of LZRCHT's answers [C32]
    methods['mouseDragged:'] = { types: ['void', ['id']], implementation: function (event) { trmnlDragged(event); } };
    methods['rightMouseDown:'] = { types: ['void', ['id']], implementation: function (event) { if (!trmnlContext(event) && !inspectContext(event)) canvas.nextResponder.rightMouseDown(event); } };
    methods['keyDown:'] = { types: ['void', ['id']], implementation: function (event) { if (!trmnlShortcut(event)) typed(event); } };
    methods['performKeyEquivalent:'] = { types: ['bool', ['id']], implementation: function (event) { return trmnlShortcut(event); } };    // a key with Command reaches a view before the window's menus: only the terminal's own keys are taken here
    methods['copy:'] = { types: ['void', ['id']], implementation: function (sender) { trmnlCopy(); } };
    methods['paste:'] = { types: ['void', ['id']], implementation: function (sender) { trmnlPaste(); } };
    methods['validateMenuItem:'] = { types: ['bool', ['id']], implementation: function (item) { return trmnlKeys && !chtTab && !modalOpen; } };    // Copy and Paste, the two items of the menu this view answers
    return methods;
}
function trmnlTakes() { return trmnlKeys && !chtTab && liveOn && sheet && free && !modalOpen && canvas && win.firstResponder.isEqual(canvas); }    // the terminal is shown and has the keyboard
function trmnlKeyOf(event) {    // a key as TRMNL_SHORTCUTS names it: its modifiers (c Command, t Control, o Option, s Shift) and the key
    var flags = event.modifierFlags, mods = (flags & CMD ? 'c' : '') + (flags & CONTROL ? 't' : '') + (flags & OPTION ? 'o' : '') + (flags & SHIFT ? 's' : '');
    var key = TRMNL_NAMED_KEYS[event.keyCode] || String(event.charactersIgnoringModifiers.js || '').toLowerCase();
    return mods + ' ' + key;
}
function trmnlShortcut(event) {
    if (!trmnlTakes() || event.type != 10) return false;    // 10: a key pressed
    var name = TRMNL_SHORTCUTS[trmnlKeyOf(event)];
    if (!name) return false;
    say('page tkey ' + name);
    return true;
}
function trmnlContext(event) {
    if (!trmnlKeys || chtTab || !liveOn || !sheet || !free || modalOpen) return false;
    win.makeFirstResponder(canvas);
    var at = pointIn(canvas, event), x = Math.round(at.x), y = Math.round(at.y);
    if (x >= 0 && y >= 0 && x < sheet.wide && y < sheet.high) say('page context ' + x + ' ' + y);
    return true;
}
function trmnlTold(word, rest) {    // what lzrprf says of a terminal's tab alone
    if (word == 'trmnlcopy') trmnlCopied(rest);
    else if (word == 'trmnlmenu') trmnlMenu(rest);
}
function trmnlHint(item, id) {    // the key of an item, shown beside it as the window's menus show theirs
    Object.keys(TRMNL_SHORTCUTS).forEach(function (key) {
        if (TRMNL_SHORTCUTS[key] != id) return;
        var parts = key.split(' '), mods = parts[0], glyph = TRMNL_KEY_GLYPHS[parts[1]];
        item.keyEquivalent = $(glyph ? String.fromCharCode(glyph) : parts[1]);
        item.keyEquivalentModifierMask = (/c/.test(mods) ? CMD : 0) | (/t/.test(mods) ? CONTROL : 0) | (/o/.test(mods) ? OPTION : 0) | (/s/.test(mods) ? SHIFT : 0);
    });
}
function trmnlMenu(rest) {    // "X Y", then each item as ID|WORDS|1 or 0 (offered or not), "-" a line between: shown at that point of the page
    if (!trmnlKeys || !liveOn || !sheet || modalOpen || !canvas) return;
    var items = rest.split('\t'), at = /^(\d{1,5}) (\d{1,5})$/.exec(items.shift() || '');
    if (!at) return;
    var menu = $.NSMenu.alloc.initWithTitle($(''));
    menu.autoenablesItems = false;
    menu.appearance = $.NSAppearance.appearanceNamed($('NSAppearanceNameDarkAqua'));
    if (!trmnlHand) trmnlHand = $.LzrprfTrmnlHand.alloc.init;
    trmnlOffered = [];
    items.forEach(function (one) {
        if (one == '-') return menu.addItem($.NSMenuItem.separatorItem);
        var f = /^([a-z]{1,8}(?:-[a-z]{1,8})?)\|([A-Za-z ]{1,40})\|([01])$/.exec(one);
        if (!f) return;
        var item = menu.addItemWithTitleActionKeyEquivalent($(f[2]), 'trmnlPicked:', $(''));
        trmnlHint(item, f[1]);
        item.target = trmnlHand;
        item.tag = trmnlOffered.length;
        item.enabled = f[3] == '1';
        trmnlOffered.push(f[1]);
    });
    menu.popUpMenuPositioningItemAtLocationInView($(), $.NSMakePoint(+at[1], +at[2]), canvas);
}
function trmnlPicked(item) {    // an item chosen: Copy and Paste are the window's own, any other is said to lzrprf, which takes only what it offered
    var id = trmnlOffered[item.tag];
    trmnlOffered = [];
    if (!id || !trmnlKeys || modalOpen) return;
    if (id == 'copy') return trmnlCopy();
    if (id == 'paste') return trmnlPaste();
    say('page menu ' + id);
}
ObjC.registerSubclass({ name: 'LzrprfTrmnlHand', superclass: 'NSObject', methods: {
    'trmnlPicked:': { types: ['void', ['id']], implementation: function (item) { trmnlPicked(item); } }
} });
function trmnlWheeled(event) {
    if (!trmnlKeys || modalOpen) return false;
    var dy = event.scrollingDeltaY, rows;
    if (event.hasPreciseScrollingDeltas) { trmnlWheelHeld += dy; rows = trmnlWheelHeld > 0 ? Math.floor(trmnlWheelHeld / 16) : Math.ceil(trmnlWheelHeld / 16); trmnlWheelHeld -= rows * 16; }    // a trackpad says points: a row is 16
    else rows = dy > 0 ? Math.max(1, Math.round(dy * 3)) : dy < 0 ? Math.min(-1, Math.round(dy * 3)) : 0;    // a wheel says lines: three rows a line, as Terminal
    if (rows) say('page wheel ' + Math.max(-999, Math.min(999, rows)));
    return true;
}
function trmnlDragged(event) {
    if (!trmnlKeys || chtTab || !sheet || !free || modalOpen) return;
    var at = pointIn(canvas, event), x = Math.max(0, Math.min(sheet.wide - 1, Math.round(at.x))), y = Math.max(0, Math.min(sheet.high - 1, Math.round(at.y)));
    if (x + ' ' + y == trmnlDragSaid) return;
    trmnlDragSaid = x + ' ' + y;
    say('page drag ' + trmnlDragSaid);
}
function trmnlCopy() {
    if (!trmnlKeys || chtTab || modalOpen) return;
    trmnlCopyAsked = Date.now();
    say('page copy');
}
function trmnlCopied(rest) {    // lzrprf's answer to your copy: the selected text, written to the clipboard
    if (!trmnlKeys || Date.now() - (chtTab ? trmnlPressAt : trmnlCopyAsked) > 5000) return;    // LZRCHT's: within five seconds of your press [C32]
    trmnlCopyAsked = trmnlPressAt = 0;
    var text;
    try { text = decodeURIComponent(rest); } catch (fault) { return; }
    clipboardWrite(text);
}
function trmnlPaste() {
    if (!trmnlKeys || chtTab || modalOpen) return;
    var got = $.NSPasteboard.generalPasteboard.stringForType($('public.utf8-plain-text'));    // [C29] the one read of the clipboard, on your paste
    if (!got || got.isNil()) return;
    var said;
    try { said = encodeURIComponent(got.js); } catch (fault) { return; }    // a lone half of a surrogate pair is no text
    if (!said) return;
    if (said.replace(/%[0-9A-F]{2}/g, 'x').length > TRMNL_PASTE) return say('page pastelong');    // its bytes in UTF-8
    say('page paste ' + said);
}
END
}

# LZRTRMNL, a terminal in a tab [C29]. It starts on a press of the terminal
# icon of the local home and on nothing else, and never in an incognito or a
# Tor window. Three processes make it, each with as little as it needs:
#
# - lzrprf, outside every container and as you, opens a pseudo-terminal of
#   the system (/dev/ptmx) and starts your login shell on its other end: the
#   shell the system names for your account and lists in /etc/shells, in your
#   home folder, with a short list of variables and no descriptor of lzrprf's.
#   That shell runs with your rights, as one in Terminal does: that is what a
#   terminal is for.
# - core-lzrbrwsr-trmnl, a program of the application, in a container of its
#   own, $TRMNL_CONTAINER, narrower than the page's: it keeps the screen and
#   draws it as the lines of a laid page. It holds no descriptor of the
#   terminal; lzrprf hands it what the shell wrote, "o LEN" and the bytes, and
#   the size of the tab, "s WIDE HIGH". It has no network, reads no file but
#   its own program and the system's shared libraries, writes none, starts
#   nothing, and gets no variable but its seal.
# - the window, which draws those lines as it draws a page and says the keys.
#
# What scrolled off is kept by the container, in a ring of at most 5,000 rows
# and 256 KiB; the wheel and Shift-Page Up and Down look back in it, and what
# the shell writes brings the tab back to its screen. A press and a drag
# select; your copy (Cmd-C) has the container hand lzrprf the selected text,
# each row checked as text, which lzrprf hands the window to write to the
# clipboard (sub trmnl_copied). Your paste (Cmd-V) is the one moment the
# window reads the clipboard: it hands lzrprf the text, and lzrprf writes it to
# the shell with no control character but tabs and line ends, between ESC
# [200~ and ESC [201~ when the shell asked for that (sub trmnl_pasted). A
# title a program sets (OSC 0 or 2) is the tab's title, as plain text of at
# most $TRMNL_TITLE characters (sub trmnl_titled). Nothing a program writes
# ever reaches the clipboard: OSC 52 is passed over.
#
# A key goes from the window to lzrprf, which writes it into the terminal in
# the one fixed form each named key has (sub trmnl_input). Nothing the
# container says is ever written to the shell, but for the answers a terminal
# gives when a program asks it (its status, where its cursor is, what kind of
# terminal it is), each only after the shell wrote that question, once for
# each question, in its one form, with numbers inside the screen
# (sub trmnl_replied). Each line the container draws is checked as a line of
# a laid page is (sub laid_run), so it can draw nothing a page could not.
#
# The container's allow list, and why each entry is in it. Everything else is
# refused (deny default), and so is mapping any file as code. Measured on
# macOS 27.2 by taking each entry out in turn: the program does not start
# without any one of them, and starts with these alone.
#   process-exec of the program itself: sandbox-exec turns into it.
#   file-read* of the program: the system reads it to run it.
#   file-read* of the system's cryptex: the shared cache of the system
#     libraries the program links (libSystem), where macOS keeps it.
#   file-read* of "/" itself (not what is under it): the loader reads the
#     root folder once as it starts.
#   sysctl-read of hw.pagesize_compat alone: the size of a memory page, which
#     the program's runtime reads to place its stack's guard page.
# Its limits ($TRMNL_LIMITS): no byte written to a file, no memory dump, at
# most 16 open files, no more memory than its shell holds plus 64 MiB. No
# limit of processor time: a terminal stays open as long as you keep it.
my $TRMNL_CONTAINER = <<'END';
(version 1)
(deny default)
(deny syscall-unix (syscall-number SYS_shmget SYS_semget SYS_msgget))
(allow process-exec (literal (param "APP")))
(deny file-map-executable)
(allow file-read* (subpath "/System/Volumes/Preboot/Cryptexes") (literal "/") (literal (param "APP")))
(allow sysctl-read (sysctl-name "hw.pagesize_compat"))
END
my $TRMNL_LIMITS = 'limit() { ulimit -S "$@" && ulimit -H "$@"; } && v=$(/bin/ps -o vsz= -p $$) && limit -f 0 && limit -c 0 && { limit -n 16 2>/dev/null || [ "$(ulimit -H -n)" -le 16 ] 2>/dev/null; } && limit -v $((v + 65536)) && exec /usr/bin/env -i "LZRPRF_SEAL=$LZRPRF_SEAL" "$@"';
my $TRMNL_PROGRAM = 'core-lzrbrwsr-trmnl';    # its file name is the name Activity Monitor shows (docs/process-names.md)
my $TRMNL_FEED = 262_144;                 # the most of what the shell wrote held for the container: past it lzrprf reads no more of the terminal, and the shell waits in its write
my $TRMNL_LINE = 9000;                    # the longest line the container may write: a run of 2000 characters of up to four bytes each, and its head
my $TRMNL_ROW = 420;                      # the most lines one row of the screen may be drawn with (DECLARED: src/trmnl/draw.rs ROW_R + ROW_X + the cursor)
my $TRMNL_KEYS = 131_072;                 # the most of your keys held while the shell does not read them: a whole paste and the keys around it
my $TRMNL_PASTE = 65_536;                 # the most bytes one paste writes (DECLARED: the window's trmnlPaste)
my $TRMNL_COPY = 262_144;                 # the most bytes one copy hands the clipboard (DECLARED: src/trmnl/scroll.rs COPY_MOST)
my $TRMNL_COPY_ROWS = 5120;               # the most rows of one copy: the scrollback's 5,000 and a screen's 120 (DECLARED: src/trmnl/scroll.rs ROWS_MOST, src/trmnl/grid.rs MOST_ROWS)
my $TRMNL_TITLE = 80;                     # the most characters of a title a program sets (DECLARED: src/trmnl/scroll.rs TITLE_CHARS)
my %TRMNL_NAMED = (Space => ' ', Enter => "\r", Tab => "\t", Backspace => "\x7f", Escape => "\e", Delete => "\e[3~", PageUp => "\e[5~", PageDown => "\e[6~");
my %TRMNL_CURSOR = (ArrowUp => 'A', ArrowDown => 'B', ArrowRight => 'C', ArrowLeft => 'D', Home => 'H', End => 'F');    # after ESC [, or ESC O while the shell asked for the cursor keys' other form
my %TRMNL_ASKS = (status => qr/\e\[5n/, cursor => qr/\e\[6n/, primary => qr/\e\[0?c/, secondary => qr/\e\[>0?c/);    # the questions a program writes to its terminal, by the answer each wants

# The press: a new tab, with the terminal's containers started in it, one a
# pane: the tabs and views saved for this profile, or one pane
# (24-trmnl-panes.pl). Each pane's shell is started once its container said
# the size of its screen.
sub trmnl_opened {
    $TRMNL_OPEN = 0;
    return idle('An incognito or Tor window opens no terminal: a shell writes its history to your disk, which such a window promises not to do.') if $INCOGNITO || $TOR_WINDOW;
    return idle('LZRTRMNL is not installed. Add it in Add or remove LZR modules, in the cogwheel menu.') unless part_on('lzrtrmnl');
    return idle("A window holds $TABS_MOST tabs at most: close one to open LZRTRMNL.") if @TABS >= $TABS_MOST;
    my ($w, $why) = trmnl_workspace();
    return idle($why) unless $w;
    $TABS[$TAB]{shown} = $SHOWN;
    push @TABS, fresh_tab();
    $TAB = $#TABS;
    undef $SHOWN;
    @{ $TABS[$TAB] }{qw(title trmnl says)} = ('LZRTRMNL', $w, 'LZRTRMNL: your login shell, as you, drawn by a container of its own that has no network and writes no file.');
    noted('you opened LZRTRMNL: your login shell, drawn in a container of its own');
    tab_shown();
    live_told();
}

sub trmnl_program {                       # the drawing program beside this application, as it was installed: its path, or nothing and why in full
    my $program = dirname($PROGRAM) . "/$TRMNL_PROGRAM";
    my ($named) = map { /^file \Q$TRMNL_PROGRAM\E ([0-9a-f]{64})$/ ? $1 : () } release_lines();
    return (undef, 'LZRTRMNL is not installed beside this application, so no terminal was opened') unless -f $program && -x _;
    return (undef, 'LZRTRMNL is not the program this application was installed with, so no terminal was opened. Installing again mends it') if $PROGRAM =~ m{\.app/Contents/MacOS/} && (!defined $named || $named ne (sum_of($program) // ''));    # read again for each pane, as the page's program is read again before each run (sub contained)
    return $program;
}

sub trmnl_started {                       # a pane's container, started and said to be contained by the system, handed its seal: the pane's record, its shell to start in $cwd, or nothing and why
    my ($program, $cwd) = @_;
    return (undef, 'its path holds a character lzrprf does not pass on') if $program =~ /["\\\n]/;
    pipe(my $in, my $to) && pipe(my $from, my $out) or return (undef, 'no pipe was to be had');
    my $seal = run_seal() // return (undef, 'no seal was to be had');
    my $box = fork // return (undef, 'no process was to be had');
    if (!$box) {
        %ENV = (LZRPRF_SEAL => $seal);
        chdir '/';
        become($in, $out, $TRY ? \*STDERR : undef, '/bin/sh', '-c', $TRMNL_LIMITS, 'lzrprf', '/usr/bin/sandbox-exec', '-D', "APP=$program", '-p', $TRMNL_CONTAINER, $program);    # [C29]
    }
    close $_ for $in, $out;
    if (!inside($box)) {                  # [C3] it waits for its seal on its input, so it is there to be asked about
        kill 'KILL', $box;
        waitpid $box, 0;
        return (undef, 'the system did not say that its container holds');
    }
    fcntl($_, POSIX::F_SETFL(), O_NONBLOCK) for $to, $from;
    my $t = { box => $box, to => $to, from => $from, feed => "=seal $seal\n", heard => '', keys => '', size => [0, 0], laid => undef, head => [], rows => [], tally => [], asked => {}, tail => "", ckm => 0, cwd => $cwd, mtail => '', mouse => 0, sgr => 0, pressed => 0 };    # its size is told once it is laid out (sub trmnl_layout)
    return $t;
}

sub trmnl_sized {                         # the size of a pane, in points, to its container, when it is not the size it was told last
    my ($t) = @_;
    return unless $t->{rect} && $t->{to};
    my ($wide, $high) = @{ $t->{rect} }[2, 3];
    return if "$wide $high" eq ($t->{told} // '');
    $t->{told} = "$wide $high";
    trmnl_send($t, "s $wide $high\n");
}

# Your shell, on the other end of a terminal of the system, the size of the
# screen the container said. Nothing when the system gives no terminal or the
# shell is not one it lists.
sub trmnl_shell {
    my ($t, $cols, $rows) = @_;
    my ($user, $home, $shell) = (getpwuid $<)[0, 7, 8];
    open my $listed, '<', '/etc/shells' or return 'the system lists no shell';
    my %shells = map { chomp; m{^/} ? ($_ => 1) : () } <$listed>;
    return 'your login shell is not one the system lists in /etc/shells' unless defined $shell && $shells{$shell} && -x $shell;
    sysopen(my $master, '/dev/ptmx', O_RDWR | POSIX::O_NOCTTY()) or return 'the system gave no terminal';
    my $name = "\0" x 128;
    ioctl($master, 0x20007454, 0) && ioctl($master, 0x20007452, 0) && ioctl($master, 0x40807453, $name) or return 'the system gave no terminal';    # TIOCPTYGRANT, TIOCPTYUNLK, TIOCPTYGNAME
    ($name) = $name =~ m{\A(/dev/ttys[0-9]{3,5})\0} or return 'the system gave a terminal of no name lzrprf knows';
    my $size = pack 'S4', $rows, $cols, 0, 0;
    my $lzr = lzr_bin();                  # [C20] the folder of lzr, the terminal's own command, first on the shell's PATH (sub lzr_bin)
    my %own = (HOME => $home, USER => $user, LOGNAME => $user, SHELL => $shell, PATH => (defined $lzr ? "$lzr:" : '') . '/usr/bin:/bin:/usr/sbin:/sbin', TERM => 'xterm-256color', COLORTERM => 'truecolor', TERM_PROGRAM => 'LZRTRMNL',
        LANG => ($ENV{LANG} // '') =~ /\A([A-Za-z0-9_.@-]{1,40})\z/ ? $1 : 'en_US.UTF-8', ($ENV{TMPDIR} // '') =~ m{\A(/[A-Za-z0-9_./-]{1,200})\z} ? (TMPDIR => $1) : ());
    my $pid = fork // return 'no process was to be had';
    if (!$pid) {
        POSIX::setsid() // POSIX::_exit(127);    # a session of its own, whose terminal this is
        sysopen(my $terminal, $name, O_RDWR) or POSIX::_exit(127);
        ioctl($terminal, 0x20007461, 0) // POSIX::_exit(127);    # TIOCSCTTY
        ioctl($terminal, 0x80087467, $size) // POSIX::_exit(127);    # TIOCSWINSZ
        $SIG{$_} = 'DEFAULT' for grep { !/^__/ } keys %SIG;    # lzrprf ignores SIGPIPE; your shell gets every signal back as it would in Terminal
        POSIX::sigprocmask(POSIX::SIG_SETMASK(), POSIX::SigSet->new);
        %ENV = %own;
        (defined $t->{cwd} && chdir $t->{cwd}) or chdir $home or chdir '/';    # the folder a saved or split pane's shell was in, else your home folder
        become($terminal, $terminal, $terminal, $shell, '-l');    # [C29] as you, a login shell; every other descriptor of lzrprf is closed (sub seal)
    }
    fcntl($master, POSIX::F_SETFL(), O_NONBLOCK);
    @$t{qw(master shell)} = ($master, $pid);
    return;
}

sub trmnl_send {                          # bytes for the container, written as it takes them
    my ($t, $bytes) = @_;
    $t->{feed} .= $bytes;
    trmnl_fed($t);
}

sub trmnl_fed {
    my ($t) = @_;
    return unless $t->{to} && length $t->{feed};
    my $n = syswrite($t->{to}, $t->{feed});
    if (defined $n) { substr($t->{feed}, 0, $n, '') }
    elsif (!$!{EAGAIN} && !$!{EINTR}) { $t->{lost} = 'its container stopped reading' }
}

sub trmnl_keys {                          # your keys, written into the terminal as the shell takes them
    my ($t) = @_;
    return unless $t->{master} && length $t->{keys};
    my $n = syswrite($t->{master}, $t->{keys});
    substr($t->{keys}, 0, $n, '') if defined $n;
}

# What the window says while a terminal's tab is shown: a key in its one
# form; text typed with a key that makes a character beyond ASCII, as UTF-8;
# a key held with Control, as the control character it makes; each to the
# focused pane's shell. A press, a drag, a right press, an item of a menu and
# a key of the terminal's own are sub trmnl_pressed's; what is no key (the
# wheel, a copy, a paste) is sub trmnl_viewed's, for the focused pane.
sub trmnl_input {
    my ($what) = @_;
    return cht_input($what) if $TABS[$TAB]{cht};    # [C32] the wheel in LZRCHT's tab, which takes the terminal's part of the window
    my $w = $TABS[$TAB]{trmnl} or return;
    return trmnl_pressed($TABS[$TAB], $what) if $what =~ /^(?:click|drag|context|menu|tkey) /;
    my $t = trmnl_shown_tab($w)->{focus};
    return trmnl_viewed($t, $what) if $what =~ /^(?:wheel|copy|paste|pastelong)(?: |\z)/ || $what =~ /^key Page(?:Up|Down) shift$/;
    return unless $t->{master};
    my $bytes;
    if ($what =~ /^key ([\x21-\x7e])(?: shift)?$/) { $bytes = $1 }    # the character the key makes, Shift already in it
    elsif ($what eq 'key Tab shift') { $bytes = "\e[Z" }
    elsif ($what =~ /^key ([A-Za-z]+)(?: shift)?$/ && defined $TRMNL_NAMED{$1}) { $bytes = $TRMNL_NAMED{$1} }
    elsif ($what =~ /^key ([A-Za-z]+)(?: shift)?$/ && defined $TRMNL_CURSOR{$1}) { $bytes = ($t->{ckm} ? "\eO" : "\e[") . $TRMNL_CURSOR{$1} }
    elsif ($what =~ /^ctrl ([a-z@\[\]\\^_])$/) { $bytes = chr(ord(uc $1) & 0x1f) }
    elsif ($what =~ /^text (.+)\z/s) {
        my $chars = $bytes = $1;
        return unless utf8::decode($chars) && $chars !~ /[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\p{NChar}]|[^\x{0}-\x{10ffff}]/;
    }
    return unless defined $bytes && length($t->{keys}) + length($bytes) <= $TRMNL_KEYS;
    $t->{keys} .= $bytes;
    trmnl_keys($t);
}

sub trmnl_viewed {                        # [C29] looking back, copying, pasting: the container is told, and only a paste reaches the shell (a press and a drag that select: sub trmnl_clicked)
    my ($t, $what) = @_;
    return if $t->{ended};
    my $page = ($t->{size}[1] || 2) - 1;
    if ($what =~ /^key Page(Up|Down) shift$/) { trmnl_send($t, ($1 eq 'Up' ? 'u' : 'd') . " $page\n") }
    elsif ($what =~ /^wheel (-?)([1-9][0-9]{0,2})$/) { trmnl_send($t, ($1 ? 'd' : 'u') . " $2\n") }
    elsif ($what eq 'copy') { $t->{copying} = 1; trmnl_send($t, "c\n") }
    elsif ($what eq 'pastelong') { aside("LZRTRMNL takes a paste of at most $TRMNL_PASTE bytes, so nothing was pasted.") }
    elsif ($what =~ /^paste (.+)\z/s) { trmnl_pasted($t, $1) }
}

sub trmnl_pasted {                        # [C29] what you pasted, which the window read from the clipboard on your paste alone: text for the shell, with no control character but tabs and line ends, so nothing pasted can move the cursor, end a bracketed paste or act as a key of its own
    my ($t, $said) = @_;
    return unless $t->{master} && length $said <= 3 * $TRMNL_PASTE && $said =~ /\A(?:[A-Za-z0-9_.!~*'()-]|%[0-9A-F]{2})+\z/;    # as the window's encodeURIComponent writes it
    (my $text = $said) =~ s/%([0-9A-F]{2})/chr hex $1/ge;
    return unless length $text <= $TRMNL_PASTE && utf8::decode($text);
    $text =~ s/\r\n?/\n/g;
    $text =~ s/[^\P{Cc}\t\n]//g;          # ESC and every other control character go
    $text =~ tr/\n/\r/;                     # a line end is Return, as a terminal sends it
    utf8::encode($text);
    return unless length $text;
    $text = "\e[200~$text\e[201~" if $t->{paste};    # the shell asked for it (mode 2004): it reads the paste as text, not as keys
    return aside('The shell has not read what was typed before, so nothing was pasted. Paste again in a moment.') if length($t->{keys}) + length($text) > $TRMNL_KEYS;
    $t->{keys} .= $text;
    trmnl_keys($t);
    trmnl_send($t, "d 100000\n");    # back to the screen, where the paste is
}

sub trmnl_copied {                        # [C29] the text you selected, from the container on your copy: each row text with no control character, handed to the window, which writes it to the clipboard
    my ($tab, $rows) = @_;
    my @rows = @$rows;
    for (@rows) { my $chars = $_; return unless utf8::decode($chars) && $chars !~ /\p{Cc}/ }
    my $text = join "\n", @rows;
    return if length $text > $TRMNL_COPY;
    if (!length $text) { aside('Nothing is selected: drag across the text, then copy.'); return 1 }
    (my $said = $text) =~ s/([%\x00-\x1f\x7f])/sprintf '%%%02X', ord $1/ge;
    return 1 unless $tab == $TABS[$TAB];
    window("trmnlcopy $said");
    my $chars = $text;
    utf8::decode($chars);
    aside('Copied ' . length($chars) . (length($chars) == 1 ? ' character' : ' characters') . ' to the clipboard.');
    return 1;
}

sub trmnl_titled {                        # [C29] a title a program set: its pane's title, as plain text of at most $TRMNL_TITLE characters, which names its terminal tab in the strip and, while it has the focus, the browser tab; none when it is empty
    my ($tab, $t, $title) = @_;
    return unless utf8::decode($title);
    $title =~ s/[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\p{NChar}]|[^\x{0}-\x{10ffff}]//g;
    $title =~ s/\s+/ /g;
    $title =~ s/\A | \z//g;
    $title = substr $title, 0, $TRMNL_TITLE;
    utf8::encode($title);
    return 1 if $title eq ($t->{title} // '');
    $t->{title} = length $title ? $title : undef;
    $t->{fresh} = 1;                      # the strip drawn again with it
    trmnl_retitled($tab);
    return 1;
}

sub trmnl_replied {                       # [C29] an answer the container gives, written to the shell only when it asked for one of that kind and not yet answered
    my ($t, $kind, $row, $col) = @_;
    $kind =~ s/ .*//;
    return unless $t->{master} && ($t->{asked}{$kind} // 0) > 0;
    $t->{asked}{$kind}--;
    return if $kind eq 'cursor' && ($row > $t->{size}[1] || $col > $t->{size}[0]);
    $t->{keys} .= { status => "\e[0n", cursor => "\e[$row;${col}R", primary => "\e[?1;2c", secondary => "\e[>0;0;0c" }->{$kind};
    trmnl_keys($t);
}

sub trmnl_reported {                      # [C29] a press you made, told to the shell as a program asked: only while lzrprf saw the shell ask for presses (DEC 1000, 1002 or 1003), once for each press of yours, at a cell inside the screen, as a left press and its release
    my ($t, $col, $row) = @_;
    return unless $t->{master} && $t->{mouse} && $t->{pressed} > 0 && $col <= $t->{size}[0] && $row <= $t->{size}[1];
    $t->{pressed}--;
    my $report = $t->{sgr} ? "\e[<0;$col;${row}M\e[<0;$col;${row}m" : $col <= 223 && $row <= 223 ? "\e[M" . chr(32) . chr(32 + $col) . chr(32 + $row) . "\e[M" . chr(35) . chr(32 + $col) . chr(32 + $row) : return;
    return if length($t->{keys}) + length($report) > $TRMNL_KEYS;
    $t->{keys} .= $report;
    trmnl_keys($t);
}

sub trmnl_moded {                         # the modes of presses the shell asked for, read by lzrprf itself in what it wrote: whether a press is told (1000, 1002, 1003) and in which form (1006)
    my ($t, $bytes) = @_;
    my $scan = $t->{mtail} . $bytes;
    while ($scan =~ /\e\[\?([0-9;]{1,40})([hl])/g) {
        my ($modes, $on) = ($1, $2 eq 'h');
        for (split /;/, $modes) { $t->{mouse} = $on if /^100[023]\z/; $t->{sgr} = $on if $_ eq '1006' }
    }
    $t->{pressed} = 0 unless $t->{mouse};    # a press made while no press was asked for is never told later
    $t->{mtail} = substr($scan, -44);
    $t->{mtail} =~ s/\A.*\e\[\?[0-9;]*[hl]//s;    # a request read whole is not read again
}

sub trmnl_wrote {                         # what a pane's shell wrote, to its container; the questions in it counted
    my ($tab, $t) = @_;
    my $got = sysread($t->{master}, my $bytes, 65536);
    return if !defined $got && ($!{EAGAIN} || $!{EINTR});
    return trmnl_gone($tab, $t) unless $got;    # the shell and all it started let go of the terminal (EIO), or it closed
    my $scan = $t->{tail} . $bytes;
    for my $kind (keys %TRMNL_ASKS) {
        while ($scan =~ /$TRMNL_ASKS{$kind}/g) { $t->{asked}{$kind}++ if pos($scan) > length $t->{tail} && ($t->{asked}{$kind} // 0) < 8 }    # a question that ended in the bytes before was counted then
    }
    $t->{tail} = substr($scan, -4);
    trmnl_moded($t, $bytes);
    trmnl_send($t, 'o ' . length($bytes) . "\n" . $bytes);
}

sub trmnl_gone {                          # a pane's shell ended: the pane closes, as in the common terminals; the last pane stays as it was, with a line that says so, and takes no more keys
    my ($tab, $t) = @_;
    close $t->{master};
    ended($t->{shell}, 1);
    delete @$t{qw(master shell)};
    @$t{qw(keys gone)} = ('', 1);
    my @panes = trmnl_panes($tab->{trmnl});
    return trmnl_pane_closed($tab, $t) if @panes > 1;
    my $note = "\r\n\e[2m[the shell ended]\e[m";
    trmnl_send($t, 'o ' . length($note) . "\n$note");
    $tab->{says} = 'The shell ended. Close this tab, or open LZRTRMNL again from the home page.';
    idle($tab->{says}) if $tab == $TABS[$TAB];
}

sub trmnl_read {                          # what a pane's container drew, line by line, each checked
    my ($tab, $t) = @_;
    my $got = sysread($t->{from}, $t->{heard}, 262_144, length $t->{heard});
    return if !defined $got && ($!{EAGAIN} || $!{EINTR});
    return trmnl_lost($tab, $t, 'its container ended') unless $got;
    while ((my $end = index($t->{heard}, "\n")) >= 0) {
        my $line = substr($t->{heard}, 0, $end + 1, '');
        chop $line;
        return trmnl_lost($tab, $t, 'its container wrote a line too long') if length $line > $TRMNL_LINE;
        if (my $block = $t->{block}) {
            push @{ $block->[3] }, $line;
            next if --$block->[2];
            delete $t->{block};
            next if $block->[0] eq 'copy' && trmnl_copied($tab, $block->[3]);
            return trmnl_lost($tab, $t, 'its container handed a copy that is not text') if $block->[0] eq 'copy';
            trmnl_block($t, @$block) or return trmnl_lost($tab, $t, 'its container drew a row that is not fit');
        }
        elsif ($line =~ /^=row (0|[1-9][0-9]{0,2}) (0|[1-9][0-9]{0,3})$/ && $1 < $t->{size}[1] && $2 <= $TRMNL_ROW) { $2 ? ($t->{block} = ['row', 0 + $1, 0 + $2, []]) : trmnl_block($t, 'row', 0 + $1, 0, []) }
        elsif ($line eq '=head 2') { $t->{block} = ['head', 0, 2, []] }
        elsif ($line eq '=drawn') { $t->{fresh} = 1 }
        elsif ($line =~ /^=size ([1-9][0-9]{0,2}) ([1-9][0-9]{0,2})$/ && $1 <= 300 && $2 <= 120) {
            my ($cols, $rows) = (0 + $1, 0 + $2);
            $t->{size} = [$cols, $rows];
            splice @{ $t->{$_} }, $rows for grep { @{ $t->{$_} } > $rows } 'rows', 'tally', 'moved';
            if ($t->{master}) { my $size = pack 'S4', $rows, $cols, 0, 0; ioctl($t->{master}, 0x80087467, $size) }    # TIOCSWINSZ: the shell's programs are told the new size
            elsif (!$t->{gone}) { my $w = $tab->{trmnl}; trmnl_send($t, "b\n") if $w && !$w->{opened}++; my $why = trmnl_shell($t, $cols, $rows); return trmnl_lost($tab, $t, $why) if $why }    # the first size: the opening screen (the container's src/trmnl/banner.rs) in the first pane of a window alone, then the shell starts, once
        }
        elsif ($line =~ /^=reply (status|cursor ([1-9][0-9]{0,2}) ([1-9][0-9]{0,2})|primary|secondary)$/) { trmnl_replied($t, $1, $2, $3) }
        elsif ($line =~ /^=mode ckm ([01])$/) { $t->{ckm} = $1 }
        elsif ($line =~ /^=mode paste ([01])$/) { $t->{paste} = $1 }
        elsif ($line =~ /^=mouse ([1-9][0-9]{0,2}) ([1-9][0-9]{0,2})$/) { trmnl_reported($t, $1, $2) }
        elsif ($line =~ /^=title(?: (.{1,400}))?$/s) { trmnl_titled($tab, $t, $1 // '') or return trmnl_lost($tab, $t, 'its container wrote a title that is not text') }
        elsif ($line =~ /^=copy (0|[1-9][0-9]{0,3})$/ && $1 <= $TRMNL_COPY_ROWS && delete $t->{copying}) { $1 ? ($t->{block} = ['copy', 0, 0 + $1, []]) : trmnl_copied($tab, []) }    # only after your copy asked for it
        else { return trmnl_lost($tab, $t, 'its container wrote a line of no form') }
    }
    return trmnl_lost($tab, $t, 'its container wrote a line too long') if length $t->{heard} > $TRMNL_LINE;
}

sub trmnl_block {                         # [C29] [C9] the head of a pane's screen, or one row: lines of a laid page, checked as every laid line is
    my ($t, $kind, $n, undef, $lines) = @_;
    no warnings 'utf8';
    if ($kind eq 'head') {
        my ($wide, $high) = $lines->[0] =~ /^L${N}x$N$/ or return;
        return unless $wide >= 1 && $high >= 1 && $wide <= 20_000 && $high <= 20_000 && $lines->[1] =~ /^R/;
        my $state = { wide => $wide, high => $high, text => 0, pixels => 0, rows => 0, row_bytes => 0, row_chars => 0, count => {}, tile => {} };
        laid_run($lines, 1, 1, $state, [], []) or return;
        @$t{qw(laid head rows tally moved)} = ([$wide, $high], $lines, [], [], []);    # a new head: every row is drawn again after it
        return 1;
    }
    my ($wide, $high) = @{ $t->{laid} // return };
    utf8::decode($_) or return for @$lines;
    return if grep { !/^[RX]/ } @$lines;
    my $state = { wide => $wide, high => $high, text => 0, pixels => 0, rows => 0, row_bytes => 0, row_chars => 0, count => {}, tile => {} };
    laid_run($lines, 0, $#$lines, $state, [], []) or return;
    utf8::encode($_) for @$lines;
    $t->{rows}[$n] = $lines;
    $t->{tally}[$n] = [$state->{count}{R} // 0, $state->{count}{X} // 0, $state->{text}];
    $t->{moved}[$n] = undef;              # moved to where the pane stands again when it is drawn (sub trmnl_composed)
    return 1;
}

sub trmnl_drawn {                         # the workspace as one laid list, the bar, the strip and the panes of the terminal tab shown, sent to the window when its tab is shown: only the lines that changed
    my ($tab) = @_;
    my $w = $tab->{trmnl} or return;
    delete $_->{fresh} for trmnl_panes($w);
    my ($list, $cut) = trmnl_composed($w);
    aside('LZRTRMNL left out rows its panes drew: together they held more than a page may.') if $cut && !$w->{cut}++;    # said once
    $w->{list} = $list;
    return unless $tab == $TABS[$TAB];
    live_window_patch($w->{sent}, $w->{list});
    $w->{sent} = $w->{list};
    $DRAWN = 1;
}

sub trmnl_shown {                         # a terminal's tab chosen: laid out at the window's size, each pane told its own, and drawn
    my ($tab) = @_;
    my $w = $tab->{trmnl};
    window('address LZRTRMNL');
    trmnl_layout($w);
    trmnl_retitled($tab);
    ($w->{list}) = trmnl_composed($w);
    window("page $TAB", @{ $w->{list} }, '.');
    $w->{sent} = $w->{list};
    $DRAWN = 1;
    window('secure none');
    nav_told();
    idle($tab->{says});
}

sub trmnl_pane_end {                      # one pane ended: its shell's group hung up (as a closed terminal does), the terminal closed, its container ended, and both waited for
    my ($t) = @_;
    return if $t->{ended}++;
    if ($t->{shell}) { kill 'HUP', -$t->{shell}; close $t->{master}; ended($t->{shell}, 1) }    # the shell's group, then the terminal closed: what runs in front is hung up too
    kill 'KILL', $t->{box};
    waitpid $t->{box}, 0;
    close $_ for grep { defined } @$t{qw(to from)};
    delete @$t{qw(to from master shell)};
}

sub trmnl_lost {                          # a pane's container ended or went wrong: that pane closes, and the terminal with it when it was the last pane
    my ($tab, $t, $why) = @_;
    my @panes = trmnl_panes($tab->{trmnl});
    return trmnl_end($tab, $why) if @panes <= 1;
    noted("a pane of LZRTRMNL ended: $why");
    aside("A pane of LZRTRMNL ended: $why.") if $tab == $TABS[$TAB];
    trmnl_pane_closed($tab, $t);
}

sub trmnl_end {                           # a terminal ended: every pane's shell hung up and its container ended
    my ($tab, $why) = @_;
    my $w = delete $tab->{trmnl} or return;
    trmnl_pane_end($_) for trmnl_panes($w);
    noted("LZRTRMNL ended: $why");
    $tab->{says} = "LZRTRMNL ended: $why.";
    return unless $tab == $TABS[$TAB];
    window("page $TAB", @{ $w->{list} // [] }, '.');
    live_told();
    idle($tab->{says});
}

sub trmnl_all { return map { $_->{trmnl} ? trmnl_panes($_->{trmnl}) : () } @TABS }    # every pane of every terminal of the window

sub trmnl_select {                        # the panes' descriptors, for the wait of sub hear
    my ($ready, $writable) = @_;
    for my $t (grep { !$_->{ended} } trmnl_all()) {
        vec($$ready, fileno $t->{from}, 1) = 1;
        vec($$ready, fileno $t->{master}, 1) = 1 if $t->{master} && length $t->{feed} < $TRMNL_FEED;
        vec($$writable, fileno $t->{to}, 1) = 1 if length $t->{feed};
        vec($$writable, fileno $t->{master}, 1) = 1 if $t->{master} && length $t->{keys};
    }
}

sub trmnl_heard {                         # what the wait of sub hear found ready, for each pane; each terminal drawn once for all it read
    my ($ready, $writable) = @_;
    for my $tab (grep { $_->{trmnl} } @TABS) {
        for my $t (trmnl_panes($tab->{trmnl})) {
            next if $t->{ended} || !$tab->{trmnl};
            trmnl_fed($t) if vec($writable, fileno $t->{to}, 1);
            trmnl_keys($t) if $t->{master} && vec($writable, fileno $t->{master}, 1);
            trmnl_wrote($tab, $t) if $t->{master} && vec($ready, fileno $t->{master}, 1);
            trmnl_read($tab, $t) if !$t->{ended} && $tab->{trmnl} && vec($ready, fileno $t->{from}, 1);
            trmnl_lost($tab, $t, $t->{lost}) if !$t->{ended} && $tab->{trmnl} && $t->{lost};
        }
        trmnl_drawn($tab) if $tab->{trmnl} && grep { $_->{fresh} } trmnl_panes($tab->{trmnl});
    }
}

sub trmnl_fds { return map { grep { defined } @$_{qw(to from master)} } trmnl_all() }    # for a copy of lzrprf that goes on as perl: it lets go of every terminal, so their ends are lzrprf's alone
# A question, in lzrprf's strip of the window, with two buttons, or with one
# where there is nothing to choose. The first
# button is always the one that fetches, sends, replaces and keeps nothing, or
# keeps less, and it is the answer when the time is over; when the window is
# gone, lzrprf ends instead, and nothing is fetched or sent. Returns 1 or 2.
# Both sides count the questions, and a button says which question it
# answers: a press that comes late, after its question ran out of time, is
# not taken as the answer to the next one.
my $ASKED = 0;
sub ask { my ($words, @buttons) = @_; return asked('ask ' . $words =~ s/\s+/ /gr, @buttons) }

sub asked_later { my ($line, @buttons) = @_; $ASKED++; window(join "\t", $line, @buttons); return $ASKED }    # a question whose answer the main loop hears as any line (sub permit_button): it holds nothing

sub asked {                               # a question in a line of its own kind: "ask" in the strip, "webquestion" in the LZRDFNDR modal
    my ($line, @buttons) = @_;
    my $saved = ref($buttons[0]) eq 'CODE' ? shift @buttons : undef;
    $ASKED++;
    window(join "\t", $line, @buttons);
    if (!$FROM) {                         # "lzrprf try" only: the test's answer
        my $press = $ANSWER eq 'allow' ? 2 : $ANSWER =~ s/^([1-6])// ? $1 : 1;    # a digit for each question in turn; one through six
        window("answered $press");
        return $press;
    }
    my $until = now() + $ANSWER_SECONDS;
    while ((my $left = $until - now()) > 0) {
        my $event = hear($left) // leave();
        return $1 if $event =~ /^button $ASKED ([1-6])$/ && $1 <= @buttons;
        if ($saved && $event eq 'essential list') { essential_web_told(); next }
        if ($saved && $event =~ /\Aessential save ([01])((?: [0-9]=[a-z-]+){0,8})\z/) {
            my ($on, $changes) = ($1, $2);
            my $ok = essential_web_save($on, grep length, split / /, $changes);
            my $press = $ok ? $saved->() : undef;
            window('essential saved ' . ($ok ? defined $press ? 'resolved' : 'ok' : 'failed'));
            return $press if defined $press;
            next;
        }
        if ($event =~ /^button /) { push @LATER, $event; next }    # the answer to the question about scripts, which stood before this one: heard after it (sub permit_button)
        viewing($event); if ($event =~ /^page scroll [0-9]{1,2} [0-9]{1,6} [0-9]{1,6}$/) { my $back = live_scroll_back(); @LATER = ((grep { !/^page scroll / || $_ eq $back && $_ ne $event } @LATER), $event) } elsif ($event =~ /^tor (?:on|off)$/) { push @LATER, $event }    # a new size of the window's page said meanwhile is still its size; the page is laid out at it after the question (sub relaid); Tor turned on or off is heard after it too, and where the window shows the page from, the newest place only: one said each frame of a long question is not kept by the hundred, but the page's own scroll said back is kept too, so the window's places are heard again after it (sub live_input)
    }
    return 1;
}

# What is fetched for a text that was typed. An address is https, a host by its
# name, port 443, and plain characters without a space. lzrprf adds https://
# when no scheme was typed, writes the host in small letters, and leaves out
# what follows a #, which is never sent to a site. Everything else is sent
# exactly as typed, or, when it is not such an address, not at all.
sub address {
    my ($text) = @_;
    $text =~ s/^[ \t]+|[ \t\r\n]+$//g;
    $text =~ s/#.*//s;
    $text = "https://$text" unless $text =~ m{^[A-Za-z][A-Za-z0-9+.-]*://};
    return unless $text =~ m{^https://($NAME)(?::443)?([/?][\x21-\x7e]*)?$}i && length $1 <= 253 && length $text <= 2000;
    my ($host, $rest) = (lc $1, $2 // '/');
    $rest = "/$rest" if $rest =~ /^\?/;
    return if listed("https://$host$rest");    # [C23] a listed address is no address lzrprf fetches, wherever it came from
    return ("https://$host$rest", $host);
}

# A host that leads to this computer, into a network of your own, or to a
# place this computer reaches by a route of its own is not the public
# internet. It is fetched only after you said yes to exactly that, in
# lzrprf's strip of the window, and the yes holds for that one request.
# Returns nothing after a yes, and the reason after a no.                # [C8]
sub own_network {
    my ($host, $where, $kept) = @_;
    my $there = join ', ', map { $_->{text} } @$where;
    my $yes = ask("$host is not on the public internet. It leads to $there: this computer, a network of your own, or a place this computer reaches by a route of its own, such as a VPN. What answers there can be a device of yours, such as a router. Fetch it this once?", 'No', 'Yes, this once') == 2;
    record('you ' . ($yes ? 'allowed' : 'refused') . " $host, which is inside your own network ($there)" . ($yes ? ', this once' : ''), $kept) or return 'the log could not be written';
    return $yes ? undef : 'you said no to a host inside your own network';
}


# LZRCHT, one place for your Telegram and Discord messages, in a tab
# [C32]. It starts on a press of its icon on the local home and on nothing
# else, and never in an incognito or a Tor window. Everything of it is the
# application's program core-lzrbrwsr-cht, run as three roles, each in a
# container of its own; lzrprf holds only what keeps them apart and you safe:
#
# - the drawing role, in the terminal's container ($TRMNL_CONTAINER: no
#   network, no file but its program and the system's libraries, nothing
#   started): it keeps your conversations and draws the tab as the lines of a
#   laid page, each page checked as a page is (sub laid_run). It is told the
#   tab's size, your presses and the wheel, and what the other roles may say.
# - the keeper, in that container and the config of LZRCHT
#   ($CHT_CONFIG under your home) and the files it names, to read and nothing
#   more: it says, for each platform, only whether LZRBRWSR's credentials for
#   it are in place, "=auth SERVICE 0|1". lzrprf reads of that config its
#   first line and the paths alone, never a file it names, and hands the
#   drawing role the word and nothing else (sub cht_kept).
# - a connector, one an account, in the terminal's container too: no network
#   and no file. It speaks the platform's protocol over the one connection
#   lzrprf opens and holds for it (sub cht_dialed): TCP to an IPv4 address
#   that platform publishes as its own, on a port it serves, and nothing else.
#   It is started only when the drawing role asks for it in its answer to a
#   press of yours, and only once the keeper said that platform's credentials
#   are in place. Discord publishes no addresses, and our own LZRCHT service
#   is coming, so no connector of theirs is ever given a connection.
#
# The drawing role may hand the clipboard one line of text, checked as text,
# only in its answer to a press of yours, and the window writes it only
# within five seconds of that press (sub cht_copied). Nothing reads the
# clipboard. Every line any role writes has one form, and a role that writes
# one of no form ends; the drawing role's end is LZRCHT's. Its tab ends every
# role, its connections with them, as does an address opened in it or its
# window's close. Each connection and each connector is a line of the log.
my $CHT_PROGRAM = 'core-lzrbrwsr-cht';    # its file name is the name Activity Monitor shows (docs/process-names.md)
my $CHT_CONFIG = '.config/lzrbrwsr/lzrcht.conf';    # under your home (DECLARED: src/cht/config.rs CONFIG_PATH)
my $CHT_HEAD = 'lzrcht-app-credentials 1';    # its first line (DECLARED: src/cht/config.rs HEAD)
my %CHT_NAMED = map { $_ => 1 } qw(telegram.api_id telegram.api_hash discord.client_id);    # the names of its paths (DECLARED: src/cht/config.rs locations)
my @CHT_SERVICES = qw(lzrcht telegram discord);    # in the keeper's order (DECLARED: src/cht/adapter.rs Service::ALL)
my $CHT_LINE = 65_536;                    # the longest line a role may write: a copy of one message, or a laid line
my $CHT_PAGE = 200_000;                   # the most lines of one page, and its bytes below
my $CHT_PAGE_BYTES = 16 << 20;
my $CHT_NET = 65_536;                     # the most bytes of one "=net" (DECLARED: src/cht/link.rs)
my $CHT_EVENT = 1 << 20;                  # the most bytes of one "=ev" (DECLARED: src/cht/link.rs, src/cht/main.rs)
my $CHT_HELD = 4 << 20;                   # the most held for a role or a connection before lzrprf reads no more of what feeds it
my $CHT_DIALS = 16;                       # the most connections one connector may ask for in its life
my %CHT_RANGES = (telegram => [qw(91.108.56.0/22 91.108.4.0/22 91.108.8.0/22 91.108.16.0/22 91.108.12.0/22 149.154.160.0/20 91.105.192.0/23 91.108.20.0/22 185.76.151.0/24)]);    # Telegram's own, as it publishes them (https://core.telegram.org/resources/cidr.txt, IPv4, read 2026-11-24); Discord publishes none
my @CHT_PORTS = (443, 80, 5222);          # the ports Telegram's servers serve

sub cht_opened {                          # the press: a new tab, its drawing role and its keeper started
    $CHT_OPEN = 0;
    return idle('An incognito or Tor window opens no LZRCHT: your messages would be kept on your disk, which such a window promises not to do.') if $INCOGNITO || $TOR_WINDOW;
    return idle("A window holds $TABS_MOST tabs at most: close one to open LZRCHT.") if @TABS >= $TABS_MOST;
    my ($program, $why) = cht_program();
    return idle("$why.") unless $program;
    my $draw = cht_box($program, 'draw', $TRMNL_CONTAINER, []) or return idle('LZRCHT could not be started: the system did not say that its container holds. Nothing was opened.');
    my $c = { program => $program, draw => $draw, links => {}, auth => {}, told => 0, asked => [], list => [] };
    $c->{keep} = cht_keeper($program);    # none: every platform waits for its credentials, as when none are placed
    $TABS[$TAB]{shown} = $SHOWN;
    push @TABS, fresh_tab();
    $TAB = $#TABS;
    undef $SHOWN;
    @{ $TABS[$TAB] }{qw(title cht says)} = ('LZRCHT', $c, 'LZRCHT: your messages, drawn by a container of its own that has no network; each platform connects only once it allows the connection.');
    noted('you opened LZRCHT: its drawing role and its keeper, each in a container of its own');
    tab_shown();
    live_told();
}

sub cht_program {                         # the program beside this application, as it was installed: its path, or nothing and why in full
    my $program = dirname($PROGRAM) . "/$CHT_PROGRAM";
    my ($named) = map { /^file \Q$CHT_PROGRAM\E ([0-9a-f]{64})$/ ? $1 : () } release_lines();
    return (undef, 'LZRCHT is not installed beside this application, so nothing was opened') unless -f $program && -x _;
    return (undef, 'LZRCHT is not the program this application was installed with, so nothing was opened. Installing again mends it') if $PROGRAM =~ m{\.app/Contents/MacOS/} && (!defined $named || $named ne (sum_of($program) // ''));
    return $program;
}

sub cht_box {                             # [C32] one role in its container, said by the system to be contained, handed its seal: its record, or nothing
    my ($program, $role, $profile, $defines, @words) = @_;
    return if $program =~ /["\\\n]/;
    pipe(my $in, my $to) && pipe(my $from, my $out) or return;
    my $seal = run_seal() // return;
    my $box = fork // return;
    if (!$box) {
        %ENV = (LZRPRF_SEAL => $seal);
        chdir '/';
        become($in, $out, $TRY ? \*STDERR : undef, '/bin/sh', '-c', $TRMNL_LIMITS, 'lzrprf', '/usr/bin/sandbox-exec', '-D', "APP=$program", @$defines, '-p', $profile, $program, @words);    # [C32]
    }
    close $_ for $in, $out;
    if (!inside($box)) {                  # [C3]
        kill 'KILL', $box;
        waitpid $box, 0;
        return;
    }
    fcntl($_, POSIX::F_SETFL(), O_NONBLOCK) for $to, $from;
    return { role => $role, box => $box, to => $to, from => $from, feed => "=seal $seal\n", heard => '', out => '' };
}

sub cht_keeper {                          # [C32] the keeper, which may read the config and the paths it names: lzrprf reads its first line and its paths, never a file it names
    my ($program) = @_;
    my $home = (getpwuid $<)[7] // return;
    my @read = ("$home/$CHT_CONFIG");
    if (sysopen my $in, $read[0], O_RDONLY | O_NOFOLLOW | O_NONBLOCK) {
        my $text = '';
        1 while length $text <= 4096 && sysread($in, $text, 4097 - length $text, length $text);
        my @lines = split /\n/, $text;
        my @paths;
        my $fit = length $text <= 4096 && @lines && shift(@lines) eq $CHT_HEAD;    # DECLARED: src/cht/config.rs MOST_FILE
        for (@lines) {
            next if /^\s*$/ || /^#/;
            my ($name, $path) = m{^([a-z._]{1,40}) (/[A-Za-z0-9 _.\@+~/-]{1,1024})$} or ($fit = 0, last);
            ($fit = 0, last) unless $CHT_NAMED{$name} && $path !~ m{/\.\.(?:/|$)};
            push @paths, $path;
        }
        push @read, @paths if $fit;       # a config of no form: the keeper reads it, refuses it whole, and says every platform waits
    }
    my $profile = $TRMNL_CONTAINER . '(allow file-read* ' . join(' ', map { "(literal (param \"F$_\"))" } 0 .. $#read) . ")\n";
    my $keep = cht_box($program, 'keep', $profile, [map { ('-D', "F$_=$read[$_]") } 0 .. $#read], 'keep', $read[0]) or return;
    noted('LZRCHT started its keeper, which may read its config and the ' . (@read - 1) . ' files it names, and nothing else');
    return $keep;
}

sub cht_send {                            # bytes for a role, written as it takes them
    my ($b, $bytes) = @_;
    return if $b->{ended};
    $b->{feed} .= $bytes;
    cht_fed($b);
}

sub cht_fed {
    my ($b) = @_;
    return unless !$b->{ended} && length $b->{feed};
    my $n = syswrite($b->{to}, $b->{feed});
    if (defined $n) { substr($b->{feed}, 0, $n, '') }
    elsif (!$!{EAGAIN} && !$!{EINTR}) { $b->{lost} = 'stopped reading' }
}

sub cht_tell {                            # a frame for the drawing role, which answers each with one page; what it answers to is kept, so a copy and a connector are taken only in an answer to a press
    my ($c, $frame, $kind) = @_;
    push @{ $c->{asked} }, $kind;
    cht_send($c->{draw}, $frame);
}

sub cht_sized {                           # the size of the tab, in points, to the drawing role, when it is not the size it was told last
    my ($tab) = @_;
    my $c = $tab->{cht} or return;
    my ($wide, $high) = trmnl_page();
    return if "$wide $high" eq ($c->{size} // '');
    $c->{size} = "$wide $high";
    cht_tell($c, "s $wide $high\n", 's');
}

sub cht_input {                           # [C32] what the window says in LZRCHT's tab: a press and the wheel reach its drawing role, and nothing else does
    my ($what) = @_;
    my $c = $TABS[$TAB]{cht} or return;
    if ($what =~ /^click $N $N$/ && $1 <= 200_000 && $2 <= 200_000) { cht_tell($c, "p $1 $2\n", 'p') }
    elsif ($what =~ /^wheel (-?)([1-9][0-9]{0,2})$/) { cht_tell($c, ($1 ? 'd' : 'u') . " $2\n", 'w') }
}

sub cht_shown {                           # LZRCHT's tab chosen: its last page, at the window's size
    my ($tab) = @_;
    my $c = $tab->{cht};
    window('address LZRCHT');
    cht_sized($tab);
    my ($wide, $high) = trmnl_page();
    my $list = @{ $c->{list} } ? $c->{list} : ["L${wide}x$high", "R0,0,$wide,$high,0c0f12ff"];    # before its first page: its ground (DECLARED: src/cht/paint.rs BG)
    window("page $TAB", @$list, '.');
    $c->{sent} = $list;
    $DRAWN = 1;
    window('secure none');
    nav_told();
    idle($tab->{says});
}

sub cht_units {                           # what a role wrote: its lines, and after "=net N" or "=ev N" those N bytes; and why it ended, when it did
    my ($b) = @_;
    my $got = sysread($b->{from}, $b->{heard}, 262_144, length $b->{heard});
    return ([]) if !defined $got && ($!{EAGAIN} || $!{EINTR});
    my @units;
    while (1) {
        if (my $need = $b->{need}) {
            last if length $b->{heard} < $need->[1];
            push @units, [$need->[0], substr($b->{heard}, 0, $need->[1], '')];
            delete $b->{need};
            next;
        }
        my $end = index($b->{heard}, "\n");
        last if $end < 0;
        my $line = substr($b->{heard}, 0, $end + 1, '');
        chop $line;
        return (\@units, 'wrote a line too long') if length $line > $CHT_LINE;
        if ($b->{role} eq 'link' && $line =~ /^=(net|ev) ([1-9][0-9]{0,6})$/) {
            return (\@units, 'wrote a count past its bound') if $2 > ($1 eq 'net' ? $CHT_NET : $CHT_EVENT);
            $b->{need} = [$1, 0 + $2];
            next;
        }
        push @units, [$line];
    }
    return (\@units, 'wrote a line too long') if !$b->{need} && length $b->{heard} > $CHT_LINE;
    return (\@units, $got ? undef : 'ended');
}

sub cht_drew {                            # [C32] what the drawing role wrote: whole pages, each checked; a copy and a connector asked for only in its answer to a press
    my ($tab, $c, $units) = @_;
    for (@$units) {
        my $line = $_->[0];
        if (my $page = $c->{page}) {
            return 'drew a page past its bound' if ($page->{bytes} += length $line) > $CHT_PAGE_BYTES;
            push @{ $page->{lines} }, $line;
            next if --$page->{left};
            delete $c->{page};
            cht_paged($tab, $c, $page->{lines}) or return 'drew a page that is not fit';
        }
        elsif (delete $c->{copying}) { cht_copied($tab, $line) or return 'handed a copy that is not text' }
        elsif ($line =~ /^=page ([1-9][0-9]{0,5})$/ && $1 <= $CHT_PAGE && @{ $c->{asked} }) { $c->{page} = { left => 0 + $1, lines => [], bytes => 0 } }
        elsif ($line eq '=copy 1' && ($c->{asked}[0] // '') eq 'p' && !$c->{copied}++) { $c->{copying} = 1 }
        elsif ($line eq '=app discord' && ($c->{asked}[0] // '') eq 'p' && !$c->{app_opened}++) { $c->{app_pending} = 1 }
        elsif ($line =~ /^=link (lzrcht|telegram|discord) 0$/ && ($c->{asked}[0] // '') eq 'p') { cht_linked($c, $1, 0) }
        elsif ($line eq '=drawn' && @{ $c->{asked} }) {
            shift @{ $c->{asked} }; $c->{copied} = 0; $c->{app_opened} = 0;
            kept_app_open_tab($tab) if delete $c->{app_pending};
        }
        else { return 'wrote a line of no form' }
    }
    return;
}

sub cht_paged {                           # [C32] [C9] a whole page the drawing role drew: the lines of a laid page, checked as every laid line is, then drawn when its tab is shown
    my ($tab, $c, $lines) = @_;
    no warnings 'utf8';
    my ($wide, $high) = $lines->[0] =~ /^L${N}x$N$/ or return;
    return unless $wide >= 1 && $high >= 1 && $wide <= 20_000 && $high <= 20_000 && ($lines->[1] // '') =~ /^R/;
    utf8::decode($_) or return for @$lines;
    my $state = { wide => $wide, high => $high, text => 0, pixels => 0, rows => 0, row_bytes => 0, row_chars => 0, count => {}, tile => {} };
    laid_run($lines, 1, $#$lines, $state, [], []) or return;
    return if $state->{rows};             # a picture cut short
    utf8::encode($_) for @$lines;
    $c->{list} = $lines;
    return 1 unless $tab == $TABS[$TAB];
    live_window_patch($c->{sent}, $lines);
    $c->{sent} = $lines;
    $DRAWN = 1;
    return 1;
}

sub cht_copied {                          # [C32] the text of a Copy you pressed: one line, text with no control character, handed to the window, which writes it to the clipboard only within five seconds of your press
    my ($tab, $text) = @_;
    my $chars = $text;
    return unless utf8::decode($chars) && $chars !~ /\p{Cc}/;
    return 1 unless length $text && $tab == $TABS[$TAB];
    (my $said = $text) =~ s/(%)/%25/g;
    window("trmnlcopy $said");
    aside('Copied ' . length($chars) . (length($chars) == 1 ? ' character' : ' characters') . ' to the clipboard.');
    return 1;
}

sub cht_kept {                            # [C32] what the keeper said: whether each platform's credentials are in place, once each, in its order, to the drawing role as a word and nothing more
    my ($c, $units) = @_;
    for (@$units) {
        my $service = $CHT_SERVICES[$c->{told}] // return 'said more than it has to say';
        my ($placed) = $_->[0] =~ /^=auth \Q$service\E ([01])$/ or return 'wrote a line of no form';
        $c->{told}++;
        $c->{auth}{$service} = 0 + $placed;
        cht_tell($c, "a $service $placed\n", 'a');
    }
    return;
}

sub cht_linked {                          # [C32] a connector asked for in the answer to your press: started in a container with no network, once its platform's credentials are in place
    my ($c, $service, $slot) = @_;
    return if $c->{links}{"$service $slot"};
    return cht_tell($c, "x $service $slot LZRBRWSR is not yet authorized by $service\n", 'x') unless $c->{auth}{$service};
    my $link = cht_box($c->{program}, 'link', $TRMNL_CONTAINER, [], 'link', $service, $slot) or return cht_tell($c, "x $service $slot its container did not start\n", 'x');
    @$link{qw(service slot dials)} = ($service, $slot, 0);
    $c->{links}{"$service $slot"} = $link;
    noted("LZRCHT started a $service connector, in a container of its own with no network");
}

sub cht_reachable {                       # [C32] whether lzrprf opens a connection for a connector of $service to $ip, port $port: an IPv4 address in its one form inside a range that platform publishes, on a port it serves
    my ($service, $ip, $port) = @_;
    my $byte = qr/(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])/;
    return 0 unless $ip =~ /\A$byte\.$byte\.$byte\.$byte\z/ && grep { $_ == $port } @CHT_PORTS;
    my $at = unpack 'N', pack 'C4', split /\./, $ip;    # numbers alone: nothing here can look a name up
    for (@{ $CHT_RANGES{$service} // [] }) {
        my ($net, $bits) = split m{/};
        my $mask = (0xffffffff << (32 - $bits)) & 0xffffffff;
        return 1 if ($at & $mask) == (unpack('N', pack 'C4', split /\./, $net) & $mask);
    }
    return 0;
}

sub cht_heard_link {                      # [C32] what a connector wrote: a connection to open, bytes for it, an event for the drawing role, or its end
    my ($c, $link, $units) = @_;
    my ($service, $slot) = @$link{qw(service slot)};
    for (@$units) {
        my ($kind, $bytes) = @$_;
        if ($kind eq 'net') { return 'wrote for a connection it does not have' unless $link->{up}; $link->{out} .= $bytes }
        elsif ($kind eq 'ev') { cht_tell($c, "e $service $slot " . length($bytes) . "\n$bytes", 'e') }
        elsif ($kind =~ /^=dial ([0-9.]{7,15}) ([1-9][0-9]{0,4})$/) {
            my ($ip, $port) = ($1, $2);
            return "asked for $ip port $port, which is no address $service publishes" unless cht_reachable($service, $ip, $port);
            return 'asked for a second connection' if $link->{sock};
            return "asked for more than $CHT_DIALS connections" if ++$link->{dials} > $CHT_DIALS;
            cht_dialed($link, $ip, $port);
        }
        elsif ($kind =~ /^=down ([\x20-\x7e]{1,200})$/) { return $1 }
        else { return 'wrote a line of no form' }
    }
    return;
}

sub cht_dialed {                          # [C32] a connector's one connection, opened and held by lzrprf as you: TCP to an address its platform publishes, a line of the log
    my ($link, $ip, $port) = @_;
    noted("LZRCHT's $link->{service} connector asked for $ip port $port, an address $link->{service} publishes: lzrprf opened that connection for it");
    socket(my $sock, AF_INET, SOCK_STREAM, 0) or return cht_send($link, "=gone no socket was to be had\n");
    fcntl($sock, POSIX::F_SETFL(), O_NONBLOCK);
    if (connect($sock, pack_sockaddr_in($port, pack 'C4', split /\./, $ip))) { @$link{qw(sock up)} = ($sock, 1); return cht_send($link, "=up\n") }    # [C32] the address cht_reachable checked, as four numbers
    return cht_send($link, "=gone the connection was refused\n") unless $!{EINPROGRESS};
    @$link{qw(sock dialing)} = ($sock, 1);
}

sub cht_hung {                            # a connector's connection closed, and the connector told why
    my ($link, $why) = @_;
    close delete $link->{sock};
    delete @$link{qw(up dialing)};
    $link->{out} = '';
    noted("a connection of LZRCHT's $link->{service} connector closed: $why");
    cht_send($link, "=gone $why\n");
}

sub cht_net {                             # a connection ready: its opening finished, bytes read for the connector, bytes written from it
    my ($link, $ready, $writable) = @_;
    my $sock = $link->{sock};
    if ($link->{dialing}) {
        return unless vec($writable, fileno $sock, 1);
        my $error = unpack 'i', getsockopt($sock, SOL_SOCKET, SO_ERROR) // pack('i', 1);
        return cht_hung($link, 'the connection could not be opened') if $error;
        delete $link->{dialing};
        $link->{up} = 1;
        return cht_send($link, "=up\n");
    }
    if (vec($ready, fileno $sock, 1)) {
        my $got = sysread($sock, my $bytes, $CHT_NET);
        return if !defined $got && ($!{EAGAIN} || $!{EINTR});
        return cht_hung($link, 'the other end closed the connection') unless $got;
        cht_send($link, "=net $got\n$bytes");
    }
    if (length $link->{out} && vec($writable, fileno $sock, 1)) {
        my $n = syswrite($sock, $link->{out});
        if (defined $n) { substr($link->{out}, 0, $n, '') }
        elsif (!$!{EAGAIN} && !$!{EINTR}) { cht_hung($link, 'the connection failed') }
    }
}

sub cht_box_end {                         # a role ended, its connection closed, and waited for
    my ($b) = @_;
    return if $b->{ended}++;
    close delete $b->{sock} if $b->{sock};
    kill 'KILL', $b->{box};
    waitpid $b->{box}, 0;
    close $_ for grep { defined } @$b{qw(to from)};
    delete @$b{qw(to from)};
}

sub cht_unlinked {                        # a connector ended: its connection with it, and the drawing role told why
    my ($c, $link, $why) = @_;
    cht_box_end($link);
    delete $c->{links}{"$link->{service} $link->{slot}"};
    noted("LZRCHT's $link->{service} connector ended: $why");
    $why =~ s/[^\x20-\x7e]//g;
    cht_tell($c, "x $link->{service} $link->{slot} $why\n", 'x');
}

sub cht_end {                             # LZRCHT ended: every role and every connection
    my ($tab, $why, $replacing) = @_;
    my $c = delete $tab->{cht} or return;
    cht_box_end($_) for cht_boxes($c);
    noted("LZRCHT ended: $why");
    $tab->{says} = "LZRCHT ended: $why.";
    return if $replacing || $tab != $TABS[$TAB];
    window("page $TAB", @{ $c->{sent} // [] }, '.');
    live_told();
    idle($tab->{says});
}

sub cht_boxes { my ($c) = @_; return grep { defined && !$_->{ended} } $c->{draw}, $c->{keep}, values %{ $c->{links} } }

sub cht_select {                          # the roles' descriptors and the connections, for the wait of sub hear; what feeds a role that does not read is not read
    my ($ready, $writable) = @_;
    for my $c (map { $_->{cht} // () } @TABS) {
        my $full = length $c->{draw}{feed} > $CHT_HELD;
        for my $b (cht_boxes($c)) {
            vec($$ready, fileno $b->{from}, 1) = 1 if $b == $c->{draw} || !$full && length $b->{out} < $CHT_HELD;
            vec($$writable, fileno $b->{to}, 1) = 1 if length $b->{feed};
            my $sock = $b->{sock} or next;
            vec($$ready, fileno $sock, 1) = 1 if !$b->{dialing} && length $b->{feed} < $CHT_HELD;
            vec($$writable, fileno $sock, 1) = 1 if $b->{dialing} || length $b->{out};
        }
    }
}

sub cht_heard {                           # what the wait of sub hear found ready, for each role of each LZRCHT
    my ($ready, $writable) = @_;
    for my $tab (grep { $_->{cht} } @TABS) {
        my $c = $tab->{cht};
        for my $b (cht_boxes($c)) {
            last unless $tab->{cht};
            next if $b->{ended};
            cht_fed($b) if vec($writable, fileno $b->{to}, 1);
            cht_net($b, $ready, $writable) if $b->{sock};
            my ($units, $why) = vec($ready, fileno $b->{from}, 1) ? cht_units($b) : ([]);
            $why //= $b->{lost};
            if ($b->{role} eq 'draw') { my $wrong = cht_drew($tab, $c, $units) // $why; cht_end($tab, "its drawing container $wrong") if defined $wrong }
            elsif ($b->{role} eq 'keep') { my $wrong = cht_kept($c, $units) // $why; if (defined $wrong) { cht_box_end($b); delete $c->{keep}; noted("LZRCHT's keeper $wrong") } }
            else { my $wrong = cht_heard_link($c, $b, $units) // ($why && "its container $why"); cht_unlinked($c, $b, $wrong) if defined $wrong }
        }
    }
}

sub cht_fds { return map { my $c = $_->{cht}; $c ? map({ grep { defined } @$_{qw(to from sock)} } cht_boxes($c)) : () } @TABS }    # for a copy of lzrprf that goes on as perl: it lets go of every role and connection
# The log in the window: this window's lines where a page stands, and under
# them the log on this computer when there is one; one sentence on what is
# kept; the button that clears the log whenever there is one; and, while a
# log is kept, the questions that keep less. The log is cleared by that
# button, and that it was cleared is the first line of the new log.     # [C12]
# No button of the window makes lzrprf keep more: a log is chosen, and full
# addresses are chosen, with "lzrprf keep" in a terminal and in no other
# way. The window's process is the one that tells lzrprf which button was
# pressed, so what it could do by itself, if text it draws took it over, is
# what the buttons can do: keep less, and clear.
# Every question here has the button that keeps less, or changes nothing,
# first, and a question nobody answers counts as that one.
sub log_shown {
    $DRAWN = 0;                           # what the window shows from here on is lzrprf's own, over the page: a fault it says now is not of a page the application drew
    $UNEXPIRED = !expire_log() if $UNEXPIRED;
    my ($mode, $days, $unread) = keeping();
    my ($holds, $count, @lines) = holds_log();
    my $rows = sub { map { my ($when, undef, $what) = split /\t/, s/[^\x20-\x7e\t]/?/gr, 3; "log line $when\t" . (length($what // '') > 600 ? substr($what, 0, 600) . ' ...' : $what // '') =~ s/\t/   /gr } @_ };    # the time, what happened; the number of the run stays in the file
    my @mine = @SESSION > 200 ? @SESSION[-200 .. -1] : @SESSION;
    my $says = "Every address lzrprf fetched for $APP in this window is below" . (@SESSION > @mine ? ', its last ' . @mine . ' lines' : '') . '. ' . kept_words($mode, $days, $unread)
        . ($count ? " The log on this computer holds $holds." . ($count > @lines ? ' Below are its last ' . @lines . ' lines.' : '') . " The whole of it: $DIR/log" . ($mode eq 'nothing' ? ' It was written earlier, and nothing more is added to it.' : '') : '')
        . ($UNMARKED ? ' The log could not be marked for Time Machine to leave it out of backups.' : '');
    undef $UNMARKED;                      # said once
    my $more = $INCOGNITO ? ' No button of this window makes lzrprf keep more.' : $mode eq 'nothing' ? " To keep a log, type in Terminal: perl $SELF keep " . (defined $PROFILE ? "--profile $PROFILE " : '') . "hosts. No button of this window makes lzrprf keep more." : '';    # an incognito window keeps nothing whatever is chosen, and is told nothing of profiles [C16]: the words to type would not be of it
    # The log page of the window, over the page shown, which stays as it is under it: these words, then this
    # window's lines, then the last of the log on this computer. "log shut" closes it again.
    window('log begin', "log note $says$more", 'log part This window', $rows->(@mine), $count ? ('log part On this computer', $rows->(@lines)) : (), 'log end');
    if ($count) {                         # the clear, one click away whenever there is a log on this computer
        window("brief $count " . ($count == 1 ? 'line is' : 'lines are') . ' kept on this computer.');
        if (ask($says, 'Keep the log', 'Clear the log') == 2) {
            window('brief Clear the log? This cannot be undone.');
            return aside('The log was kept.') unless ask("Clear the log? It holds $holds. This cannot be undone.", 'Keep', 'Clear') == 2;
            my $cleared = clear_log();
            window('log shut');
            return idle(!$cleared ? 'The log was not cleared: an address is being fetched right now, or the log could not be written. Nothing was removed.' : $mode eq 'nothing' ? 'The log was cleared: there is no log on this computer now.' : 'The log was cleared. Its first line now says so.');
        }
        $says = 'The log is as it was. ' . kept_words($mode, $days, $unread);
    }
    return aside("$says$more") if $mode eq 'nothing';
    window('brief Kept on this computer: ' . ($mode eq 'all' ? 'full addresses.' : 'hosts only.'));
    return aside($says, 1) unless ask($says, 'Close', 'Keep less') == 2;
    choose_keeping($mode, $days);
    window('log shut');
}

# Keeping less, in the window: full addresses can become hosts only, and
# either can become nothing. Each first button keeps less. What is chosen
# holds from the next request on, and deletes and shortens nothing that is
# on the disk already: that is the button "Clear the log".
sub choose_keeping {
    my ($was, $days) = @_;
    my $log = ask('What is kept after this window closes? A log on this computer lets you look back at what was fetched, and so can anyone who reads your files.', 'Keep nothing', $was eq 'all' ? 'Keep a log' : 'Hosts only, as now') == 2;
    my $full = $log && $was eq 'all' && ask('A log of hosts only holds, for each request, the time, the host, the numeric address and how it ended: no path and no query. Full addresses can hold search words, tokens and invitation links.', 'Hosts only', 'Full addresses, as now') == 2;
    my $mode = !$log ? 'nothing' : $full ? 'all' : 'hosts';    # never more than $was: "all" only from "all", "hosts" only from "all" or "hosts"
    my $lock = keep_lock() or return idle("What is kept was not changed: $DIR/keep.lock could not be taken.");
    my ($now, $left) = keeping();         # read again, under the lock: a question can stand open for minutes, and "lzrprf keep" may have run in that time
    if ($MORE{$mode} >= $MORE{$now}) {    # nothing is written that is not less than what is kept at this moment
        return idle('What is kept is as it was. ' . kept_words($now, $left)) if $now eq $was && $left == $days;
        return idle('What is kept was changed elsewhere while this question was open. Nothing was written here. ' . kept_words($now, $left));
    }
    my (undef, $count) = holds_log();
    my $writing = log_lock() or return idle("What is kept was not changed: $DIR/lock could not be taken.");
    return idle("What is kept was not changed: $DIR/keep could not be written.") unless keep_as($mode, $left);    # the days as they are now: never more of them
    my $told = changed('in the window', $now, $left, $writing);
    idle('From the next request on: ' . kept_words(keeping()) . ($count ? " The log on this computer still holds $count lines written before this choice. They are not deleted or shortened: the Log button offers to clear it." : '')
        . ($told ? '' : ' The log on this computer could not be given the line that says so.'));
}

# A change of what is kept is written down itself: among this window's
# lines, and as a line of the log on this computer when there is one or one
# is kept from now on. So a log says where it stops, or where its lines
# became shorter or longer, and whether a button or the command did it.
sub changed {
    my ($how, $was, $before, $lock) = @_;
    my ($mode, $days) = keeping();
    my $named = sub { $_[0] eq 'nothing' ? 'nothing' : ($_[0] eq 'hosts' ? 'hosts only' : 'full addresses') . ($_[1] ? ", $_[1] days" : ', until cleared') };
    my $line = line("what is kept was changed $how: " . $named->($was, $before) . ' -> ' . $named->($mode, $days));
    push @SESSION, $line;
    return 1 if $mode eq 'nothing' && !-e "$DIR/log";
    $lock //= log_lock() or return 0;
    my $new = !-e "$DIR/log";
    my $size = (-s "$DIR/log") // 0;
    if (!put("$DIR/log", O_APPEND, $line)) { $HALF = ((-s "$DIR/log") // 0) > $size; return 0 }
    excluded("$DIR/log") if $new || !$MARKED++;
    return 1;
}

sub log_lock {                            # one writer of the log at a time. A change of what is kept holds it from the setting to its line, so no line of a request falls between the two
    open my $lock, '>>', "$DIR/lock" or return;
    flock $lock, LOCK_EX or return;
    return $lock;
}

sub keep_lock {                           # one writer of the setting at a time: a window's answers, or "lzrprf keep". Held from reading the setting to the line that says it changed
    open my $lock, '>>', "$DIR/keep.lock" or return;
    flock $lock, LOCK_EX or return;
    return $lock;
}

sub holds_log {                           # what the log on the disk holds, in words; the number of its lines; the last 200 of them
    my ($count, $first, $last, @tail) = (0, '', '');
    my $in;
    if (sysopen($in, "$DIR/log", O_RDONLY | O_NOFOLLOW | O_NONBLOCK) && -f $in) {    # a plain file and no link; a pipe put in its place is not waited for
        while (my $line = <$in>) {
            chomp $line;
            $first = $line unless $count++;
            $last = $line;
            push @tail, $line;
            shift @tail if @tail > 200;
        }
    }
    return ('nothing yet', 0) unless $count;
    return (sprintf('%d lines, %.1f MB, from %s to %s', $count, (-s "$DIR/log") / 1048576, map { /^(\S+)/ ? $1 : '?' } $first, $last), $count, @tail);
}

# What is kept, in a plain settings file of yours, "$DIR/keep": "nothing";
# "hosts" or "all" with a number of days, 0 for until you clear it. Only
# lzrprf writes it, outside every container: "lzrprf keep" for you, and the
# process behind the window after an answer there that keeps less (sub
# choose_keeping, sub keep_as). No container can write a file, and no button
# of the window keeps more. Anything else in that place counts as
# "nothing": no file, a link, a file of another owner or with a second name,
# a file that is not plain, more than one short line, a word or a number
# lzrprf does not take. Returns the mode, the days, and whether the file was
# there and not read.                                                   # [C12]
sub keeping {
    return ('nothing', 0, 0) if $INCOGNITO;    # [C16] its log is in its memory only
    sysopen(my $in, "$DIR/keep", O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return ('nothing', 0, -l "$DIR/keep" || -e _);
    my @is = stat $in;
    return ('nothing', 0, 1) unless @is && -f _ && $is[3] == 1 && $is[4] == $< && $is[7] <= 64;
    my $text = '';
    sysread($in, $text, 65) // return ('nothing', 0, 1);
    my ($mode, $days) = $text =~ /^(nothing|hosts|all)(?: ([0-9]{1,4}))?\n?\z/ or return ('nothing', 0, 1);
    return ('nothing', 0, defined $days) if $mode eq 'nothing';
    $days //= $KEPT_DAYS;
    return $days <= $KEPT_MOST ? ($mode, $days + 0, 0) : ('nothing', 0, 1);
}

sub kept_words {                          # what is kept, in one sentence
    my ($mode, $days, $unread) = @_;
    return ($unread ? "$DIR/keep is not a setting lzrprf takes, so: " : '') . 'Nothing is kept after this window closes.' if $mode eq 'nothing';
    return 'Kept on this computer ' . ($days ? "for $days days" : 'until you clear it') . ': ' . ($mode eq 'hosts' ? 'hosts only.' : 'full addresses.');
}

sub keep_as {                             # the settings file, written beside the old one and through to the disk, then given its name in one step
    my ($mode, $days) = @_;
    unlink "$DIR/keep.new";
    sysopen(my $out, "$DIR/keep.new", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) or return 0;
    require IO::Handle; print($out $mode eq 'nothing' ? "nothing\n" : "$mode $days\n") && $out->flush or return 0;
    return 0 unless ($^O eq 'darwin' ? defined fcntl($out, 51, 0) : $out->sync) && close $out;
    rename "$DIR/keep.new", "$DIR/keep" or return 0;
    synced();
    return 1;
}

sub keep_command {                        # "lzrprf keep": what is kept, in words; or a new setting. The one place where more is chosen
    my ($mode, $days) = @_;
    mkdir $DIR, 0700;
    my @folder = lstat $DIR;
    die "lzrprf: $DIR is not a folder of yours\n" unless @folder && -d _ && $folder[4] == $<;
    my $one = defined $PROFILE ? "--profile $PROFILE " : '';    # the profile it was said of, so the words to type again name it too
    my $choices = "lzrprf keep ${one}nothing\n       lzrprf keep ${one}hosts|all [DAYS]     DAYS from 0 (until you clear it) to $KEPT_MOST, $KEPT_DAYS when it is left out\n";
    my $lock = keep_lock() or die "lzrprf: $DIR/keep.lock could not be taken. Nothing was changed.\n";
    my ($was, $before) = keeping();
    my (undef, $count) = holds_log();
    my $untold;
    if (defined $mode) {
        die "usage: $choices" unless $mode =~ /^(?:nothing|hosts|all)\z/ && (!defined $days || $mode ne 'nothing' && $days =~ /^[0-9]{1,4}\z/ && $days <= $KEPT_MOST);
        my $writing = log_lock() or die "lzrprf: $DIR/lock could not be taken. Nothing was changed.\n";
        keep_as($mode, $days // $KEPT_DAYS) or die "lzrprf: $DIR/keep could not be written. Nothing was changed.\n";
        my ($now, $after) = keeping();
        if (($now ne $was || $after != $before) && !changed('by "lzrprf keep"', $was, $before, $writing)) {    # the line that says so could not be written
            if ($now eq 'nothing') { $untold = 1 }    # keeping nothing is never refused
            else {
                my $half = $HALF;
                my $back = keep_as($was, $before);
                my $noted = $back && $half && changed('back by "lzrprf keep", as the line before this one could not be confirmed on the disk', $now, $after, $writing);
                die "lzrprf: the line that says what was changed could not be " . ($half ? 'confirmed on the disk' : 'written') . " in $DIR/log, so "
                    . (!$back ? "the old setting was to be put back, and that failed too: the change stands unsaid. Look at $DIR/keep"
                        : !$half ? 'nothing was changed'
                        : 'the old setting was put back. The log holds the line of the change' . ($noted ? ', and after it the line that it was put back' : ', and not that it was put back')) . ".\n";
            }
        }
        print 'From the next request on: ';
    }
    my ($now) = keeping();
    print kept_words(keeping()) =~ s/this window closes/a window closes/r, "\n";
    print "Full addresses can hold search words, tokens and invitation links.\n" if $now eq 'all';
    print "The log on this computer still holds $count lines written before this choice. They are not deleted or shortened: the Log button of the window offers to clear it.\n" if defined $mode && $count && $now ne 'all' && $now ne $was;
    print "A log written earlier is still on this computer, $count lines. Nothing more is added to it: the Log button of the window offers to clear it.\n" if !defined $mode && $count && $now eq 'nothing';
    print "The log on this computer could not be given the line that says so.\n" if $untold;
    print "To choose: $choices" unless defined $mode;
}

# The log. Every line is kept in the memory of the process behind the window,
# and there only, unless you chose a kept log: then it is added at the end of
# the log on the disk too, cut to its hosts unless you chose full addresses,
# and this returns true only when the system says the line is on the disk.
# Nothing is looked up or fetched whose line could not be recorded, and no
# answer is shown whose line could not.                                  # [C5]
# Nothing in this file changes or removes a line of the log on the disk but
# your button and the days you chose, and the log has no size at which
# anything is dropped. Each line: the time, the number of the run it belongs
# to, what happened. The log stays on this computer. Nothing in this file
# sends it, or any part of it, anywhere.                                 # [C12]
sub record {
    my ($what, $mode) = @_;
    my $line = line(unlisted($what));    # [C23]
    ($mode) = keeping() unless defined $mode;    # a request reads it once and hands it in: none of its lines is kept at more than that
    my $lock;
    if ($mode ne 'nothing') {
        $lock = log_lock() or return 0;
        my ($now) = keeping();            # read again, under the lock a change of what is kept holds: when less was chosen while this request is open, no line follows the line of that change at more
        $mode = $now if $MORE{$now} < $MORE{$mode};
    }
    if ($mode ne 'nothing') {
        my $new = !-e "$DIR/log";
        put("$DIR/log", O_APPEND, $mode eq 'hosts' ? shortened($line) : $line) or return 0;
        excluded("$DIR/log") if $new || !$MARKED++;    # a new log, and once in each window a log that was there already, such as one an earlier release wrote
    }
    push @SESSION, $line;
    return 1;
}

sub line { strftime('%Y-%m-%dT%H:%M:%SZ', gmtime) . "\t$$\t$_[0]" }    # the time, the run, what happened

# A line of a log of hosts only: every address in it cut to https://host. So
# the disk holds the time, the run, the host, the numeric addresses lzrprf
# connected to and how it ended; no path, no query, no name before an @.
sub shortened { $_[0] =~ s{https://(?:[^/?#\s\@]*\@)?([A-Za-z0-9.-]+)\S*}{https://$1}gr }

# Time Machine leaves out of its backups a file with this mark. That it does
# is Apple's doing and is not tested here. A mark that could not be set
# stops nothing, and the Log button says so once.
sub excluded {
    my ($file) = @_;
    my (undef, $done) = said(5, '/usr/bin/xattr', '-w', '-s', 'com.apple.metadata:com_apple_backup_excludeItem', 'com.apple.backupd', $file);
    $UNMARKED = 1 unless $done;
    return $done;
}

sub put {                                 # lines into a plain file of yours that no link leads elsewhere, and through to the disk
    my ($file, $how, @lines) = @_;
    sysopen(my $out, $file, O_WRONLY | O_CREAT | O_NOFOLLOW | $how, 0600) or return 0;
    my @is = stat $out;
    return 0 unless -f _ && $is[3] == 1 && $is[4] == $<;
    require IO::Handle; print($out map { /\n\z/ ? $_ : "$_\n" } @lines) && $out->flush or return 0;
    return 0 unless $^O eq 'darwin' ? defined fcntl($out, 51, 0) : $out->sync;    # 51 is F_FULLFSYNC: through the disk's own cache
    return close $out;
}

sub synced { if (open my $folder, '<', $_[0] // $DIR) { $^O eq 'darwin' ? fcntl($folder, 51, 0) : $folder->sync } }    # a change of name, through to the disk too

# Replacing the log: the new log, whose first line says why, is written
# beside the old one and through to the disk, marked for Time Machine, and
# then takes its name in one step. So at no moment is there a log that was
# emptied or shortened without saying so.                                # [C12]
sub replace_log {
    unlink "$DIR/log.new";
    unless (put("$DIR/log.new", O_EXCL, @_)) { unlink "$DIR/log.new"; return 0 }    # what could not be written whole is not left beside the log
    excluded("$DIR/log.new");
    unless (rename "$DIR/log.new", "$DIR/log") { unlink "$DIR/log.new"; return 0 }
    synced();
    return 1;
}

# Clearing: by your button only, and not while a request is between its
# first line and its last. With a kept log the new log's first line says what
# the old one held. When nothing is kept, the log an earlier window or an
# earlier release left is taken away whole.
sub clear_log {
    open my $requests, '>>', "$DIR/busy" or return 0;
    flock $requests, LOCK_EX | LOCK_NB or return 0;
    open my $lock, '>>', "$DIR/lock" or return 0;
    flock $lock, LOCK_EX or return 0;
    my ($holds) = holds_log();
    if ((keeping())[0] eq 'nothing') {
        unlink "$DIR/log.new";            # and what a replacing that failed may have left beside it
        unlink "$DIR/log" or return 0;
        synced();
        push @SESSION, line("you cleared the log: it held $holds");    # no log is left to say so: this window's lines do
        return 1;
    }
    return replace_log(line("you cleared the log: it held $holds"));
}

# The days you chose. At the start of a window, the lines of a kept log that
# are older than that are taken out, the way clearing replaces the log, and
# the new first line says how many and why. With 0 days, or when nothing is
# kept, no line is taken out: a log an earlier release left stays as it is
# until you clear it.                                                    # [C12]
sub expire_log {
    my ($mode, $days) = keeping();
    return 1 if $mode eq 'nothing' || !$days || !-e "$DIR/log";
    open my $requests, '>>', "$DIR/busy" or return 0;
    flock $requests, LOCK_EX | LOCK_NB or return 0;
    open my $lock, '>>', "$DIR/lock" or return 0;
    flock $lock, LOCK_EX or return 0;
    my $before = strftime('%Y-%m-%dT%H:%M:%SZ', gmtime(time - $days * 86400));
    my ($old, @kept) = (0);
    sysopen(my $in, "$DIR/log", O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return 0;
    return 0 unless -f $in;                # a plain file and no link; a pipe put in its place is not waited for
    while (my $one = <$in>) {
        if ($one =~ /^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)\t/ && $1 lt $before) { $old++ } else { push @kept, $one }    # a line without a time is kept
    }
    close $in;
    return 1 unless $old;
    return replace_log(line("lzrprf took out $old lines older than $days days, as you chose"), @kept);
}

sub show {
    my ($mode, $days, $unread) = keeping();
    print 'What is kept: ', kept_words($mode, $days, $unread) =~ s/this window closes/a window closes/r, $mode eq 'all' ? '' : ' The full lines of a window that is open now are in that window only: press its Log button.', "\n";
    print "when (UTC)\trun\twhat you typed, where lzrprf connected for it, and how it ended\n";
    if (open my $in, '<', "$DIR/log") { print <$in> } else { print "(nothing on this computer)\n" }
}

# The proof for this computer. "selftest" probes this file on this Mac and,
# when every probe was held, writes down the mark of what it tested: the
# build of macOS, the SHA-256 of this file and the SHA-256 of the selftest
# beside it, the file that made the probes. Nothing is shown unless that
# mark is the mark of now. So after macOS was updated, or this file or the
# selftest beside it changed, no page is shown before the probes were made
# again. Where no selftest can be read beside this file, there is no mark,
# and nothing counts as proven.
# When the test held but could not try every check on this Mac, it writes
# the mark followed by ", untested: " and the checks it could not try. Such
# a line counts only after you said yes to starting without exactly those
# checks, for exactly this mark: the window names them and asks, Quit first,
# and your yes is kept as that whole line in the file "untested". A yes to
# another line (other checks, another build, another lzrprf) is not a yes to
# this one, and the question comes again.                                # [C11]
# The file of marks holds up to eight lines, one for each copy of lzrprf that
# was tested on this build of macOS: testing another copy, such as one from
# the public repository, does not take the proof from the one that is
# installed. A line counts only when it is the mark of this file, of now.
sub mark {
    my ($build) = said(5, '/usr/sbin/sysctl', '-n', 'kern.osversion');
    my $self = sum_of($SELF) // return '';
    my $test = sum_of(dirname($SELF) . '/selftest') // return '';    # no selftest to read beside this file: no mark, so nothing counts as proven
    return $build =~ /^(\w+)$/ ? "macOS build $1, lzrprf $self, selftest $test" : '';
}

sub sum_of { sysopen my $in, $_[0], O_RDONLY | O_NOFOLLOW | O_NONBLOCK or return; -f $in or return; binmode $in; return eval { Digest::SHA->new(256)->addfile($in)->hexdigest } }    # what cannot be read to its end has no sum; a plain file and no link, and a pipe put in its place is not waited for

# The program is the file this window began with. Its SHA-256 is read whole when the window begins
# ($BEGAN, sub behind), and with it the file it was read from, as the system names a file: its
# device, its number on that device, its mode, its size, and the times it was last written and last
# changed, to the nanosecond. Before every run (sub contained) and before a site is asked for a page
# (sub visit) the file is named again; while it is still that file, nothing was written to it, put
# in its place or moved over it since its bytes were read: every write sets the time of change,
# which no program can set back, and a file put in its place is another number. Then the sum stands
# without reading 10 MB again, which took 30 to 36 ms before every run, four times for a visit with
# the two runs before its page (measured 2026-11-24, scripts/snappy.pl). Any other file, or one that
# was touched, is read whole again, and the window goes on only with the same sum. A sum read again
# would come from what the system holds in memory, not from the disk, so reading it again found no
# more than this does. The file is named once it is open (fstat), never by its path alone.
sub sum_seen {                            # (the SHA-256 of a file, the file it was) from one opening; the file only when it did not change while it was read
    sysopen my $in, $_[0], O_RDONLY | O_NOFOLLOW | O_NONBLOCK or return;
    -f $in or return;
    binmode $in;
    my $before = file_named($in);
    my $sum = eval { Digest::SHA->new(256)->addfile($in)->hexdigest } // return;
    my $after = file_named($in);
    return ($sum, defined $before && defined $after && $before eq $after ? $after : undef);
}
# At the start the sum is read by a copy of this process (fork, no other program) while the tries of
# sub holds run, and handed back on a pipe: the same sub, the same file, the same answer, but its 30 ms
# no longer stand on the way to the first page (measured 2026-11-24). The copy runs nothing else and
# ends at once; an answer that is not one sum of 64 hex digits and one name of a file is no answer, and
# then the sum is read here, as before.
sub copied {                              # a copy of this process (fork, no other program) that works out one answer beside this one, and the pipe it answers on; or nothing
    my ($work) = @_;
    pipe(my $from, my $to) or return;
    my $copy = fork // return;
    if (!$copy) {
        close $from;
        $SIG{$_} = 'DEFAULT' for qw(INT TERM HUP QUIT);
        syswrite $to, $work->();
        POSIX::_exit(0);
    }
    close $to;
    return [$from, $copy];
}
sub copy_said {                           # what the copy answered, at most 400 bytes, once it ended
    my ($from, $copy) = @{ $_[0] };
    my $said = '';
    1 while length $said < 400 && sysread($from, $said, 400, length $said);
    close $from;
    waitpid $copy, 0;
    return $said;
}
sub sum_started { my ($file) = @_; my $run = copied(sub { my ($sum, $seen) = sum_seen($file); ($sum // '') . "\n" . ($seen // '') . "\n" }) or return; return [@$run, $file] }    # the pipe the copy answers on, or nothing
sub sum_read {                            # (the SHA-256, the file it was) as sub sum_seen gives them, from the copy or else read here
    my ($run) = @_;
    return unless $run;
    my $file = $run->[2];
    my $said = copy_said($run);
    my ($sum, $seen) = $said =~ /\A([0-9a-f]{64})\n((?:[0-9]+(?:\.[0-9]+)? ){5}[0-9]+(?:\.[0-9]+)?)?\n\z/ or return sum_seen($file);
    return ($sum, $seen);
}
sub file_named { my @is = Time::HiRes::stat($_[0]); return @is ? join(' ', @is[0, 1, 2, 7, 9, 10]) : undef }    # device, number, mode, size, written, changed
sub program_same {                        # true when the program on the disk is the file this window began with
    return 0 unless defined $BEGAN;
    if (defined $PROGRAM_SEEN && sysopen my $in, $PROGRAM, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) { return 1 if -f $in && (file_named($in) // '') eq $PROGRAM_SEEN }
    my ($sum, $seen) = sum_seen($PROGRAM);
    my $same = defined $sum && $sum eq $BEGAN;
    $PROGRAM_SEEN = $same ? $seen : undef;
    return $same ? 1 : 0;
}

# The mark of now is worked out the same way, by sub mark in a copy beside the tries (10 ms off the way
# to the first page, measured 2026-11-24): the same build asked of sysctl, the same two files read whole,
# the sums taken while the window is being made rather than a moment after it said it was ready. Only a
# whole mark is taken from the copy; no answer, or an empty one, and the mark is worked out here, after.
sub mark_started { return copied(sub { mark() . "\n" }) }
sub mark_read { my $said = $_[0] ? copy_said($_[0]) : ''; return $said =~ /\A(macOS build \w+, lzrprf [0-9a-f]{64}, selftest [0-9a-f]{64})\n\z/ ? $1 : mark() }
sub proven {                              # given the copy of sub mark_started, or nothing
    my $mark = mark_read($_[0]);
    my $is = sub {                        # 'plain' for the mark of now; the line, for the mark of now with the checks that could not be tried; '' for neither
        sysopen my $in, "$ROOT/proven", O_RDONLY | O_NONBLOCK or return '';    # a pipe put in its place is not waited for
        return '' unless length $mark && -f $in;
        my @lines = map { scalar(<$in>) // () } 1 .. 8;
        return 'plain' if grep { $_ eq "$mark\n" } @lines;
        my ($line) = grep { /^\Q$mark\E, untested: [\x20-\x7e]{1,600}\n\z/ } @lines;    # as selftest writes it: the question shows all of it, so the yes is to nothing unseen
        return defined $line ? $line =~ s/\n\z//r : '';
    };
    my $without = sub {                   # a line that names checks the test could not try counts only after a yes to exactly that line
        my ($line) = @_;
        return 1 if $line eq 'plain';
        my $yes = '';
        if (sysopen my $in, "$ROOT/untested", O_RDONLY | O_NOFOLLOW | O_NONBLOCK) { $yes = (-f $in ? scalar(<$in>) : undef) // '' }    # a plain file and no link; a pipe put in its place is not waited for
        return 1 if $yes eq "$line\n";
        my $text = substr($line, length "$mark, untested: ");
        if (ask("The self-test held on this Mac, but it could not try every check here: $text. What it could not try is not shown to hold on this Mac as it is now. Start $APP without it?", 'Quit', 'Start') != 2) {
            window('quit');
            leave();
        }
        unlink "${\ shared()}/untested";
        if (sysopen my $out, "${\ shared()}/untested", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) { print $out "$line\n"; close $out }    # when it cannot be kept, the question comes again at the next start
        return 1;
    };
    my $found = $is->();
    return $without->($found) if length $found;
    if (testing()) {                      # a self-test is running on this Mac (an installer's in Terminal, or one by hand): it took this copy's mark out when it began and writes it again when it holds, so its result is waited for, not asked for twice
        busy("lzrprf's self-test is running on this Mac, an installer's or one by hand. $APP waits for its result instead of asking to test again.");
        my $until = now() + 900;
        select undef, undef, undef, 0.5 while testing() && now() < $until;
        $found = $is->();
        return $without->($found) if length $found;
    }
    return 0 if $INCOGNITO;               # [C16] the self-test writes its result: an incognito window does not run it
    my $test = dirname($SELF) . '/selftest';
    if (ask("lzrprf has not been tested on this Mac as it is now: macOS was updated, or lzrprf or its selftest is new. The test runs hostile tries we made ourselves, just to be sure, and lzrprf must deflect every one; it takes about half a minute. $APP shows a page only when all were deflected. Test now?", 'Not now', 'Test now') != 2) {
        window('quit');
        leave();
    }
    busy('lzrprf is deflecting hostile tries we made ourselves, just to be sure. This takes about half a minute.');
    my ($report) = -f $test ? said(900, '/usr/bin/perl', $test) : ("there is no selftest beside $SELF\n");
    unlink "${\ shared()}/selftest.txt";
    if (sysopen my $out, "${\ shared()}/selftest.txt", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) { print $out $report }
    $found = $is->();
    return $without->($found) if length $found;    # the test held: when it could not try every check, the same question is asked before an address is taken
    my @failed = grep { /^(?:FAILED|UNTESTED|selftest:)/ } split /\n/, $report;
    @failed = (split /\n/, $report)[-20 .. -1] unless @failed;
    window('page', 'Pc0', (map { ('T@' . substr(s/\t/   /gr =~ s/[^\x20-\x7e]/?/gr, 0, 300), 'B') } grep { length } @failed[0 .. (@failed > 200 ? 199 : $#failed)]), '.');
    return 0;
}

# True while another process holds the lock selftest keeps for the whole of its run
# (~/.lzrprf/selftest.lock): a shared lock is not given beside it. A link, a pipe
# or no file at all is no test running.
sub testing {
    sysopen my $lock, "$ROOT/selftest.lock", O_RDONLY | O_NOFOLLOW | O_NONBLOCK or return 0;
    return 0 unless -f $lock;
    return !flock $lock, LOCK_SH | LOCK_NB;
}

sub lookup {                              # every address a name leads to, as numbers, one on a line
    return unless $$ == $FRESH;           # only in a process started afresh ("lzrprf lookup NAME"): a copy made by fork looks up nothing here, and is given no address
    return if listed($_[0]);              # [C23] a listed name is never handed to the resolver, from here either: nothing is printed, as for a name that leads nowhere
    my ($failed, @all) = getaddrinfo($_[0], 443, { socktype => SOCK_STREAM });
    print map { (getnameinfo($_->{addr}, NI_NUMERICHOST | NI_NUMERICSERV))[1] . "\n" } $failed ? () : @all;
}

