# The test site: four listeners on this computer.
#   trusted     https, with the certificate lzrprf is told to trust
#   untrusted   https, with a certificate nothing trusts
#   plain       no encryption at all: it takes whatever arrives
#   echo        no encryption: answers what it is sent, preceded by "echo:"
# Each connection adds one line to the site's record: which listener, every
# byte that arrived there in the request, the bytes that opened the
# encryption, and whether lzrprf's log already held the line for this
# request at the moment the request arrived.
my (%listener, %port);
for my $kind (qw(trusted untrusted plain echo closed)) {
    $listener{$kind} = IO::Socket::IP->new(LocalHost => '127.0.0.1', LocalPort => 0, Listen => 64, ReuseAddr => 1) or die "selftest: cannot listen: $!\n";
    $port{$kind} = $listener{$kind}->sockport;
}
close delete $listener{closed};           # a port where nothing listens
# [C25] The test's own keys, made here and thrown away with the test: a release key (Ed25519) and an approval key
# (P-256), as the project's server and the owner's phone hold the real ones. The test site serves one manifest of
# release 7, naming the installer it serves, signed with both, beside every installer address; "lzrprf try" reads the
# two public keys from its own folder, so the runs that look at release 7 are given them (sub run_of).
my $signed_folder = "$site_folder/signed";
mkdir $signed_folder, 0700 or die "selftest: cannot make $signed_folder: $!\n";
for (['release', 'ed25519', 'test-release'], ['approval', 'ecdsa', 'test-approval']) {
    my ($key, $type, $comment) = @$_;
    system('/usr/bin/ssh-keygen', '-q', '-t', $type, ($type eq 'ecdsa' ? ('-b', '256') : ()), '-N', '', '-C', $comment, '-f', "$signed_folder/$key") == 0 or die "selftest: cannot make the test's $key key\n";
}
system('/bin/cp', "$signed_folder/release.pub", "$signed_folder/release-key.pub") == 0 && system('/bin/cp', "$signed_folder/approval.pub", "$signed_folder/approval-keys.pub") == 0 or die "selftest: cannot place the test's public keys\n";
{
    my @at = map { my @t = gmtime(time + $_); sprintf '%04d-%02d-%02dT%02d:%02d:%02dZ', $t[5] + 1900, $t[4] + 1, @t[3, 2, 1, 0] } -60, 30 * 86400;
    open my $out, '>', "$signed_folder/release.manifest" or die "selftest: cannot write the test's manifest: $!\n";
    print $out "lzrbrwsr release manifest 1\nrelease 7\nsigned $at[0]\nexpires $at[1]\nfile install.sh " . Digest::SHA::sha256_hex("the page of the test site\n") . "\n";
    close $out;
    for (['release', 'lzrbrwsr-release', 'sig'], ['approval', 'lzrbrwsr-approval', 'approval']) {
        my ($key, $namespace, $ending) = @$_;
        system('/bin/sh', '-c', 'exec /usr/bin/ssh-keygen -q -Y sign -f "$0" -n "$1" <"$2" >"$3"', "$signed_folder/$key", $namespace, "$signed_folder/release.manifest", "$signed_folder/release.manifest.$ending") == 0 or die "selftest: cannot sign the test's manifest with its $key key\n";
    }
