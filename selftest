    # Otherwise the new, independent pre-fetch shield correctly stops the broken copy first and the
    # test never reaches the boundary it is supposed to weaken. Real C28 runs above use the unmodified lzrprf.
    if ($name =~ /\A(?:nofeeder|leftpage|lostlook|lostprobe|lostpage)\z/) {
        $text =~ s/^sub shield_said \{.*?^\}/sub shield_said { return 'allow' }/ms
            or die "selftest: the isolated legacy fixture no longer has shield_said\n";
    }
    open my $out, '>', "$site_folder/$name" or die "selftest: cannot write $site_folder/$name: $!\n";
    print $out $text;
    close $out;
    system('/bin/cp', abs_path($0), "$site_folder/selftest") == 0 or die "selftest: cannot copy selftest beside the copies\n" unless -e "$site_folder/selftest";    # a copy has a mark, and so offers a report, only with a selftest beside it
    put_file("$site_folder/blocklist", slurp("$here/blocklist")) unless -e "$site_folder/blocklist";    # [C23] a copy opens no page without its list
