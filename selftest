sub mutant {                              # a copy of lzrprf with one of its conditions taken out, to see that the test notices
    my ($name, %changes) = @_;
    my $text = $text_of_lzrprf;
    for my $old (sort keys %changes) {
        my $at = index $text, $old;
        die "selftest: lzrprf no longer holds the line this test takes out ($old)\n" if $at < 0;
        substr($text, $at, length $old) = $changes{$old};
    }
