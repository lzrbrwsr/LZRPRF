# The bytes that open an encryption, with the values that must differ from one
# connection to the next set to zero: the random number, the session number,
# the key that is offered. And whether an earlier connection is taken up again.
sub offered {                            # the ciphers and curves the first message of a connection offers, as hex
    my ($hello) = @_;
    return unless length $hello > 48 && ord($hello) == 22 && ord(substr $hello, 5, 1) == 1;
    my $at = 9 + 2 + 32;
    $at += 1 + ord substr $hello, $at, 1;
    my $long = unpack 'n', substr $hello, $at, 2;
    my @ciphers = map { sprintf '%04x', $_ } unpack 'n*', substr $hello, $at + 2, $long;
    $at += 2 + $long;
    $at += 1 + ord substr $hello, $at, 1;
    my $end = $at + 2 + unpack 'n', substr $hello, $at, 2;
    $at += 2;
    my @curves;
    while ($at + 4 <= $end) {
        my ($type, $size) = unpack 'nn', substr $hello, $at, 4;
        @curves = map { sprintf '%04x', $_ } unpack 'n*', substr $hello, $at + 6, $size - 2 if $type == 10;
        $at += 4 + $size;
    }
    return ('ciphers', @ciphers, 'curves', @curves);
}
sub steady {
    my ($hello) = @_;
    return unless length $hello > 48 && ord($hello) == 22 && ord(substr $hello, 5, 1) == 1;
    my $at = 11;
    substr($hello, $at, 32) = "\0" x 32;
    $at += 32;
    my $n = ord substr $hello, $at, 1;
    substr($hello, $at + 1, $n) = "\0" x $n;
    $at += 1 + $n;
    $at += 2 + unpack 'n', substr $hello, $at, 2;
    $at += 1 + ord substr $hello, $at, 1;
    return ($hello, 0) if $at + 2 > length $hello;
    my $end = $at + 2 + unpack 'n', substr $hello, $at, 2;
    my $head = substr $hello, 0, $at;     # all that stands before the extensions
    $at += 2;
    my ($resumes, $rest) = (0, '');
    while ($at + 4 <= $end && $end <= length $hello) {
        my ($type, $size) = unpack 'nn', substr $hello, $at, 4;
        my $body = substr $hello, $at + 4, $size;
        $body = "\0" x $size if $type == 51;
        $body = '' if $type == 0 || $type == 21;    # the name of the host asked for, and the padding that fills the bytes up to one length whatever that name is: a picture's request names the picture's host
        $resumes = 1 if $type == 41 || $type == 35 && $size;
        $rest .= pack('nn', $type, length $body) . $body;
        $at += 4 + $size;
    }
    substr($head, 3, 2) = "\0\0";         # the two lengths before them count the name in
    substr($head, 6, 3) = "\0\0\0";
    $hello = $head . $rest;
    return ($hello, $resumes);
}

# What the test put on this computer is taken away again: its site with the
# helpers the site started, the runs it started itself, its files. Also when
# the test is stopped from outside. Only processes this test started itself
# are ever ended: each by the number "fork" returned for it, or as a child of
# the site by that number. No list of other processes is ever walked.
sub tidy {
    my @helpers = $site && $site > 1 ? map { /^\s*(\d+)\s+\Q$site\E\s*$/ ? $1 : () } qx{/bin/ps -axo pid=,ppid=} : ();
    kill 'KILL', grep { /^\d+$/ && $_ > 1 && $_ != $$ } keys %pid;
    kill 'TERM', grep { /^\d+$/ && $_ > 1 && $_ != $$ } $site && $site > 1 ? $site : (), @helpers;
    unlink $secret if $secret_made;
    unlink $temp_file if length($temp_file // '');
    unlink $settings_file if length($settings_file // '');
    keep_logs($_[0]) if $failures || $_[0]; for my $one (glob "$base.*") { chmod 0600, glob "$one/*"; remove_tree($one) }    # a test that failed, or was stopped, keeps first what each of its runs said (sub keep_logs)
}
sub keep_logs { my ($why) = @_; my ($tmp) = ($ENV{TMPDIR} // '') =~ m{\A(/[^\0]*?)/*\z}; my $kept = defined $tmp && -d $tmp && -o _ ? "$tmp/lzrprf-selftest.$outside.kept" : return; mkdir $kept, 0700 or return; open my $runs, '>', "$kept/runs.txt" or return; print $runs "selftest of lzrprf: $mark\n" . ($why ? "$why\n" : "$failures FAILED\n") . 'the load of this Mac at the end: ' . load_now() . "\n", map { sprintf "%s\t%s s\t%s\n", $_, defined $run{$_}{took} ? sprintf('%.1f', $run{$_}{took}) : '-', ended_how($_) } @order; close $runs; for my $one (map { ("$_.out", "$_.err") } @order) { my $text = slurp("$site_folder/$one"); next unless length $text; open my $to, '>', "$kept/$one" or next; binmode $to; print $to substr($text, -65536); close $to } print "kept   how each run of this test ended, and the last of what its windows and lzrprf said, for the failure to be read: $kept\n"; }    # into the temporary folder (TMPDIR: a runner slot's own, which scripts/test-run.sh keeps with the run): how each run ended, and the last 64 KiB of what its window and lzrprf said, one file each
sub unmark {                              # the mark of this copy is taken out of the file of marks; the marks of other copies stay
    open my $in, '<', "$home/.lzrprf/proven" or return;
    my @all = map { scalar(<$in>) // () } 1 .. 8;
    close $in;
    my @kept = grep { plain_mark($_) ne "$mark\n" } @all;    # in either form: the mark alone, or with the checks that could not be tried
    return if @kept == @all;
    open my $out, '>', "$home/.lzrprf/proven.new" or die "selftest: cannot write $home/.lzrprf/proven.new: $!\n";
    print $out @kept;
    close $out && rename "$home/.lzrprf/proven.new", "$home/.lzrprf/proven" or die "selftest: cannot write $home/.lzrprf/proven: $!\n";
}

sub plain_mark { $_[0] =~ s/, untested: [^\n]*//r }    # a line of the file of marks without the checks that could not be tried: the mark of its copy

sub pulled_words {                        # "sub pulled_command", "sub opened_with", "sub started" and "sub address" of lzrprf, taken out and run here
    my ($command) = $text_of_lzrprf =~ /^(sub pulled_command \{.*)$/m;
    my @rest = map { my ($one) = $text_of_lzrprf =~ /^(sub $_ \{.*?^\}\n)/ms; $one } qw(opened_with started address);    # "sub listed" [C23] stands in as a list of nothing: the list is tried in its own runs
    my ($name) = $text_of_lzrprf =~ /^(my \$NAME = .*)$/m;
    return 'not found in lzrprf' if grep { !defined } $command, $name, @rest;
    my $got = eval "package Pulled; no warnings; our (\$SELF, \$INCOGNITO, \$TOR_WINDOW, \$PROGRAM, \@ARGUMENTS, \$PROFILE, \@script) = ('lzrprf');\n$name\n$command\n" . join("\n", @rest) . "\nsub listed { 0 }\nsub hear { shift \@script }\n" . q{
        my @words = map { $INCOGNITO = $_->[0]; ($PROGRAM, @ARGUMENTS) = @{ $_->[2] }; my @c = pulled_command(@{ $_->[1] }); join ' ', @c[2 .. $#c] } [0, ['10 20 900 700'], ['/app', 'x']], [1, ['1 2 30 40'], ['/app']];
        my $in = sub { my $bytes = shift; open my $h, '<', \$bytes; $h };
        my @opened = map { my ($bytes, @more) = @$_; join(',', map { $_ // '-' } opened_with($in->($bytes), '--open', '5 6 700 500', '/app', @more)) } ["site.test/b\nmore\n", 'y'], ["\n"], [''];
        my @died = map { my ($bytes, @one) = @$_; eval { opened_with($in->($bytes), '--open', @one); 1 } ? 'took' : 'died' } ["http://site.test/b\n", '5 6 700 500', '/app'], ["\n", '5 6 0 500', '/app'], ["\n", '5 6 700 500'], ['https://site.test/' . ('a' x 2100) . "\n", '5 6 700 500', '/app'];
        my @start = map { @script = @$_; my $one = started(); !defined $one ? 'refused' : length $one ? $one : 'none' } ['start -', 'ready'], ['start https://site.test/c', 'ready'], ['ready'], ['go https://site.test/c', 'ready'], ['start https://site.test/c', 'view 1 2'];
        join(' | ', @words, @opened, "@died", "@start");
    };
    return $got // "failed: $@";
}
sub pulled_argv {                         # every command line lzrprf builds for a pulled tab's window, run here with its address in hand: "sub tab_out" and "sub pulled_command", and the two lines of "sub run" that start behind and the window, with the real "sub window_text"; how many arguments hold the address
    my @subs = map { my ($one) = $text_of_lzrprf =~ /^(sub $_ \{.*?^\}\n)/ms; $one } qw(tab_out);
    my ($command) = $text_of_lzrprf =~ /^(sub pulled_command \{.*)$/m;
    my ($text) = join "", $text_of_lzrprf =~ /^(sub window(?:_sound)?_text \{.*?^END\n\}\n)/msg;    # the window's text and the part of a video's sound joined after it
    my ($run) = $text_of_lzrprf =~ /^(sub run \{.*?^\}\n)/ms;
    my @lines = (($run // '') =~ /^(    become\(\$from, .*\n)/m, ($run // '') =~ /^(    my \$window_source = .*?^    become\(\$window_in, [^\n]*\n)/ms);
    return 'not found in lzrprf' if grep({ !defined } @subs, $command, $text) || @lines != 2;
    my $got = eval "package Argv; no warnings; our (\$SELF, \$INCOGNITO, \$TOR_WINDOW, \$PROGRAM, \@ARGUMENTS, \@TABS, \$TAB, \$TRY, \$OPEN, \$OPEN_FRAME, \$APP, \$HOME, \$WINDOW_CONTAINER, \$SCRIPT, \$DIR, \$PEER, \$ANSWER, \$BASE, \$PROFILE, \$ROOT, \@made, \$PULLED, \$PULLED_MOST, \$GONE) = ('lzrprf');\n(\$PULLED, \$PULLED_MOST) = (0, 32);\n"
        . "sub address { (\$_[0]) } sub idle {} sub window {} sub tabbed {} sub frame_kept { '1 2 300 400' } sub window_host { \$_[0] eq 'bundle' ? ('/app/lzrbrwsr-window', 'fixture-profile') : (undef, \$WINDOW_CONTAINER) } sub apart { push \@made, ['apart', \@_]; 1 } sub become { push \@made, ['become', 'nothing', \@_[3 .. \$#_]] }\n"
        . join("\n", @subs, $command, $text) . q{
        my $secret = 'https://site.test/secret/page';
        @TABS = ({ url => $secret }, { url => 'https://site.test/other' });
        ($TRY, $TAB, $PROGRAM, @ARGUMENTS) = (0, 0, '/app', 'x');
        for my $mode (0, 1) { $INCOGNITO = $mode; tab_out(0, '10 20 900 700') }
        ($OPEN, $OPEN_FRAME, $APP, $HOME, $SCRIPT, $DIR, $INCOGNITO) = ($secret, '10 20 900 700', 'App', '/Users/someone', '/usr/bin/osascript', '/tmp/x', 0);
        my ($from, $to, $window_in, $window_out, $more, $behind, $window, $program, @arguments) = (undef, undef, undef, undef, '', 0, 1, '/app', 'x');
        eval join('', } . join(', ', map { "q\x01$_\x01" } @lines) . q{) . '1' or return "failed: $@"; $program = 'bundle'; eval } . "q\x01$lines[1]\x01" . q{ . '1' or return "failed: $@";
        join(' | ', map { my ($how, $in, @argv) = @$_; ($argv[0] =~ s{.*/}{}r) . ($how eq 'apart' ? ' in=' . ($in eq $secret ? 'the address' : $in) : '') . ' argv=' . @argv . ' holding it=' . grep({ index($_, 'site.test') >= 0 } @argv) } @made);
    };
    return $got // "failed: $@";
}

sub profile_argv {                        # every command line that names a profile, run here in a profile's window: "sub profile_command" for the first and for another profile, "sub pulled_command", and the line of "sub run" that starts behind
    my @subs = map { my ($one) = $text_of_lzrprf =~ /^(sub $_ \{.*)$/m; $one } qw(profile_command pulled_command);
    my ($run) = $text_of_lzrprf =~ /^(sub run \{.*?^\}\n)/ms;
    my ($behind) = ($run // '') =~ /^\s+(become\(\$from, \$to, .*)$/m;
    return 'not found in lzrprf' if grep { !defined } @subs, $behind;
    my $got = eval "package ProfileArgv; no warnings; our (\$SELF, \$INCOGNITO, \$TOR_WINDOW, \$PROGRAM, \@ARGUMENTS, \$PROFILE, \$ROOT, \$DIR, \$TRY, \$PEER, \$ANSWER, \$BASE, \@made) = ('lzrprf');\nsub become { push \@made, [\@_[3 .. \$#_]] }\n" . join("\n", @subs) . q{
        $PROGRAM = '/app'; @ARGUMENTS = ('x'); $PROFILE = 'a0a0a0a0a0a0'; $INCOGNITO = 0;
        ($ROOT, $DIR, $TRY, $PEER, $ANSWER) = ('/Users/someone/.lzrprf', '/Users/someone/.lzrprf/profiles/a0a0a0a0a0a0', 0, '-', 'allow');
        my ($from, $to, $behind, $window, $program, @arguments) = (undef, undef, 0, 1, '/app', 'x');
        my @lines = (profile_command('a0a0a0a0a0a0'), '|', profile_command('first'), '|', pulled_command('1 2 300 400'));
        eval } . "q\x01$behind\x01" . q{ . "\n1" or return "failed: $@";
        ($INCOGNITO, $DIR) = (1, '/tmp/lzrprf-i.1.abcdefabcdef');    # an incognito window opened from that profile's window
        push @lines, '|', pulled_command('1 2 300 400');
        eval } . "q\x01$behind\x01" . q{ . "\n1" or return "failed: $@";
        my @one = (@lines, '|', @{ $made[0] // [] }, '|', @{ $made[1] // [] });
        join(' ', map { $_ eq '/usr/bin/perl' || $_ eq 'lzrprf' ? () : $_ } @one);
    };
    return $got // "failed: $@";
}
sub closed_order {                        # "sub closed_kept" of lzrprf, taken out and run here: twelve tabs closed, then one with no address
    my ($text) = $text_of_lzrprf =~ /^(sub closed_kept \{.*?^\}\n)/ms;
    defined $text or return 'not found in lzrprf';
    return eval "package Closed; no warnings; our \@CLOSED; our (\$CLOSED_MOST, \$CLOSED_DRAWN) = (10, 2); $text " . q{
        closed_kept({ url => "https://site.test/$_", shown => {} }, $_ - 1) for 1 .. 12;
        my $before = @CLOSED;
        closed_kept({ url => '', shown => {} }, 0);
        scalar(@CLOSED) . ': ' . join(' ', map { ($_->[1]{url} =~ m{(\d+)$})[0] . '@' . $_->[0] . ($_->[1]{shown} ? '+' : '') } @CLOSED) . " empty=$before";
    } // "failed: $@";
}

sub later_heard {                         # "sub asked" and "sub hear" of lzrprf, taken out and run here: Tor turned on and off while a question is open, then the loop of sub behind hearing again
    my ($asked) = $text_of_lzrprf =~ /^(sub asked \{.*?^\}\n)/ms;
    my ($hear) = $text_of_lzrprf =~ /^(sub hear \{.*?^\}\n)/ms;
    defined $asked && defined $hear or return 'not found in lzrprf';
    my $vars = 'package Later; no warnings; our ($FROM, $FROM_HELD, $IDLE_WORK, $SPARE_WANTED, $CURL_WANTED, $ASKED, $ANSWER, $ANSWER_SECONDS, $TRY, $TRY_QUIET, $SOUND, @LATER, @HELD, @EVENTS, @LIVE, @said, @seen, @script);';
    my $press = eval "$vars \$FROM = 1; \$ASKED = 0; \$ANSWER_SECONDS = 5; \@said = \@seen = \@LATER = \@HELD = (); \@script = ('tor on', 'view 900 700', 'tor off', 'button 1 2'); sub window { push \@said, \$_[0] } sub viewing { push \@seen, \$_[0] } sub now { Time::HiRes::time() } sub leave { die qq{left\\n} } sub hear { shift \@script } $asked asked('ask Keep a log?', 'No', 'Yes')" // 'x';    # the window's answer comes after three other lines
    no warnings 'once';
    my @kept = @Later::LATER;
    my @next = eval "$vars $hear (hear(0, 1), hear(0, 1))";    # the real "sub hear" now, as the loop of sub behind calls it
    return "press=$press kept=" . join(',', @kept) . ' seen=' . join(',', @Later::seen) . ' next=' . join(',', @next) . ' left=' . (@Later::LATER + @Later::HELD);
}

sub program_starts {                      # every place the text of a lzrprf starts a system program, as "PROGRAM<tab>WHERE" => its first line; and each place it turns into another program
    my ($text) = @_;
    # WHERE is the top-level sub the line is in, or the name of the top-level variable whose text it is (a
    # shell's limits, a probe given to a container), or "(start of the file)" before both. A start is a
    # program's path that is a string of its own ('/usr/bin/plutil'), the head of a command in a shell's text
    # ("$(/bin/ps", "exec /usr/bin/env"), or a name that holds the path ($CURL) where it is used. A path
    # compared (eq), tested (-x) or allowed in a sandbox profile (literal) is not started there, and a line
    # that is all comment starts nothing.
    my $program = qr{/(?:usr/(?:local/)?)?(?:s?bin|libexec)/[\w.+-]+};
    my %named = $text =~ /^my \$(\w+) = '($program)';/mg;
    my $names = %named ? join('|', map { quotemeta } sort keys %named) : '(?!)';
    my (%starts, @execs);
    my ($where, $until, $number) = ('(start of the file)', undef, 0);
    for my $line (split /\n/, $text) {
        $number++;
        my $code = !defined $until;       # perl of lzrprf itself, not the text of a here-document
        if (defined $until) { undef $until if $line eq $until }
        else {
            $where = $1 if $line =~ /^sub (\w+)/;
            $where = $1 if $line =~ /^(?:my|our) ([\$\@%]\w+)/;
            $until = $1 if $line =~ /<<\s*'(\w+)'/ || $line =~ /<<\s*"(\w+)"/ || $line =~ /<<([A-Z_]+)\b/;
        }
        next if $line =~ /^\s*#/;
        next if $line =~ /^my \$(?:$names) = '$program';/;    # the name is given its path here; it is started where it is used
        while ($line =~ /(.{0,8}?)(['"])($program)\2/g) {
            my ($before, $path) = ($1, $3);
            $starts{"$path\t$where"} //= $number unless $before =~ /(?:\beq|-x|literal)\s*\z/;
        }
        $starts{"$1\t$where"} //= $number while $line =~ /(?:\$\(|\bexec )($program)/g;
        $starts{"$named{$1}\t$where"} //= $number while $line =~ /\$($names)\b/g;
        next unless $code;
        my $bare = $line =~ s/'(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*"|\bqw\([^)]*\)//gr =~ s/(?<!\$)#.*//r;    # without its strings and its comment
        push @execs, "$where\t$number" if $bare =~ /(?<![\w\$\@%>{-])(?:exec|system|qx|readpipe)\b(?!\s*=>)|\bIPC::Open\d|\x60/
            || $line =~ /\bopen\b.*['"](?:-\||\|-|\|[^'"]*|[^'"]*\|)['"]/;    # a pipe to a program, as open takes it
    }
    return (\%starts, \@execs);
}

sub starts_apart {                        # where the starts found in lzrprf and the starts capabilities.json lists part, one line each
    my ($starts, $listed) = @_;
    my $place = sub { $_[0] =~ /^\w/ ? "sub $_[0]" : $_[0] };
    return (map({ my ($path, $where) = split /\t/; "started but not listed: $path in " . $place->($where) . " (line $starts->{$_})" } grep { !$listed->{$_} } sort keys %$starts),
        map({ my ($path, $where) = split /\t/; "listed but no longer started: $path in " . $place->($where) } grep { !$starts->{$_} } sort keys %$listed));
}

sub changed {                             # the text of lzrprf with one line changed, as a copy of sub mutant has it
    my ($text, $old, $new) = @_;
    my $at = index $text, $old;
    die "selftest: lzrprf no longer holds the line this test changes ($old)\n" if $at < 0;
    substr($text, $at, length $old) = $new;
    return $text;
}

sub sub_map {                             # what tools/sub-map prints for this folder of parts (or file): "PART<tab>LINE<tab>NAME<tab>MARKS" for each part and each sub
    my ($from) = @_;
    open my $map, '-|', '/usr/bin/perl', "$here/tools/sub-map", $from or return;
    chomp(my @lines = <$map>);
    close $map or return;
    return @lines;
}

sub map_apart {                           # the first row where a written map and the map of the parts now part, in words; nothing when they agree
    my ($now, $written) = @_;
    my $key = sub { my ($part, $line, $name) = split /\t/, $_[0]; return $name eq '-' ? "part $part" : "sub $name" };    # a part's own row is named "-"
    my %now = map { my ($part, $line) = split /\t/; ($key->($_) => "line $line of $part") } @$now;
    my %was = map { my ($part, $line) = split /\t/; ($key->($_) => "line $line of $part") } @$written;
    for my $i (0 .. (@$now > @$written ? $#$now : $#$written)) {
        my ($is, $was) = ($now->[$i] // '', $written->[$i] // '');
        next if $is eq $was;
        my ($new, $old) = (length $is ? $key->($is) : '', length $was ? $key->($was) : '');
        return "$new at $now{$new} is not in AUDIT.md's map" if length $is && !exists $was{$new};
        return "$old at $was{$old} of AUDIT.md's map is not in lzrprf" if length $was && !exists $now{$old};
        return "$new is at $now{$new} and at $was{$new} in AUDIT.md's map" if length $is && $was{$new} ne $now{$new};
        return "AUDIT.md's map says \"" . ($was =~ s/\t/ /gr) . '" where the parts now have "' . ($is =~ s/\t/ /gr) . '"';    # the same lines, other marks
    }
    return;
}

sub joined {                              # what "perl tools/join --check DIR FILE" says of a folder of parts and a file: whether they join, and its words
    my ($dir, $file) = @_;
    my $pid = open(my $in, '-|') // return (0, 'tools/join could not be started');
    if (!$pid) { open STDERR, '>&', \*STDOUT; { no warnings; exec '/usr/bin/perl', "$here/tools/join", '--check', $dir, $file; } POSIX::_exit(127) }
    my $words = do { local $/; <$in> } // '';
    my $held = close $in;
    chomp $words;
    $words =~ s{\Q$_\E/}{}g for $site_folder, $here;    # the folders named shortly, as the files beside selftest are
    return ($held, length $words ? $words : 'tools/join said nothing');
}

sub parts_copy {                          # a copy of the parts in src/ at $to, the first part that holds $old with $new there: that part's name, and the line of the change in it
    my ($to, $old, $new) = @_;
    opendir my $in, "$here/src" or die "selftest: cannot read $here/src: $!\n";
    my @names = sort grep { /\A[0-9]{2}-[a-z0-9-]+\.pl\z/ } readdir $in;
    closedir $in;
    make_path($to);
    my ($name, $line);
    for my $one (@names) {
        my $text = slurp("$here/src/$one");
        my $at = defined $name ? -1 : index($text, $old);
        if ($at >= 0) { ($name, $line) = ($one, 1 + (substr($text, 0, $at) =~ tr/\n//)); substr($text, $at, length $old) = $new }
        open my $out, '>:raw', "$to/$one" or die "selftest: cannot write $to/$one: $!\n";
        print $out $text;
        close $out or die "selftest: cannot write $to/$one: $!\n";
    }
    die "selftest: no part of lzrprf holds the line this test changes ($old)\n" unless defined $name;
    return ($name, $line);
}

sub hears {                               # "sub hear" of lzrprf, taken out and run here against a pipe: what it returns when nothing is said in time, then when the other end is gone
    my ($text) = $text_of_lzrprf =~ /^(sub hear \{.*?^\})/ms;
    defined $text && pipe(my $from, my $to) or return ('x', 'x');
    my @got = eval "package Heard; no warnings; my \$FROM = \$from; my \$FROM_HELD = ''; my \$IDLE_WORK; my \$SPARE_WANTED; my \$CURL_WANTED; my \@EVENTS; my \@HELD; my \@LATER; my \@LIVE; my \$TRY = 0; my \$TRY_QUIET = 2; my \$SOUND; sub trmnl_select { } sub trmnl_heard { } sub prefetch_select { } sub prefetch_heard { } sub cht_select { } sub cht_heard { } sub now { require Time::HiRes; Time::HiRes::clock_gettime(Time::HiRes::CLOCK_MONOTONIC()) } $text; my \$quiet = hear(0.2); close \$to; (\$quiet, scalar hear(0.2))";    # with no page kept running, which it also hears
    return @got == 2 ? @got : ('x', 'x');
}

sub inked_lines {                         # "sub install_line" of lzrprf, taken out and run here: what the window's install modal would be given for each line an installer printed
    my ($text) = $text_of_lzrprf =~ /^(sub install_line \{.*?^\})/ms;
    my ($ink) = $text_of_lzrprf =~ /^(my %INK = .*?;)/m;
    defined $text && defined $ink or return;
    my $out = '';
    {
        local *STDOUT;
        open STDOUT, '>', \$out or return;
        eval "package Inked; no warnings; my \$INSTALL_LINE = 2000; my \$INSTALL_LOG; $ink $text; install_line(\$_) for \@_; 1" or $out = '';
        close STDOUT;
    }
    return split /\n/, $out;
}

sub check($$$) {
    my ($did, $what, $saw) = @_; $did ? $held++ : $failures++;
    printf "%-6s %s (%s)\n", $did ? 'held' : 'FAILED', $what, $saw // ''; printf "saw    %s\n", substr($saw // '', 0, 2000) unless $did;    # what it saw once more on a line of its own: an installer shows a check's first 200 characters
}

sub untested($$) {
    my ($what, $why) = @_; $untested++; push @not_tried, "$what ($why)";
    printf "%-6s %s (%s)\n", 'UNTESTED', $what, $why;
}

sub works($$$) {
    my ($did, $what, $saw) = @_; $did ? $held++ : $failures++;
    printf "%-6s %s (%s)\n", $did ? 'works' : 'FAILED', $what, $saw // ''; printf "saw    %s\n", substr($saw // '', 0, 2000) unless $did;
}
